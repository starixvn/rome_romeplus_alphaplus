    <EmbeddedResource Update="LocalResources\UIScoreMapLang.zh-CN.resx">
      <LastGenOutput>UIScoreMapLang.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="LocalResources\UIScoreMapLang.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>UIScoreMapLang.Designer.cs</LastGenOutput>
