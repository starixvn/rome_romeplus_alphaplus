    <NeutralLanguage>en-US</NeutralLanguage>
    <Version>4.0.0-standard1</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="LocalResources\UIScoreMapLang.Designer.cs">
