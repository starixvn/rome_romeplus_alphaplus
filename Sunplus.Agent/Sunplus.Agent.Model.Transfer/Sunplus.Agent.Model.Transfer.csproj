      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="AppResources\TransferError.th-TH.resx">
      <LastGenOutput>TransferError.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="AppResources\TransferError.zh-TW.resx">
      <LastGenOutput>TransferError.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="AppResources\TransferError.zh-CN.resx">
      <LastGenOutput>TransferError.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="AppResources\TransferError.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>TransferError.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Alpha\Alpha.Web\Alpha.Web.csproj" />
    <ProjectReference Include="..\Sunplus.Agent.Model.DataAccessLibrary\Sunplus.Agent.Model.DataAccessLibrary.csproj" />
  </ItemGroup>
</Project>