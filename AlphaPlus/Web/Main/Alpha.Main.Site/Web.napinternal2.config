<configuration>
  <configSections>
    <section name="AuthorizationSection" type="AlphaPlus.Auth.Configurations.AuthorizationSection, AlphaPlus.Auth" />
  </configSections>

  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="~/App_Data/SPNames/INTERNAL/" enableWatching="1" ignoreExceptionIsNotParameters="true" />
    </providers>
  </Fanex.Data.DbSettingProvider>

  <AuthorizationSection configSource="Web.Configuration\AuthorizationSection.config" />

  <appSettings file="Web.AppSettings.config" />

  <system.web>
    <pages buffer="true" enableViewState="false"></pages>
    <siteMap defaultProvider="AlphaSiteMap" enabled="true">
      <providers>
        <add name="AlphaSiteMap" type="System.Web.XmlSiteMapProvider"
          siteMapFile = "~/App_Data/Alpha.sitemap" />
      </providers>
    </siteMap>

    <compilation debug="false" targetFramework="4.6.1" />
    <httpRuntime enableVersionHeader="false" />
    <httpModules>
      <add name="SecurityCodeHttpModule" type="Alpha.SecurityCode.HttpModules.SecurityCodeHttpModule, Alpha.SecurityCode" />
    </httpModules>

    <authentication mode="Forms">
      <forms loginUrl="/ex-main/_Authorization/SignIn.aspx" defaultUrl="~/default" path="/" name=".SHAREDFORMSAUTH" protection="All" cookieless="UseDeviceProfile" />
    </authentication>
    <sessionState mode="Custom" customProvider="MySessionStateStore" cookieless="true">
      <providers>
        <add name="MySessionStateStore" type="Microsoft.Web.Redis.RedisSessionStateProvider" connectionString="10.2.27.140:16379,Password=foo1@bared,abortConnect=false,configChannel=__Booksleeve_MasterChanged" applicationName="SHAREDFORMSAUTH.Prod.Internal.789y" />
      </providers>
    </sessionState>
  </system.web>
  <system.webServer>
    <modules>
      <remove name="WindowsAuthentication"></remove>
      <remove name="PassportAuthentication"></remove>
      <remove name="DefaultAuthentication" />
      <remove name="OutputCache" />
      <remove name="AnonymousIdentification" />
      <remove name="RoleManager" />
      <remove name="Alpha.SecurityCodeHttpModule" />
      <add name="Alpha.SecurityCodeHttpModule" type="Alpha.SecurityCode.HttpModules.SecurityCodeHttpModule, Alpha.SecurityCode" preCondition="managedHandler" />
    </modules>
    <validation validateIntegratedModeConfiguration="false" />
    <staticContent>
      <clientCache cacheControlMaxAge="365:00:00" cacheControlMode="UseMaxAge" />
    </staticContent>
  </system.webServer>
