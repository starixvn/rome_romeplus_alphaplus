<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H],[L]"
  custIdQueryStringParamNameMapping="subaccid,subAccountId,custid,CustId,custId,targetCustId,id,cid,recommend,mrecommend,idagent,masterId,agentId,idAgent,idMaster,ibccustid,ACustID"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer"
  ignoreUrls="SignIn.aspx,ProcessAdminLogin.ashx,ProcessAfterLogin.ashx,Captcha.ashx,ChartImg.axd,ReCheckin.ashx,SecurityCode,Header.aspx,Index.aspx,GetServerTime"
  cachedExpireTime="30"
  kickOutUrl="~/default/kickout">
  <!--
    [A]: Create
    [B]: Update
    [C]: Transfer
    [D]: Total Bets
    [E]: Reports
    [F]: Forcast
    [H]: Member Information
    [G]: View Log
    [L]: Bet Lists
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="2.08.35" permission="[A],[B],[H]" mainfuncname="Member Info" subfuncname="Reset Secuirty Code" url="SecurityCode/ResetSecurityCode" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="2.08.31" permission="[B]" mainfuncname="Member Info" subfuncname="Reset Password downline" url="Password/ResetMainAccountPassword" ischeckbelonging="true" isallowtodobythemselves="true" />

      <add id="2.15.01" permission="[A],[B],[H]" mainfuncname="Member Info" subfuncname="Reset otp downline" url="Otp/ResetOtp" ischeckbelonging="true" isallowtodobythemselves="true" />

      <add id="2.16.00" permission="[B]" mainfuncname="Member Info" subfuncname="Reset Password subacc" url="Password/ResetSubAccountPassword" ischeckbelonging="true" isallowtodobythemselves="true" isallowedcrosslevel="false" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>