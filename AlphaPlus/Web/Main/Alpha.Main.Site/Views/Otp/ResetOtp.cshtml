@using Alpha.Main.Site.Features.OTP
@model ResetOtpViewModel
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@Model.ResetTitle</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/otp/otp")
    @GoogleAnalyticHelper.GtagScript()
</head>

<body>
    @GoogleAnalyticHelper.GtagNoScript()
    <h1 id="title_header" class="page-title">@Model.ResetTitle</h1>
    @if (Model.Result != null)
    {
        <div class="msg @(Model.Result.IsSuccessful ? "msg-success" : "msg-error")">@Model.Result.Message</div>
    }
    @Html.Hidden("ResetOtpWarning", Security.ResetDownlineOtpWarning)
    @using (Html.BeginForm("resetotp", "otp", FormMethod.Post, new { @id = "otp-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.CustId)
        @Html.HiddenFor(model => model.SubAccountId)
        @Html.HiddenFor(model => model.Username)
        <div class="otp-reset">
            <p class="note">@Security.ResetOtpWarning</p>
            <button id="btn-change-status" class="btn-remove">@Resources.Remove</button>
        </div>
    }
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render($"/bundles/site-main/otp/otp-default")
    @StaticResources.RenderScripts("~/assets/bundles/security/otp/reset-otp")
</body>

</html>
