@using Alpha.Main.Site.ViewModels.Security;
@model VerifyOTPViewModel
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@Security.OtpValidation</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/otp/otp")
    @GoogleAnalyticHelper.GtagScript()
</head>

<body>
    @GoogleAnalyticHelper.GtagNoScript()
    <h1 id="title_header" class="page-title">@Security.OtpValidation</h1>
    <div class="verify-otp">
        <img alt="Avatar" src='' class='profile-avatar' />
        <div class="wrapper-right">
            <form class="form-validation block" id="otp-form">
                <div class="msg-content form-group hidden" id="otp-message">
                    <div class="msg msg-warning"></div>
                </div>
                <div class="form-group">
                    <label>@(string.Format(@Security.VerifySecurityCodeShower, @Model.UsernameShower))</label>
                    <label>@Security.InputOtpBeforeProceeding</label>
                    <label class="otp-title">OTP</label>
                    <input maxlength="6" type="password" class="txt form-control" name="otp" id="txtOTP" />
                </div>
                <div class="form-group">
                    @if (Model.IsShowGenerateOTPButton)
                    {
                        <button type="button" class="btn-submit" id="btnGenerateOTP">@Security.GenerateOTP <span
                                id="countdown"></span></button>
                    }
                    <input type="submit" class="btn-submit" id="btnSubmit" value="@Security.Submit" />
                </div>
            </form>
            <div class="note">
                <span class="note-red">*</span>@Security.OtpDatetimeWarning
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()
    @Html.Hidden("requiredFieldMessage", Security.alertSecCodeEmpty)
    @Html.Hidden("mainRootPath", MicroSites.MainUrl())
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/otp/otp-default")
    @StaticResources.RenderScripts("~/assets/bundles/security/otp/verify-otp")
</body>

</html>
