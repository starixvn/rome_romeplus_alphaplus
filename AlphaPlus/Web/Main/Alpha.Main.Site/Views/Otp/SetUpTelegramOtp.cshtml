@model Alpha.Main.Site.ViewModels.TelegramChatBot.RegisterAccountViewModel

<div class="panel">
    <div class="panel-heading" role="tab" id="headingRegisterTelegram">
        <h4 class="panel-title">
            <a role="button" data-toggle="collapse" href="#registerTelegram" aria-expanded="false"
                aria-controls="registerTelegram">
                @Security.SetupOTPViaTelegramChatbot
            </a>
        </h4>
    </div>
    <div id="registerTelegram" class="panel-collapse collapse in" role="tabpanel"
        aria-labelledby="headingRegisterTelegram">
        <div class="panel-body has-padding">
            <p>@Security.OTPViaChatbotIntroduction</p>
            <p>@Security.ToSetupChatbot</p>
            @Html.PartialAsync("../TelegramChatBot/RegisterTelegramAccount", Model)
            <label class="input-disable ml-16">
                <input id="cbkEnableOtp" type="checkbox" disabled />
                @Security.EnableOtpViaTelegramChatbot
            </label>
        </div>
    </div>
</div>