@using Alpha.Main.Site.ViewModels.Nickname
@model CreateNicknameViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="description">
    <meta content="" name="author">
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-main/security/before-home-page")
    @StaticResources.RenderStyles("~/Assets/bundles/nickname/nickname")
    <title>@Resources.nickname</title>
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
      @StaticResources.AssetScripts.RenderCommon("/bundles/common/support-IE8")
    <![endif]-->
    @AlphaPlus.Web.Helpers.GoogleAnalyticHelper.GtagScript()
</head>
<body>
    @GoogleAnalyticHelper.GtagNoScript()
    <div class="block nickname">
        @using (Html.BeginForm("Index", "Nickname", FormMethod.Post, new { id = "frmNickname", @class = "form-SC form-validation", novalidate = "novalidate" }))
        {
            @* TODO: Languages @Html.Action("Languages", "SecurityCode") *@
            @Html.AntiForgeryToken()
            <h1 class="title">@Resources.nickname</h1>
            <p>
                @Resources.NicknameCompanyPolicy
                @if (Model.IsRecommendLoginByNickname)
                {
                    <br />
                    <span class="text-red bold">@Model.NicknameEffectedFrom</span>
                    <div>
                        <a class="link" href="@MicroSites.MainUrl("~/Default/Index?action=Skip")">@Resources.NicknameSkipText</a>
                    </div>
                }
            </p>
            <p class="lblUsername">@(Model.IsDisableUpdateNickname ? Resources.PleaseSelectLoginByNickname : Resources.PleaseChooseNickname):</p>
            <div class="rowlg">
                <input type="text" id="nickname" name="nickname" value="@Model.Nickname" class="txt nickname" autocomplete="off" placeholder="@Resources.nickname" maxlength="20" @(Model.IsDisableUpdateNickname ? "disabled" : string.Empty)>
                <label id="nickname-error" class="error">
                    @if (Model.Result?.IsFailed == true)
                    {
                        @Model.Result.Message
                    }
                </label>
                <i class="icon-user"></i>
                <i class="validation"></i>
            </div>
            <div class="rowlg">
                @if (Model.IsDisableUpdateNickname)
                {
                    <div class="radio">
                        <input type="radio" id="loginByUsernameOrNickname" name="nickNameLoginOnly" checked>
                        <label class="label-text txtAccent" for="loginByUsernameOrNickname">@Resources.NicknameOption1</label>
                    </div>
                }
                <div class="radio">
                    <input type="radio" id="loginByNickname" name="nickNameLoginOnly" @(Model.IsDisableUpdateNickname ? string.Empty : "checked")>
                    <label class="label-text txtAccent bold" for="loginByNickname">@Resources.NicknameOption2</label>
                </div>
            </div>
            <div>
                <button type="button" class="btn-cancel" id="buttonBack">@Security.lblBack</button>
                <button type="submit" class="btn-submit" id="buttonSubmit" @(Model.IsDisableUpdateNickname ? "disabled" : string.Empty)>@Resources.submit</button>
            </div>
        }
        <div class="rules" id="rules">
            <div class="rules-title" data-toggle="modal" data-target="#nicknameRules"><span class="icon-information-outline icon-rules"></span>@Resources.NicknameRules</div>
            <!-- Modal -->
            <div class="modal fade information" id="nicknameRules" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <span class="icon icon-close close" data-dismiss="modal" aria-label="Close"></span>
                            <h4 class="modal-title" id="myModalLabel"><span class="icon-information-outline icon-rules"></span>@Resources.NicknameRules</h4>
                        </div>
                        <div class="modal-body">
                            <ul class="list-note">
                                <li>@Resources.NicknameRule</li>
                                <li>@Resources.NicknameNote1</li>
                                <li>@(UserSession.Current.IsSubAcc ? Resources.SubAccNicknameNote2 : Resources.NicknameNote2)</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Html.Hidden("mainRootPath", CreateNicknameViewModel.MainRootPath)
    @* @Html.Hidden("oldMainRootPath", CreateNicknameViewModel.OldMainRootPath) *@
    @Html.Hidden("nicknameRule", Resources.NicknameRule)
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.RenderScripts("~/Assets/bundles/nickname/create-nickname")
</body>
</html>
