@using Alpha.Main.Site.Features.Password
@model ForceChangePasswordViewModel
@{
    ViewBag.Title = Security.lblChangePassword;
    Layout = "~/Views/Password/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-main/security/before-home-page")
}
<div class="block force-change-password-container">
    <form class="form-SC form-validation" action="" method="post" id="pwdForm" novalidate="novalidate">
        @await Component.InvokeAsync("Languages")
        <h1 class="title">@Resources.password</h1>
        <p> @(string.Format(@Security.PasswordShower, @Model.UsernameShower))</p>
        <figure class="avatar">
            <img id="logoProfileImg" profile-image-id="@Model.ProfileImageId"
                default-avatar="@Model.IsDefaultAvatar.ToString().ToLower()"
                src='@(Model.IsDefaultAvatar ? Url.Content("~/assets/images/icon_user_default.png") : Model.EmbedImage)'
                alt="Avatar" />
            <figcaption><span class="username">@Model.Username</span><br /><span
                    class="nickname">@Model.AlternateUsername</span></figcaption>
        </figure>
        <div class="rowlg">
            <input type="password" autocomplete="off" class="txt" name="txtOldPassword" id="txtOldPwd"
                placeholder="@Security.lblOldPassword" maxlength="16" />
            <label id="txtOldPwd-error" class="error"></label>
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg help-rules">
            <input type="password" autocomplete="off" class="txt" name="txtNewPassword"
                placeholder="@Security.NewPassword" id="txtNewPwd" maxlength="16" />
            <label id="txtNewPwd-error" class="error"></label>
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg">
            <input type="password" autocomplete="off" class="txt" name="txtConfirmPassword"
                placeholder="@Security.lblConfirmPassword" id="txtConfirmPwd" maxlength="16" />
            <label id="txtConfirmPwd-error" class="error"></label>
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg custom-checkbox">
            <input type="checkbox" id="showPasswordchk" />
            <label>@Security.ShowPassword</label>
        </div>
        <div class="list-button">
            <input type="button" class="btn-cancel" id="btn-back" value="@Security.lblBack" />
            <input type="submit" class="btn-submit" value="@Security.Submit" />
        </div>
    </form>
    <div class="rules" id="rules">
        <div class="rules-title" id="rules-title" data-toggle="modal" data-target="#pwd"><span
                class="icon-information-outline icon-rules"></span>@Security.PasswordRules</div>
        @if (Model.IsShowSkipForceChangePassword)
        {
            <div class="rules-title skip-force-change">@Security.Skip<span class="icon-skip-next"></span></div>
        }
        <!-- Modal -->
        <div class="modal fade information" id="pwd" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <span class="icon icon-close close" data-dismiss="modal" aria-label="Close"></span>
                        <h4 class="modal-title" id="myModalLabel"><span
                                class="icon-information-outline icon-rules"></span>@Security.PasswordRules</h4>
                    </div>
                    <div class="modal-body">
                        <p>@Security.PasswordHint01</p>
                        <ul>
                            @Html.Raw(Security.PasswordHint02)
                        </ul>
                        @Html.Raw(Security.PasswordHint03)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.IsShowSkipForceChangePassword)
{
    <div class="block hidden skip-force-change-container">
        @using (Html.BeginForm("SkipForceChangePassword", "Password", FormMethod.Post, new
        {
            id =
       "SkipForceChangePasswordForm",
            @class = "form-SC form-validation",
            role = "form"
        }))
        {
            @await Component.InvokeAsync("Languages")
            <h1 class="title">@Resources.password</h1>
            <p> @Security.SkipForceChangePasswordWarning</p>
            <div class="rowlg help-rules">
                <input type="text" autocomplete="off" class="txt" placeholder='@Security.SkipForceChangePasswordPlaceHolder'
                    id="skip-text" maxlength="16" />
            </div>
            <div class="list-button">
                <input type="button" class="btn-cancel" id="btn-back-skip" value="@Security.lblBack" />
                <input type="submit" disabled class="btn-submit" id="btn-submit-skip" value="@Security.Submit" />
            </div>
            @Html.AntiForgeryToken()
        }
    </div>
}

@Html.Hidden("hashkey", Model.HashKey)
@* @Html.Hidden("oldMainRootPath", Model.OldMainRootPath) *@
@Html.Hidden("mainRootPath", Model.MainRootPath)
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    @StaticResources.RenderScripts("~/assets/bundles/security/password/force-change-password")
}
