@model MenuBarViewModel
<ul class="main-tab">
    <li id="main-menu-header"
        class="mainmenu active @(Model.IsAccountInfoVisible ? "withripple" : "disabledViewAccInfo")"
        data-target-container="mainmenu-container">
        <a>@Resources.mainMenu</a>
    </li>
    @if (Model.IsAccountInfoVisible)
    {
        <li class="accountinfo withripple" id="account-info-header" data-target-container="accountinfo-container">
            <a>@Resources.accountInfo</a>
        </li>
    }
    <li class="visible-mobile nav-close">
        <span class='icon-close icon-close-left-panel' id="closeIconOnMobile"></span>
    </li>
</ul>
<section id="main-menu-tab"
    class="mainmenu-container mCustomScrollbar @(Model.IsAccountInfoVisible ? string.Empty : "disabledViewAccInfo")"
    data-mcs-theme="minimal@(Model.IsDarkMode ? string.Empty : "-dark")" role="tablist" aria-multiselectable="true">
    <ul class="list-menu" id="main-menu-items">
        @foreach (var menuItem in Model.MenuItems)
        {
            if (menuItem.VisibleSubMenus.Any())
            {
                <li class="menu-item @(menuItem.ShowSubMenus ? "active" : string.Empty)"
                    id="menu-@(menuItem.ResourceKey.ToUpper())">
                    <a class="withripple menu-opener parent-menu @(menuItem.ShowSubMenus ? "active" : string.Empty)">
                        <span class="txt-item pull-left txt-@menuItem.ResourceKey.ToLower()">
                            <span class="icon icon-@menuItem.ResourceKey.ToLower()"></span>
                            @Html.Raw(menuItem.DisplayName)
                        </span>
                        <span class="pull-right icon-arrow-right"></span>
                    </a>
                    <ul class="sub-menu" style="display: @(menuItem.ShowSubMenus ? "block" : "none");">
                        @foreach (var subMenuItem in menuItem.VisibleSubMenus)
                        {
                            <li data-url="@subMenuItem.Link"
                                class="sub-menu-item @(subMenuItem.Status.Disabled ? "disabled-menu" : string.Empty)"
                                id="sub-menu-@(subMenuItem.ResourceKey.ToUpper())">
                                <a href="#" class="redirect-item">
                                    @subMenuItem.DisplayName
                                    @Html.Raw(subMenuItem.IsBeta ? "<span class=\"beta-version\">" + Alpha_sitemap.Beta + "</span>"
                                             : string.Empty)
                                    @Html.Raw(subMenuItem.IsNew ? "<span class=\"beta-version\">" + Resources.lblNew + "</span>" :
                                             string.Empty)
                                    @Html.Raw(subMenuItem.IsOld ? $"<span> ({Alpha_sitemap.Old})</span>" : string.Empty)
                                </a>
                            </li>
                        }
                    </ul>
                </li>
            }
            else
            {
                <li class="menu-item" id="menu-@(menuItem.ResourceKey.ToUpper())">
                    <a class="withripple menu-opener parent-menu redirect-item" href="@menuItem.Link" target="main">
                        <span class="txt-item pull-left"><span
                                class="icon icon-@menuItem.ResourceKey.ToLower()"></span>@menuItem.DisplayName</span>
                        @Html.Raw(menuItem.IsNew ? "<span class=\"new-version\">" + Resources.lblNew + "</span>" : string.Empty)
                    </a>
                </li>
            }
        }
    </ul>
    <div class="extra-box">
        @if (Model.IsAccountInfoVisible)
        {
            <span class="icon icon-user" id="user-icon"></span>
        }
    </div>
    @if (!Model.IsHideBanner)
    {
        <div id="carousel-banner" class="carousel slide carousel-banner"></div>
    }
</section>
@Html.Hidden("AssetCommonCssLink", StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common"))
@if (Model.IsAccountInfoVisible)
{
