@model HeaderNavViewModel
@{
    var changeNickNameUrl = $"{Model.MainRootPath}LoginOption?custId={Model.CustId}";
    var mainFrameName = "main";
    var viewProfileUrl = $"{Model.AccountInfoRootPath}ProfilePicture";
    var profileImageSrc = Model.IsDefaultAvatar ? Url.Content("~/assets/images/icon_user_default.png") : Model.EmbedImage;
}

<section class="navbar header-nav" id="header-nav">
    <span class="icon-collapse icon-hamburger withripple" id="hamburger-icon"></span>
    <ul class="nav navbar-nav list-top">
        <li class="maintenance-box hide" id="um-message-box" title="@Resources.UMAnnouncementTitle">
            <span class="icon-under-maintenance"></span>
        </li>
        <li class="switch-mode-box">
            <span class="switch-mode @(Model.IsDarkMode ? "dark-mode" : string.Empty)"></span>
        </li>
        <li class="feedback-box" id="feedback-box">
            <span class="icon-feedback"></span>
        </li>
        @if (Model.ShowCreateMemberByQRCode)
        {
            <li class="visible-mobile"><span class="icon icon-qr-code-top" title="@Resources.CreateMemberWithQRCode"></span>
            </li>
        }
        @if (!Model.IsProtectedMode)
        {
            <li class="visible-mobile"><span class="icon icon-home"></span></li>
        }
        @if (Model.ShowSearchAccount)
        {
            <li class="visible-mobile"><span class="icon icon-account-search"></span></li>
        }
        <li class="hidden-mobile datetime">
            <span class="icon icon-time"></span>
            <span class="txt-top" id="clock" data-year="@DateTime.Now.Year" data-month="@DateTime.Now.Month"
                data-day="@DateTime.Now.Day" data-hour="@DateTime.Now.Hour" data-minute="@DateTime.Now.Minute"
                data-second="@DateTime.Now.Second"></span>
        </li>
        <li class="hidden-mobile dropdown language">
            @await Component.InvokeAsync("LanguageList")
        </li>

        @if (Model.ShowCreateMemberByQRCode)
        {
            <li class="hidden-mobile dropdown language">
                <a class="icon icon-qr-code-top withripple" title="@Resources.CreateMemberWithQRCode"></a>
            </li>
        }
        @if (Model.IsProtectedMode)
        {
            <li class="dropdown setting visible-mobile">
                <a id="btn-header-menu" data-target="#" class="dropdown-toggle withripple" data-toggle="dropdown">
                    <span class="profile-avatar">
                        <img id="userPicture" width="50" height="50" src='@profileImageSrc' alt=""
                            title="@Resources.ProfileClickTootip" />
                    </span>
                </a>
                <ul id="header-dropdown-menu" class="dropdown-menu list-setting">
                    <li class="profile-group">
                        <div class="profile-avatar">
                            <span class="img-link">
                                <img width="50" height="50" src='@profileImageSrc' alt="" />
                            </span>
                        </div>
                        <div class="userinfo">
                            <div class="info level username">
                                @Model.Username
                                @if (AlphaPlus.Core.Models.UserSession.Current.IsIndirectLoggedIn)
                                {
                                    <span class="icon-account-circle">&nbsp;</span>
                                }
                            </div>
                            <div class="info level nickname">
                                @if (!string.IsNullOrEmpty(Model.NickName))
                                {
                                    @Html.Raw(Model.NickName)
                                }
                            </div>
                            <div class="info">OTP: @(Model.IsEnabledOtp ? Resources.Enabled : Resources.Disabled)</div>
                        </div>
                    </li>
                    <li class="dropdown-submenu language">
                        @await Component.InvokeAsync("LanguageList")
                    </li>
                    <li class="bg-light">
                        <a class="link-logout"><span class="icon-pc icon-logout"></span>@Resources.LogOut</a>
                    </li>
                </ul>
            </li>
        }
        else
        {
            <li class="notification">
                <a class="icon icon-bell withripple"></a>
                <span id="numberOfNewMessage" class="number-msg"></span>
            </li>
            <li class="dropdown setting">
                <a id="btn-header-menu" data-target="#" class="dropdown-toggle withripple" data-toggle="dropdown">
                    <span class="icon icon-squares top-right-menu"></span>
                    <span class="profile-avatar">
                        <img id="userPicture" width="50" height="50" src='@profileImageSrc' alt=""
                            title="@Resources.ProfileClickTootip" />
                    </span>
                </a>
                <ul id="header-dropdown-menu" class="dropdown-menu list-setting">
                    <li class="profile-group visible-mobile">
                        <div class="profile-avatar">
                            <a href="@(viewProfileUrl)" target="@mainFrameName" class="img-link">
                                <img id="profile-avatar-image" width="50" height="50" src='@profileImageSrc' alt=""
                                    title="@Resources.ProfileClickTootip" />
                            </a>
                        </div>
                        <div class="userinfo">
                            <div class="info level username">
                                @Model.Username
                                @if (AlphaPlus.Core.Models.UserSession.Current.IsIndirectLoggedIn)
                                {
                                    <span class="icon-account-circle">&nbsp;</span>
                                }
                            </div>
                            <div class="info level nickname">
                                @if (!string.IsNullOrEmpty(Model.NickName))
                                {
                                    @Html.Raw(Model.NickName)
                                }
                                else
                                {
                                    <span id="spanNickNameID">@Resources.nickname: </span>
                                    <a href="@changeNickNameUrl" class="linkConfigNow" id="linkNickNameID"
                                        target="@mainFrameName">
                                        <span id="labelNickname">@Resources.configNow</span>
                                    </a>
                                }
                            </div>
                            <div class="info">OTP: @(Model.IsEnabledOtp ? Resources.Enabled : Resources.Disabled)</div>
                        </div>
                    </li>
                    <li class="visible-mobile dropdown-submenu language">
                        @* TODO: Language @Html.Action("List", "Language") *@
                    </li>
                    @if (Model.ShowNicknameMenu)
                    {
                        <li><a href="@($"{Model.MainRootPath}LoginOption?custId={Model.CustId}")" target="main"><span
                                    class="icon icon-account-key"></span>@Resources.nickname</a></li>
                    }
                    <li><a href="@viewProfileUrl" target="main"><span
                                class="icon icon-account-circle"></span>@Resources.EditProfilePicture</a></li>
                    <li><a href="@($"{Model.MainRootPath}Password/ChangePassword")" target="main"><span
                                class="icon icon-lock"></span>@Resources.password</a></li>
                    @if (Model.EnableSecurityCode)
                    {
                        <li><a href="@($"{Model.MainRootPath}SecurityCode/ChangeUserOwnSecurityCode")" target="main"><span
                                    class="icon icon-sercuritycode"></span>@Resources.SecurityCode</a></li>
                    }
                    <li><a href="@($"{Model.MainRootPath}otp/SetUpOtp")" target="main"><span
                                class="icon icon-otp"></span>OTP</a></li>
                    @if (Model.ShowAPIKeyFunction)
                    {
                        <li><a href="@($"{Model.MainRootPath}ApiKey/CreateApiKey")" target="main"><span
                                    class="icon icon-settingapi"></span>@ApiKey.API</a></li>
                    }
                    @if (Model.IsOfferProtectedMode)
                    {
                        <li><a href="@($"{Model.MainRootPath}ProtectionCode/Setup")" target="main"><span
                                    class="icon icon-key"></span>@Resources.ProtectionCode</a></li>
                    }
                    <li class="bg-light">
                        <ul class="list-unstyled">
                            @if (Model.ShowHelpLink)
                            {
                                <li><a href="@($"{Model.HowToUseRootPath}Index.aspx")" target="_blank"><span
                                            class="icon icon-help"></span>@Resources.Help</a></li>
                            }

                            @if (!Model.IsDisabledContactUsLink)
                            {
                                <li>
                                    <a href="@($"{Model.MainRootPath}ContactUs/Index")" target="main"><span
                                            class="icon icon-contactus"></span>@Resources.ContactUs</a>
                                </li>
                            }
                            @if (Model.IsOfferLiveChat)
                            {
                                <li>
                                    <a href="javascript:;" id="liveChat" class="white-space-nowrap"><span
                                            class="icon icon-Live-chat"></span>@Resources.LiveMessage</a>
                                </li>
                            }
                            <li class="visible-mobile"><a class="link-logout"><span
                                        class="icon icon-logout"></span>@Resources.LogOut</a></li>
                        </ul>
                    </li>
                </ul>
            </li>
        }
        <li class="hidden-mobile logout"><a class="icon icon-logout withripple" data-toggle="tooltip"
                data-placement="bottom" title="@Resources.LogOut"></a></li>
    </ul>
</section>