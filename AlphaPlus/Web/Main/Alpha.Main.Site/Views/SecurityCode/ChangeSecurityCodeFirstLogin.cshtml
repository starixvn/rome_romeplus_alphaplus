@using Alpha.Main.Site.ViewModels.Security
@model ForceChangeSecurityCodeViewModel
@{
    Layout = "~/Views/SecurityCode/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-main/security/before-home-page")
}
<div class="block">
    <form class="form-SC form-SC-before form-validation">
        @* TODO: Languages*@
        @* @Html.Action("Languages", "SecurityCode") *@
        <h1 class="title">@Security.SecurityCode</h1>
        <p> @Security.createSecurityCode</p>
        <figure class="avatar">
            <img id="logoProfileImg" alt="Avatar" src='' class='profile-avatar' />
            <figcaption><span class="username">@Model.Username</span><br /><span
                    class="nickname">@Model.AlternateUsername</span></figcaption>
        </figure>
        <div class="rowlg help-rules">
            <input type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" class="txt" name="SC"
                id="txtSecCode" placeholder="@Security.NewSecurityCode" maxlength="6">
            <label id="txtSecCode-error" class="error"></label>
            <i class="icon-account-key"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg">
            <input type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" class="txt" name="confirmSC"
                id="txtConfirmSecCode" placeholder="@Security.ConfirmSecurityCode" maxlength="6">
            <label id="txtConfirmSecCode-error" class="error"></label>
            <i class="icon-account-key"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg">
            <label><input type="checkbox" id="showSCchk" /> @Security.ShowSecurityCode</label>
        </div>
        <div class="list-button">
            <input type="button" class="btn-cancel" id="btn-back" value="@Security.lblBack" />
            <input type="submit" class="btn-submit" value="@Security.Submit" />
        </div>
    </form>
    <div class="rules" id="rules">
        <div class="rules-title" id="rules-title" data-toggle="modal" data-target="#sc"><span
                class="icon-information-outline icon-rules"></span>@Security.SecurityCodeRules</div>
        <!-- Modal -->
        <div class="modal fade information" id="sc" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <span class="icon icon-close close" data-dismiss="modal" aria-label="Close"></span>
                        <h4 class="modal-title" id="myModalLabel"><span
                                class="icon-information-outline icon-rules"></span>@Security.SecurityCodeRules</h4>
                    </div>
                    <div class="modal-body">
                        <p>@Security.SecurityCodeRules01</p>
                        <ul>
                            <li>@Security.SecurityCodeRules02</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Hidden("hashkey", Model.HashKey)
@* @Html.Hidden("oldMainRootPath", Model.OldMainRootPath) *@
@Html.Hidden("mainRootPath", Model.MainRootPath)
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    @StaticResources.RenderScripts("~/assets/bundles/security/security-code/change-securitycode-firstlogin")
}
