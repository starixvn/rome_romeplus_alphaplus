@using Alpha.Main.Site.ViewModels.Security
@model SecurityCodeViewModel
@{
    ViewBag.Title = @Security.titleVerifySecurityCode;
    Layout = "~/Views/SecurityCode/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.RenderStylesWithDarkMode("~/Assets/bundles/security/verify-security-code")
}
<h1 id="title_header" class="page-title">@Security.SecurityCodeValidation</h1>
<div class="verify-security-code" id="verify-security-code-container">
    <img alt="Avatar" src='' class='profile-avatar' />
    <div class="wrapper-right">
        <div class="block" id="container">
            <form class="form-SC form-validation">
                <div id="status-message" class="form-group hidden">
                    <div id="status-message-content" class="msg msg-warning"></div>
                </div>
                <div class="form-group">
                    <label>@(string.Format(@Security.VerifySecurityCodeShower, @Model.UsernameShower))</label>
                    <label>@Security.informSecCode</label>
                    <label class="security-code-title">@Security.SecurityCode</label>
                    <input type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" class="txt form-control"
                        name="txtSecCode" id="txtSecCode" maxlength="6" />
                    <i class="validation"></i>
                </div>
                <div class="form-group">
                    <label><input type="checkbox" id="showSCchk" /> @Security.ShowSecurityCode</label>
                </div>
                <div class="form-group">
                    <input id="btn-submit" type="submit" class="btn-submit" value="@Security.Submit" />
                </div>
            </form>
        </div>
    </div>
</div>
@Html.Hidden("securitycode-token", Model.SecurityCodeToken)
@Html.Hidden("security-salt", Model.SecuritySalt)
@* @Html.Hidden("oldMainRootPath", Model.OldMainRootPath) *@
@Html.Hidden("mainRootPath", Model.MainRootPath)
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    @StaticResources.RenderScripts("~/Assets/bundles/security/security-code/verify-securitycode")
}
