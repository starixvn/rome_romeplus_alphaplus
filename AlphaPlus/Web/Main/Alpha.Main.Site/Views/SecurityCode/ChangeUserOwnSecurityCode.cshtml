@using Alpha.Main.Site.ViewModels.Security
@model SecurityCodeViewModel
@{
    ViewBag.Title = @Security.SecurityCode;
    Layout = "~/Views/SecurityCode/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode($"/bundles/site-main/tab-{Model.UserLevel}")
    @StaticResources.RenderStylesWithDarkMode("~/Assets/bundles/security/security")
}
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" id="passwordNav">
        <a href="@($"{Model.MainRootPath}Password/ChangePassword")" role="tab" data-toggle="tab">@Security.Password</a>
    </li>
    <li role="presentation" class="active">
        <a>@Security.SecurityCode</a>
    </li>
    <li role="presentation">
        <a id="profilePicture" href="@MicroSites.AccountInfoUrl($"~/ProfilePicture/")">@Resources.EditProfilePicture</a>
    </li>
    <li role="presentation" id="otpNav">
        <a href="@($"{Model.MainRootPath}Otp/SetupOtp")" role="tab" data-toggle="tab">OTP</a>
    </li>
    @if (Model.IsOfferProtectedMode)
    {
        <li role="presentation">
            @Html.ActionLink(Resources.ProtectionCode, "Setup", "ProtectionCode")
        </li>
    }
</ul>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active">
        <div id="status-message" class="msg-content display-none">
            <div id="status-message-content" class="msg"></div>
        </div>
        <div class="block" id="container">
            <form class="form-SC form-SC-before form-validation">
                <div class="form-group">
                    <label>@Security.oldSecCode</label>
                    <input type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" class="txt form-control"
                        name="oldSC" id="txtOldSecCode" maxlength="6" />
                </div>
                <div class="form-group">
                    <label>@Security.NewSecurityCode</label>
                    <input type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" class="txt form-control"
                        name="SC" id="txtSecCode" maxlength="6" />
                    <i class="validation"></i>
                </div>
                <div class="form-group">
                    <label>@Security.ConfirmSecurityCode</label>
                    <input type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" class="txt form-control"
                        name="confirmSC" id="txtConfirmSecCode" maxlength="6" />
                    <i class="validation"></i>
                </div>
                <div class="form-group">
                    <label><input type="checkbox" id="showSCchk" /> @Security.ShowSecurityCode</label>
                </div>
                <div class="form-group">
                    <input type="submit" class="btn-submit" value="@Security.Submit" />
                    <input type="reset" value="@Security.Reset" id="btn-reset" />
                </div>
            </form>
        </div>
        <div class="rules">
            <p><span class="note-red">*</span>@Security.SecurityCodeRules01</p>
            <ul>
                <li>@Security.SecurityCodeRules02</li>
            </ul>
            <a href="@($"{Model.MainRootPath}SecurityCode/LearnMore")" target="_blank"
                class="learn-more">@Security.LearnMore</a>
        </div>
        <div class="sc-control-list">
            <p class="bold">@Security.SCAskedOncePerSession</p>
            <p class="bold actions">-&nbsp;&nbsp;&nbsp;@Security.MandatoryActions</p>
            <ul>
                <li>@Security.CreateNewDownline</li>
                <li>@Security.PositionTakingTemplate</li>
                <li>@Security.Transfer</li>
                <li>@Security.UpdateDownlineCreditAndSettings</li>
                <li>@Security.UpdateSecurityInformation</li>
                <li>@Security.UpdateSubAccInformation</li>
            </ul>
            <p class="bold actions">-&nbsp;&nbsp;&nbsp;@Security.OptionalAction</p>
            <div class="switch-buttons">
                <div>
                    <span class="switch-on @(Model.IsEnabledBetLists ? string.Empty : "switch-off")"
                        data-function="BetList">
                        @(Model.IsEnabledBetLists ? Security.SwitchLabelOn : Security.SwitchLabelOff)
                    </span>
                    <span>@Security.AccessToBetLists</span>
                </div>
                <div>
                    <span class="switch-on @(Model.IsEnabledStatement ? string.Empty : "switch-off")"
                        data-function="Statement">
                        @(Model.IsEnabledStatement ? Security.SwitchLabelOn : Security.SwitchLabelOff)
                    </span>
                    <span>@Security.AccessToStatementReport</span>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Hidden("securitycode-token", Model.SecurityCodeToken)
@Html.Hidden("security-salt", Model.SecuritySalt)
@Html.Hidden("hashkey", Model.HashKey)
@Html.Hidden("mainRootPath", Model.MainRootPath)
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    @StaticResources.RenderScripts("~/Assets/bundles/security/security-code/change-user-own-securitycode")
}