@using Alpha.Main.Site.Features.Dashboard
@model DashboardViewModel
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode($"/bundles/site-main/dashboard/dashboard-{Model.UserLevelName}")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/default-home")
    @StaticResources.RenderStylesWithMediaDarkMode(767, "~/assets/bundles/home-mobile-calculate-07")
    @AlphaPlus.Core.Helpers.GoogleAnalyticHelper.GtagScript()
</head>

<body>
    @AlphaPlus.Core.Helpers.GoogleAnalyticHelper.GtagNoScript()
    <div class="scroll-tabs">
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation" class="active" id="balance-tab">
                <a href="#balance" aria-controls="home" role="tab" data-toggle="tab">@Resources.balance</a>
            </li>
            <li role="presentation" id="stats-tab">
                <a href="#stats" aria-controls="home" role="tab" data-toggle="tab">@Resources.stats</a>
            </li>
        </ul>
    </div>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane active balance-info" id="balance" action-url="@Url.Action("BalanceInfo")">
        </div>
        <div role="tabpanel" class="tab-pane statistic" id="stats" action-url="@Url.Action("Index", "Statistics")">
            <div class="text-center"><span class="block-icon-small "></span></div>
        </div>
    </div>
    @await Html.PartialAsync("HiddenFields", Model)
    <!--[if IE 8]><!-->
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/es5-shim")
    <!--<![endif]-->
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/dashboard/dashboard-default")
    @* @StaticResources.RenderScripts("~/assets/bundles/default-dashboard") *@
    <script src="~/assets/bundles/default-dashboard.js" type="text/javascript" asp-append-version="true"></script>
    <script>
        $(() => {
            const topWindow = window.top;
            if ($('#dashboard-winloss') && $('#dashboard-winloss').attr('href').indexOf('(S(') !== -1) {
                $('#dashboard-winloss').attr('href', $('#dashboard-winloss').attr('href').replace(topWindow.menuBar.domElements.sessionId, topWindow.menuBar.domElements.reportSessionId));
            }

            if ($('#dashboard-yesterday-winloss') && $('#dashboard-yesterday-winloss').attr('href').indexOf('(S(') !== -1) {
                $('#dashboard-yesterday-winloss').attr('href', $('#dashboard-yesterday-winloss').attr('href').replace(topWindow.menuBar.domElements.sessionId, topWindow.menuBar.domElements.reportSessionId));
            }

            var loadOutstanding = null;
            var retryTimes = 0;
            loadOutstanding = setInterval(() => {
                if (retryTimes >= 10) {
                    retryTimes = 0;
                    clearInterval(loadOutstanding);
                }

                if (($('#dashboard-outstanding') && $('#dashboard-outstanding').attr('href'))
                    || $('#dashboard-total-outstanding') && $('#dashboard-total-outstanding').attr('href')) {
                    clearInterval(loadOutstanding);

                    if ($('#dashboard-outstanding').attr('href') && $('#dashboard-outstanding').attr('href').indexOf('(S(') !== -1) {
                        $('#dashboard-outstanding').attr('href', $('#dashboard-outstanding').attr('href').replace(topWindow.menuBar.domElements.sessionId, topWindow.menuBar.domElements.reportSessionId));
                    }

                    if ($('#dashboard-total-outstanding').attr('href') && $('#dashboard-total-outstanding').attr('href').indexOf('(S(') !== -1) {
                        $('#dashboard-total-outstanding').attr('href', $('#dashboard-total-outstanding').attr('href').replace(topWindow.menuBar.domElements.sessionId, topWindow.menuBar.domElements.reportSessionId));
                    }
                }

                retryTimes++;
            }, 1000);
        });
    </script>
</body>

</html>
