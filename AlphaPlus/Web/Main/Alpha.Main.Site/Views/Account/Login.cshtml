@model Alpha.Main.Site.ViewModels.Account.LoginInputViewModel

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign In</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>

<body>
    <form method="post" name="fLogin" class="block">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="language-area">
            <select id="selLanguage" onchange="SelectLanguage(this.value)" class="language-dropdown">
                <option value="0">English</option>
                <option value="1">繁體中文</option>
                <option value="4">简体中文</option>
                <option value="2">日本語</option>
                <option value="3">ภาษาไทย</option>
                <option value="5">한국어</option>
                <option value="6">Tiếng Việt</option>
            </select>
            <span id="spnLanguage" class="language"></span>
            <input type="hidden" value="en-US" id="hidLanguage" name="hidLanguage" asp-for="Language" />
        </div>
        <div class="form">
            <div class="form-group">
                <input class="form-control" id="txtUserName" name="txtUserName" type="text" placeholder="Username" asp-for="Username"
                    autofocus />
            </div>
            <div class="form-group">
                <input class="form-control" id="txtPassWord" name="txtPassWord" type="password" placeholder="Password" asp-for="Password"
                    autocomplete="off" onkeydown="age.DoEnter(event, 'DoLogin()')" />
            </div>
            <div class="row">
                <input type="hidden" value="" id="browserSize" name="browserSize" asp-for="BrowserSize" />
                <input id="btnLogin" type="button" class="button" value="Login" onclick="return DoLogin()" />
            </div>
        </div>

        <div id="errmsg" class="errmsg"></div>
        <!--<div style="padding-top:23px">{VersionMobile}</div>-->
    </form>
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>

</html>
