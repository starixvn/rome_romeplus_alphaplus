@using Alpha.Main.Site.ViewModels.ApiKey
@model ApiKeyManagementViewModel
@{
    Layout = "~/Views/ApiKey/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode($"/bundles/site-main/tab-{Model.CustLevel.ToLowerInvariant()}")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-main/apikey")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/apikey/apikey")
}
<div class="realtive">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation">
            <a href="@($"{Model.MainRootPath}Apikey/CreateApiKey")" role="tab"
                data-toggle="tab">@ApiKey.CreateAPIKey</a>
        </li>
        <li role="presentation" id="" class="active">
            <a href="@($"{Model.MainRootPath}Apikey/ApiKeyManagement")" role="tab"
                data-toggle="tab">@ApiKey.APIKeyManagement</a>
        </li>
        <li class="guideline">
            <a class="btn-guideline" href="@Model.HelpPage" target="_blank"><span
                    class="icon icon-book"></span>@ApiKey.Guideline</a>
        </li>
    </ul>

</div>
<div class="tab-content apikey-form">
    <div class="box-service-url">
        <span class="label-service-url">@ApiKey.ServiceURL</span>
        <div class="service-url-mask close">
            <div class="dummy-text">@ApiKey.GetLinkHere</div>
            <input id="lnk-api-guides" type="text" class="real-text" value="@AppSettings.APIGatewaysURL" readonly />
            <span class="icon-content-copy icon" data-clipboard-action="copy" data-clipboard-target="#lnk-api-guides"
                title="@Security.Copied"></span>
        </div>
    </div>

    <table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover">
        <thead>
            <tr>
                <th class="sorting" data-colindex="0">@ApiKey.APIKeyName</th>
                <th class="sorting" data-colindex="1">@ApiKey.CreatedDate</th>
                <th class="hidden-stack-mode sorting" data-colindex="2">@ApiKey.ExpirationDate</th>
                <th class="hidden-stack-mode col-netturnover-header sorting" data-colindex="3">@ApiKey.Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ApiKeyInfos.Any())
            {
                for (var i = 0; i < Model.ApiKeyInfos.Count(); i++)
                {
                    var apikey = Model.ApiKeyInfos.ElementAt(i);

                    <tr>
                        <td class="text-center col-nameapi">
                            <div class="api-key-name">@apikey.Name</div>
                            <div class="api-key-popup form-group hide">
                                <label>@ApiKey.APIKey</label>
                                <div class="relative">
                                    <input type="text" class="form-control" id="key-@i" autocomplete="off" value="@apikey.Key"
                                        readonly />
                                    <span class="icon-content-copy icon" data-clipboard-action="copy"
                                        data-clipboard-target="#key-@i" title="@Security.Copied"></span>
                                </div>
                            </div>
                        </td>
                        <td class="text-center">@apikey.CreatedDate</td>
                        @if (apikey.IsExpired)
                        {
                            <td class='col-expired text-center expired-date'>@ApiKey.Expired</td>
                        }
                        else if (apikey.ExpirationDate.HasValue)
                        {
                            <td class='col-expired text-center'>@apikey.ExpirationDateStr</td>
                        }
                        else
                        {
                            <td class='col-expired text-center'>@ApiKey.Never</td>
                        }
                        <td class="text-center">
                            <button class="btn-submit btn-edit" apikey=@apikey.Key>@ApiKey.Edit</button>
                            <button class="btn-remove btn-revoke" apikey=@apikey.Key
                                apiname=@apikey.Name>@ApiKey.Revoke</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" align="center">@Resources.NoInformationIsAvailable</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@Html.Hidden("Language", Model.Language)
@Html.Hidden("EditAPIKey", ApiKey.EditAPIKey)
@Html.Hidden("AreYouSureRevokeAPIKey", ApiKey.AreYouSureRevokeAPIKey)
@Html.Hidden("ThisActionCannotBeUndone", ApiKey.ThisActionCannotBeUndone)
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-main/apikey")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-main/apikey/clipboard")
    @StaticResources.RenderScripts("~/assets/bundles/apikey/apikey-management")
}
