@model AlphaPlus.Main.Site.Features.ProtectionCode.ProtectionCodeViewModel
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Resources.ProtectionCode</title>
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode($"/bundles/site-main/security/security-{Model.UserLevel}")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/protection-code/protection")
    @GoogleAnalyticHelper.GtagScript()
</head>

<body>
    @GoogleAnalyticHelper.GtagNoScript()
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation">
            <a href="@MicroSites.MainUrl($"~/Password/ChangePassword")" role="tab"
                data-toggle="tab">@Security.Password</a>
        </li>
        @if (Model.EnableSecurityCode)
        {
                <li role="presentation" id="securityCodeNav">
                    <a href="@MicroSites.MainUrl("~/SecurityCode/ChangeUserOwnSecurityCode")" role="tab"
                        data-toggle="tab">@Security.SecurityCode</a>
                </li>
        }
        <li role="presentation">
            <a href="@MicroSites.AccountInfoUrl($"~/ProfilePicture/")">@Resources.EditProfilePicture</a>
        </li>
        <li role="presentation">
            @Html.ActionLink("OTP", "SetUpOtp", "OTP")
        </li>
        <li role="presentation" class="active">
            <a href="#protectionCode" aria-controls="home" role="tab" data-toggle="tab">@Resources.ProtectionCode</a>
        </li>
    </ul>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane active" id="protectionCode">
            <div id="msg-content" class="msg-content hidden">
                <div id="msg" class="msg"></div>
            </div>
            @using (Html.BeginForm("Setup", "ProtectionCode", FormMethod.Post, new
            {
                @class = "form-validation",
                id =
            "frm-protectionCode"
            }))
            {
                @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label for="txt-newProtectionCode">@Resources.NewProtectionCode</label>
                        <input type="text" autocomplete="off" maxlength="30" class="txt form-control"
                            id="txt-newProtectionCode" />
                        <i class="validation"></i>
                    </div>
                    <div class="form-group">
                        <label for="txtConfirmProtectionCode">@Resources.ConfirmProtectionCode</label>
                        <input type="text" autocomplete="off" maxlength="30" class="txt form-control"
                            id="txt-confirmProtectionCode" />
                        <i class="validation"></i>
                    </div>
                    <div class="form-group">
                        <label><input type="checkbox" id="chk-showProtectionCode" /> @Resources.ShowProtectionCode</label>
                    </div>
                    <div class="form-group">
                        <input type="submit" value="@(Model.IsExistedProtectionCode ? Resources.Update : Resources.Create)"
                            class="btn-submit" />
                        <input type="reset" value="@Security.Reset" id="btn-reset" />
                    </div>
            }
            <div class="rules">
                <p><span class="note-red">*</span> @Resources.ProtectionCodeRule</p>
                <a href="#" class="learn-more" data-toggle="modal"
                    data-target="#learn-more-popup">@Security.LearnMore</a>
            </div>
        </div>
    </div>
    <div class="modal fade in" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false"
        id="learn-more-popup">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="icon icon-close close" data-dismiss="modal"
                        aria-label="@Resources.close"><span aria-hidden="true"></span></button>
                    <h4 class="modal-title">@Resources.ProtectionCode</h4>
                </div>
                <div class="modal-body">
                    @{
                        @Html.RenderPartialAsync($"_LearnMorePopup_{Model.GetLearnMoreViewLang()}")
                        ;
                    }
                </div>
            </div>
        </div>
    </div>
    @Html.Hidden("hashkey", Model.HashKey)
    @Html.Hidden("requiredNewProtectionCode", Resources.RequiredNewProtectionCode)
    @Html.Hidden("minLengthNewProtectionCodeError", Resources.MinLengthNewProtectionCodeError)
    @Html.Hidden("requiredConfirmProtectionCode", Resources.RequiredConfirmProtectionCode)
    @Html.Hidden("notMatchedConfirmProtectionCode", Resources.NotMatchedConfirmProtectionCode)
    @Html.Hidden("containsSpaceOrUnicodeCharacterError", Resources.ContainsSpaceOrUnicodeCharacterError)
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    @StaticResources.RenderScripts("~/assets/bundles/protection-code/protection")
</body>

</html>
