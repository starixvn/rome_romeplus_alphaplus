@{
    Layout = null;
}
@model string
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Index</title>
    <link href="~/assets/bundles/error@(Model).css" rel="stylesheet" type="text/css" asp-append-version="true" />
</head>

<body>
    <div class="container">
        <img src="~/assets/error/images/error2@(Model).png" title="Error" alt="" class="error-bg" />
        <div class="error-txt">Sorry, there was an unexpected issue on the server. Please seek help from our customer support. [500]</div>
       
    </div>
</body>

</html>
