@using AlphaPlus.Main.Site.Features.Tour
@using AlphaPlus.Core.Configurations
@model TourViewModel

@{
    var imagePath = $"~/assets/images/tour/directmember/master/{Model.Language}";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Tour</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    <link rel="stylesheet" href="~/assets/bundles/tour/common-tour@(Model.DarkModeName).css"
        asp-append-version="true" />
</head>

<body>
    <div class="wrapper-tour">
        <span class="icon-close" onclick="top.popupManager.closeAllPopup()"></span>
        <div class="inner">
            <div class="content-page content-page-1">
                <div class="title">@Tour.Index_Page1_Title</div>
                <p>@Html.Raw(Tour.Index_Page1_Row1)</p>
                <img src="@Url.Content($"{imagePath}/Page1.png")" alt="tour Directmember" />
            </div>
            <div class="content-page content-page-2 hidden">
                <div class="title">@Tour.Index_Page2_Title</div>
                <img src="@Url.Content($"{imagePath}/Page2.png")" alt="tour Directmember" />
            </div>
            <div class="content-page content-page-3 hidden">
                <div class="title">@Html.Raw(Tour.Index_Page3_Title)</div>
                <img src="@Url.Content($"{imagePath}/Page3.png")" alt="tour Directmember" />
            </div>
            <div class="content-page content-page-4 hidden">
                <div class="title">@Html.Raw(Tour.Index_Page4_Title)</div>
                <img src="@Url.Content($"{imagePath}/Page4.png")" alt="tour Directmember" />
            </div>
            <div class="content-page content-page-5 hidden">
                <div class="title">@Html.Raw(Tour.Index_Page5_Title)</div>             
                <img src="@Url.Content($"{imagePath}/Page5.png")" alt="tour Directmember" />
            </div>
        </div>
        
    </div>
    <div class="control">
        <div class="spn-page">
            <span>@Resources.Page</span>
            <span class="page-index">1</span>
            <span>@Resources.of</span>
            <span class="total-page">5</span>
        </div>
        <div class="page-btn">
            <span class="page-btn-prev hidden"><i class="icon-caret-left"></i></span>
            <span class="page-btn-next"><i class="icon-caret-right"></i></span>
        </div>
    </div>
    @StaticResources.AssetScripts.Render("/bundles/site-main/default")
    <script src="~/assets/bundles/tour/new-feature-tour.js" asp-append-version="true"></script>
    @Html.Hidden("NewFeatureUrl", MicroSites.SettingUrl("~/Customer/CreateDirectMember"))
</body>

</html>
