@using AlphaPlus.Main.Site.Features.Tour
@using AlphaPlus.Core.Configurations
@model TourViewModel
@{
    var language = Model.Language;
    var roleId = Model.RoleId;

    var imagePath = $"~/assets/images/tour/rebate-and-retention/{language}";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/tour/common-tour")
</head>
<body>
    <div class="wrapper-tour">
        <span class="icon-close" onclick="top.popupManager.closeAllPopup()"></span>
        <div class="inner">
            <div class="content-page content-page-1">
                <div class="title">@Resources.RebateAndRetentionTour_Page1_Row1</div>
                <img src="@Url.Content( $"{imagePath}/Page1-lv{roleId}.png")" alt="image tour">
            </div>
            <div class="content-page content-page-2 hidden">
                <div class="title">@Resources.RebateAndRetentionTour_Page1_Row2</div>
                <img src="@Url.Content( $"{imagePath}/Page2-lv{roleId}.png")" alt="image tour">
            </div>
            <div class="content-page content-page-3 hidden">
                <div class="title">@Resources.RewardPayment</div>
                <p>@Resources.RebateAndRetentionTour_Page1_Row3</p>
                <img src="@Url.Content( $"{imagePath}/Page3-lv{roleId}.png")" alt="image tour">
            </div>
            <div class="content-page content-page-4 hidden">
                <div class="title">@Resources.RewardDetail</div>
                <p>@Resources.RebateAndRetentionTour_Page1_Row4</p>
                <img src="@Url.Content( $"{imagePath}/Page4-lv{roleId}.png")" alt="image tour">
            </div>
            <div class="content-page content-page-5 hidden">
                <p>@Resources.RebateAndRetentionTour_Page1_Row5</p>
                <img src="@Url.Content( $"{imagePath}/Page5-lv{roleId}.png")" alt="image tour">
            </div>
        </div>
        <div class="control">
            <div class="spn-page">
                <span>@Resources.Page</span>
                <span class="page-index">1</span>
                <span>@Resources.of</span>
                <span class="total-page">5</span>
            </div>
            <div class="page-btn">
                <span class="page-btn-prev hidden"><i class="icon-caret-left"></i></span>
                <span class="page-btn-next"><i class="icon-caret-right"></i></span>
            </div>
        </div>
    </div>
    @StaticResources.AssetScripts.Render("/bundles/site-main/default")
    @StaticResources.RenderScripts("~/assets/bundles/tour/rebate-and-retention-tour")
</body>
</html>
