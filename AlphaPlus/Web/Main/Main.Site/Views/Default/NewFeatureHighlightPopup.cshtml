@using AlphaPlus.Main.Site
@using AlphaPlus.Main.Site.Features.Default
@model IndexViewModel
@if (Model.HightLightFeaturePermission)
{
    <div class="popup-highlight hide" id="boxHighlightPopupNewFeature">
        <button type="button" class="icon icon-close close" title="@Resources.close">
            <span aria-hidden="true"></span>
        </button>
        <div class="text">
            <div class="image">
                <img src="~/assets/images/@Model.HightLightFeatureImageName?v=@AppSettings.JsVersion"
                    alt="@Resources.HighlightPopupNewFeatureTitle">
                <p class="sm"><span>HTML Ipsum Presents</span></p>
            </div>
            <div>
                <p class="pc"><span>HTML Ipsum Presents</span></p>
                <p>Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas. Vestibulum
                    tortor quam, feugiat vitae, ultricies eget, tempor sit amet, ante. Donec eu libero sit amet quam egestas
                    semper. Aenean ultricies mi vitae est. Mauris placerat eleifend leo.</p>
            </div>
        </div>
        <div class="action">
            <label class="label">
                <input id="chkHideHighlightPopupNewFeature" type="checkbox" />
                <span>@Resources.doNotShowAgain</span>
            </label>
            <a class="btn-submit" id="linkHighlightPopupCheckOut" href="javascript:;">@Resources.TakeATour</a>
        </div>
    </div>
}
else if (Model.IsShowRewardTour)
{
    <input type="hidden" id="hidden-isShowRewardTour" value="1" />
    <partial name="RewardHighlightPopup" />
}