@inject AlphaPlus.Core.Models.IUserSession userSession
@using AlphaPlus.Main.Site.Features.Password
@model PasswordViewModel
@{
    ViewBag.Title = Security.lblChangePassword;
    Layout = "~/Views/Password/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode($"/bundles/site-main/security/security-{Model.UserLevel}")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/security/security")
}
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="active">
        <a role="tab" data-toggle="tab">@Resources.password</a>
    </li>
    @if (Model.EnableSecurityCode)
    {
        <li role="presentation" id="securityCodeNav">
            <a href="@($"{Model.MainRootPath}SecurityCode/ChangeUserOwnSecurityCode")" role="tab"
                data-toggle="tab">@Security.SecurityCode</a>
        </li>
    }
    <li role="presentation">
        <a id="profilePicture"
            href="@MicroSites.AccountInfoUrl($"~/ProfilePicture?lng={userSession.Language}")">@Resources.EditProfilePicture</a>
    </li>
    <li role="presentation" id="otpNav">
        <a href="@($"{Model.MainRootPath}Otp/SetupOtp")" role="tab" data-toggle="tab">OTP</a>
    </li>
    @if (Model.IsOfferProtectedMode)
    {
        <li role="presentation">
            @Html.ActionLink(Resources.ProtectionCode, "Setup", "ProtectionCode")
        </li>
    }
</ul>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active">
        <div id="status-message" class="msg-content display-none">
            <div id="status-message-content" class="msg"></div>
        </div>
        <div class="block" id="container">
            <form class="form-SC form-validation" id="pwdForm">
                <div class="form-group">
                    <label>@Security.lblOldPassword</label>
                    <input type="password" class="txt form-control" name="txtOldPwd" id="txtOldPwd" autocomplete="off"
                        maxlength="16" />
                </div>
                <div class="form-group">
                    <label>@Security.NewPassword</label>
                    <input type="password" class="txt form-control" name="txtNewPwd" id="txtNewPwd" autocomplete="off"
                        maxlength="16" />
                    <i class="validation"></i>
                </div>
                <div class="form-group">
                    <label>@Security.lblConfirmPassword</label>
                    <input type="password" class="txt form-control" name="txtConfirmPwd" id="txtConfirmPwd"
                        autocomplete="off" maxlength="16" />
                    <i class="validation"></i>
                </div>
                <div class="form-group">
                    <label><input type="checkbox" id="showPasswordchk" /> @Security.ShowPassword</label>
                </div>
                <div class="form-group">
                    <input type="submit" class="btn-submit" value="@Security.Submit" />
                    <input type="reset" value="@Security.Reset" id="btn-reset" />
                </div>
            </form>
        </div>
        <div class="rules">
            <p><span class="note-red">*</span>@Security.PasswordHint01</p>
            <ul>
                @Html.Raw(Security.PasswordHint02)
            </ul>
            @Html.Raw(Security.PasswordHint03)
        </div>
    </div>
</div>
@Html.Hidden("hashkey", Model.HashKey)
@* @Html.Hidden("oldMainRootPath", Model.OldMainRootPath) *@
@Html.Hidden("mainRootPath", Model.MainRootPath)
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    @StaticResources.RenderScripts("~/assets/bundles/security/password/change-password")
}
