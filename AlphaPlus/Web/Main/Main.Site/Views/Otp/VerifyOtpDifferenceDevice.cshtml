@using AlphaPlus.Main.Site.Features.OTP
@model VerifyOtpDifferenceDeviceViewModel
@{
    Layout = "~/Views/SecurityCode/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-main/security/before-home-page")
}
<div class="block">
    <form class="form-SC form-validation" id="otp-form">
        @await Component.InvokeAsync("Languages")
        <h1 class="title">OTP</h1>
        <p> @string.Format(Security.OtpHiMessage, Model.UsernameShower)</p>
        <figure class="avatar">
            <img id="logoProfileImg" alt="Avatar" src='' class='profile-avatar' />
            <figcaption><span class="username">@Model.Username</span><br /><span
                    class="nickname">@Model.AlternateUsername</span></figcaption>
        </figure>
        <div class="rowlg">
            <i class="icon-lock"></i>
            <input maxlength="6" type="password" autocomplete="off" class="txt" name="otp" id="txtOTP"
                placeholder="OTP" />
            @if (Model.IsShowGenerateOTPButton)
            {
                <button class="btn-submit" id="btnGenerateOTP">@Security.GenerateOTP <span id="countdown"></span></button>
            }
            <label class="error"></label>
            <i class="validation"></i>
        </div>
        <div class="list-button">
            <input type="button" class="btn-cancel" id="btn-back" value="@Security.lblBack" />
            <input type="submit" class="btn-submit" value="@Security.Submit" />
        </div>
        <div class="note">
            @Security.OtpDatetimeWarning
        </div>
    </form>
</div>
@Html.Hidden("requiredFieldMessage", Security.alertSecCodeEmpty)
@* @Html.Hidden("oldMainRootPath", MicroSites.SettingUrl("~/")) *@
@Html.Hidden("mainRootPath", MicroSites.MainUrl())
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    @StaticResources.RenderScripts("~/assets/bundles/security/otp/verify-otp-difference-device")
}
