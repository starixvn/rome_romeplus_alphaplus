@model AlphaPlus.Main.Site.Features.Banner.BannerViewModel
@{
    var maxBanners = Model == null ? 0 : Model.Banners.Length;
}
@if (maxBanners > 0)
{
        <!-- Wrapper for slides -->
        <div class="carousel-inner">
        @for (int i = 0; i < maxBanners; i++)
        {
            var banner = Model.Banners[i];
            var className = banner.LogClick ? "log-banner" : "";
                    <div class="item @(i == 0 ? "active" : string.Empty)">
                @if (string.IsNullOrWhiteSpace(banner.RedirectUrl))
                {
                    <img src="@Url.Content(banner.ImageSource)" class="img-banner @className" />
                }
               else if (string.IsNullOrWhiteSpace(banner.Target))
                {
                    <img data-href="@banner.RedirectUrl" src="@Url.Content(banner.ImageSource)" class="@className" />
                }
                else
                {
                    <img src="@Url.Content(banner.ImageSource)"
                        class="img-banner @className"
                        data-target-url="@banner.RedirectUrl" 
                        data-target="@(banner.Target ?? "")" />
                }
                    </div>
        }
        </div>
        <!-- Indicators -->
        <ol class="carousel-indicators">
        @for (int i = 0; i < maxBanners; i++)
        {
                    <li data-target="#carousel-banner" data-slide-to="@i" @(i == 0 ? "class=active" : string.Empty)></li>
        }
        </ol>
}
