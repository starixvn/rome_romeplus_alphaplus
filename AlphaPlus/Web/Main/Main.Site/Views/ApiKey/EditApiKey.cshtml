@using AlphaPlus.Main.Site.Features.ApiKey
@model EditApiKeyViewModel
@{
    Layout = "~/Views/ApiKey/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-main/apikey")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/apikey/apikey")
}

<form class="block" id="apikey-form" autocomplete="off">
    <div id="error-message" class="container-msg"></div>
    <div class="form-group">
        <label>@ApiKey.APIKeyName</label>
        <input type="text" class="form-control" id="apiname" autocomplete="off" value="@Model.ApiKeyInfo.Name"
            maxlength="50" />
    </div>
    <div class="form-group">
        <label>@ApiKey.APIKey</label>
        <div class="relative">
            <input type="text" class="form-control" id="key" autocomplete="off" value="@Model.ApiKeyInfo.Key"
                readonly />
            <span class="icon-content-copy icon" data-clipboard-action="copy" data-clipboard-target="#key"
                title="@Security.Copied"></span>
        </div>
    </div>
    <div class="form-group form-calendar">
        <label>@ApiKey.ExpirationDate</label>

        <div class="relative input-group date" id="dpkContainer">
            <input type="text" class="form-control" id="expirationdate" autocomplete="off"
                value="@Model.ApiKeyInfo.ExpirationDate" placeholder="MM/DD/YYYY" />
            <span class="input-group-addon icon-calendar"></span>
        </div>

    </div>
    <label class="scope-label">@ApiKey.SelectScopes</label>
    <div class="list-scope">
        <label class="scope-input"><input type="checkbox" value="All" id="ckbAll" /> @ApiKey.All</label>
        <div class="ml-25" id="apiKeyScopes">
            @foreach (var scope in Model.Scopes)
            {
                var isChecked = Model.ApiKeyInfo.ScopeIdList.Contains(scope);
                    <div><label class="scope-input"><input type="checkbox" value="@scope" name="scope" @(isChecked ? "checked" :
                        "") />@ResourceHelper.GetApiKeyResource($"Scope_{scope}", Model.Language)</label></div>
            }
        </div>
    </div>
    <div class="form-group form-group-button mt-10">
        <button class="btn-submit" id="btnSubmit">@ApiKey.Save</button>
        <button class="btn-remove" id="btnCancel">@ApiKey.Cancel</button>
    </div>
</form>
@Html.Hidden("PleaseInputAPIKeyName", ApiKey.PleaseInputAPIKeyName)
@Html.Hidden("APIKeyNameCanNotContainSpecialCharacters", ApiKey.APIKeyNameCanNotContainSpecialCharacters)
@Html.Hidden("NoMoreThan50Characters", ApiKey.NoMoreThan50Characters)
@Html.Hidden("CantSelectTimeFromPast", ApiKey.CantSelectTimeFromPast)
@Html.Hidden("ScopesIsRequired", ApiKey.ScopesIsRequired)
@Html.Hidden("UpdateSuccessful", ApiKey.UpdateSuccessful)
@Html.Hidden("CurrentDate", Model.CurrentDate)
@Html.Hidden("ExpirationDate", Model.ApiKeyInfo.ExpirationDate)
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-main/apikey")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-main/apikey/clipboard")
    @StaticResources.RenderScripts("~/assets/bundles/apikey/edit-apikey")
}
