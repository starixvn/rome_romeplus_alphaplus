@model AlphaPlus.Main.Site.Features.ContactUs.ContactUsViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderCommon("/bundles/site-main/anybody-fonts")
    @StaticResources.RenderStyles("~/assets/bundles/whitelabel")
</head>
<body>
    <div class="wrapper-white-label">
        <p class="text">@Html.Raw(string.Format(Resources.DashboardViewOverallInformation, "<span onclick=\"location.href=top.headerNav.urls.home;\" class=\"icon icon-home\"></span>"))</p>
        <div class="white-label">
            <div class="offer @(Model.IsEndWhiteLabelOffer ? "end-offer" : string.Empty) ">
                <div class="inner">
                    <span class="icon-alert-circle"></span>
                    @Html.Raw(Resources.Limit_Offer_Date)
                    <a href="@Model.ClaimSpotUrl" target="_blank" id="lnk-livechat">@Resources.Limit_Offer_Link</a>
                    @Resources.Limit_Offer_End
                </div>
            </div>
            <div class="intro">@Html.Raw(Resources.WhiteLabel_Intro)</div>
            <div class="items">
                <div class="item">
                    <div class="image">
                        <img src="~/assets/images/DashboardBanner/white-label/turnkey.png" />
                        <div class="title">@Resources.TurnkeySolution</div>
                    </div>
                    <div class="description">@Resources.TurnkeySolution_Description</div>
                </div>
                <div class="item">
                    <div class="image">
                        <img src="~/assets/images/DashboardBanner/white-label/no-bad-debt.png" />
                        <div class="title">@Resources.NoBadDebt</div>
                    </div>
                    <div class="description">@Resources.NoBadDebt_Description</div>
                </div>
                <div class="item">
                    <div class="image">
                        <img src="~/assets/images/DashboardBanner/white-label/rich-products-collection.png" />
                        <div class="title">@Resources.RichProductsCollection</div>
                    </div>
                    <div class="description">@Resources.RichProductsCollection_Description</div>
                </div>
            </div>
            <div class="bottom">
                <div class="inner-bottom">
                    <div class="left">
                        <div class="title">@Resources.Interested</div>
                        <div>@Resources.ContactCSD</div>
                    </div>
                    <div class="line"></div>
                    <div class="right">
                        @if (Model.IsShowSkypeId)
                        {
                            <div class="messenger lnk-skype">
                                <div class="icon">
                                    <img src="~/assets/images/DashboardBanner/white-label/icon-skype.png" />
                                </div>
                                <div class="info">
                                    <div class="name">@Resources.SkypeID</div>
                                    <div class="account">@Model.SkypeId</div>
                                </div>
                            </div>
                        }
                        <div class="messenger lnk-lettalk">
                            <div class="icon">
                                <img src="~/assets/images/DashboardBanner/white-label/icon-letstalk.png" />
                            </div>
                            <div class="info">
                                <div class="name">@Resources.LetstalkIMID</div>
                                <div class="account">@Model.LetstalkId</div>
                                <div class="better">@Resources.ContactUsLegend</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.RenderScripts("~/assets/bundles/dashboard/whitelabel")
    @Html.Hidden("SkypeId", Model.SkypeId)
    @Html.Hidden("Username", Model.Username)
</body>
</html>