<?xml version="1.0"?>
<configuration>
  <configSections>
    <sectionGroup name="system.web.webPages.razor" type="System.Web.WebPages.Razor.Configuration.RazorWebSectionGroup, System.Web.WebPages.Razor, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35">
      <section name="host" type="System.Web.WebPages.Razor.Configuration.HostSection, System.Web.WebPages.Razor, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" requirePermission="false" />
      <section name="pages" type="System.Web.WebPages.Razor.Configuration.RazorPagesSection, System.Web.WebPages.Razor, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" requirePermission="false" />
    </sectionGroup>
  </configSections>

  <system.web.webPages.razor>
    <host factoryType="Microsoft.AspNetCore.Mvc.MvcWebRazorHostFactory, Microsoft.AspNetCore.Mvc, Version=5.2.3.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
    <pages pageBaseType="Microsoft.AspNetCore.Mvc.WebViewPage">
      <namespaces>
        <add namespace="Microsoft.AspNetCore.Mvc" />
        <add namespace="Microsoft.AspNetCore.Mvc.Ajax" />
        <add namespace="Microsoft.AspNetCore.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Linq" />
        <add namespace="AlphaPlus.Main.Site" />
        <add namespace="AlphaPlus.Main.Site.ViewModels" />
        <add namespace="AlphaPlus.Main.Site.ViewModels.CustomerProfile" />
        <add namespace="System.Web.Optimization" />
        <add namespace="AlphaPlus.Main.Site.AppResources" />
        <add namespace="AlphaPlus.Main.Site.Helpers" />
        <add namespace="AlphaPlus.Main.Site.Models.Requests.UserMessages" />
        <add namespace="Alpha.Main.Configurations" />
        <add namespace="AlphaPlus.Main.Site.ViewModels.Security" />
        <add namespace="AlphaPlus.Main.Site.ViewModels.TelegramChatBot" />
        <add namespace="AlphaPlus.Main.Site.ViewModels.ApiKey" />
        <add namespace="Alpha.Main.Helpers" />
        <add namespace="AlphaPlus.Web.Models" />
        <add namespace="AlphaPlus.Core.Models" />
      </namespaces>
    </pages>
  </system.web.webPages.razor>

  <appSettings>
    <add key="webpages:Enabled" value="false" />
  </appSettings>

  <system.webServer>
    <handlers>
      <remove name="BlockViewHandler" />
      <add name="BlockViewHandler" path="*.cshtml" verb="*" preCondition="integratedMode" type="System.Web.HttpNotFoundHandler" />
    </handlers>
  </system.webServer>

  <system.web>
    <compilation>
      <assemblies>
        <add assembly="Microsoft.AspNetCore.Mvc, Version=5.2.3.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
  </system.web>
</configuration>