@using AlphaPlus.Features.Messages.API.Extensions
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Features.Messages.API.AppResources
@using AlphaPlus.Features.Messages.API.Constants

@model AlphaPlus.Features.Site.Messages.ViewModels.MessagesHistoryViewModel


@section Styles{
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-betlists/pagination")
}

<div class="modal fade message-modal" id="guide-note" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label=""><span aria-hidden="true"></span></button>
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body">
                <div id="msg-content">
                    @Html.Raw(Resources.GuideNote)
                </div>
            </div>
        </div>
    </div>
</div>

<div role="tabpanel" class="tab-pane active">

    @if (Model.MessageType != MessageType.Special)
    {
        <div class="filter">
            @using (Html.BeginForm("Messages", "MessageHistory", new { messageType = Model.MessageType }, FormMethod.Post, antiforgery: false, new { id = "report-form" }))
            {
                <div id="daterange-picker"
                     class="daterange-picker"
                     data-mindate="@DateTime.Now.AddMonths(-3).ToShortDateWithSlash()"
                     data-maxdate="@DateTime.Now.ToShortDateWithSlash()">
                </div>

                <div class="form-group">
                    <label class="txt">@Resources.from</label>
                    <div class="control date">
                        <div class="input-group date fromdate" id="from-date-container">
                            <input type="text"
                                   id="FromDate"
                                   name="FromDate"
                                   readonly="readonly"
                                   autocomplete="off"
                                   class="ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate form-control"
                                   value="@Model.FromDate.ToShortDateWithSlash()" />
                            <span class="input-group-addon">
                                <span class="icon-calendar" id="fdate_trigger"></span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="txt">@Resources.to</label>
                    <div class="control date">
                        <div id="to-date-container"
                             class="input-group date todate">
                            <input type="text"
                                   id="ToDate"
                                   name="ToDate"
                                   readonly="readonly"
                                   autocomplete="off"
                                   class="ui_nexdatepicker_datetextbox ui_nexdatepicker_todate form-control"
                                   value="@Model.ToDate.ToShortDateWithSlash()" />
                            <span class="input-group-addon">
                                <span class="icon-calendar" id="tdate_trigger"></span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group group-button">
                    <input type="submit" value="@Resources.submit" class="btn-submit" />
                </div>
                <div class="form-group icon">
                    <span id="icon-information" class="icon icon-information-outline"></span>
                </div>

            }
        </div>
    }
    @Html.Hidden("GuidelineUrl", @MicroSites.FeatureUrl("GuideNote"))

    <table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover">
        <thead>
            <tr>
                <th class="col-order">#</th>
                <th>@Resources.message</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.ReportData.Any())
            {
                <tr>
                    <td colspan="2" class="text-center">@Resources.NoInformationIsAvailable</td>
                </tr>
            }
            else
            {
                foreach (var message in Model.ReportData.DataSource.Select((value, index) => new { index, value }))
                {
                    <tr>
                        <td class="col-order">@Model.BuildNo(message.index)</td>
                        <td>
                            <div class="row-first">
                                @message.value.PostTime
                                <span class="messageId">@message.value.Id</span>
                                @if (Model.IsNewMessage(message.value.PostTime))
                                {
                                    <span class="badge-title">@Resources.New</span>
                                }
                            </div>
                            <div class="message-content @(message.value.HasRedColor ? "text-red" : string.Empty)">
                                @Html.Raw(message.value.Content(Model.LanguageKey))
                            </div>
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>


    @if (Model.MessageType != MessageType.Special)
    {
        @await Html.PartialAsync("~/Views/Components/Pager.cshtml", Model.PagerViewModel)

    }
</div>

@section Scripts{
    @StaticResources.RenderScripts("~/assets/bundles/message")
    @StaticResources.AssetScripts.Render("/bundles/site-betlists/pagination")
}