@using AlphaPlus.Features.Messages.API.Services
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Shared.AppResources.Features.Messages
@{
    Layout = null;
}
<html>
<head>
    <title>New Announcement</title>
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-reports/default")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/extendMessage")
</head>
<body>
    <div class="baio-title-effect-date-format">@Lang.NewBetTypeOfBadmintonTitle</div>
    <table class="tblRpt tblRpt-bordered alternative-row-table width-100per tablesorter tblRpt-hover" id="tbl-report" style="padding: 0px;">
        <thead class="tableFloatingHeaderOriginal">
            <tr>
                <th>@Lang.NewBetType</th>
                <th>@Lang.BetSettingFollows</th>                
                <th>@Lang.CommissionSettingFollows</th>
                <th>@Lang.PositionTakingSettingFollows</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("701")</td>
                <td class="center" rowspan="14">@AlphaRemotingRefService.GetSportTypeName(99)</td>
                <td class="center">@Lang.LabelAsianHDC_OU_OE</td>
                <td class="center">@AlphaRemotingRefService.GetBetTypeName("1")</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("702")</td>
                <td class="center">@Lang.LabelAsianHDC_OU_OE</td>
                <td class="center">@Lang.LabelOverUnder</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("703")</td>
                <td class="center">@Lang.LabelOtherTypes</td>
                <td class="center">@Lang.LabelOthers</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("704")</td>
                <td class="center">@Lang.LabelAsianHDC_OU_OE</td>
                <td class="center">@Lang.LabelHandicapFC</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("705")</td>
                <td class="center">@Lang.LabelAsianHDC_OU_OE</td>
                <td class="center">@Lang.LabelOverUnder</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("706")</td>
                <td class="center">@Lang.LabelAsianHDC_OU_OE</td>
                <td class="center">@Lang.LabelOddEven</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("707")</td>
                <td class="center">@Lang.Label1x2</td>
                <td class="center">@Lang.moneyline</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("708")</td>
                <td class="center">@Lang.LabelAsianHDC_OU_OE</td>
                <td class="center">@Lang.LabelHandicapFC</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("709")</td>
                <td class="center">@Lang.LabelAsianHDC_OU_OE</td>
                <td class="center">@Lang.LabelOverUnder</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("710")</td>
                <td class="center">@Lang.LabelAsianHDC_OU_OE</td>
                <td class="center">@Lang.LabelOddEven</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("711")</td>
                <td class="center">@Lang.LabelOtherTypes</td>
                <td class="center">@Lang.LabelOthers</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("712")</td>
                <td class="center">@Lang.Label1x2</td>
                <td class="center">@Lang.moneyline</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("713")</td>
                <td class="center">@Lang.Label1x2</td>
                <td class="center">@Lang.moneyline</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("714")</td>
                <td class="center">@Lang.Label1x2</td>
                <td class="center">@Lang.moneyline</td>
            </tr>
           
        </tbody>
    </table>
</body>
</html>