@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
}

@model EditMultipleViewModel

@section Styles {
    <link rel="stylesheet" asp-href-include="/protectedMultiple-*.css" />
}

@Html.AntiForgeryToken()
<div id="container" class="protected-status-container" />

@section Scripts {
    <script type="module" asp-src-include="/protectedMultiple-*.js"></script>

    <script type="text/javascript">
        $(document).ready(() => {
            window.renderProtectedMultiple(@Html.Raw(JsonSerializer.Serialize(Model.ProtectedStatus)));
        })
    </script>
}