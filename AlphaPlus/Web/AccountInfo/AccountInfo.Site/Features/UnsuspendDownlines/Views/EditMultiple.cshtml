@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
}

@model UnsuspendMultipleViewModel

@section Styles {
    @* @StaticResources.RenderStylesWithDarkMode("~/Features/UnsuspendDownlines/Bundles/unsuspend-multiple") *@
}

@Html.AntiForgeryToken()

<div id="container" class="unsuspend-container" />

@section Scripts {
    @* @StaticResources.RenderScripts("~/Features/UnsuspendDownlines/Bundles/unsuspend-multiple") *@
    <script async src="~/unsuspendMultiple.js" asp-append-version="true"></script>
    <script>
        window.renderUnsuspendMultiple(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model)));
    </script>
}