@inject AlphaPlus.Core.Models.IUserSession userSession
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@(ViewBag.Title ?? "Alpha - Account Info")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />

    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-accountinfo/index")
    @RenderSection("Styles", required: false)
</head>

<body data-theme="@(string.IsNullOrWhiteSpace(userSession.DarkModeName) ? "light" : "dark")>
    @RenderBody()
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    <link rel="stylesheet" href="~/react-tippy.css" asp-append-version="true" />
    <script type="module" src="~/react-tippy.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/settings-service.css" asp-append-version="true" />
    <script type="module" src="~/settings-service.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>