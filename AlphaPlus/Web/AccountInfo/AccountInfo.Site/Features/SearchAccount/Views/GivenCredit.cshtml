@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
}
@using System.Globalization
@using AlphaPlus.AccountInfo.Site.Features.SearchAccount.GetAccount.GivenCredit.Get
@model GivenCreditViewModel

@section Styles {
    <link rel="stylesheet" href="~/givenCredit.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div id="root"></div>

@section Scripts {
    <script type="text/javascript">
        const givenCreditParams = {
            searchAccountId: @Model.SearchAccountId,
            searchAccountName: '@Model.SearchAccountName',
            searchAccountRoleId: @Model.SearchAccountRoleId,
            currentGivenCredit: '@Model.CurrentGivenCredit',
            givenCreditMin: '@Model.GivenCreditMin',
            givenCreditMax: '@Model.GivenCreditMax',
            memberMaxCredit: @Model.MemberMaxCredit.ToString(CultureInfo.InvariantCulture),
            availableCredit: @Model.AvailableCredit.ToString(CultureInfo.InvariantCulture)
                                            };
    </script>
    <script type="module" src="~/givenCredit.js" asp-append-version="true"></script>
