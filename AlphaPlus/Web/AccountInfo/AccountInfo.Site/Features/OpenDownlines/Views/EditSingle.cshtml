@model OpenSingleViewModel

@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" asp-href-include="/unsuspend-downlines-*.css" />
}

@Html.AntiForgeryToken()

<div id="container" class="unsuspend-container" />

@section Scripts {
    @* @StaticResources.RenderScripts("~/Features/OpenDownlines/Bundles/open-single") *@
    @* <script type="module" src="~/open-helper.js" asp-append-version="true"></script> *@
    <script type="module" asp-src-include="/openSingle-*.js"></script>
    <script>
        $(document).ready(() => {
            window.renderOpenSingle(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Data)));
        })
    </script>
}