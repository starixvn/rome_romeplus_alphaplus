@{
    Layout = null;
    async Task RenderViewBetListCell(int betCount, int matchId, int betType, decimal total)
    {
        <td class="text-right">
            @if (betCount != 0)
            {
                <view-betlist matchid="@matchId" bettype="@betType" value="@total" redpositive="false" />
            }
        </td>
    }
    async Task RenderViewForecastCell(int betCount, int matchId, int betType)
    {
        <td class="w-icon-fc">
            @if (betCount != 0)
            {
                <a asp-controller="Forecast" asp-action="1X2ByMatch" asp-route-matchid="@matchId" asp-route-bettype="@betType"
                    class="icon-fc"></a>
            }
        </td>
    }
}

@model IEnumerable<OE1X2DND>
@if (Model.Any())
{
    var number = 1;
    var matchIndex = 0;
    var currentLeagueId = 0;
    foreach (var item in Model)
    {
        if (currentLeagueId == item.LeagueId)
        {
            matchIndex++;
        }
        else
        {
            matchIndex = 0;
            currentLeagueId = item.LeagueId;
            <tr class="col-league">
                <td colspan="10">@item.LeagueName</td>
            </tr>
        }
        var className = item.LiveIndicator ? "bg-live" : (matchIndex % 2 == 0 ? string.Empty : "odd");
        <tr class="@className">
            <td>@(number++)</td>
            <td>
                <event live="@item.LiveIndicator" homescore="@item.LiveHomeScore" awayscore="@item.LiveAwayScore"
                    time="@item.ShowTime" />
            </td>
            <td>@item.Event</td>
            @{
                await RenderViewBetListCell(item.BetCount_OE, item.MatchId, BetTypeConstants.OddEven, item.Home_Odds_OE -
                item.Away_Odds_OE);
                await RenderViewBetListCell(item.BetCount_1X2, item.MatchId, BetTypeConstants._1X2, item.Odds_1 + item.Odds_X +
                item.Odds_2);
                await RenderViewForecastCell(item.BetCount_1X2, item.MatchId, BetTypeConstants._1X2);
                await RenderViewBetListCell(item.BetCount_DND, item.MatchId, BetTypeConstants.DrawNoDraw, item.Home_Odds_DND -
                item.Away_Odds_DND);
                await RenderViewBetListCell(item.BetCount_OE_1st, item.MatchId, BetTypeConstants._1stOddEven, item.Home_Odds_OE_1st
                - item.Away_Odds_OE_1st);
                await RenderViewBetListCell(item.BetCount_1X2_1st, item.MatchId, BetTypeConstants._1st1X2, item.Odds_1_1st +
                item.Odds_X_1st +
                item.Odds_2_1st);
                await RenderViewForecastCell(item.BetCount_1X2_1st, item.MatchId, BetTypeConstants._1st1X2);
            }
        </tr>
    }
}
else
{
    <tr>
        <td colspan="10" class="text-center">@Resources.NoInformationIsAvailable</td>
    </tr>
}
