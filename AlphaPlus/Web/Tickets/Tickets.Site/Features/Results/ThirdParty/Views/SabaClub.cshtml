@using AlphaPlus.Core.Helpers
@using AlphaPlus.Tickets.Site.Features.Results.ThirdParty;
@{
    Layout = null;
}
@model ThirdPartyProductViewModel
<!DOCTYPE html>
<html>

<head>
    <title>@Model.Title</title>
    <link rel="stylesheet" href="~/bundles/results/thirdparty-result.css" asp-append-version="true" />
</head>

<body>
    <div class="third-party-result">
        @if (Model.IsSuccess)
        {
            <iframe src="@Model.Result" frameborder="0" class="card-club-iframe"></iframe>
        }
        else
        {
            <div class="alertboxerr"><span class="icon-error"></span>@Model.Result</div>
        }
    </div>
    @StaticResources.AssetScripts.Render("/bundles/site-results/default")
</body>

</html>
