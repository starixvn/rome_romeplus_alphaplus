@{
    ViewBag.Title = Resources.LastBets;
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/common/common")
    @StaticResources.AssetStyles.Render("/bundles-v2/site-betlists/monitoring-bets")
    <link rel="stylesheet" href="~/bundles/betlists/last-bets-new.css" asp-append-version="true" />
}
@section Scripts {
    @StaticResources.AssetScripts.RenderCommon("/bundles-v2/site-betlists/monitoring-bets")
    <script src="~/bundles/betlists/last-bets-new.js" asp-append-version="true"></script>
}
@model AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.LastBets.LastBetsNewViewModel
<div class="flex">
    <div class="bl_title">
        <div class="box">
            <div>@Resources.LastBets</div>
            <div>
                <div class="">
                    <span id="icon-information" class="icon icon-information-outline"></span>
                    <a href="@Model.UserGuideLink" target="_blank" class="icon icon-book"></a>
                </div>
                <partial name="IconInformationPopup" model="new[] { Resources.ipnote, CommonResx.MemberWinNote }" />
            </div>
            <div class="push">
                <div class="list-icon">
                    <ul>
                        <li><span class="icon-arrow-up-drop-circle icon-filter" id="icon-filter"
                                title="@Resources.HideFilter"></span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="form-inline filter" id="form-monitoring-bets">
        <div class="form-group">
            <label class="label-form-control">
                @Resources.MyFilters
                <span class="icon-save hide" id="icon-save-filter"></span>
            </label>
            <select id="monitoring-bets-filter" style="width: 160px" data-placeholder="@Resources.PleaseSelect">
                @if (Model.IsShowFilterPlaceHolder)
                {
                    <option></option>
                }
                @foreach (var savedFilter in Model.Filters)
                {
                    <!option value="@savedFilter.FilterId" data-members="@savedFilter.Members"
                        data-bet-types="@savedFilter.BetTypes" data-sport-types="@savedFilter.SportTypes"
                        data-leagues="@savedFilter.Leagues" data-event-status="@savedFilter.EventStatus"
                        data-stake="@savedFilter.Stake" data-filter-by-member="@savedFilter.FilterByMembers"
                    @(savedFilter.FilterId == Model.FilterId ? "selected" : string.Empty)>@savedFilter.FilterName
                    </!option>
                }
            </select>
        </div>
        <div class="form-group">
            <a class="button-link navigation" target="main" asp-action="ManageFilters"
                asp-controller="MonitoringBets">@Resources.ManageFilters</a>
        </div>
        <div class="form-group">
            <label class="label-form-control">@Resources.MostRecentTickets</label>
            <select id="most-recent-tickets" style="width: 160px" asp-items="Model.MostRecentTickets"></select>
        </div>
        <auto-refresh seconds="Model.AutoRefreshSeconds" selected="@Model.AutoRefreshSeconds[1]"
            is-start="Model.AutoStart && Model.FilterId != -1" />
        <div class="form-group">
            <a class="button-link navigation" target="main" asp-action="FilterConfiguration"
                asp-controller="MonitoringBets">@Resources.FilterConfiguration</a>
        </div>
        <div class="form-group col-item">
            <span class="ic-copy" title="@Resources.Copy" id="icon-copy"></span>
        </div>
    </div>
    <div id="msg-error" class="msg msg-error hide">@Resources.FunctionTurnOffError</div>
    <div class="scrollable">
        <table class="tb tb-bordered tb-hover tb-freeze-header w-full" id="tbl-betlist">
            <thead>
                <tr>
                    <th class="col-number">#</th>
                    <th class="col-refno">@Resources.RefNo</th>
                    <th class="col-transtime">@Resources.transtime</th>
                    <th class="col-member">@Resources.Username</th>
                    <th class="col-bettype">@Resources.BetType</th>
                    <th>@Resources.choice</th>
                    <th class="col-odds">@Resources.odds</th>
                    <th class="col-stake">@Resources.stake</th>
                    <th class="col-status">@Resources.IP</th>
                    <th class="col-stake">@Resources.MemberRisk</th>
                    @if (Model.ViewerLevel.IsSuperLevel())
                    {
                        <th class="col-stake">@Resources.SuperRisk</th>
                    }
                    @if (Model.ViewerLevel.IsMasterLevel())
                    {
                        <th class="col-stake">@Resources.MasterRisk</th>
                    }
                    @if (Model.ViewerLevel.IsAgentLevel())
                    {
                        <th class="col-stake">@Resources.AgentRisk</th>
                    }
                    <th class="col-platform">@Resources.platform</th>
                </tr>
            </thead>
            <tbody id="bet-list-table-container">
                <partial name="Tickets" model="Model" />
            </tbody>
        </table>
    </div>
    <partial name="~/Features/BetLists/Views/MonitoringBets/SaveFilterConfirmPopup.cshtml" model="false" />
</div>
@* @Html.Hidden("betlist-path", Response.ApplyAppPathModifier($"~/{AppSettings.BetlistRouting}"))
@Html.Hidden("old-main-path", Model.OldMainPath) *@
<input type="hidden" id="last-trans-id" value="@Model.LastTransId.ToString()" />
<input type="hidden" id="latest-trans-id" value="@Model.LatestTransId.ToString()" />
<input type="hidden" id="last-trans-id-cache-key-by-filter" value="@Model.LastTransIdCacheKeyByFilter" />
<input type="hidden" id="latest-trans-id-cache-key-by-filter" value="@Model.LatestTransIdCacheKeyByFilter" />
<input type="hidden" id="hidden-IsInternal" value="@Convert.ToByte(Model.IsInternal).ToString()" />
<input type="hidden" id="hidden-OnText" value="@Resources.On" />
<input type="hidden" id="hidden-OffText" value="@Resources.Off" />
<input type="hidden" id="hidden-CopyText" value="@Resources.Copy" />
<input type="hidden" id="hidden-CopiedText" value="@Resources.Copied" />
<input type="hidden" id="hidden-HideFilterText" value="@Resources.HideFilter" />
<input type="hidden" id="hidden-ShowFilterText" value="@Resources.ShowFilter" />
