@using System.Text.Json;
@using System.Text.Json.Serialization;
@{
    ViewData["Title"] = Model.Title;
    var notes = new List<string> { Resources.ipnote, Resources.CommissionRoundNote };
    if (Model.ShowContributionAmountRoundNote)
    {
        notes.Add(Resources.ContributionAmountRoundNote);
    }
}
@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-betlists/filter-new")
    <link rel="stylesheet" href="~/bundles/betlists/winloss.css" asp-append-version="true" />
}
@section Scripts {
    <script type="text/javascript">
        var productList = $.parseJSON('@Html.Raw(JsonSerializer.Serialize(Model.ProductViewModel.Products))');
        var productDetailList = $.parseJSON('@Html.Raw(JsonSerializer.Serialize(Model.ProductViewModel.ProductDetails))');
    </script>
    @StaticResources.AssetScripts.Render("/bundles/site-betlists/filter-new")
    <script src="~/bundles/betlists/winloss.js" asp-append-version="true"></script>
}
@model AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.WinLoss.WinLossNewViewModel
<div class="flex">
    <div class="bl_title">
        <div class="box">
            <div>@Model.Title</div>
            <div>
                <partial name="IconInformation" model="@notes" />
            </div>
            <div class="push">
                <div class="list-icon">
                    <ul>
                        <li><span class="icon-arrow-up-drop-circle icon-filter" id="icon-filter"
                                title="@Resources.HideFilter"></span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="form-inline filter" id="form-filter">
        <daterange-picker-jquery model="@Model.DateRangePicker" />
        <product-dropdown show-product-details="true" />
    </div>
    <div id="betlist-week-selection" class="cover-week-selection">
        <partial name="BetListWeekSelection" model="Model" />
    </div>
</div>
<input type="hidden" id="winloss-detail-report-path" value="@MicroSites.ReportsUrl("~/WinLossDetail/IndexNew")" />
<input type="hidden" id="cust-name" value="@Model.CustName" />
<input type="hidden" id="hidden-hide-filter-text" value="@Resources.HideFilter" />
<input type="hidden" id="hidden-show-filter-text" value="@Resources.ShowFilter" />
<input type="hidden" id="hidden-show-columns" value="@Model.VisibleColumns" />
