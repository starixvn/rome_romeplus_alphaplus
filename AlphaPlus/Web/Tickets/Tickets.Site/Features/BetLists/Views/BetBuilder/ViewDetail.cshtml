@{
    Layout = null;
}
@model AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.BetBuilder.BetBuilderDetailViewModel;
@if (Model.Details.Any())
{
    <div class="betbuilder">
        @foreach (var detail in Model.Details)
        {
            <div>
                @detail.SelectionName
                @if (Model.IsSettled && !string.IsNullOrWhiteSpace(detail.Result))
                {
                    <span class="sport"> - @detail.Result</span>
                }
            </div>
        }
    </div>
}
