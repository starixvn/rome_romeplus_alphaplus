@{
    Layout = null;
    var isWinLossBetListNew = ViewData != null && ViewData.ContainsKey("WinLossBetListNew");
}
@model AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.WinLoss.WinLossViewModel
<div class="scrollable">
    <table class="tblRpt tblRpt-bordered tblRpt-striped width-100per tblRpt-hover tbl-betlist tblRpt-freeze-header"
        id="tbl-betlist">
        <thead>
            <tr>
                <th class="col-number">#</th>
                @if (Model.ShowMemberName)
                {
                    <th class="col-member">@Resources.member</th>
                }
                <th class="col-transtime">@Resources.transtime</th>
                <th>@Resources.choice</th>
                <th class="col-odds">@Resources.odds</th>
                <th class="col-stake">@Resources.stake</th>
                <th class="col-winloss">@Resources.lblWinLoss</th>
                <th class="col-status">@Resources.status</th>
                @if (Model.AllowToViewSuperPT)
                {
                    <th class="col-pt">@Resources.superptcomm</th>
                }
                @if (Model.AllowToViewMasterPT)
                {
                    <th class="col-pt">@Resources.masterptcomm</th>
                }
                <th class="col-pt">@Resources.agentptcomm</th>
                @if (Model.SupportRiskAmount)
                {
                    <th class="col-stake">@Resources.MemberRisk</th>
                    if (Model.ViewerLevel.IsSuperLevel())
                    {
                        <th class="col-stake">@Resources.SuperRisk</th>
                    }
                    if (Model.ViewerLevel.IsMasterLevel())
                    {
                        <th class="col-stake">@Resources.MasterRisk</th>
                    }
                    if (Model.ViewerLevel.IsAgentLevel())
                    {
                        <th class="col-stake">@Resources.AgentRisk</th>
                    }
                }
                <th class="col-platform">@Resources.platform</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.BetListData.Tickets.Any())
            {
                var index = Model.StartIndex;
                foreach (var ticket in Model.BetListData.Tickets)
                {
                    <tr id="r@(ticket.TransId)">
                        <td class="w-order text-center">@(index++)</td>
                        @if (Model.ShowMemberName)
                        {
                            <td class="text-center">@ticket.UserName</td>
                        }
                        <trans builder="Model.Builder" ticket="ticket" />
                        <choice builder="Model.Builder" ticket="ticket" ticket-helper="Model.TicketHelper"
                            ticket-data="Model.BetListData.TicketData" is-show-score-map="Model.CanViewScoreMap(ticket)" />
                        <odds builder="Model.Builder" ticket="ticket" ticket-data="Model.BetListData.TicketData"
                            get-cache-property-by-id="Model.TicketHelper.GetOddsTypeNameById" />
                        <stake builder="Model.Builder" ticket="ticket" ticket-helper="Model.TicketHelper" />
                        <winloss ticket="ticket" />
                        <status builder="Model.Builder" ticket="ticket" ticket-helper="Model.TicketHelper"
                            ticket-data="Model.BetListData.TicketData" is-show-vn-ip="Model.DisplayVNIP"
                            country="@ticket.Country" />
                        @if (Model.AllowToViewSuperPT)
                        {
                            <position-taking ticket="ticket" ticket-data="Model.BetListData.TicketData"
                                user-level="UserLevel.Super" />
                        }
                        @if (Model.AllowToViewMasterPT)
                        {
                            <position-taking ticket="ticket" ticket-data="Model.BetListData.TicketData"
                                user-level="UserLevel.Master" />
                        }
                        <position-taking ticket="ticket" ticket-data="Model.BetListData.TicketData"
                            user-level="UserLevel.Agent" />
                        @if (Model.SupportRiskAmount)
                        {
                            <risk-amount member-win="@ticket.MemberWinText" sma-risk-amount="@Model.GetSMARiskAmount(ticket)" />
                        }
                        <platform value="@ticket.Platform" />
                    </tr>
                }
                if (Model.Footer != null)
                {
                    <footer subtotal-colspan="@Model.Footer.SubTotalColSpan" status-colspan="@Model.Footer.StatusColSpan"
                        subtotal-winloss="@Model.Footer.SubTotalWinLoss" subtotal-commission="@Model.Footer.SubTotalCommission"
                        total="@Model.Footer.Total" />
                }
            }
            else
            {
                <no-infomation colspan="Model.TotalColumn" hastbody="false" />
            }
        </tbody>
    </table>
</div>
