@{
    ViewData["Title"] = Model.Title;
}
@section Scripts {
    <script src="~/bundles/betlists/icon-note.js" asp-append-version="true"></script>
}
@model AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.CorrectScore.CorrectScoreViewModel
<div class="bl_title">
    <div class="box">
        <div>@Model.Title</div>
        <div>
            <partial name="IconInformation" model="new[] { Resources.ipnote, Resources.MemberWinNote }" />
        </div>
        <div class="push">
            <div class="bl-export-excel">
                <a asp-action="Excel" class="icon icon-excel" title="@Resources.ExportToExcel"></a>
            </div>
        </div>
    </div>
</div>
<partial name="TableWithoutWinLoss" model="Model" />
