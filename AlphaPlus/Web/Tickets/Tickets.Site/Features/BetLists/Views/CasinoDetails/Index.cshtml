@{
    ViewData["Title"] = Model.Title;
}
@model AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.CasinoDetails.CasinoDetailsViewModel
@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-betlists/pagination")
}
@section Scripts {
    @StaticResources.AssetScripts.Render("/bundles/site-betlists/pagination")
    <script src="~/bundles/betlists/casino-details.js?v=1"></script>
}
<div class="space-fixed-title"></div>
<div class="bl_title no-border-bottom fixed-top">
    <div class="bl-export-excel">
        <a asp-action="@Model.ExportExcelUrl" asp-all-route-data="@Model.GetExcelParams()" class="icon icon-excel"
            title="@Resources.ExportToExcel"></a>
        </a>
    </div>
</div>
<div id="table-container" class="combined-fixed-pagination-bottom">
    <partial name="WinLossTable" model="Model" />
</div>
<pager model="@Model.Pager" />
<form class="hide" role="form" id="betlist-form">
    @Html.Hidden("RefNo", Model.RefNo)
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("TransType", Model.TransType)
    @Html.Hidden("SportName", Model.SportName)
    @Html.Hidden("ProductId", Model.ProductId)
</form>
