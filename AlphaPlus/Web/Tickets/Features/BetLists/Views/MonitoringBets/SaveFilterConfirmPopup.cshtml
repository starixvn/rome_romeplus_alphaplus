@{
    Layout = null;
}
@model bool
<div class="modal fade modal-form" data-backdrop="false" tabindex="-1" role="dialog" id="save-filter-popup">
    <div class="modal-dialog save-filter-popup" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="Close"><span
                        aria-hidden="true"></span></button>
                <h4 class="modal-title">@Resources.SaveToMyFilters</h4>
            </div>
            <div class="modal-body">
                <label class="ttl">@Resources.FilterName <span class="require">*</span></label>
                <input type="text" id="txt-filterName" autocomplete="off" maxlength="50" />
                <div id="inline-message-popup" class="msg hide"></div>
            </div>
            <div class="modal-footer">
                <label><input type="checkbox" id="chk-isDefault" /><span>@Resources.SetAsDefaultFilter</span></label>
                <div class="block-btn">
                    <button type="button" class="button button-cancel" data-dismiss="modal">@Resources.Cancel</button>
                    <button type="button" class="button button-save" id="btn-save-filter-popup">@(Model ? Resources.Save
                        : Resources.SaveFilter)</button>
                    @if (Model)
                    {
                        <button type="button" class="button button-save"
                            id="btn-save-filter-apply-popup">@Resources.SaveAndApply</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Hidden("hidden-FilterNameRequiredError", Resources.FilterConfigurationFilterNameRequiredError)
<a class="hide" id="hidden-SaveFilterUrl" asp-action="@(Model ? "AddFilter" : "AddUnsavedFilter")"></a>
