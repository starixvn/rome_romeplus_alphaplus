@using Fanex.BetList.Core.App_GlobalResources
@{
    Layout = null;
}
@model AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.Parlay.ComboParlayViewModel
@if (Model.HasValidData)
{
    foreach (var unitStakeByOfferNames in Model.UnitStakeByOfferNames)
    {
        <div class="offer-name-list">
            @unitStakeByOfferNames.Key x <span class="unit-stake">@unitStakeByOfferNames.Value</span>
        </div>
    }
    <div class="max-payout" style="display: none;">(@CoreBetList.MaxPayoutAlert)<span class="icon-max-payout"
            title="@CoreBetList.MaxPayoutAlertInfo"></span></div>
    <div class="line"></div>
    foreach (var ticket in Model.BetListData.Tickets)
    {
        <div class="ticket-list">
            @Html.Raw(Model.Builder.BuildChoice(ticket, Model.TicketHelper, null, Model.CanViewScoreMap(ticket)))
            @Html.Raw(Model.Builder.BuildTransEventDateAndStatusResult(ticket, null))
        </div>
        if (!ticket.Equals(Model.BetListData.Tickets.Last()))
        {
            <div class="line"></div>
        }
    }
}
else
{
    @Resources.NoInformationIsAvailable
}