@using AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.Parlay
@{
    Layout = null;
    async Task RenderDetailItems(IGrouping<string, ComboParlayDetailWrapper> groupDetailItem)
    {
        var showWinLostDate = false;
        foreach (var item in groupDetailItem)
        {
            <tr>
                @if (!showWinLostDate)
                {
                    <td class="text-center" rowspan="@groupDetailItem.Count()">@groupDetailItem.Key</td>
                    showWinLostDate = true;
                }
                <td class="text-left">
                    @foreach (var eventDetail in item.Events)
                    {
                        <div>@eventDetail</div>
                    }
                </td>
                <td class="text-right bl_underdog">
                    @if (Model.IsParlayBoost)
                    {
                        <parlay-boost-odds original-odds="@item.Odds" boost-odds="@item.MasterOdds" boost-rate="@item.BoostRate" />
                    }
                    else
                    {
                        Html.Raw(item.MasterOdds);
                    }
                </td>
                <td class="text-right bl_underdog">@Html.Raw(item.Stake)</td>
                <td class="text-right">
                    <div class="bl_underdog">@Html.Raw(item.WinLost)</div>
                    <div class="bl_underdog">@Html.Raw(item.Comm)</div>
                </td>
                <td class="text-center bl_status">@item.Status</td>
            </tr>
        }
    }
}
@model ComboParlayDetailViewModel
<table class="tblRpt tblRpt-bordered tblRpt-striped width-100per tablesorter tblRpt-hover">
    <thead>
        <tr>
            <th>@Resources.date</th>
            <th>@Resources.events</th>
            <th>@Resources.odds</th>
            <th>@Resources.stake</th>
            <th>@Resources.lblWinLoss</th>
            <th>@Resources.status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in Model.ComboParlayDetailWrapperGroups)
        {
            await RenderDetailItems(group);
            <tr class="bl_footertotal">
                <td class="text-right" colspan="4">@Resources.subTotal:</td>
                <td class="text-right">@Html.Raw(Model.SubTotalWinLost(group))</td>
                <td></td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="bl_footertotal outstanding">
            <td class="text-right" colspan="4">@Resources.outstanding:</td>
            <td class="text-right">@Html.Raw(Model.OutStanding)</td>
            <td></td>
        </tr>
        @if (!Model.IsRunningTicket)
        {
            <tr class="bl_footertotal">
                <td class="text-right" colspan="4">@Resources.total:</td>
                <td class="text-right">@Html.Raw(Model.TotalWinLost)</td>
                <td></td>
            </tr>
        }
    </tfoot>
</table>
