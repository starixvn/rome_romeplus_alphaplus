<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    @StaticResources.AssetStyles.RenderCommon("/bundles3/site-totalbetsforecast/default")
    @await RenderSectionAsync("Styles", required: false)
</head>

<body data-theme="">
    @RenderBody()
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
