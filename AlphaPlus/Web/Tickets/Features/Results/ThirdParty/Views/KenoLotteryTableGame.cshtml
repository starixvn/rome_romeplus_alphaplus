@using AlphaPlus.Tickets.Site.Features.Results.ThirdParty;
@{
    Layout = "~/Features/Results/Views/_Layout.cshtml";
    ViewBag.Title = Model.ProductName;
}
@section Scripts {
    <script src="~/bundles/results/kenolotterytablegame-result.js" asp-append-version="true"></script>
}
@model KenoLotteryTableGameResultViewModel
<div role="tabpanel" class="tab-pane active">
    <div class="filter">
        <a href="@(Model.ResultUrl)" id="result-link" class="lnk" target="_blank"
            data-productname="@Model.ProductName">@Model.ResultLinkText</a>
    </div>
</div>
