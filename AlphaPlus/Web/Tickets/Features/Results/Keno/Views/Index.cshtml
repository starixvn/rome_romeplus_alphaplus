@using AlphaPlus.Tickets.Site.Features.Results.Keno;
@{
    Layout = "~/Features/Results/Views/_Layout.cshtml";
    ViewBag.Title = Model.ProductName;
}
@section Scripts {
    <script src="~/bundles/results/keno-result.js" asp-append-version="true"></script>
}
@model KenoLotteryTableGameResultViewModel
<div role="tabpanel" class="tab-pane active" id="keno">
    <div class="filter">
        <a href="@(Model.ResultUrl)" id="result-link" class="lnk" target="_blank">@Model.ResultLinkText</a>
    </div>
</div>
