@{
    ViewData["Title"] = Resources.HDPOULive;
}
@section Styles {
    <link rel="stylesheet" href="~/bundles/totalbets/totalbets.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/bundles/forecast/forecast.js" asp-append-version="true"></script>
}
@model ForecastViewModel<ForecastHDPOULive>
<div class="page-title">@Resources.HDPOULive</div>
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation">
        <a asp-controller="TotalBets" asp-action="HDPOULive">@Resources.TotalBets</a>
    </li>
    <li role="presentation" class="active">
        <a href="javascript:;">@Resources.Forecast</a>
    </li>
</ul>
<div class="filter">
    <div class="auto-refresh"></div>
</div>
<div id="content">
    <partial name="HDPOULivePartial" />
</div>
<input type="hidden" id="hidden-autoRefreshRefreshText" value="@Resources.Refresh" />
<input type="hidden" id="hidden-autoRefreshSeconds" value="15,30,45,60,75" />
<input type="hidden" id="hidden-autoRefreshUrl" value="HDPOULive?partial=true&leagueId=" />
<input type="hidden" id="hidden-autoRefreshSavedSecondKey" value="FC-HDPOULive" />
<input type="hidden" id="hidden-dataUrl" value="HDPOULiveData?leagueId=" />
