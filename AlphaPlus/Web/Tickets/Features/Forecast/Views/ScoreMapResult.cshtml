@{
    Layout = null;
    void RenderMatrix(int rowNumber, int columnNumber, int[,] matrix, string tableId)
    {
        <table id="@tableId" class="tblScoreMap">
            <thead>
                <tr>
                    <td rowspan="2">@Resources.Away</td>
                    <td colspan="@columnNumber">@Resources.Home</td>
                </tr>
                <tr>
                    @for (int i = 0; i < columnNumber; i++)
                    {
                        <td style="width:13%;">@i</td>
                    }
                </tr>
            </thead>
            @if (matrix != null)
            {
                <tbody>
                    @for (int i = 0; i < rowNumber; i++)
                    {
                        <tr>
                            <td>@i</td>
                            @for (int j = 0; j < columnNumber; j++)
                            {
                                var score = matrix[i, j];
                                <td class="@(score > 0 ? "positive" : string.Empty)">@score</td>
                            }
                        </tr>
                    }
                </tbody>
            }
        </table>
    }
}
@model IEnumerable<ScoreMapResult>
@* bool isRefresh = (bool)ViewBag.IsRefresh; *@
@foreach (var item in Model)
{
    var matchId = item.MatchId;
    var rowNumber = item.RowNumber;
    var columnNumber = item.ColumnNumber;
    @* if (!isRefresh)
{
@:<div class="paddingTopMatch" id="RefreshContent@(item.MatchId)">
} *@
    <div class="button_mid" data-matchid="@matchId">
        <span id="lnkGroupscoreMap@(matchId)" class="lnkGroup">@item.Event</span>
        <span id="lnkRefresh@(matchId)" class="lnkRefresh" title="@Resources.Refresh" data-matchid="@matchId"></span>
    </div>
    <div style="clear:both"></div>
    <div id="scoreMap@(matchId)" class="scoreMap">
        <div class="round haft-time">@Resources.HT</div>
        @{
            RenderMatrix(rowNumber, columnNumber, item.HaftTime, "tblht" + matchId);
        }
        <div class="round full-time">@Resources.FT</div>
        @{
            RenderMatrix(rowNumber, columnNumber, item.FullTime, "tblft" + matchId);
        }
    </div>
    @* if (!isRefresh)
{
@:
</div>
} *@
}
