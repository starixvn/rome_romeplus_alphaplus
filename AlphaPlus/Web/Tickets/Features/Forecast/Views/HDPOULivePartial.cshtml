@{
    Layout = null;
}
@model ForecastViewModel<ForecastHDPOULive>
<div>
    <label for="ddlLeague">@Resources.League</label>
    @Html.DropDownList("league", Model.Leagues, new { @id = "ddlLeague" })
</div>
<table class="tblRpt tblRpt-bordered text-center" id="tblRpt">
    <thead>
        <tr>
            <th colspan="2">@Resources.Team</th>
            <th colspan="3">@Resources.Handicap</th>
            <th colspan="3">@Resources.OverSlashUnder</th>
        </tr>
    </thead>
    <tbody>
        <partial name="HDPOULiveData" model="Model.Forecast" />
    </tbody>
</table>
