@inject Microsoft.Extensions.Options.IOptions<AlphaPlus.Tickets.Site.Features.Shared.Models.AppSettings> appSettings
@{
    Layout = null;
    var version = appSettings.Value.JsVersion;
}
@model string
<p class="main-desc">
    投注&预测功能根据每场赛事进行中的注单总结主要投注类型、注单数量和本金。它还根据目前比分预测注单的输赢金额，并显示每个滚球赛事的总预测输赢。
</p>
<img class="img-big" src="~/images/@Model/1.png?v=@version" />
<div class="block-Guideline">
    <h4 class="title-Guideline">预测让球盘输/赢</h4>
    <div class="detail">
        <div class="left">
            <h5>滚球</h5>
            <ul class="circle">
                <li>预测输赢总从目前比分差距开始。</li>
                <li>例子： 目前实时比分 2 - 0</li>
            </ul>
            <div class="c-red txt-bold">
                <p>目前比分差距 (X) = 主队实时比分 - 客队实时比分 = 2 - 0 = 2</p>
            </div>
            <div class="img-small">
                <img src="~/images/@Model/2.png?v=@version" />
            </div>
        </div>
        <div class="left">
            <h5>非滚球</h5>
            <ul class="circle">
                <li>预测输赢从取其整数让球盘平均值开始。</li>
                <li>
                    例子：该赛事让盘球值：1.5 – 2
                    <ul class="circle c-red txt-bold">
                        <li>让球盘平均值= (1.5 + 2)/2 = 1.75</li>
                        <li>取其整数让球值 (Y) = 1</li>
                    </ul>
                </li>
            </ul>
            <div class="img-small">
                <img src="~/images/@Model/3.png?v=@version" />
            </div>
        </div>
    </div>
</div>

<div class="block-Guideline">
    <h4 class="title-Guideline">预测大小盘输/赢</h4>
    <div class="detail">
        <div class="left">
            <h5>滚球</h5>
            <ul class="circle">
                <li>预测输赢从目前总比分开始。</li>
                <li>例子： 目前实时比分 0 - 4</li>
            </ul>
            <div class="c-red txt-bold">
                <p>总目前比分（X）</p>
                <p>= 主队实时比分 + 客队实时比分 = 0 + 4 = 4</p>
            </div>
            <div class="img-small">
                <img src="~/images/@Model/4.png?v=@version" />
            </div>
        </div>
        <div class="left">
            <h5>非滚球</h5>
            <ul class="circle">
                <li>预测输赢从取其整数总进球平均值开始。</li>
                <li>
                    例子：该赛事大小值：2 – 2.5
                    <ul class="circle c-red txt-bold">
                        <li>总进球平均值 = (2 + 2.5)/2 = 2.25</li>
                        <li>向下舍入平均值球数 (Y) = 2</li>
                    </ul>
                </li>
            </ul>
            <div class="img-small">
                <img src="~/images/@Model/5.png?v=@version" />
            </div>
        </div>
    </div>
</div>

<div class="block-Guideline">
    <h4 class="title-Guideline">预测独赢盘输/赢</h4>
    <div class="detail">
        <div class="left">
            <h5>滚球</h5>
            <ul class="circle">
                <li>突出显示当前成绩。</li>
                <li>
                    例子： 目前实时比分 2 - 0
                    <ul class="arrow txt-bold">
                        <li>主队赢</li>
                        <li>突出显示标题 1</li>
                    </ul>
                </li>
            </ul>
            <div class="img-small">
                <img src="~/images/@Model/6.png?v=@version" />
            </div>
        </div>
        <div class="left">
            <h5>非滚球</h5>
            <ul class="circle">
                <li>
                    若该赛事提供让球盘投注类型。
                    <div class="img-small img-ex">
                        <img src="~/images/@Model/7.png?v=@version" />
                    </div>
                </li>
                <li>若该赛事未提供让球盘投注类型，则不会突出显示标题。</li>
                <li>
                    例子：该赛事让球盘值：1.5 – 2
                    <ul class="circle c-red txt-bold">
                        <li>让球盘平均值= (1.5 + 2)/2 = 1.75</li>
                        <li>取其整数让球平均值（X）= 1 > 0</li>
                    </ul>
                    <ul class="arrow txt-bold">
                        <li>突出显示标题 1</li>
                    </ul>
                </li>
            </ul>
            <div class="img-small img-ex">
                <img src="~/images/@Model/8.png?v=@version" />
            </div>
        </div>
    </div>
</div>