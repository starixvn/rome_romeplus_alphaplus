@{
    ViewData["Title"] = Resources.Forecast;
}
@section Styles {
    <link rel="stylesheet" href="~/bundles/totalbets/totalbets.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/bundles/forecast/forecast.js" asp-append-version="true"></script>
}
@model AH
<div class="page-title">@Resources.Forecast</div>
<div class="filter">
    <div class="auto-refresh"></div>
</div>
<div id="content">
    <table class="tblRpt width-100per">
        <thead>
            <tr>
                <th>@Resources.Team</th>
                <th>@Resources.Score</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.Event</td>
                <td>@Model.LiveHomeScore : @Model.LiveAwayScore</td>
            </tr>
        </tbody>
    </table>
    <table class="tblRpt width-100per">
        <tbody>
            <tr>
                <td>{Title</td>
                <td colspan="4">
                    <!--ForecastPointContent-->
                    <a href='javascript:GetFCAH({MatchId},{ForecastPoint},{BetType})'>{ForecastPointValue}</a>&nbsp;
                    <!--/ForecastPointContent-->
                </td>
            </tr>
        </tbody>
    </table>
</div>
<input type="hidden" id="hidden-autoRefreshRefreshText" value="@Resources.Refresh" />
<input type="hidden" id="hidden-autoRefreshSeconds" value="15,30,45,60,75" />
<input type="hidden" id="hidden-autoRefreshUrl" value="AH?partial=true&leagueId=" />
<input type="hidden" id="hidden-autoRefreshSavedSecondKey" value="AH" />
