@inject Microsoft.Extensions.Options.IOptions<AlphaPlus.Tickets.Site.Features.Shared.Models.AppSettings> appSettings
@{
    Layout = null;
    var version = appSettings.Value.JsVersion;
}
@model string
<p class="main-desc">
    投注&預測功能根據每場賽事進行中的注單總結主要投注類型、注單數量和本金。它還根據目前比分預測注單的輸贏金額，並顯示每個滾球賽事的總預測輸贏。
</p>
<img class="img-big" src="~/bundles/images/@Model/1.png?v=@version" />
<div class="block-Guideline">
    <h4 class="title-Guideline">預測讓球盤輸/贏</h4>
    <div class="detail">
        <div class="left">
            <h5>滾球</h5>
            <ul class="circle">
                <li>預測輸贏總從目前比分差距開始。</li>
                <li>例子： 目前實時比分 2 - 0</li>
            </ul>
            <div class="c-red txt-bold">
                <p>目前比分差距 (X) = 主隊實時比分 - 客隊實時比分 = 2 - 0 = 2</p>
            </div>
            <div class="img-small">
                <img src="~/bundles/images/@Model/2.png?v=@version" />
            </div>
        </div>
        <div class="left">
            <h5>非滾球</h5>
            <ul class="circle">
                <li>預測輸贏從取其整數讓球盤平均值開始。</li>
                <li>
                    例子：該賽事讓球盤值：1.5 – 2
                    <ul class="circle c-red txt-bold">
                        <li>讓球盤平均值= (1.5 + 2)/2 = 1.75</li>
                        <li>取其整數讓球盤值 (Y) = 1</li>
                    </ul>
                </li>
            </ul>
            <div class="img-small">
                <img src="~/bundles/images/@Model/3.png?v=@version" />
            </div>
        </div>
    </div>
</div>

<div class="block-Guideline">
    <h4 class="title-Guideline">預測大小盤輸/贏</h4>
    <div class="detail">
        <div class="left">
            <h5>滾球</h5>
            <ul class="circle">
                <li>預測輸贏從目前總比分開始。</li>
                <li>例子： 目前實時比分 0 - 4</li>
            </ul>
            <div class="c-red txt-bold">
                <p>總目前比分（X）</p>
                <p>= 主隊實時比分 + 客隊實時比分 = 0 + 4 = 4</p>
            </div>
            <div class="img-small">
                <img src="~/bundles/images/@Model/4.png?v=@version" />
            </div>
        </div>
        <div class="left">
            <h5>非滾球</h5>
            <ul class="circle">
                <li>預測輸贏從取其整數總進球平均值開始。</li>
                <li>
                    例子：該賽事大小值：2 – 2.5
                    <ul class="circle c-red txt-bold">
                        <li>總進球平均值 = (2 + 2.5)/2 = 2.25</li>
                        <li>向下舍入平均值球數 (Y) = 2</li>
                    </ul>
                </li>
            </ul>
            <div class="img-small">
                <img src="~/bundles/images/@Model/5.png?v=@version" />
            </div>
        </div>
    </div>
</div>

<div class="block-Guideline">
    <h4 class="title-Guideline">預測獨贏盤輸/贏</h4>
    <div class="detail">
        <div class="left">
            <h5>滾球</h5>
            <ul class="circle">
                <li>突出顯示當前成績。</li>
                <li>
                    例子： 目前實時比分 2 - 0
                    <ul class="arrow txt-bold">
                        <li>主隊贏</li>
                        <li>突出顯示標題 1</li>
                    </ul>
                </li>
            </ul>
            <div class="img-small">
                <img src="~/bundles/images/@Model/6.png?v=@version" />
            </div>
        </div>
        <div class="left">
            <h5>非滾球</h5>
            <ul class="circle">
                <li>
                    若該賽事提供讓球盤投注類型。
                    <div class="img-small img-ex">
                        <img src="~/bundles/images/@Model/7.png?v=@version" />
                    </div>
                </li>
                <li>若該賽事未提供讓球盤投注類型，則不会突出顯示標題。</li>
                <li>
                    例子：該賽事讓球盤值：1.5 – 2
                    <ul class="circle c-red txt-bold">
                        <li>讓球盤平均值= (1.5 + 2)/2 = 1.75</li>
                        <li>取其整數讓球平均值（X）= 1 > 0</li>
                    </ul>
                    <ul class="arrow txt-bold">
                        <li>突出顯示標題 1</li>
                    </ul>
                </li>
            </ul>
            <div class="img-small img-ex">
                <img src="~/bundles/images/@Model/8.png?v=@version" />
            </div>
        </div>
    </div>
</div>