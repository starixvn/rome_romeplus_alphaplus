@{
    Layout = null;
    void RenderMatrix(int rowNumber, int columnNumber, int[,] matrix, string tableId)
    {
        <table id="@tableId" class="tbl-score-result">
            <thead>
                <tr class="vsmHomeWay">
                    <td rowspan="2">@Resources.Away</td>
                    <td colspan="@columnNumber">@Resources.Home</td>
                </tr>
                <tr class="vsm">
                    @for (int i = 0; i < columnNumber; i++)
                    {
                        <td style="width:13%;">@i</td>
                    }
                </tr>
            </thead>
            @if (matrix != null)
            {
                <tbody>
                    @for (int i = 0; i < rowNumber; i++)
                    {
                        <tr>
                            <td class="vsm">@i</td>
                            @for (int j = 0; j < columnNumber; j++)
                            {
                                var score = matrix[i, j];
                                <td class="@(score > 0 ? "positive" : string.Empty)">@score</td>
                            }
                        </tr>
                    }
                </tbody>
            }
        </table>
    }
}
@model IEnumerable<ScoreMapResult>
@* bool isRefresh = (bool)ViewBag.IsRefresh; *@
@foreach (var item in Model)
{
    @* if (!isRefresh)
{
@:<div class="paddingTopMatch" id="RefreshContent@(item.MatchId)">
} *@
    <div data-matchid="@item.MatchId" class="match-title">
        <span class="icon-menu-down open"></span>
        <span id="lnkGroupscoreMap@(item.MatchId)">@item.Event</span>
        <span id="lnkRefresh@(item.MatchId)" class="icon-refresh" title="@Resources.Refresh" data-matchid="@item.MatchId"></span>
        <span class="lds-spinner"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></span>
    </div>
    <div id="scoreMap@(item.MatchId)" class="tbl-ht-time">
        <div class="round haft-time">@Resources.HT</div>
        @{
            RenderMatrix(item.RowNumber, item.ColumnNumber, item.HaftTime, "tblht" + item.MatchId);
        }
        <div class="round full-time">@Resources.FT</div>
        @{
            RenderMatrix(item.RowNumber, item.ColumnNumber, item.FullTime, "tblft" + item.MatchId);
        }
    </div>
    @* if (!isRefresh)
{
@:
</div>
} *@
}
