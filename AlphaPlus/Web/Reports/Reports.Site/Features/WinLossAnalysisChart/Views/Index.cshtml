@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AlphaPlus.Reports.Site
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Core.Extensions
@using AlphaPlus.Reports.Features.WinLossAnalysisChart
@using AlphaPlus.Reports.Site
@using AlphaPlus.Reports.Site.Features.Shared.ViewModels.Components
@using AlphaPlus.Reports.Site.Features.WinLossAnalysisChart
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.PageHeader.Title;
}
@section Scripts {
    @StaticResources.AssetScripts.Render("/bundles/site-reports/winloss-analysis-chart")
    <script src="~/bundles/winlossanalysischart/winlossanalysischart.js" asp-append-version="true"></script>
}
@model WinLossAnalysisChartViewModel
<report-title model="Model.PageHeader" />
<form class="form-inline filter@(Model.PageHeader.IsFilterVisible ? string.Empty : " hide")" role="form"
    id="report-form">
    <div id="msg-error" class="msg msg-error hide">
        @Resources.Least3MonthToChart
    </div>
    <product model="@Model.ProductViewModel" />
    <month-range-picker model="@Model.MonthPicker" />
    <div class="form-group">
        <input type="submit" value="@Resources.Submit" class="btn-submit" />
    </div>
    <div class="form-group hide">
        <span id="icon-information" class="icon-information-outline"></span>
    </div>
    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage
    </div>
</form>
<div class="container-fluid">
    <div class="row report-content">
        <div class="col-xs-12 col-sm-12 col-md-8 col-lg-9 pull-right">
            <div class="chart-container">
                <dual-axis-chart model="Model.DualAxisChart" />
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-3 pull-left table-container">
            <table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover" id="tbl-report">
                <thead>
                    <tr>
                        <th>@Resources.Month</th>
                        <th>@Model.DualAxisChart.FirstDataLabel</th>
                        <th>@Model.DualAxisChart.SecondDataLabel</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ReportData.Any())
                    {
                        foreach (var data in Model.ReportData)
                        {
                            <tr>
                                <td>@Model.ToShortMonthNameAndYear(data.WinLossDate)</td>
                                <td>@data.WinLoss.FormatNumber()</td>
                                <td>@data.Turnover.FormatNumber()</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <no-information colspan="3" />
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<a class="hide" id="LoadLegendURL" asp-action="Index" asp-controller="Legends"
    asp-route-MinDate="@Model.MonthPicker.MinDate.ToShortDateWithSlash()"></a>
<input type="hidden" asp-for="IsDarkMode" />
