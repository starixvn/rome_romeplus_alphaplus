@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AlphaPlus.Reports.Site
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Reports.Features.Shared.Extensions
@using AlphaPlus.Reports.Features.CommissionByBetType
@using AlphaPlus.Reports.Site
@using AlphaPlus.Reports.Site.Features.Shared.ViewModels.Components
@using AlphaPlus.Reports.Site.Features.CommissionByBetType
@{
    Layout = "_Layout";
    ViewData["Title"] = "Commission By Bet Type";
    void RenderCellValue(CommissionByBetTypeModel commission)
    {
        <td>@commission.Comm1.FormatNumber()</td>
        <td>@commission.Comm2.FormatNumber()</td>
        <td>@commission.Comm3.FormatNumber()</td>
        if (Model.IsShowMyanmarOdds)
        {
            <td>@commission.MyanmarOddsComm.FormatNumber()</td>
        }
        <td>@commission.CasinoComm.FormatNumber()</td>
    }

    var sortIndex = 4;
}
@section Scripts {
    <script src="~/bundles/commissionbybettype/commissionbybettype.js" asp-append-version="true"></script>
}
@model CommissionByBetTypeViewModel
<report-title model="Model.PageHeader" />
<form method="get" class="form-inline filter@(Model.PageHeader.IsFilterVisible ? string.Empty : " hide")" role="form"
    id="report-form" asp-action="Index">
    <daterange-picker model="Model.DateRangePicker" />
    <div class="form-group hide">
        <span id="icon-information" class="icon-information-outline"></span>
    </div>
    <div class="form-group">
        <a class="icon-excel" title="@Resources.ExportToExcel" asp-action="Excel"
            asp-all-route-data="@Model.GetExcelParams()"></a>
    </div>
    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage
    </div>
    <input type="hidden" asp-for="CustId" />
    <input type="hidden" asp-for="CustName" />
    <input type="hidden" id="CustLevelId" name="CustLevelId" value="@Model.CustLevel.Value.ToString()" />
    <input type="hidden" name="BreadcrumbsJson" value="@Model.PageHeader.BreadcrumbLevel.BreadcrumbsJson" />
    @* <input type="hidden" asp-for="SortPropertyName" />
    <input type="hidden" asp-for="DescendingSort" /> *@
    <input type="hidden" id="IsFilterVisible" name="IsFilterVisible"
        value="@Model.PageHeader.IsFilterVisible.ToString()" />
</form>
<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover tablesorter tbl-small-width" id="tbl-report"
    data-cansort="@Model.ReportData.MoreThanOne" data-sortedcolumn="@Model.SortPropertyName"
    data-descendingsort="@Model.DescendingSort">
    <thead class="tableFloatingHeaderOriginal">
        <tr>
            <th class="sorting" data-colindex="0" data-sortedname="CustName">@Resources.Username</th>
            <th class="sorting" data-colindex="1" data-sortedname="Comm1">@Resources.Commission1</th>
            <th class="sorting" data-colindex="2" data-sortedname="Comm2">@Resources.Commission2</th>
            <th class="sorting" data-colindex="3" data-sortedname="Comm3">@Resources.Commission3</th>
            @if (Model.IsShowMyanmarOdds)
            {
                <th class="sorting" data-colindex="@sortIndex++" data-sortedname="MyanmarOddsComm">
                    @Resources.SymbolMyanmarOdds</th>
            }
            <th class="sorting" data-colindex="@sortIndex" data-sortedname="CasinoComm">@Resources.Gaming</th>
        </tr>
    </thead>
    @if (Model.ReportData.HasData)
    {
        var isAgentLevel = Model.CustLevel.IsAgentLevel();
        <tbody>
            @foreach (var commission in Model.ReportData.DataSource)
            {
                <tr>
                    @if (isAgentLevel)
                    {
                        <td class="text-left">@commission.CustName</td>
                    }
                    else
                    {
                        <td data-islink="true" class="text-left">
                            <a href="javascript:;" class="downline-link" data-custid="@commission.CustId"
                                data-custname="@commission.CustName">@commission.CustName</a>
                        </td>
                    }
                    @{
                        RenderCellValue(commission);
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="tbl-footer">
                <td class="text-left">@Resources.Total</td>
                @{
                    RenderCellValue(Model.ReportData.Total);
                }
            </tr>
        </tfoot>
    }
    else
    {
        <no-information colspan="@(Model.IsShowMyanmarOdds ? 7 : 6)" />
    }
</table>
<a class="hide" id="LoadLegendURL" asp-action="Index" asp-controller="Legends"
    asp-route-MinDate="@Model.DateRangePicker.MinDate"></a>
