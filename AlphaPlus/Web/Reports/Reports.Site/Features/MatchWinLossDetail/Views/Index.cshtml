@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AlphaPlus.Reports.Site
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Reports.Features.Shared.Extensions
@using AlphaPlus.Reports.Features.MatchWinLossDetail
@using AlphaPlus.Reports.Site
@using AlphaPlus.Reports.Site.Features.Shared.ViewModels.Components
@using AlphaPlus.Reports.Site.Features.MatchWinLossDetail
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.PageHeader.Title;
    var isSuperLevel = Model.CustLevel.IsSuperLevel();
    var isMasterOrSuperLevel = Model.CustLevel.IsMasterOrSuperLevel();

    void RenderBetTypeRow(BetTypeWinLossModel data, string betType)
    {
        <td class="text-left">@Html.Raw(betType)</td>
        if (Model.PageHeader.IsStackMode)
        {
            <td class="visible-stack-mode combinedcell col-turnover-combined">
                <ul>
                    <li>@data.Turnover.FormatNumber()</li>
                    <li>@data.GrossComm.FormatNumber()</li>
                </ul>
            </td>
            RenderStackNetWinLoss(UserLevel.Member, data.MemberWinLoss, data.MemberComm, data.MemberTotal);
            RenderStackNetWinLoss(UserLevel.Agent, data.AgWinLoss, data.AgComm, data.AgTotal);
            if (isMasterOrSuperLevel)
            {
                RenderStackNetWinLoss(UserLevel.Master, data.MAgWinLoss, data.MAgComm, data.MAgTotal);
            }
            if (isSuperLevel)
            {
                RenderStackNetWinLoss(UserLevel.Super, data.SAgWinLoss, data.SAgComm, data.SAgTotal);
            }
            <td class="visible-stack-mode combinedcell col-company-winloss-combined">
                <ul>
                    <li>@data.CompanyComm.FormatNumber()</li>
                    <li>@data.Company.FormatNumber()</li>
                </ul>
            </td>
        }
        else
        {
            <td class="hidden-stack-mode col-turnover">@data.Turnover.FormatNumber()</td>
            <td class="hidden-stack-mode">@data.GrossComm.FormatNumber()</td>
            RenderNetWinLoss(UserLevel.Member, data.MemberWinLoss, data.MemberComm, data.MemberTotal);
            RenderNetWinLoss(UserLevel.Agent, data.AgWinLoss, data.AgComm, data.AgTotal, "altercol");
            if (isMasterOrSuperLevel)
            {
                RenderNetWinLoss(UserLevel.Master, data.MAgWinLoss, data.MAgComm, data.MAgTotal);
            }
            if (isSuperLevel)
            {
                RenderNetWinLoss(UserLevel.Super, data.SAgWinLoss, data.SAgComm, data.SAgTotal, "altercol");
            }
            <td class="hidden-stack-mode col-company-winloss">@data.CompanyComm.FormatNumber()</td>
            <td class="hidden-stack-mode">@data.Company.FormatNumber()</td>
        }
    }

    void RenderNetWinLoss(UserLevel level, decimal winloss, decimal comm, decimal total, string highlightClass = "")
    {
        <td class="hidden-stack-mode col-@level.DisplayName.ToLower()-winloss @highlightClass">
            @winloss.FormatNumber()
        </td>
        <td class="hidden-stack-mode @highlightClass">
            @comm.FormatNumber()
        </td>
        <td class="hidden-stack-mode bold @highlightClass">
            @total.FormatNumber()
        </td>
    }

    void RenderStackNetWinLoss(UserLevel level, decimal winloss, decimal comm, decimal total, string highlightClass = "")
    {
        <td class="visible-stack-mode combinedcell col-@level.DisplayName.ToLowerInvariant()-winloss-combined @highlightClass">
            <ul>
                <li>@winloss.FormatNumber()</li>
                <li>@comm.FormatNumber()</li>
                <li>@total.FormatNumber()</li>
            </ul>
        </td>
    }

}
@section Styles {
    <link rel="stylesheet" href="~/bundles/matchwinlossdetail/matchwinlossdetail.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/bundles/matchwinlossdetail/matchwinlossdetail.js" asp-append-version="true"></script>
}
@model MatchWinLossDetailViewModel
<report-title model="Model.PageHeader" />
<form method="get" class="form-inline filter form-report@(Model.PageHeader.IsFilterVisible ? string.Empty : " hide")"
    role="form" id="report-form" asp-action="Index">
    <product model="@Model.ProductViewModel" />
    <daterange-picker model="Model.DateRangePicker" />
    <league model="@Model.LeagueViewModel" />
    <div class="form-group hide">
        <span id="icon-information" class="icon-information-outline"></span>
    </div>
    <div class="form-group">
        <a class="icon-excel" title="@Resources.ExportToExcel" asp-action="Excel"
            asp-all-route-data="Model.GetExcelParams()"></a>
    </div>
    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage
    </div>
</form>
<table
    class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per@(Model.PageHeader.IsStackMode ? " stack-mode" : string.Empty)"
    id="tbl-report">
    <thead>
        <tr>
            <th class="hidden-stack-mode" rowspan="2">@Resources.BetType</th>
            <th class="hidden-stack-mode" rowspan="2">@Resources.Turnover</th>
            <th class="hidden-stack-mode" rowspan="2">@Resources.GrossComm</th>
            <th class="visible-stack-mode">@Resources.BetType</th>
            <th class="visible-stack-mode">@Resources.Turnover<br />@Resources.GrossComm</th>
            <th class="hidden-stack-mode" colspan="3">@Resources.Member</th>
            <th class="visible-stack-mode col-combine">
                @Resources.Member<br />(<span>@Resources.WinLossAbbr</span>@Resources.CommAndTotal)</th>
            <th class="hidden-stack-mode" colspan="3">@Resources.Agent</th>
            <th class="visible-stack-mode col-combine">
                @Resources.Agent<br />(<span>@Resources.WinLossAbbr</span>@Resources.CommAndTotal)</th>
            @if (isMasterOrSuperLevel)
            {
                <th class="hidden-stack-mode" colspan="3">@Resources.Master</th>
                <th class="visible-stack-mode col-combine">
                    @Resources.Master<br />(<span>@Resources.WinLossAbbr</span>@Resources.CommAndTotal)</th>
            }
            @if (isSuperLevel)
            {
                <th class="hidden-stack-mode" colspan="3">@Resources.Super</th>
                <th class="visible-stack-mode col-combine">
                    @Resources.Super<br />(<span>@Resources.WinLossAbbr</span>@Resources.CommAndTotal)</th>
            }
            <th class="hidden-stack-mode" colspan="2">@Resources.Company</th>
            <th class="visible-stack-mode col-combine">@Resources.Company<br />(@Resources.Comm/@Resources.Total)</th>
        </tr>
        <tr>
            <th class="hidden-stack-mode">@Resources.WinLoss</th>
            <th class="hidden-stack-mode">@Resources.Comm</th>
            <th class="hidden-stack-mode">@Resources.Total</th>
            <th class="hidden-stack-mode">@Resources.WinLoss</th>
            <th class="hidden-stack-mode">@Resources.Comm</th>
            <th class="hidden-stack-mode">@Resources.Total</th>
            @if (isMasterOrSuperLevel)
            {
                <th class="hidden-stack-mode">@Resources.WinLoss</th>
                <th class="hidden-stack-mode">@Resources.Comm</th>
                <th class="hidden-stack-mode">@Resources.Total</th>
            }
            @if (isSuperLevel)
            {
                <th class="hidden-stack-mode">@Resources.WinLoss</th>
                <th class="hidden-stack-mode">@Resources.Comm</th>
                <th class="hidden-stack-mode">@Resources.Total</th>
            }
            <th class="hidden-stack-mode">@Resources.Comm</th>
            <th class="hidden-stack-mode">@Resources.Total</th>
        </tr>
    </thead>
    @if (Model.ReportData.HasData)
    {
        <tbody>
            <tr class="tbl-footer">
                @{
                    RenderBetTypeRow(Model.ReportData.GrandTotal, Resources.GrandTotal);
                }
            </tr>
            @foreach (var data in Model.ReportData.NormalMatchWinLoss)
            {
                <tr class="match-title-row">
                    <td class="text-left col-username" colspan="@Model.ReportColumnsCount">
                        <span class="league-title" title="@data.LeagueName">@data.LeagueName</span>
                        @if (!string.IsNullOrWhiteSpace(data.MatchName))
                        {
                            <span class="match-title">@data.MatchName</span>
                        }
                    </td>
                </tr>
                @* var isEvenRow = false; *@
                foreach (var betType in data.BetTypeWinLoss)
                {
                    <tr @*class="@(isEvenRow ? "even-row" : string.Empty)"*@>
                        @{
                            RenderBetTypeRow(betType, $"<a href=\"javascript:;\">{betType.Name}</a>");
                        }
                    </tr>
                    @* isEvenRow = !isEvenRow; *@
                }
                if (data.RenderSubTotal)
                {
                    <tr class="sub-total-row">
                        @{
                            RenderBetTypeRow(data.Total, Resources.SubTotal);
                        }
                    </tr>
                }
            }
            @if (Model.ShowTotalRow)
            {
                <tr class="tbl-footer">
                    @{
                        RenderBetTypeRow(Model.ReportData.TotalNormalMatchWinLoss, Resources.Total);
                    }
                </tr>
            }
            @if (Model.ReportData.MixParlay != null)
            {
                <tr>
                    @{
                        RenderBetTypeRow(Model.ReportData.MixParlay, $"<a href=\"javascript:;\">{Model.ReportData.MixParlay.Name}</a>");
                    }
                </tr>
            }
            @if (Model.ReportData.SystemParlay != null)
            {
                <tr>
                    @{
                        RenderBetTypeRow(Model.ReportData.SystemParlay, $"<a href=\"javascript:;\">{Model.ReportData.SystemParlay.Name}</a>");
                    }
                </tr>
            }
            @foreach (var parlay in Model.ReportData.ParlayMatchWinLoss)
            {
                <tr>
                    @{
                        RenderBetTypeRow(parlay, $"<a href=\"javascript:;\">{parlay.Name}</a>");
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="tbl-footer">
                @{
                    RenderBetTypeRow(Model.ReportData.GrandTotal, Resources.GrandTotal);
                }
            </tr>
        </tfoot>
    }
    else
    {
        <no-information colspan="@Model.ReportColumnsCount" />
    }
</table>
<a class="hide" id="LoadLegendURL" asp-action="MatchWinLossDetail" asp-controller="Legends"></a>
<a class="hide" id="LoadLeagueURL" asp-action="Leagues"></a>
<input type="hidden" asp-for="IsSetDefaultStackMode" />
