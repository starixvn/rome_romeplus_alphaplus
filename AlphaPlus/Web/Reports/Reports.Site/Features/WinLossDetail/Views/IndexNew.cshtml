@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AlphaPlus.Reports.Site
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Reports.Site
@using AlphaPlus.Reports.Site.Features.Shared.Helpers
@using AlphaPlus.Reports.Site.Features.WinLossDetail
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.PageHeader.Title;
    var isSuperLevel = Model.ViewerLevel.IsSuperLevel();
    var isMasterOrSuperLevel = Model.ViewerLevel.IsMasterOrSuperLevel();
}
@section Styles {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-reports/winlossdetail-new")
}
@section Scripts {
    <script type="text/javascript">
        var viewResources = {
            Username: '@Resources.Username',
            FirstLastName: '@Resources.FirstLastName',
            BetCount: '@Resources.BetCount',
            Turnover: '@Resources.Turnover',
            NetTurnover: '@Resources.NetTurnover',
            GrossComm: '@Resources.GrossComm',
            Member: '@Resources.Member',
            Agent: '@Resources.Agent',
        @if (isMasterOrSuperLevel)
        {
            @:Master: '@Resources.Master',
        }
        @if (isSuperLevel)
        {
            @:Super: '@Resources.Super',
        }
                    Company: '@Resources.Company',
                    WinLoss: '@Resources.WinLoss',
                    Comm: '@Resources.Comm',
                    Total: '@Resources.Total',
                    NoInformationIsAvailable: '@Resources.NoInformationIsAvailable',
                    Total: '@Resources.Total',
                    DormantAccounts: '@Resources.DormantAccounts',
                    Copy: '@Resources.Copy',
                    Copied: '@Resources.Copied',
                    SummaryOfDormantAccounts: '@Resources.SummaryOfDormantAccounts'
            };
        var reportTitle = {
            2: '@Resources.MemberWinLossDetail',
            @if (isMasterOrSuperLevel)
            {
                @:3: '@Resources.AgentWinLossDetail',
            }
            @if (isSuperLevel)
            {
                @:4: '@Resources.MasterWinLossDetail'
            }
        };
        var productList = $.parseJSON('@Html.Raw(JsonHelper.ToJson(Model.ProductViewModel.Products))');
        var productDetailList = $.parseJSON('@Html.Raw(JsonHelper.ToJson(Model.ProductViewModel.ProductDetails))');
        var columnList = [
            { value: "fullname", text: '@Resources.FirstLastName', checked: false },
            { value: "betcount", text: '@Resources.BetCount' },
            { value: "turnover", text: '@Resources.Turnover' },
            { value: "netturnover", text: '@Resources.NetTurnover' },
            { value: "grosscomm", text: '@Resources.GrossComm' },
            { value: "pwinloss", text: '@Resources.Member @Resources.WinLoss' },
            { value: "pcomm", text: '@Resources.Member @Resources.Comm' },
            { value: "ptotal", text: '@Resources.Member @Resources.Total' },
            { value: "awinloss", text: '@Resources.Agent @Resources.WinLoss' },
            { value: "acomm", text: '@Resources.Agent @Resources.Comm' },
            { value: "atotal", text: '@Resources.Agent @Resources.Total' },
        @if (isMasterOrSuperLevel)
        {
            @:{ value: "mwinloss", text: '@Resources.Master @Resources.WinLoss' },
            @:{ value: "mcomm", text: '@Resources.Master @Resources.Comm' },
            @:{ value: "mtotal", text: '@Resources.Master @Resources.Total' },
        }
        @if (isSuperLevel)
        {
            @:{ value: "swinloss", text: '@Resources.Super @Resources.WinLoss' },
            @:{ value: "scomm", text: '@Resources.Super @Resources.Comm' },
            @:{ value: "stotal", text: '@Resources.Super @Resources.Total' },
        }
            { value: "company", text: '@Resources.Company' }
        ];
        var breadcrumbLevel = $.parseJSON('@Html.Raw(Model.BreadcrumbLevel)');
        var currentFromData = {
            custId: @Model.CustId,
            custName: '@Model.CustName',
            custLevelId: @Model.CustLevelId,
            weekFromDate: '@Model.WeekFromDate',
            weekToDate: '@Model.WeekToDate'
        }
        const visibleColumns = '@Model.VisibleColumns';
        var betListUrl = '@MicroSites.TicketUrl("~/WinLoss/IndexNew")';
        var viewerLevelId = @Model.ViewerLevel.Value;
    </script>
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-reports/winlossdetail-new")
    <script src="~/bundles/winlossdetail/winlossdetail-new.js" asp-append-version="true"></script>
}
@model WinLossDetailNewViewModel
<report-title-new model="Model.PageHeader" />
<form class="form-inline filter" role="form" id="report-form">
    <div class="switch-version">
        <a class="btn-switch-version" asp-action="Index">
            <span class="icon-swap-horizontal"></span>
            <span class="text">@Resources.ClassicView</span>
        </a>
    </div>
    <daterange-picker-jquery model="@Model.DateRangePicker" />
    <product-dropdown show-product-details="true" />
    <div class="form-group">
        <label class="label-form-control">@Resources.Username</label>
        <div>
            <input type="text" id="txt-username-suggestion" placeholder="@Resources.UsernameOrFirstLastName" autocomplete="off" value="@Model.Username" />
        </div>
    </div>
    <visible-column />
    <div class="label-week-box" id="week-container"></div>
</form>
<div class="breadcrumb-table hide">
    <div class="breadcrumb-container">
        <ul class="breadcrumb" id="breadcrumb-level"></ul>
    </div>
    <div class="list-icon">
        <ul>
            <li><span id="icon-copy" class="icon icon-content-copy" data-toggle="tooltip" data-placement="top" title="@Resources.Copy"></span></li>
            <li><a id="icon-excel" class="icon icon-excel icon-excel-new" data-toggle="tooltip" data-placement="top" title="@Resources.ExportToExcel" asp-action="ExcelNew"></a></li>
        </ul>
    </div>
</div>
<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover tablesorter width-100per hide" id="tbl-report">
</table>
<a class="hide" id="LoadLegendURL" asp-action="WinLossDetail" asp-controller="Legends" asp-route-IsNew="true" asp-route-MinDate="@Model.DateRangePicker.MinDate" asp-route-ShowDormantAccountsNote="True"></a>
<a class="hide" id="hidden-usernameSuggestionUrl" asp-action="Suggest" asp-controller="Customer"></a>
