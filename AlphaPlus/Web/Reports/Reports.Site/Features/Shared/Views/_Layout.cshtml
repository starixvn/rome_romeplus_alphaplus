@inject AlphaPlus.Core.Models.IUserSession userSession
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Alpha - Reports")</title>
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-reports/default")
    <link rel="stylesheet" href="~/bundles/default.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body data-theme="@(string.IsNullOrWhiteSpace(userSession.DarkModeName) ? "light" : "dark")">
    @RenderBody()
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/ajaxSetup")
    @StaticResources.AssetScripts.Render("/bundles/site-reports/default")
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        $(document).ready(function () {
            $(".open-link").unbind().bind('click', function (event) { top.alpha.viewDataURL(event); });
        });
    </script>
</body>

</html>
