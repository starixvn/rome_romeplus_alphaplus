@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AlphaPlus.Reports.Site
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Reports.Features.Shared.Extensions
@using AlphaPlus.Reports.Features.ProgressiveContribution
@using AlphaPlus.Reports.Site
@using AlphaPlus.Reports.Site.Features.Shared.ViewModels.Components
@using AlphaPlus.Reports.Site.Features.ProgressiveContribution
@{
    Layout = "_Layout";
    ViewData["Title"] = "Progressive Games Contribution";
    var isSuperLevel = Model.ViewerLevel.IsSuperLevel();
    var isMasterLevel = Model.ViewerLevel.IsMasterLevel();
    var isMasterOrSuperLevel = Model.ViewerLevel.IsMasterOrSuperLevel();

    void RenderProgressiveContribution(ProgressiveContributionEntity data)
    {
        <td class="col-turnover">@data.Turnover.FormatNumber()</td>
        <td class="col-contribution">data.ContributionAmount.FormatNumber(4)</td>
        if (Model.IsStackMode)
        {
            if (isSuperLevel)
            {
                RenderStackContributionNumberCell(UserLevel.Super, data.SuperContribution, data.MasterContribution,
                data.AgentContribution);
            }
            else if (isMasterLevel)
            {
                RenderStackContributionNumberCell(UserLevel.Master, data.MasterContribution, data.AgentContribution);
            }
            else
            {
                RenderContributionNumberCell(UserLevel.Agent, data.AgentContribution);
            }
        }
        else
        {
            if (isSuperLevel)
            {
                RenderContributionNumberCell(UserLevel.Super, data.SuperContribution);
            }

            if (isMasterOrSuperLevel)
            {
                RenderContributionNumberCell(UserLevel.Master, data.MasterContribution);
            }

            RenderContributionNumberCell(UserLevel.Agent, data.AgentContribution);
        }

        <td class="col-company">data.CompanyContribution.FormatNumber(4)</td>
    }
    void RenderContributionNumberCell(UserLevel level, decimal value)
    {
        <td class="hidden-stack-mode col-@level.DisplayName.ToLower()-contribution-share">
            @value.FormatNumber(4)
        </td>
    }
    void RenderStackContributionNumberCell(UserLevel level, params decimal[] cellValues)
    {
        <td class="visible-stack-mode combinedcell col-@level.DisplayName.ToLower()-contribution-share-combined">
            <ul>
                @foreach (var cellValue in cellValues)
                {
                    <li>@cellValue.FormatNumber(4)</li>
                }
            </ul>
        </td>
    }

    var reportTitle = new PageHeaderViewModel(
    Title: Model.Title,
    HasStackIcon: isMasterOrSuperLevel,
    HasHideFilterIcon: true,
    IsStackMode: Model.IsStackMode,
    IsFilterVisible: true,
    BreadcrumbLevelViewModel: new BreadcrumbLevelViewModel());
}
@section Styles {
    <link rel="stylesheet" href="~/bundles/progressivecontribution/progressivecontribution.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/bundles/progressivecontribution/progressivecontribution.js" asp-append-version="true"></script>
}
@model ProgressiveContributionViewModel
<report-title model="reportTitle" />
<form method="get" class="form-inline filter" role="form" id="report-form" asp-action="Index">
    <input type="hidden" id="IsStackMode" name="IsStackMode" value="@Model.IsStackMode" />
    <input type="hidden" id="IsHistoricReport" name="IsHistoricReport" value="@Model.IsHistoricReport" />
    <product model="Model.ProductViewModel" />
    @if (Model.IsHistoricReport)
    {
        <div class="form-group">
            <input type="submit" value="@Resources.Submit" class="btn-submit" />
        </div>
    }
    else
    {
        <daterange-picker model="Model.DateRangePickerViewModel" />
    }
    <div id="icon-information-container" class="form-group">
        <span id="icon-information" class="icon-information-outline"></span>
    </div>
    <div class="form-group">
        <a class="icon-excel" title="@Resources.ExportToExcel" asp-action="Excel"></a>
    </div>
    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage
        <a id="historic-report" data-is-historic-report="@Model.IsHistoricReport.ToString().ToLower()" href="#">ABC</a>
    </div>
</form>
<table
    class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover tablesorter tbl-progressive-contribution width-100per@(Model.IsStackMode ? " stack-mode" : string.Empty)"
    id="tbl-report">
    <thead>
        <tr>
            <th rowspan="2">@Resources.Product/@Resources.BetType</th>
            <th rowspan="2">@Resources.Turnover</th>
            <th rowspan="2">@Resources.ContributionAmount</th>
            <th colspan="@Model.ContributionShareColumnsCount"
                class="@(isMasterOrSuperLevel ? "hidden-stack-mode": string.Empty)">
                @Resources.ContributionShare</th>
            @if (isMasterOrSuperLevel)
            {
                <th rowspan="2" class="visible-stack-mode col-combine">
                    @Resources.ContributionShare
                    <br />
                    @if (isMasterLevel)
                    {
                        <span>(@Resources.Master/@Resources.Agent)</span>
                    }
                    else
                    {
                        <span>(@Resources.Super/@Resources.Master/@Resources.Agent)</span>
                    }
                </th>
            }
            <th rowspan="2">@Resources.Company</th>
        </tr>
        <tr class="thead-row2">
            @if (isSuperLevel)
            {
                <th class="hidden-stack-mode">@Resources.Super</th>
            }
            @if (isMasterOrSuperLevel)
            {
                <th class="hidden-stack-mode">@Resources.Master</th>
            }
            <th class="hidden-stack-mode">@Resources.Agent</th>
        </tr>
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var data in Model.ReportData)
            {
                <tr class="product-row bold" data-product-id="@data.ProductId">
                    <td class="text-left col-username">@data.ProductName</td>
                    @{
                        RenderProgressiveContribution(data.Total);
                    }
                </tr>
                if (data.ProgressiveContributions.Any())
                {
                    foreach (var item in data.ProgressiveContributions)
                    {
                        <tr class="bet-type-row">
                            <td class="text-left col-username">@item.BetTypeName</td>
                            @{
                                RenderProgressiveContribution(item);
                            }
                        </tr>
                    }
                }
            }
        </tbody>
        <tfoot>
            <tr class="tbl-footer">
                <td class="text-left col-username">@Resources.Total</td>
                @{
                    RenderProgressiveContribution(Model.Total);
                }
            </tr>
        </tfoot>
    }
    else
    {
        <no-information colspan="Model.ReportColumnsCount" />
    }
</table>
