@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AlphaPlus.Reports.Site
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Reports.Features.Shared.Extensions
@using AlphaPlus.Reports.Features.IPMatching
@using AlphaPlus.Reports.Site
@using AlphaPlus.Reports.Site.Features.Shared.ViewModels.Components
@using AlphaPlus.Reports.Site.Features.IPMatching
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.PageHeader.Title;

    async Task RenderRow(IPMatchingModel data, bool isTotalRow)
    {
        <tr @(isTotalRow ? "class=tbl-footer" : string.Empty)>
            <td data-islink="true" class="text-left col-username">
                @if (isTotalRow)
                {
                    @Resources.Total
                }
                else
                {
                    <a class="view-bet-list" asp-area="tickets" asp-controller="RiskAnalysisIPMatching" asp-action="Index"
                        asp-route-date="@Model.Date" asp-route-ip="@data.IP">@data.IP</a>
                }
            </td>
            <td class="text-right col-member-count">@data.MemberCount.FormatNumber()</td>
            <td class="text-right col-bet-count">@data.BetCount.FormatNumber()</td>
            <td class="text-right col-member-turnover">@data.Stake.FormatNumber()</td>
            <td class="text-right col-member-winloss">@data.MemberWinLoss.FormatNumber()</td>
            <td class="text-right col-super-winloss altercol">@data.SuperWinLoss.FormatNumber()</td>
            <td class="text-right col-company">@data.Company.FormatNumber()</td>
        </tr>
    }
}
@section Scripts {
    <script src="~/bundles/ipmatching/ipmatching.js" asp-append-version="true"></script>
}
@model IPMatchingViewModel
<report-title model="Model.PageHeader" />
<form method="get" class="form-inline filter" role="form" id="report-form" asp-action="Index">
    <div class="form-group">
        <label class="txt">@Resources.Date</label>
        <div class="control date">
            <div class="input-group date" id="dpkContainer">
                <input type="text" readonly="readonly" class="form-control" asp-for="Date" />
                <span class="input-group-addon">
                    <span class="icon-calendar"></span>
                </span>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label>@Resources.MemberCount</label>
        <select name="MemberCount" asp-items="Model.MemberCounts"></select>
    </div>
    <div class="form-group">
        <input type="submit" value="@Resources.Submit" class="btn-submit" />
    </div>
    <div class="form-group">
        <a class="icon-excel" title="@Resources.ExportToExcel" asp-action="Excel"
            asp-all-route-data="Model.GetExcelParams()"></a>
    </div>
    <div class="note">
        <span class="star">*</span>@Resources.IPMatchingNote
    </div>
</form>
<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per" id="tbl-report">
    <thead>
        <tr>
            <th>@Resources.IP</th>
            <th>@Resources.MemberCount</th>
            <th>@Resources.BetCount</th>
            <th>@Resources.Stake</th>
            <th>@Resources.MemberWinLoss</th>
            <th>@Resources.SuperWinLoss</th>
            <th>@Resources.Company</th>
        </tr>
    </thead>
    @if (Model.ReportData.HasData)
    {
        <tbody>
            @foreach (var data in Model.ReportData.DataSource)
            {
                await RenderRow(data, false);
            }
        </tbody>
        <tfoot>
            @{
                await RenderRow(Model.ReportData.Total, true);
            }
        </tfoot>
    }
    else
    {
        <no-information colspan="7" />
    }
</table>
<input type="hidden" asp-for="MinDate" />
<input type="hidden" asp-for="Today" />
