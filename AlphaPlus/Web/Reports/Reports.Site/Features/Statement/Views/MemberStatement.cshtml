@{
    Layout = "_Layout";
    ViewData["Title"] = Model.PageHeader.Title;

    void RenderNegativeNumberCell(decimal? cellValue, string cssClass = "")
    {
        <span class="@(Model.IsNegative( cellValue) ? "format-negative" : string.Empty) @cssClass">
            @(cellValue.HasValue ? cellValue.Value.FormatNumber() : Resources.Symbol_NoDataNumber)
        </span>
    }
    void RenderNumberCell(decimal? cellValue)
    {
        <span>
            @(cellValue.HasValue ? cellValue.Value.FormatNumber() : Resources.Symbol_NoDataNumber)
        </span>
    }
    void RenderNullableNumber(decimal? cellValue)
    {
        @(cellValue.HasValue ? cellValue.Value.FormatNumber() : Resources.Symbol_NoDataNumber)
    }
}
@section Styles {
    <link rel="stylesheet" href="~/bundles/statement/statement.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/bundles/statement/member-statement.js" asp-append-version="true"></script>
}
@model MemberStatementViewModel
<report-title model="Model.PageHeader" />
<form class="form-inline filter@(Model.PageHeader.IsFilterVisible ? string.Empty : " hide")" role="form"
    id="report-form" asp-action="MemberStatement">
    <div class="form-group">
        <select id="dropdown-report-type">
            <option value="1" selected="selected">@Resources.DailyStatement</option>
            <option value="2" data-url="@Model.BuildBetListLink()">@Resources.BetList</option>
            <option value="3" data-url="@Model.BuildBetListRunningLink()">@Resources.BetList_Running</option>
        </select>
    </div>
    <daterange-picker model="Model.DateRangePicker" />
    <div class="form-group hide">
        <span id="icon-information" class="icon-information-outline"></span>
    </div>
    <div class="form-group">
        <a class="icon-excel" title="@Resources.ExportToExcel" asp-action="MemberStatementExcel"
            asp-all-route-data="Model.GetExcelParams()"></a>
    </div>
    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage
    </div>
    <input type="hidden" asp-for="CustId" />
    <input type="hidden" asp-for="CustName" />
    <input type="hidden" asp-for="CustLevelId" />
    <input type="hidden" asp-for="ProductIds" />
    <input type="hidden" id="IsFilterVisible" name="IsFilterVisible"
        value="@Model.PageHeader.IsFilterVisible.ToString()" />
</form>
<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per" id="tbl-report">
    <thead>
        <tr>
            <th>@Resources.Date</th>
            <th class="full-title">@Resources.OpeningBalance</th>
            <th class="short-title">@Resources.OpeningBal</th>
            <th>@Resources.Turnover</th>
            <th>@Resources.Void/@Resources.Rejected</th>
            <th>@Resources.Outstanding</th>
            <th>@Resources.WinLoss</th>
            <th class="full-title">@Resources.Commission</th>
            <th class="short-title">@Resources.Comm</th>
            <th>@Resources.GrandPrize</th>
            <th class="full-title">@Resources.TransferAmt</th>
            <th class="short-title">@Resources.Transfer</th>
            <th class="full-title">@Resources.AccumulatedTotal</th>
            <th class="short-title">@Resources.AccumTotal</th>
        </tr>
    </thead>
    @if (Model.Pager.TotalRecords > 0)
    {
        StatementModel prevStatement = null;
        <tbody>
            @foreach (var data in Model.ReportData)
            {
                var winLossDateString = data.WinLossDate.ToShortDateWithSlash();
                <tr class="hide">
                    <td class="text-center">@winLossDateString</td>
                    <td class="@(data.IsNotedBalance(prevStatement) ? "note-opening-balance" : string.Empty)">
                        @{
                            RenderNegativeNumberCell(data.OpeningBalance);
                        }
                    </td>
                    <td>@{
                            RenderNumberCell(data.Turnover);
                        }</td>
                    <td>
                        <span class="@(Model.IsNegative(data.VoidAmount) ? "format-negative" : string.Empty)
                              @(data.VoidAmount.HasValue ? " col-void-amount" : string.Empty)"
                            data-transfer-date="@winLossDateString">
                            @{
                                RenderNullableNumber(data.VoidAmount);
                            }
                        </span>
                    </td>
                    <td>
                        <span class="@(Model.IsNegative(data.Outstanding) ? "format-negative" : string.Empty)
                              @(data.Outstanding.HasValue ? " col-outstanding" : string.Empty)"
                            data-transfer-date="@winLossDateString">
                            @{
                                RenderNullableNumber(data.Outstanding);
                            }
                        </span>
                    </td>
                    <td>
                        <span class="@(Model.IsNegative(data.WinLoss) ? "format-negative" : string.Empty)
                              @(data.WinLoss.HasValue ? " col-win-loss" : string.Empty)"
                            data-transfer-date="@winLossDateString">
                            @{
                                RenderNullableNumber(data.WinLoss);
                            }
                        </span>
                    </td>
                    <td>@{
                            RenderNegativeNumberCell(data.Commission);
                        }</td>
                    <td>
                        <span class="@(Model.IsNegative(data.GrandPrize) ? "format-negative" : string.Empty)
                              @(data.GrandPrize.HasValue ? " col-grand-prize" : string.Empty)"
                            data-transfer-date="@winLossDateString">
                            @{
                                RenderNullableNumber(data.GrandPrize);
                            }
                        </span>
                    </td>
                    <td>
                        <span class=" @(data.TransferAmount.HasValue ? "column-transfer-amount" : string.Empty)
                              @(Model.IsNegative(data.TransferAmount) ? "format-negative" : string.Empty) "
                            data-transfer-date="@winLossDateString">
                            @{
                                RenderNullableNumber(data.TransferAmount);
                            }
                        </span>
                    </td>
                    <td>@{
                            RenderNegativeNumberCell(data.ClosingBalance);
                        }</td>
                </tr>
                prevStatement = data;
            }
        </tbody>
    }
    else
    {
        <no-information colspan="10" />
    }
</table>
<pager model="Model.Pager" />
<a class="hide" id="LoadLegendURL" asp-action="MemberReportLegend"></a>
<a class="hide" id="StatementDetailsURL" asp-action="StatementDetails"></a>
<input type="hidden" asp-for="BetListLink" />
<input type="hidden" id="BetListTitle" value="@Resources.BetList" />
