@{
    Layout = "_Layout";
    ViewData["Title"] = Resources.SettlementReport;
    var isSuper = Model.ViewerLevel.IsSuperLevel();
    var isMasterOrSuper = Model.ViewerLevel.IsMasterOrSuperLevel();
}
@model SettlementViewModel
@section Styles {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode($"/bundles/site-reports/tab-{Model.ViewerLevel.DisplayName.ToLowerInvariant()}")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-reports/filter-new")
    <link rel="stylesheet" href="~/bundles/whitelabel/whitelabel.css" asp-append-version="true" />
}
@section Scripts {
    <script type="text/javascript">
        var whiteLabels = JSON.parse('@Html.Raw(Model.WhiteLabelJson)');
        var columnList = [
            { value: "month", text: '@Resources.Month' },
        @if (isMasterOrSuper)
        {
            @:{ value: "whitelabel", text: '@Resources.WhiteLabel' },
            @:{ value: "agent", text: '@Resources.Agent' },
        }
        @if (isSuper)
        {
            @:{ value: "master", text: '@Resources.Master' },
        }
            { value: "memberwinloss", text: '@string.Format("{0} {1}", Resources.Member, Resources.WinLossTitle)' },
            { value: "memberpromotion", text: '@string.Format("{0} {1}", Resources.Member, Resources.Promotion)' },
            { value: "wllosscarryforward", text: '@string.Format("{0} {1}", Resources.WhiteLabel, Resources.LossCarryforward)' },
            { value: "wlwinloss", text: '@string.Format("{0} {1}", Resources.WhiteLabel, Resources.WinLossTitle)' },
            { value: "wlnetwinloss", text: '@string.Format("{0} {1}", Resources.WhiteLabel, Resources.NetWinLoss)' },
            { value: "wlgrossfee", text: '@string.Format("{0} {1}", Resources.WhiteLabel, Resources.GrossFee)' },
            { value: "wlpromotionsettlement", text: '@string.Format("{0} {1}", Resources.WhiteLabel, Resources.PromotionSettlement)' },
            { value: "wlpromotionshare", text: '@string.Format("{0} {1}", Resources.WhiteLabel, Resources.PromotionShare)' },
            { value: "wltotal", text: '@string.Format("{0} {1}", Resources.WhiteLabel, Resources.TotalFee)' },
        @if (isMasterOrSuper)
        {
            @:{ value: "masterearning", text: '@Resources.MasterEarning' },
        }
        @if (isSuper)
        {
            @:{ value: "superearning", text: '@Resources.SuperEarning' },
        }
            { value: "companyincome", text: '@string.Format("{0} {1}", Resources.Company, Resources.Income)' },
            { value: "companypromotionshare", text: '@string.Format("{0} {1}", Resources.Company, Resources.PromotionShare)' },
            { value: "companytotal", text: '@string.Format("{0} {1}", Resources.Company, Resources.Total)' }
        ];
    </script>
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-reports/filter-new")
    <script src="~/bundles/whitelabel/settlement.js" asp-append-version="true"></script>
}
<div class="page-title tabs">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="active">
            <a href="#settlement" aria-controls="home" role="tab" data-toggle="tab">@Resources.SettlementReport</a>
        </li>
        <li role="presentation">
            <a asp-controller="WhiteLabel" asp-action="DailyWinLoss">@Resources.DailyWinLossReport</a>
        </li>
    </ul>
    <div class="list-icon">
        <ul>
            <li class="showfilter-element"><span class="icon-arrow-up-drop-circle icon-filter"
                    title="@Resources.HideFilter"></span></li>
            <li class="hidefilter-element"><span class="icon-arrow-down-drop-circle icon-filter"
                    title="@Resources.ShowFilter"></span></li>
        </ul>
    </div>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active" id="settlement">
        <div class="form-inline filter" id="report-form">
            <month-range-picker model="@Model.MonthPicker" />
            @if (isMasterOrSuper)
            {
                <div class="form-group">
                    <label class="label-form-control">@Resources.WhiteLabel</label>
                    <div class="select-multiple" id="dropdown-whitelabel" data-label-selectall="@Resources.SelectAll"
                        data-label-selected="@Resources.Selected" data-label-noneselected="@Resources.NoneSelected"
                        data-label-all="@Resources.All" data-label-nodatatext="@Resources.NoInformationIsAvailable"
                        data-label-filterplaceholder="@Resources.Search"></div>
                </div>
                <username-autosuggestion value="@Model.Username" />
            }
            <visible-column />
            <div class="form-group">
                <label class="label-form-control">&nbsp;</label>
                <a asp-controller="WhiteLabel" asp-action="SettlementExcel" id="icon-excel"
                    class="icon icon-excel icon-excel-new" data-toggle="tooltip" data-placement="top"
                    title="@Resources.ExportToExcel"></a>
            </div>
        </div>
        <div style="width: fit-content">
            <div class="msg msg-warning" id="settlement-note">@Resources.WhiteLabelSettlementNote</div>
            <div id="tbl-report-container" style="visibility: hidden;">
                <partial name="SettlementData" model="Model" />
            </div>
        </div>
    </div>
</div>
<a class="hide" id="hidden-getDataUrl" asp-controller="WhiteLabel" asp-action="GetSettlementData"></a>
<a class="hide" id="hidden-usernameSuggestionUrl" asp-action="Suggest" asp-controller="Customer"></a>
