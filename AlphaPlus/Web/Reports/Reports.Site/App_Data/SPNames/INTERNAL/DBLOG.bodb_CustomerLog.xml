      <Mapping DataField="ActionNameEN" ObjectProperty="EnglishName" />
      <Mapping DataField="ActionNameCH" ObjectProperty="ChineseTraditionalName" />
      <Mapping DataField="ActionNameCS" ObjectProperty="ChineseSimplifiedName" />
      <Mapping DataField="ActionNameJP" ObjectProperty="JapaneseName" />
      <Mapping DataField="ActionNameVI" ObjectProperty="VietnameseName" />
      <Mapping DataField="ActionNameTH" ObjectProperty="ThaiName" />
      <Mapping DataField="ActionNameKO" ObjectProperty="KoreanName" />

      <Mapping DataField="IsInternal" ObjectProperty="IsInternal" />
      <Mapping DataField="SPName" ObjectProperty="SPName" />
    </Setting>
  </Function>
</Functions>