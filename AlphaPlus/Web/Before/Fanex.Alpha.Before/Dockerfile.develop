FROM hub.nexdev.net/base/dotnet/core/sdk:8.0-alpine AS builder
ENV ASPNETCORE_ENVIRONMENT=Development
ENV DOTNET_USE_POLLING_FILE_WATCHER=true
EXPOSE 5000
WORKDIR /src

COPY ["Modules/AlphaPlus.RequestInfo/AlphaPlus.RequestInfo.csproj", "Modules/AlphaPlus.RequestInfo/"]
COPY ["Web/Before/Fanex.Alpha.Before/Fanex.Alpha.Before.csproj", "Web/Before/Fanex.Alpha.Before/"]
COPY ["NuGet.config", "NuGet.config"]

RUN dotnet restore "Web/Before/Fanex.Alpha.Before/Fanex.Alpha.Before.csproj"

COPY . .
WORKDIR "/src/Web/Before/Fanex.Alpha.Before"
RUN dotnet build "Fanex.Alpha.Before.csproj" -r linux-x64 -c Debug

ENTRYPOINT ["dotnet", "run", "--no-build", "--no-launch-profile", "-c", "Debug", "--"]