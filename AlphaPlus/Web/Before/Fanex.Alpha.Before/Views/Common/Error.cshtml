@using Fanex.Alpha.Before.Resources
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Error!!!!!</title>
    <link href="~/assets/bundles/themes/error@(ViewData["DarkModeName"]).min.css" rel="stylesheet" />
</head>
<body>
    <center>
        <div class="ErrorBg">
            &nbsp;
        </div>
        <div class="err-txt">
            <h3>
                @ViewBag.ErrorMessage
            </h3>
            <h3>@Html.Raw(string.Format(Labels.GoBackToLoginPage, "//" + Context.Request.Host + Context.Request.PathBase))</h3>
        </div>
    </center>
</body>
</html>
