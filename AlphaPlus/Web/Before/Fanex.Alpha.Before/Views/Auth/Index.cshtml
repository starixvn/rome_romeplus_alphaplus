@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var darkModeName = (string)ViewData["DarkModeName"];
}

@model Fanex.Alpha.Before.Models.SignInResult

@section styles
{
    <link href="~/assets/bundles/themes/@(Model.LoginTemplate)@(darkModeName).min.css?v=20250313" rel="stylesheet" />
    <link href="~/assets/bundles/alpha.slider-captcha.css" rel="stylesheet" asp-append-version="true" />
}

<div class="head-form-login">
    <div class="box-lang">
        <div class="switch-mode-box">
            <span class="switch-mode @(string.IsNullOrWhiteSpace(darkModeName) ? string.Empty : "dark-mode")"
                id="icon-switch-mode"></span>
        </div>
        <div class="dropdown">
            <span class="btn dropdown-toggle" type="button" id="langList" data-toggle="dropdown" aria-haspopup="true"
                aria-expanded="true">
                <span class="flag" id="flag"></span>
                <span id="lblLanguage">English</span>
                <span class="caret"></span>
                <input type="hidden" value="en-US" id="hidLanguage" name="hidLanguage">
            </span>
            <ul class="dropdown-menu" aria-labelledby="langList" id="language-ddl">
                <li><a href="javascript:;"><span class="flag flag-en" data-language-code="en-US"></span>English</a></li>
                <li><a href="javascript:;"><span class="flag flag-tw" data-language-code="zh-TW"></span>繁體中文</a></li>
                <li><a href="javascript:;"><span class="flag flag-cn" data-language-code="zh-CN"></span>简体中文</a></li>
                <li><a href="javascript:;"><span class="flag flag-jp" data-language-code="ja-JP"></span>日本語</a></li>
                <li><a href="javascript:;"><span class="flag flag-th" data-language-code="th-TH"></span>ภาษาไทย</a></li>
                <li><a href="javascript:;"><span class="flag flag-kr" data-language-code="ko-KR"></span>한국어</a></li>
                @if (!AppSetting.DisabledVietnamese)
                {
                    <li><a href="javascript:;"><span class="flag flag-vn" data-language-code="vi-VN"></span>Tiếng Việt</a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <h1 class="title login-text">Login</h1>
</div>
@if (AppSetting.IsShowTechnicalErrorMessage)
{
    <div class="rowlg msg-error" id="divTechnicalErrorMsg"></div>
}
@if (Model.ErrCode != -1)
{
    <div class="rowlg msg-error" errCode="@Model.ErrCode" id="errmsg">@Model.ErrMsg</div>
}
@if (Model.IsChangedPassword)
{
    <div class="warning">
        @Html.Raw(Model.ChangedPasswordTime)
    </div>
}
<div id="verifyRegion" style="@(Model.IsVerified ? "display: none;" : string.Empty)">
    <div class="rowlg">
        <label class="label" id="labelUsername" style="display: none;">Username</label>
        <input type="text" class="txt" placeholder="Username" id="txtUserName" name="txtUserName"
            value="@Model.Username" tabindex="1" maxlength="50" />
        <i class="icon-user"></i>
    </div>
    <div>
        <input type="button" class="btnLogin" value="Login" id="btnVerify" tabindex="5" />
    </div>
</div>
<div style="@(Model.IsVerified ? string.Empty : "display: none;")" id="loginRegion">
    <div class="rowlg">
        <figure class="avatar">
            <img src='@(!string.IsNullOrEmpty(Model.Avatar) ? Model.Avatar : Url.Content("~/assets/images/icon_user_default.png"))'
                alt="Avatar" id="avatar" />
            <figcaption><span class="username" id="username">@Model.Username</span></figcaption>
        </figure>
    </div>

    <div class="rowlg warningMessage" id="warningMessage">Do not proceed if this is not your
        profile picture.
    </div>

    <div class="rowlg">
        <label class="label" id="labelPassword" style="display: none;">Password</label>
        <input type="password" class="txt" placeholder="Password" id="txtPassWord" name="txtPassWord" tabindex="2"
            autocomplete="off" />
        <i class="icon-lock"></i>
    </div>

    <div class="rowlg checkbox">
        <label>
            <input name="chb-showpass" type="checkbox" id="chbShowPass" tabindex="3" />
            <span id="lbShowPass">Show password</span>
        </label>
    </div>
    <div class="list-button">
        <input type="button" class="btnLogin" value="Back" id="btnBack" tabindex="5" />
        <input type="button" class="btnLogin" value="Login" id="btnLogin" tabindex="5" />
    </div>
</div>


<div id="captcha" name="captchaToken"></div>
<input type="hidden" name="browserSize" id="browserSize" value="" />
<input type="hidden" name="assetAppPath" id="assetAppPath" value="" />
<input type="hidden" name="dcsStaticAppPath" id="dcsStaticAppPath" value="" />
@if (AppSetting.IsShowTechnicalErrorMessage)
{
    <input type="hidden" id="hiddenTechnicalErrorTime" value="@AppSetting.TechnicalErrorTime" />
}

<input type="hidden" id="isVerified" value="@(Model.IsVerified ? 1 : 0)" />
<input type="hidden" id="hiddenAssetAppPaths" value="@Model.AssetAppPaths" />
<input type="hidden" id="hiddenDCSStaticAppPaths" value="@Model.DCSStaticAppPaths" />

@if (Model.ErrCode == Fanex.Alpha.Before.Constants.SignInErrorContants.CaptchaRequired)
{
    @Html.Hidden("NoInteractionTimeInMinutes", Model.NoInteractionTimeInMinutes)

    @section scripts
    {
        <script src="~/assets/bundles/alpha.slider-captcha.js" type="text/javascript" asp-append-version="true"></script>
        <script>
            var noInteractionTimeInMinutes = parseInt(document.getElementById("NoInteractionTimeInMinutes").value);
            setTimeout(
                function () {
                    window.location.href = window.location.href;
                }, noInteractionTimeInMinutes * 60 * 1000);

            window.scInstance = sliderCaptcha('captcha', {
                lang: "@AppSession.Language",
                baseUri: "@Url.Content("~/")",
                keyElement: document.getElementById('txtUserName'),
                callback: function (response) {
                    if (response.Code === 0) {
                        $('#errmsg').text('');
                    }
                }
            });
        </script>
    }
}
