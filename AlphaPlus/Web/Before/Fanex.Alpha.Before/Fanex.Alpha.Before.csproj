<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Resources\Labels.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Labels.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Labels.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Labels.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\**\*;">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fanex.Caching.Redis.AspNetCore" Version="2.2.3" />
    <PackageReference Include="Fanex.Common" Version="1.1.1" />
    <PackageReference Include="Fanex.Data.Repository" Version="4.2.2" />
    <PackageReference Include="FPS.Browserless.Detection.Client.NetStandard" Version="1.0.4" />
    <PackageReference Include="FPS.Client.NetStandard" Version="1.0.9" />
    <PackageReference Include="FPS.Device.FingerPrint.Net.Standard.Client" Version="1.0.3" />
    <PackageReference Include="JavaScriptEngineSwitcher.Extensions.MsDependencyInjection" Version="3.21.0" />
    <PackageReference Include="JavaScriptEngineSwitcher.V8" Version="3.21.3" />
    <PackageReference Include="LigerShark.WebOptimizer.Sass" Version="3.0.99" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="7.0.2" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-arm" Version="7.4.2" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-arm64" Version="7.4.2" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="7.4.2" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.4.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="7.0.3" />
    <PackageReference Include="TelegramBot.Client" Version="1.0.1" />
    <PackageReference Include="Fanex.Cryptography.Aes" Version="1.0.0.6" />
    <PackageReference Include="UAParser" Version="3.1.47" />
    <PackageReference Include="Alpha.SliderCaptcha.AspNetCore" Version="1.0.1" />
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.2.2" />
    <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.0.0" />
    <PackageReference Include="Fanex.Logging.Extensions.Database" Version="1.0.8" />
    <PackageReference Include="Fanex.Logging.RabbitMQ" Version="1.0.1" />
    <PackageReference Include="Fanex.Logging.Sentry" Version="1.0.6" />
    <PackageReference Include="ONEbook.UM.AspNetCore" Version="3.1.0" />
    <PackageReference Include="ONEbook.UM.AspNetCore.Filters" Version="3.1.0" />
    <PackageReference Include="ONEbook.UM.Transport" Version="3.1.1" />
  </ItemGroup>
</Project>