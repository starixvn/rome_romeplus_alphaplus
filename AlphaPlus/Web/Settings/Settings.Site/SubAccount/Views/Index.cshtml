@{
    Layout = "~/SubAccount/Views/_Layout.cshtml";
    var index = 0;
}
@model IEnumerable<SubAccountViewModel>
<div>
    <main role="main" class="pb-3">
        <div class="title-page">
            <span class="txt-title">Sub Account</span>
            <button class="btn-refresh btn-add" id="btn-add">Add Sub Account</button>
        </div>
        <table class="tblRpt">
            <thead class="RptHeader">
                <td>#</td>
                <td>Username</td>
                <td>Nickname</td>
                <td>Firstname</td>
                <td>Lastname</td>
                <td>Created Date</td>
                <td>Member Information</td>
                <td>Bets & Forecast</td>
                <td>Reports</td>
                <td>Bet Lists</td>
                <td>Transfer</td>
                <td>View Log</td>
                <td>Edit</td>
                <td>Password</td>
                <td>Security Code</td>
                <td>Remove OTP</td>
            </thead>
            <tbody>
            @foreach (var subAcc in Model)
            {
                ++index;
                <tr>
                    <td>@index</td>
                    <td>@subAcc.Username</td>
                    <td>@subAcc.Nickname</td>
                    <td>@subAcc.Firstname</td>
                    <td>@subAcc.Lastname</td>
                    <td class="c">@subAcc.CreateDate</td>
                    <td class="c"><div class="pMemInfo" data-subaccid="@subAcc.SubAccId" data-pageaccess="@subAcc.MemberInfoPermission">@subAcc.GetPermission()</div></td>
                    <td class="c"><input id="@(subAcc.SubAccId + "-D")" type="checkbox" class="pageaccess" data-subaccid="@subAcc.SubAccId" data-pageaccess="@subAcc.MemberInfoPermission" @(subAcc.HasBetsForecastPermission ? "checked" : string.Empty) /></td>
                    <td class="c"><input id="@(subAcc.SubAccId + "-E")" type="checkbox" class="pageaccess" data-subaccid="@subAcc.SubAccId" data-pageaccess="@subAcc.MemberInfoPermission" @(subAcc.HasReportPermission ? "checked" : string.Empty) /></td>
                    <td class="c"><input id="@(subAcc.SubAccId + "-L")" type="checkbox" class="pageaccess" data-subaccid="@subAcc.SubAccId" data-pageaccess="@subAcc.MemberInfoPermission" @(subAcc.HasBetlistPermission ? "checked" : string.Empty) /></td>
                    <td class="c"><input id="@(subAcc.SubAccId + "-C")" type="checkbox" class="pageaccess" data-subaccid="@subAcc.SubAccId" data-pageaccess="@subAcc.MemberInfoPermission" @(subAcc.HasTransferPermission ? "checked" : string.Empty) /></td>
                    <td class="c"><input id="@(subAcc.SubAccId + "-G")" type="checkbox" class="pageaccess" data-subaccid="@subAcc.SubAccId" data-pageaccess="@subAcc.MemberInfoPermission" @(subAcc.HasViewLogPermission ? "checked" : string.Empty) /></td>
                    <td class="c"><span class="icon-edit info" data-subaccid="@subAcc.SubAccId" data-username="@subAcc.Username">&nbsp;</span></td>
                    <td class="c"><span class="icon-edit pwd" data-subaccid="@subAcc.SubAccId" data-username="@subAcc.Username">&nbsp;</span></td>
                    <td class="c"><span class="icon-edit sc" data-subaccid="@subAcc.SubAccId" data-username="@subAcc.Username">&nbsp;</span></td>
                    <td class="c"><span class="icon-edit otp" data-subaccid="@subAcc.SubAccId" data-username="@subAcc.Username">&nbsp;</span></td>
                </tr>
            }
            </tbody>
        </table>
        @Html.AntiForgeryToken()
    </main>
</div>