@{
    Layout = "~/SubAccount/Views/_Layout.cshtml";
    var index = 0;
}
@model IEnumerable<SubAccountViewModel>
<div>
    <main role="main" class="pb-3">
        <div class="title-page">
            <span class="txt-title">Sub Account</span>
            <button class="btn-refresh btn-add" id="btn-add">Add Sub Account</button>
        </div>
        <table class="tblRpt">
            <thead class="RptHeader">
                <td>#</td>
                <td>Username</td>
                <td>Nickname</td>
                <td>Firstname</td>
                <td>Lastname</td>
                <td>Created Date</td>
                <td>Member Information</td>
                <td>Bets & Forecast</td>
                <td>Reports</td>
                <td>Bet Lists</td>
                <td>Transfer</td>
                <td>View Log</td>
                <td>Edit</td>
                <td>Password</td>
                <td>Security Code</td>
                <td>Remove OTP</td>
            </thead>
            <tbody>
            @foreach (var subAcc in Model)
            {
                ++index;
                <tr>
                    <td>@index</td>
                    <td>@subAcc.Username</td>
                    <td>@subAcc.Nickname</td>
                    <td>@subAcc.Firstname</td>
                    <td>@subAcc.Lastname</td>
                    <td class="c">@subAcc.CreateDate</td>
                    <td class="c"><div class="pMemInfo">@subAcc.GetPermission()</div></td>
                    <td class="c"><input type="checkbox" value="[D]" @(subAcc.HasBetsForecastPermission ? "checked" : string.Empty) /></td>
                    <td class="c"><input type="checkbox" value="[E]" @(subAcc.HasReportPermission ? "checked" : string.Empty) /></td>
                    <td class="c"><input type="checkbox" value="[L]" @(subAcc.HasBetlistPermission ? "checked" : string.Empty) /></td>
                    <td class="c"><input type="checkbox" value="[C]" @(subAcc.HasTransferPermission ? "checked" : string.Empty) /></td>
                    <td class="c"><input type="checkbox" value="[G]" @(subAcc.HasViewLogPermission ? "checked" : string.Empty) /></td>
                    <td class="c"><span class="icon-edit" id="info" data-subaccid="@subAcc.SubAccId">&nbsp;</span></td>
                    <td class="c"><span class="icon-edit" id="pwd" data-subaccid="@subAcc.SubAccId">&nbsp;</span></td>
                    <td class="c"><span class="icon-edit" id="sc" data-subaccid="@subAcc.SubAccId">&nbsp;</span></td>
                    <td class="c"><span class="icon-edit" id="otp" data-subaccid="@subAcc.SubAccId">&nbsp;</span></td>
                </tr>
            }
            </tbody>
        </table>
    </main>
</div>