@model SubAccountViewModel
@{
    Layout = "~/SubAccount/Views/_Layout.cshtml";
}
<div class="container">
    <main role="main" class="pb-3">
        <div id="errMsg" style="display: none;"></div>
        <table class="tblPop width-100per">
            @if (Model.SubAccId != 0)
            {
                <tr>
                    <td>Username</td>
                    <td><input disabled type="text" value="@Model.Username" /></td>
                </tr>
                <tr>
                    <td>Firstname</td>
                    <td><input type="text" value="@Model.Firstname" id="txtFirstname" /></td>
                </tr>
                <tr>
                    <td>Lastname</td>
                    <td><input type="text" value="@Model.Lastname" id="txtLastname" /></td>
                </tr>
                <tr>
                    <td>Status-Closed</td>
                    <td><input id="chkClosed" type="checkbox" @(Model.Closed ? "checked" : string.Empty) /></td>
                </tr>
                <tr>
                    <td></td>
                    <td><input type="button" id="btnEdit" class="btnSubmit" value="Submit ">
                        <input type="button" id="btn-reset" class="btn btn-reset" value="Reset">
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="2">There is no information is available.</td>
                </tr>
            }
        </table>
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.SubAccId)
        @Html.HiddenFor(m => m.Firstname)
        @Html.HiddenFor(m => m.Lastname)
        @Html.HiddenFor(m => m.Closed)
    </main>
</div>
