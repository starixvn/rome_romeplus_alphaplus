<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H],[L]"
  custIdQueryStringParamNameMapping="custid,CustId,custId"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer"
  ignoreUrls=""
  cachedExpireTime="30"
  kickOutUrl="~/default/kickout">
  <!--
    [A]: Create
    [B]: Update
    [C]: Transfer
    [D]: Total Bets
    [E]: Reports
    [F]: Forcast
    [H]: Member Information
    [G]: View Log
    [L]: Bet Lists
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="[C]" mainfuncname="CashBalanceTransfer" subfuncname="Cash Balance Transfer" url="CashBalanceTransfer/CashBalance" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.02" permission="[C]" mainfuncname="TransferAllAndClearCredit" subfuncname="Transfer All and Clear Credit" url="TransferAllAndClearCredit" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.03" permission="[C]" mainfuncname="MultipleTransfer" subfuncname="Multiple Transfer" url="MultipleTransfer" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.04" permission="[C]" mainfuncname="AutoTransfer" subfuncname="Auto Transfe" url="AutoTransfer" ischeckbelonging="true" isallowtodobythemselves="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>