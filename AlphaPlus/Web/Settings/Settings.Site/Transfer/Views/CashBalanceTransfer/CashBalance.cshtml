@using AlphaPlus.Core.Helpers
@using AlphaPlus.Settings.Transfer.API.AppResources
@using AlphaPlus.Settings.Site.MemberInfo.Helpers
@{
    Layout = null;
}
@using AlphaPlus.Settings.Site.Transfer.ViewModels.CashBalanceTransfer;
@model CashBalanceTransferViewModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@Resources.TransferButton</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.RenderStylesWithDarkMode("~/Transfer/assets/bundles/cash-balance-transfer")
</head>
<body>
    @if (Model == null)
    {
        <div class="container-fluid cash-balance">
            <div class="msg-content">
                <div class="msg msg-error">Error Msg</div>
            </div>
        </div>
    }
    else
    {
        <div class="container-fluid cash-balance">
            <div id="status-message" class="msg-content hidden">
                <div id="status-message-content" class="msg msg-error"></div>
            </div>
            <div class="section">
                <div class="row">
                    <div class="col-xs-5 col-sm-3 col-lg-2 ex-text">@Model.UplineLevelName @Resources.CashBalance:</div>
                    <div class="col-xs-7 col-sm-9 col-lg-10">@HtmlHelpers.FormatNumber(Model.UplineCashBalance)</div>
                </div>
            </div>
            <div class="section">
                <div class="row">
                    <div class="col-xs-12 ex-text">@Model.CustLevelName @Resources.Information:</div>
                </div>
                <div class="row">
                    <div class="col-xs-5 col-sm-3 col-lg-2">@Resources.Username</div>
                    <div class="col-xs-7 col-sm-9 col-lg-10">@Model.UserName</div>
                </div>
                <div class="row">
                    <div class="col-xs-5 col-sm-3 col-lg-2">@Resources.CashBalance</div>
                    <div class="col-xs-7 col-sm-9 col-lg-10">@HtmlHelpers.FormatNumber(Model.CashBalance)</div>
                </div>
                <div class="row">
                    <div class="col-xs-5 col-sm-3 col-lg-2">@Resources.OutstandingShortcut</div>
                    <div class="col-xs-7 col-sm-9 col-lg-10">@HtmlHelpers.FormatNumber(Model.Outstanding)</div>
                </div>
                <div class="row">
                    <div class="col-xs-5 col-sm-3 col-lg-2">@Resources.pendingTransfer3rd</div>
                    <div class="col-xs-7 col-sm-9 col-lg-10">@HtmlHelpers.FormatNumber(Model.PendingTransfer3rd)</div>
                </div>
                <div class="row">
                    <div class="col-xs-5 col-sm-3 col-lg-2">@Resources.GivenCredit</div>
                    <div class="col-xs-7 col-sm-9 col-lg-10">@HtmlHelpers.FormatNumber(Model.GivenCredit)</div>
                </div>
            </div>
            <div class="section">
                <div class="row">
                    @using (Html.BeginForm("CashBalance", "CashBalanceTransfer", FormMethod.Post, new { @class = "form-inline col-xs-12", role = "form", id = "form-transfer" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label for="amount">@Resources.Amount</label>
                            <input type="text" class="textbox hasBorder text-right" id="amount" maxlength="22" autocomplete="off">
                            <button type="submit" class="btn-submit" @(Model.DisableTransfer ? "disabled=disabled" : string.Empty)>@Resources.TransferButton</button>
                        </div>
                    }
                </div>
                <div class="row">
                    <div class="col-xs-12 note">@Model.Hint</div>
                </div>
            </div>
        </div>
        <input type="hidden" id="custId" value="@Model.CustId" />
        <input type="hidden" id="availableAmountFrom" value="@Model.TransferAmountFrom" />
        <input type="hidden" id="availableAmountTo" value="@Model.TransferAmountTo" />
        <input type="hidden" id="availableRangeTransfer" value="@Model.AvailableRangeTransfer" />
        <input type="hidden" id="confirmTransfer" value="@Resources.ConfirmTransfer" />
        <input type="hidden" id="transferAmountIs" value="@Resources.TransferAmountIs" />
        <input type="hidden" id="invalidValue" value="@Resources.InvalidValue" />
        @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
        @StaticResources.RenderScripts("~/Transfer/assets/bundles/cash-balance-transfer/cash-balance")
    }
</body>
</html>
