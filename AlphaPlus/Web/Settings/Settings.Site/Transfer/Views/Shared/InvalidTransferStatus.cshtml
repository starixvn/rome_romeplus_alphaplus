@using AlphaPlus.Shared.AppResources.Settings.Transfer
@{
    ViewBag.Title = Resources.NoInformationIsAvailable;
}
<input type="hidden" id="hiddenError" value="@Resources.DisallowedAllDayBalanceTransferError" />
@section Scripts {
    <script type="text/javascript">
        window.top.bootboxAlert($("#hiddenError").val(), null, window.top.headerNav.reloadPage);
        window.location.href = window.top.alpha.urls.mainRootPath + "Dashboard/Index";
    </script>
}