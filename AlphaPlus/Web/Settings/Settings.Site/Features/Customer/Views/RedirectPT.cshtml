@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
@using Newtonsoft.Json
@model RedirectPTViewModel
@{
    var index = 0;
}
<!DOCTYPE html>
<html>

<head>
    <title></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    @StaticResources.RenderStylesWithDarkMode("~/bundles/redirectpt/index")
    @StaticResources.AssetStyles.Render("/bundles/common/icon-common")
</head>

<body>
    <div class="product-list">
        <ul class="tab-list dragscroll" id="tab-list">
            @foreach (var product in Model.ProductList)
            {
                <li class="@(index == 0 ? "current" : string.Empty)"><a href="#" onclick="ActiveMenuTab(@index);"
                        data-url="@product.URL"><span>@product.Name</span></a></li>
                ++index;
            }
        </ul>
        <div class="list-action">
            <span class="icon-previous" title="@Lang.previous"></span>
            <span class="icon-next" title="@Lang.next"></span>
            <span id="icon-more" class="icon-more" title="@Lang.QuickSearch"></span>
        </div>
    </div>
    <div class="search-product hide" id="search-product">
        <input id="txt-search" placeholder="@Lang.search" />
    </div>
    <div class="content-main">
        <iframe src="@Model.UrlMainPage" id="frmmain" name="frmmain" scrolling="auto" noresize="noresize"
            frameborder="0"></iframe>
    </div>
    <script type="text/javascript">
        var productList = @Html.Raw(JsonConvert.SerializeObject(Model.ProductList.Select(product => product.Name)));
        var customerId = @AlphaPlus.Core.Helpers.AlphaContext.Current.Request.Query["custid"];
    </script>
    @StaticResources.RenderScripts("~/bundles/redirectpt/tabpt")
    @StaticResources.RenderScripts("~/bundles/redirectpt/index")
    <script type="text/javascript">
        var contentMain = $(".content-main");
        contentMain.attr('height', $(window).height() - 35 + "px");
        function ActiveMenuTab(index) {
            tabPT.chooseProduct(index);
        }
    </script>
</body>

</html>
