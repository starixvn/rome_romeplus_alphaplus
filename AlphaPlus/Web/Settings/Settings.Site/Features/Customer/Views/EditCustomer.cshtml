@model EditCustomerViewModel
@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@(Model.CdnUri)edit-customer/index.css" asp-append-version="true" />
}

<div class="tab-content">
    <div role="tabpanel" class="tab-pane active">
        @Html.AntiForgeryToken()
        <div id="root"></div>
    </div>
</div>
@section Scripts {
    <script type="text/javascript">
        const appConfig = @Html.Raw(Model.AppConfig);
        const params = @Html.Raw(Model.Params);
    </script>
    <environment include="Development,Production">
        <script type="module" src="@(Model.CdnUri)edit-customer/index.js" asp-append-version="true"></script>
    </environment>
