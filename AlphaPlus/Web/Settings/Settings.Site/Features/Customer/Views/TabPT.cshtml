@using AlphaPlus.Products.Models
@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
@using Newtonsoft.Json
@model IEnumerable<SettingProductTab>
@{
    var index = 0;
}
@StaticResources.RenderStylesWithDarkMode("~/bundles/redirectpt/index")
<div class="product-list">
    <ul class="tab-list dragscroll" id="tab-list">
        @foreach (var product in Model)
        {
        <li id="IdCurr@(index)" class="@(index == 0 ? "current" : string.Empty)"><a href="#" onclick="ActiveMenuTab(@index);" data-url="@product.URL"><span>@product.Name</span></a></li>
        ++index;
        }
    </ul>
    <div class="list-action">
        <span class="icon-previous" title="@Lang.previous"></span>
        <span class="icon-next" title="@Lang.next"></span>
        <span id="icon-more" class="icon-more" title="@Lang.QuickSearch"></span>
    </div>
</div>
<script type="text/javascript">
    var productList = @Html.Raw(JsonConvert.SerializeObject(Model.Select(product => product.Name)));
    var customerId = @AlphaContext.Current.Request.Query["custid"];
</script>
@StaticResources.RenderScripts("~/bundles/redirectpt/tabpt")
<script type="text/javascript">
    function ActiveMenuTab(index) {
        tabPT.chooseProduct(index);
    }
</script>
