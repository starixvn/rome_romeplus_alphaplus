@using AlphaPlus.Core.Models
@model SubAccountViewModel
@{
    Layout = "~/Features/SubAccount/Views/_Layout.cshtml";
}
<div class="container">
    <main role="main" class="pb-3">
        <div id="errMsg" style="display: none;"></div>
        <table class="tblPop width-100per">
            <tr>
                <td>Username</td>
                <td>@Model.Username @Html.DropDownList("FirstOptions.Value", Model.FirstOptions) @Html.DropDownList("NextOptions.Value", Model.NextOptions)</td>
            </tr>
            <tr>
                <td>Password</td>
                <td><input type="password" id="txtPwd" /></td>
            </tr>
            <tr>
                <td>Firstname</td>
                <td><input type="text" value="@Model.Firstname" id="txtFname" /></td>
            </tr>
            <tr>
                <td>Lastname</td>
                <td><input type="text" value="@Model.Lastname" id="txtLname" /></td>
            </tr>
        </table>
        <div>Account Permission</div>
        <table class="tblRpt">
            <thead class="RptHeader">
                <td>Member Information</td>
                <td>Bets & Forecast</td>
                <td>Reports</td>
                <td>Bet Lists</td>
                <td>Transfer</td>
                <td>View Log</td>
            </thead>
            <tbody>
                <tr>
                    <td class="c">
                        <div class="MemInfo" data-subaccid="@Model.SubAccId"
                                data-pageaccess="@Model.MemberInfoPermission" >@Model.GetPermission()</div>
                    </td>
                    <td class="c"><input id="@(Model.SubAccId + "-D")" type="checkbox" class="pageaccess"
                            data-subaccid="@Model.SubAccId" data-pageaccess="@Model.MemberInfoPermission" /></td>
                    <td class="c"><input id="@(Model.SubAccId + "-E")" type="checkbox" class="pageaccess"
                            data-subaccid="@Model.SubAccId" data-pageaccess="@Model.MemberInfoPermission" /></td>
                    <td class="c"><input id="@(Model.SubAccId + "-L")" type="checkbox" class="pageaccess"
                            data-subaccid="@Model.SubAccId" data-pageaccess="@Model.MemberInfoPermission" /></td>
                    <td class="c"><input id="@(Model.SubAccId + "-C")" type="checkbox" class="pageaccess"
                            data-subaccid="@Model.SubAccId" data-pageaccess="@Model.MemberInfoPermission" /></td>
                    <td class="c"><input id="@(Model.SubAccId + "-G")" type="checkbox" class="pageaccess"
                            data-subaccid="@Model.SubAccId" data-pageaccess="@Model.MemberInfoPermission" /></td>
                </tr>
            </tbody>
        </table>
        <div><input type="button" id="btnAdd" class="btnSubmit" value="Add "></div>
        @Html.AntiForgeryToken()
        <ul id="Popup" class="divMenuPopup" style="display: none;">
            <li class="group">
                <input type="radio" name="rdPermission" id="None" data-pageaccess="">
                <label for="pNone">None</label>
            </li>
            <li class="group">
                <input type="radio" name="rdPermission" id="View" data-pageaccess="[H]">
                <label for="pView">View</label>
            </li>
            <li class="group">
                <input type="radio" name="rdPermission" id="UpdateView" data-pageaccess="[B][H]">
                <label for="pUpdateView">Update</label>
            </li>
            <li class="group"><input type="radio" name="rdPermission" id="FullControl" data-pageaccess="[A][B][H]">
                <label for="pFullControl">Full Control</label>
            </li>
        </ul>
    </main>
</div>
