@using AlphaPlus.Core.Helpers
@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
@using AlphaPlus.Settings.Site.Features.MemberInfo.Features.Commission
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model CommissionViewModel
@{
    Layout = "~/Features/MemberInfo/Views/Shared/_Layout.cshtml";
    ViewBag.Title = @Resources.MemberCommission;
}
@section Scripts {
    <script src="~/bundles/commission/commission.js" asp-append-version="true"></script>
}
<div class="page-title">
    <span class="pull-left">@Resources.MemberCommission</span>
</div>
<form method="get" class="form-inline filter" role="form" id="form-filter">
    <div class="form-group">
        <label>@Resources.Product</label>
        <div class="original-sl">
            <select class="original" id="ddl-product" asp-items="Model.Products"></select>
        </div>
    </div>
    @if (Model.ActorLevel.IsSuperLevel())
    {
        <div class="form-group">
            <label>@Resources.SelectDirectDownline</label>
            <div class="original-sl">
                <select class="original" id="ddl-master" asp-items="Model.Masters"></select>
            </div>
        </div>
        <div class="form-group">
            <label>@Resources.SelectAgent</label>
            <div class="original-sl">
                <select class="original" id="ddl-agent" disabled>
                    <option value="0">@Resources.NoInformationIsAvailable</option>
                </select>
            </div>
        </div>
        <div class="form-group">
            <span class="block-icon-small" id="icon-loadingAgent" style="display:none"></span>
        </div>
    }
    else if (Model.ActorLevel.IsMasterLevel())
    {
        <div class="form-group">
            <label>@Resources.SelectDirectDownline</label>
            <div class="original-sl">
                <select class="original" id="ddl-agent" asp-items="Model.Agents"></select>
            </div>
        </div>
    }
    @if (Model.IsShowGroup)
    {
        <div class="form-group">
            <a asp-action="SportBookInformation" asp-controller="Customer" class="icon icon-information-outline"
                asp-all-route-data="@Model.GetCommHintParams()" target="_blank"></a>
        </div>
    }
</form>
<div id="tblRpt-container">
    <partial name="CommData" />
</div>
<input type="hidden" id="hidden-commissionUrl" value="@MicroSites.SettingUrl("~/commission")" />
<input type="hidden" id="hidden-noInfoText" value="@Resources.NoInformationIsAvailable" />
