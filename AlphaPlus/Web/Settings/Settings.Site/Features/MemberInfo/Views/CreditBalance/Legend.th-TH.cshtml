@{
    Layout = null;
}
@using AlphaPlus.Settings.Site.Features.MemberInfo.ViewModels.CreditBalance
@using AlphaPlus.Shared.AppResources.Settings.MemberInfo

@model CreditBalanceViewModel

<div class="modal fade message-modal" id="report-legend" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="@Resources.ConditionToClearCredit"><span aria-hidden="true"></span></button>
                <h4 class="modal-title">@Resources.ConditionToClearCredit</h4>
            </div>
            <div class="modal-body">
                <div id="msg-content">
                    @if (Model.CustLevel.IsAgentLevel())
                    {
                        if (!string.IsNullOrWhiteSpace(Model.TransferCondition))
                        {
                            <p>- @Model.TransferCondition</p>
                        }
                        if (Model.IsViewingMemberList)
                        {
                            <p>- @Resources.CreditBalanceNote</p>
                        }
                        <p>- สมาชิกใดก็ตามที่ไม่ได้ลงชื่อเข้าใช้งานมากกว่า 14 วันหลังจากที่เอเจนต์ได้สร้างบัญชีให้</p>
                    }
                    else
                    {
                        <span>เครดิตที่ได้รับของดาวน์ไลน์ จะถูกเคลียร์โดยอัตโนมัติหากมีการตรงตามเงื่อนไขใด ๆ ต่อไปนี้</span>
                        if (Model.CustLevel.IsSuperLevel())
                        {
                            if (Model.IsViewingMemberList)
                            {
                                <p>- @Resources.CreditBalanceNote</p>
                            }
                            <ul class="list-msg">
                                <li>
                                    สำหรับ มาสเตอร์/เอเจ้นท์ ที่ไม่มีดาวน์ไลน์ (รวมถึงสมาชิกโดยตรง):
                                    <p>- มาสเตอร์/เอเจ้นท์ ไม่ได้เข้าสู่ระบบหลังจากที่ถูกสร้างโดยอัพไลน์โดยตรงเป็นเวลา 7 วัน</p>
                                </li>
                                <li>
                                    สำหรับสมาชิก/สมาชิกโดยตรง:
                                    <p>- สมาชิก/สมาชิกโดยตรง ไม่ได้เข้าสู่ระบบหลังจากที่ถูกสร้างโดยอัพไลน์โดยตรงเป็นเวลาเกินกว่า 14 วัน</p>
                                </li>
                            </ul>
                        }
                        else
                        {
                            if (Model.IsViewingMemberList)
                            {
                                <p>- @Resources.CreditBalanceNote</p>
                            }
                            <ul class="list-msg">
                                <li>
                                    สำหรับเอเจ้นท์ที่ไม่มีดาวน์ไลน์:
                                    <p>- เอเจ้นท์ไม่ได้เข้าสู่ระบบหลังจากที่ถูกสร้างโดยมาสเตอร์เป็นเวลามากกว่า 7 วัน</p>
                                </li>
                                <li>
                                    สำหรับสมาชิก/สมาชิกโดยตรง:
                                    <p>- สมาชิก/สมาชิกโดยตรง ไม่ได้เข้าสู่ระบบหลังจากที่ถูกสร้างโดยอัพไลน์โดยตรงเป็นเวลาเกินกว่า 14 วัน</p>
                                </li>
                            </ul>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

