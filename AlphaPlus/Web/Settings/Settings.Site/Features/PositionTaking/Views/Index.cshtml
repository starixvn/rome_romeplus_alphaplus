@using AlphaPlus.Core.Configurations
@using Newtonsoft.Json
@model dynamic
@{
    Layout = "~/Features/PositionTaking/Views/Shared/_Layout.cshtml";
    var bootstrapData = JsonConvert.SerializeObject(Model);
    var productId = Model.product.mainProductId != 0 ?
        Model.product.mainProductId : Model.product.id;
    var darkModeName = ViewData["DarkModeName"];
}
@section Head{
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/bundles/position-taking/index.css")" asp-append-version="true" />
}
<body>
    <div id="page_main">
        <div id="header_main">
            Position Taking (%) @* @Resources.Lang.lblPositionTaking *@
        </div>
        <div id="tbl-container">
            <table id="tbl-container-layout" style="width: 100%;">
                <tr>
                    <td>
                        @await Html.PartialAsync("~/Features/PositionTaking/Views/Shared/_PositionTakingHeader.cshtml", new Dictionary<string, object>() { { "ProductId", productId }, { "ShowPTIcon", Model.product.showPTIcon }, {"SiteLabel", AppSettings.SiteLabel} })
                    </td>
                </tr>
                <tr>
                    <td>
                        <table id="tblHeader">
                            <tr>
                                <td class="bgcenter" colspan="2">
                                    <div id="pagingcontrol-header" class="pagingContainer viewpage-container display-none">
                                    </div>
                                </td>
                                <td class="bgright pagingcontrol"></td>
                            </tr>
                        </table>
                        <div id="gridContainer" class="freegrid">
                        </div>
                        <table id="tblFooter">
                            <tr>
                                <td class="bgright pagingcontrol">
                                    <div id="pagingcontrol-footer" class="viewpage-container display-none">
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <input type="hidden" id="arrayCustID" name="arrayCustID" />
    <input type="hidden" id="arrayUserName" name="arrayUserName" />
    @section Scripts {
        <script type="text/javascript" src="@Url.Content("~/bundles/position-taking/index.js")" asp-append-version="true"></script>
    }
    <script type="text/javascript">
        window.isDarkMode = @(string.IsNullOrWhiteSpace((string)darkModeName) ? "false" : "true");
        window.rootUrl = '/settings';
        @* var viewResources = {
            Page_Size: '@Resources.Lang.pagesize',
            Symbol_No: '@Labels.Symbol_No',
            Username: '@Resources.Lang.username',
            Page: '@Labels.Page',
            of: '@Labels.of',
            noInfo: '@Html.Raw(Resources.Lang.noInfo)',
            live: '@Resources.Lang.lblLive',
            editPTTitle: '@Resources.Lang.lblEditMember'
        }; *@
        
        var viewResources = {
            Page_Size: 'Page size',
            Symbol_No: '#',
            Username: 'Username',
            Page: 'Page',
            of: 'of',
            noInfo: 'No information is available',
            live: 'Live',
            editPTTitle: 'Edit member'
        };

        var bootstrapData = @Html.Raw(JsonConvert.DeserializeObject(bootstrapData));
    </script>
</body>