@using AlphaPlus.Core.Configurations
@using AlphaPlus.Shared.AppResources.Common
@using AlphaPlus.Shared.AppResources.Main
@using AlphaPlus.Shared.AppResources.Settings.CustomerList
@using Newtonsoft.Json
@using AlphaPlus.Core.Helpers
@model dynamic
@{
    Layout = "~/Features/PositionTaking/Views/Shared/_Layout.cshtml";
    var productId = Model.pt.product.mainProductId != 0 ?
        Model.pt.product.mainProductId : Model.pt.product.id;
    var products = JsonConvert.SerializeObject(Model.product);
    var darkModeName = ViewData["DarkModeName"];
}
@section Head{
    @StaticResources.RenderStylesWithDarkMode($"~/bundles/position-taking/index")
}
<body>
    <div id="page_main">
        <div id="header_main">
            @Alpha_sitemap.positionTaking
        </div>
        <div id="tbl-container">
            <table id="tbl-container-layout" style="width: 100%;">
                <tr>
                    <td>
                        @await Html.PartialAsync("~/Features/PositionTaking/Views/Shared/_PositionTakingHeader.cshtml", new Dictionary<string, object>() { { "ProductId", productId }, { "ShowPTIcon", Model.pt.product.showPTIcon }, {"SiteLabel", AppSettings.SiteLabel}, {"Products", products} })
                    </td>
                </tr>
                <tr>
                    <td>
                        <table id="tblHeader">
                            <tr>
                                <td class="bgcenter" colspan="2">
                                    <div id="pagingcontrol-header" class="pagingContainer viewpage-container display-none">
                                    </div>
                                </td>
                                <td class="bgright pagingcontrol"></td>
                            </tr>
                        </table>
                        <div id="gridContainer" class="freegrid">
                        </div>
                        <table id="tblFooter">
                            <tr>
                                <td class="bgright pagingcontrol">
                                    <div id="pagingcontrol-footer" class="viewpage-container display-none">
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </div>
    <input type="hidden" id="arrayCustID" name="arrayCustID" />
    <input type="hidden" id="arrayUserName" name="arrayUserName" />
    @section Scripts {
        <script type="text/javascript" src="@Url.Content("~/bundles/position-taking/index.js")" asp-append-version="true"></script>
    }
    <script type="text/javascript">
        window.isDarkMode = @(string.IsNullOrWhiteSpace((string)darkModeName) ? "false" : "true");
        window.rootUrl = '/settings';
        
        var viewResources = {
            Page_Size: '@CustomerListResources.PageSize',
            Symbol_No: '#',
            Username: '@CustomerListResources.Username',
            Page: '@CustomerListResources.Page',
            of: '@CustomerListResources.Of',
            noInfo: '@CommonResx.NoInfo',
            live: '@AlphaPlus.Shared.AppResources.Betlist.Site.Resources.Live',
            editPTTitle: '@CommonResx.lblEditMember'
        };

        var bootstrapData = @Html.Raw(JsonConvert.SerializeObject(Model.pt));
    </script>
</body>