@using AlphaPlus.Core.Extensions
@using AlphaPlus.Shared.AppResources.Settings.Transfer
@using AlphaPlus.Settings.Transfer.API.Helpers
@using AlphaPlus.Settings.Site.Features.Shared.Helpers
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var masterAgent = Model.IsSuperLevel ? Resources.MasterAgent : Resources.Agent;
}
@model AlphaPlus.Settings.Site.Features.Transfer.ViewModels.TransferList.TransferListViewModel
<table class="tblRpt tblRpt-bordered tblRpt-hover width-100per hide" id="tbl-transfer">
    <thead>
        <tr>
            <th>#</th>
            <th><input type="checkbox" id="checkbox-all" @(Model.ReportData.TotalPages == 0 ? "disabled" :
                    string.Empty) /></th>
            @if (Model.IsEnableAutoTransfer)
            {
                <th>
                    @Resources.AutoTransfer
                    <a href="@Model.AutoTransferGuidelineUrl" target="_blank" class="user-guide-link pull-right"
                        title="@Resources.AutoTransferGuideline"><span class="icon icon-book"></span></a>
                </th>
            }
            <th>@Resources.Username</th>
            <th data-colname="level">@Resources.Level</th>
            <th>@Resources.YesterdayBalance</th>
            <th data-colname="pendingtransfer3rd">@Resources.PendingTransfer3rd</th>
            <th data-colname="balance">
                @if (Model.IsSuperLevel)
                {
                    @:@Resources.MasterBalance
                }
                else
                {
                    @:@Resources.AgentBalance
                }
            </th>
            <th data-colname="yesterdaycash">@Resources.YesterdayCash</th>
            <th>@Resources.TotalCash /<br />@Resources.TotalBalance<span class="icon-information-outline"
                    title="@Resources.TotalCashTotalBalanceNote"></span></th>
            <th>@Resources.Outstanding</th>
            <th>@Resources.GivenCredit</th>
            <th>@Resources.UsedCredit</th>
            <th data-colname="fname">@Resources.FirstName</th>
            <th data-colname="lname">@Resources.LastName</th>
            <th data-colname="username">@Resources.Username</th>
        </tr>
    </thead>
    @if (Model.ReportData.TotalPages > 0)
    {
        <tbody>
            @foreach (var customer in Model.ReportData.Customers)
            {
                <tr
                    class="@BackgroundColorHelper.GetClassNameByAccountStatus(customer.Enabled, customer.Closed, customer.ClosedReason, customer.Suspended, customer.Locked)">
                    <td class="text-center">@customer.RowNumber</td>
                    <td class="text-center"><input type="checkbox" class="checkbox" data-custid="@customer.CustId"
                            data-custname="@customer.Username" data-value="@(-customer.YesterdayBalance)"
                            data-autotransfer="@(customer.IsAllowAutoTransfer ? "on" : "off")"
                            data-isdirectmember="@Convert.ToByte(customer.IsDirectMember)" /></td>
                    @if (Model.IsEnableAutoTransfer)
                    {
                        <td>
                            <div class="box-auto-calendar">
                                <a class="switch-auto-transfer" data-state="@(customer.IsAllowAutoTransfer ? "on" : "off")"
                                    asp-action="UpdateSingleAutoTransfer" asp-controller="AutoTransfer"
                                    asp-all-route-data="@Model.GetAutoTransferParams(customer)">
                                    <div class="toggle"></div>
                                </a>
                                @if (customer.IsAllowAutoTransfer)
                                {
                                    <a class="icon-calendar"
                                        title="@TransferConditionHelper.BuildDaysFromSchedule(customer.ScheduleWeekDays)"
                                        asp-action="UpdateSchedule" asp-controller="AutoTransfer"
                                        asp-all-route-data="@Model.GetScheduleTransferParams(customer)"></a>
                                }
                            </div>
                        </td>
                    }
                    <td>@customer.Username</td>
                    <td class="text-center" data-colname="level">@(customer.IsDirectMember ? Resources.DirectMember :
                masterAgent)</td>
                    <td class="text-right @Model.GetYesterdayBalanceColor(customer)">
                        @{
                            var yesterdayBalance = customer.YesterdayBalance.FormatNumber2();
                            if (Model.ShowYesterdayBalanceLink(customer.YesterdayBalance))
                            {
                                if (customer.IsDirectMember)
                                {
                                    <a class="transfer-link" asp-action="Member" asp-controller="TransferYesterdayBalance"
                                        asp-route-custid="@customer.CustId" asp-route-custname="@customer.Username" data-w="520"
                                        data-h="520">@yesterdayBalance</a>
                                }
                                else
                                {
                                    <a class="transfer-link" asp-action="Single" asp-controller="TransferYesterdayBalance"
                                        asp-route-custid="@customer.CustId" asp-route-custname="@customer.Username">@yesterdayBalance</a>
                                }
                            }
                            else
                            {
                                @yesterdayBalance
                            }
                        }
                    </td>
                    <td class="text-right" data-colname="pendingtransfer3rd">@customer.PendingTransfer3rd.FormatNumber2()
                    </td>
                    <td class="text-right @Model.GetColor(customer.Balance)" data-colname="balance">
                        @{
                            var balance = customer.Balance.FormatNumber2();
                            if (Model.ShowBalanceLink(customer.Balance))
                            {
                                if (customer.IsDirectMember)
                                {
                                    <a class="transfer-link" asp-action="Member" asp-controller="TransferYesterdayBalance"
                                        asp-route-custid="@customer.CustId" asp-route-custname="@customer.Username" data-w="520"
                                        data-h="520">@balance</a>
                                }
                                else
                                {
                                    <a class="transfer-link" asp-action="Single" asp-controller="TransferYesterdayBalance"
                                        asp-route-custid="@customer.CustId" asp-route-custname="@customer.Username">@balance</a>
                                }
                            }
                            else
                            {
                                @balance
                            }
                        }
                    </td>
                    <td class="text-right @Model.GetColor(customer.YesterdayCashBalance)" data-colname="yesterdaycash">
                        @customer.YesterdayCashBalance.FormatNumber2()</td>
                    <td
                        class="text-right @Model.GetTotalBalanceColor(customer.CashBalance, customer.FutureBetCredit, customer.IsDirectMember)">
                        @{
                            var cashBalance = customer.CashBalance.FormatNumber2();
                            if (Model.IsAllDayBalanceTransfer)
                            {
                                <a class="transfer-link" asp-action="CashBalance" asp-controller="CashBalanceTransfer"
                                    asp-route-custid="@customer.CustId" asp-route-isdirectmember="@customer.IsDirectMember" data-w="520"
                                    data-h="500">@cashBalance</a>
                            }
                            else
                            {
                                @cashBalance
                            }
                        }
                    </td>
                    <td class="text-right">@customer.Outstanding.FormatNumber2()</td>
                    <td class="text-right">@customer.GivenCredit.FormatNumber2()</td>
                    <td class="text-right">@customer.UsedCredit.FormatNumber2()</td>
                    <td data-colname="fname">@System.Net.WebUtility.HtmlEncode(customer.FirstName)</td>
                    <td data-colname="lname">@System.Net.WebUtility.HtmlEncode(customer.LastName)</td>
                    <td data-colname="username">@customer.Username</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="tbl-footer">
                <td colspan="2" class="text-center">@Resources.Total</td>
                @if (Model.IsEnableAutoTransfer)
                {
                    <td></td>
                }
                <td></td>
                <td data-colname="level"></td>
                <td class="text-right">@Model.ReportData.Total.YesterdayBalance.FormatNumber2()</td>
                <td class="text-right" data-colname="pendingtransfer3rd">
                    @Model.ReportData.Total.PendingTransfer3rd.FormatNumber2()</td>
                <td class="text-right" data-colname="balance">@Model.ReportData.Total.Balance.FormatNumber2()</td>
                <td class="text-right" data-colname="yesterdaycash">
                    @Model.ReportData.Total.YesterdayCashBalance.FormatNumber2()</td>
                <td class="text-right">@Model.ReportData.Total.CashBalance.FormatNumber2()</td>
                <td class="text-right">@Model.ReportData.Total.Outstanding.FormatNumber2()</td>
                <td class="text-right">@Model.ReportData.Total.GivenCredit.FormatNumber2()</td>
                <td class="text-right">@Model.ReportData.Total.UsedCredit.FormatNumber2()</td>
                <td data-colname="fname"></td>
                <td data-colname="lname"></td>
                <td data-colname="username"></td>
            </tr>
        </tfoot>
    }
    else
    {
        <tbody>
            <tr>
                <td colspan="15" class="text-center">@Resources.NoInformationIsAvailable</td>
            </tr>
        </tbody>
    }
</table>
