@using AlphaPlus.Core.Helpers
@using AlphaPlus.Shared.AppResources.Settings.Transfer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewBag.Title = Resources.MultipleTransfer;
    var pagerViewModel = Tuple.Create(Model.PageIndex, Model.ReportData.TotalPages);
}
@model AlphaPlus.Settings.Site.Features.Transfer.ViewModels.TransferList.TransferListViewModel
@section Styles {
    <link rel="stylesheet" href="~/bundles/transfer/transfer-list.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/bundles/transfer/transfer-list.js" asp-append-version="true"></script>
    @if (!Model.IsMasterOrSuperLevel)
    {
        <script type="text/javascript">
            const warning = @Convert.ToByte(Model.IsShowWarningMultipleTransfer);
            if (warning) {
                document.getElementById('warning-multiple-transfer').style.display = 'block';
            } else {
                document.getElementById('warning-multiple-transfer').remove();
            }
        </script>
    }
}
<div class="page-title">
    <partial name="_EnteredSportResult" model="Model.EnteredSportResult" />
    <div style="clear: both">
        @Resources.MultipleTransfer
        <a href="javascript:;" class="icon-print" id="icon-print"></a>
    </div>
</div>
<form class="form-inline filter" role="form" id="form-transfer">
    <div class="form-group">
        <label for="txt-username">@Resources.Username</label>
        <input asp-for="Username" placeholder="@Resources.UsernamePlaceHolder" autocomplete="off" />
    </div>
    <div class="form-group">
        <label>@Resources.Status</label>
        <select asp-for="Status" asp-items="Model.StatusOptions"></select>
    </div>
    @if (Model.IsEnableAutoTransfer)
    {
        <div class="form-group">
            <label>@Resources.AutoTransfer</label>
            <select asp-for="AutoTransfer" asp-items="Model.AutoTransferOptions"></select>
        </div>
    }
    <div class="form-group">
        <input asp-for="AllYesterdayBalance" />
        <label asp-for="AllYesterdayBalance">@Resources.AllYesterdayBalance</label>
    </div>
    <div class="form-group">
        <button type="submit" class="btn-submit" id="btn-submit">@Resources.Submit</button>
    </div>
    <div class="form-group">
        <span id="icon-information" class="icon-information-outline"></span>
    </div>
    <input type="hidden" name="IsPostBack" value="true" />
    <input type="hidden" asp-for="PageIndex" />
    <input type="hidden" asp-for="PageSize" />
    <input type="hidden" name="ADBT" value="@(Model.IsAllDayBalanceTransfer ? "true" : "false")" />
</form>
@if (!Model.IsMasterOrSuperLevel)
{
    <div id="warning-multiple-transfer" style="display:none">* @Html.Raw(string.Format(Resources.WarningMultipleTransfer,
    "<font class='highlight'>", "</font>"))</div>
}
<div class="msg" id="msg-alert" style="display:none"></div>
<div class="list-btn">
    <div class="btn-left">
        <div class="btn-group">
            <button type="button" class="btn-submit dropdown-toggle" data-toggle="dropdown" aria-haspopup="true"
                aria-expanded="false" id="btn-transfer" disabled>@Resources.Transfer
                <span class="caret"></span></button>
            <ul class="dropdown-menu transfer">
                <li><a href="javascript:;" id="menu-transfer"><span
                            class="icon-transfer"></span>@Resources.OnlyThisPage</a></li>
                <li class="@(Model.ReportData.TotalPages > 1 ? string.Empty : "disabled")"><a href="javascript:;"
                        id="menu-transfer-allpages"><span class="icon-transfer"></span>@Resources.AllPages</a></li>
            </ul>
        </div>
        @if (Model.IsEnableAutoTransfer)
        {
            <button type="button" class="btn-submit" id="btn-autoTransfer" disabled>@Resources.AutoTransfer</button>
        }
    </div>
    <div class="btn-right">
        <partial name="_Paging" model="pagerViewModel" />
        @Resources.PageSize
        <select class="pagingSize" asp-items="@Model.PageSizes"></select>
    </div>
</div>
<div class="block-tbl-transfer" id="block-tbl-transfer">
    @if (Model.IsMasterOrSuperLevel)
    {
        <partial name="_DataViewSuperMaster" />
    }
    else
    {
        <partial name="_DataViewAgent" />
    }
    <partial name="_Paging" model="pagerViewModel" />
    <partial name="~/Features/Transfer/Views/Shared/_VisibleColumns.cshtml" />
</div>
@Html.AntiForgeryToken()
<input type="hidden" asp-for="ViewerId" />
<input type="hidden" id="hidden-usernameSuggestionUrl" value="@MicroSites.SettingUrl("~/UserNameSuggestion")" />
<a class="hide" id="hidden-transferHintUrl" asp-action="Hint" asp-controller="CashBalanceTransfer"></a>
<a class="hide" id="hidden-transferYesterdayBalanceMultipleUrl"
    asp-action="@(Model.IsMasterOrSuperLevel ? "Multiple" : "MultipleMember")"
    asp-controller="TransferYesterdayBalance"></a>
<input type="hidden" id="hidden-updateMultipleAutoTransferUrl" value="@Model.UpdateMultipleAutoTransferUrl" />
<input type="hidden" id="hidden-confirmTransfer" value="@Resources.ConfirmTransfer" />
<input type="hidden" id="hidden-noTransferMade" value="@Resources.NoTransferMade" />
<input type="hidden" id="hidden-isAllDayBalanceTransfer" value="@(Model.IsAllDayBalanceTransfer ? 1 : 0)" />
<input type="hidden" id="hidden-messageForReloadSite" value="@Model.MessageForReloadSite" />
<input type="hidden" id="hidden-isReloadTopPage" value="@(Model.IsReloadTopPage ? 1 : 0)" />
