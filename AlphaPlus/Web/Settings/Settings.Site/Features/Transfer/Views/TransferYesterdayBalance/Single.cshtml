@using AlphaPlus.Core.Helpers
@using AlphaPlus.Shared.AppResources.Settings.Transfer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewBag.Title = Resources.Transfer;
}
@model AlphaPlus.Settings.Site.Features.Transfer.ViewModels.TransferYesterdayBalance.SingleViewModel
@section Scripts {
    <script src="~/bundles/transfer/transfer-yesterday-balance-single.js" asp-append-version="true"></script>
}
<div class="page-title hide">@Resources.Transfer</div>
<div style="padding-top: 5px;"></div>
<div class="msg" id="msg-alert" style="display:none"></div>
<form method="post" asp-action="Single" role="form" id="form-update">
    <div class="form-popup justify-content-space-between">
        <label asp-for="Amount">@Resources.Amount</label>
        <input asp-for="Amount" class="text-right" maxlength="17" autocomplete="off" />
    </div>
    <div class="form-popup justify-content-flex-end">
        <button type="button" class="btn-cancel hide">@Resources.Cancel</button>
        <button type="submit" class="btn-submit">@Resources.Submit</button>
    </div>
</form>
<input type="hidden" asp-for="CustId" />
<input type="hidden" id="hidden-InvalidValue" value="@Resources.InvalidValue" />
<input type="hidden" id="hidden-ConfirmTransfer" value="@Resources.ConfirmTransfer" />
