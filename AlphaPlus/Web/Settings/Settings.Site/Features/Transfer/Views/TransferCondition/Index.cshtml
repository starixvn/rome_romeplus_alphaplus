@using AlphaPlus.Core.Helpers
@using AlphaPlus.Shared.AppResources.Settings.Transfer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model AlphaPlus.Settings.Site.Features.Transfer.ViewModels.TransferCondition.TransferConditionViewModel
@{
    ViewBag.Title = Resources.TransferCondition;
    var showTitle = !string.IsNullOrWhiteSpace(AlphaContext.Current.Request.Query["showtitle"].ToString());
    var dayOfWeekIndex = 0;
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-assets/tipsy")
    @* <link rel="stylesheet" href="~/bundles/transfer/transfer-list.css" asp-append-version="true" /> *@
}
@section Scripts {
    @StaticResources.AssetScripts.Render("/bundles-v2/site-assets/tipsy")
    <script src="~/bundles/transfer/transfer-condition.js" asp-append-version="true"></script>
}
@if (showTitle)
{
    <div class="page-title">@Resources.MultipleTransfer</div>
}
<div class="wrapper-transfer-condition">
    <div class="msg" id="msg-alert" @(string.IsNullOrWhiteSpace(Model.WarningMessage) ? "style=display:none" :
        string.Empty)>@Model.WarningMessage</div>
    <h5 class="ttl-form-transfer-condition">@Resources.AccountBalanceTransferCondition</h5>
    <form method="post" asp-action="Update" role="form" id="form-transfer">
        <div class="form-transfer-condition">
            <div class="left">
                <input type="radio" id="rdo-daily" name="TransferCondition" value="00000000" @(Model.Daily ? "checked" :
                    string.Empty) />
                <label for="rdo-daily">@Resources.Daily</label>
            </div>
        </div>
        <div class="form-transfer-condition">
            <div class="left">
                <input type="radio" id="rdo-weekly" name="TransferCondition" value="00000001" @(Model.Daily ? string.Empty :
                    "checked") />
                <label for="rdo-weekly">@Resources.Weekly</label>
            </div>
            <div class="weekly">
                @foreach (var item in Model.Weekly)
                {
                    <input type="checkbox" id="chk-@dayOfWeekIndex" name="Weekly" value="@item.Value" @(item.Selected ? "checked" :
                    string.Empty) @(Model.Daily ? "disabled" : string.Empty) />
                    <label for="chk-@dayOfWeekIndex">@item.Text</label>
                    dayOfWeekIndex++;
                }
            </div>
        </div>
        <div class="form-transfer-condition"><button type="submit" class="btn-submit" id="btn-submit">@Resources.Update</button></div>
    </form>
</div>
<input type="hidden" asp-for="TransferOption" />
<input type="hidden" asp-for="CustId" />
<input type="hidden" id="hidden-isEnableAutoTransfer" value="@Convert.ToByte(Model.IsEnableAutoTransfer).ToString()" />
<input type="hidden" id="hidden-showTitle" value="@Convert.ToByte(showTitle).ToString()" />
<input type="hidden" id="hidden-pleaseChooseDailyText" value="@Resources.PleaseChooseDaily" />
<input type="hidden" id="hidden-pleaseSelectOneDayText" value="@Resources.PleaseSelectOneDay" />
<input type="hidden" id="hidden-noChangeToUpdateText" value="@Resources.NoChangeToUpdate" />
<input type="hidden" id="hidden-confirmUpdateTransferConditionText" value="@Resources.ConfirmUpdateTransferCondition" />
<input type="hidden" id="hidden-updateTransferCondition_NoteText" value="@Resources.UpdateTransferCondition_Note" />
<input type="hidden" id="hidden-updateTransferCondition_OnAutoText" value="@Resources.UpdateTransferCondition_OnAuto" />
<input type="hidden" id="hidden-updateTransferCondition_OffAutoText"
    value="@Resources.UpdateTransferCondition_OffAuto" />
