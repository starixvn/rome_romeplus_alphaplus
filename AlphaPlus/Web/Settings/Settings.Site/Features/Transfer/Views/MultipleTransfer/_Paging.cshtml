@using AlphaPlus.Shared.AppResources.Settings.Transfer
@{
    Layout = null;
}
@model AlphaPlus.Settings.Site.Features.Transfer.ViewModels.MultipleTransfer.TransferListViewModel
@if (Model.ReportData.TotalPages > 1)
{
    <div class="pagingContainer" data-totalpages="@Model.ReportData.TotalPages">
        <span class="icon pagingFirst @(Model.PageIndex == 1 ? "disabled" : string.Empty)" data-pageindex="1"></span>
        <span class="icon pagingPrev @(Model.PageIndex == 1 ? "disabled" : string.Empty)"
            data-pageindex="@(Model.PageIndex - 1)"></span>
        <span class="pagingSeperator"></span>
        @Resources.Page
        <input type="text" class="pagingCurrent" maxlength="9" autocomplete="off" value="@Model.PageIndex" />
        @Resources.of @Model.ReportData.TotalPages
        <span class="pagingSeperator"></span>
        <span class="icon pagingNext @(Model.PageIndex == Model.ReportData.TotalPages ? "disabled" : string.Empty)"
            data-pageindex="@(Model.PageIndex + 1)"></span>
        <span class="icon pagingLast @(Model.PageIndex == Model.ReportData.TotalPages ? "disabled" : string.Empty)"
            data-pageindex="@Model.ReportData.TotalPages"></span>
    </div>
}
