@using AlphaPlus.Settings.ViewLogs.API.AppResources
@using AlphaPlus.Settings.Site.ViewLogs.ViewModels
@using AlphaPlus.Core.Helpers

@model LogViewModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    @StaticResources.AssetStyles.Render($"/bundles/site-viewlogs/viewlogs-{Model.UserLevel}")
    <link rel="stylesheet" href="@StaticResources.RenderScripts($"~/ViewLogs/assets/bundles/default")" />
    @RenderSection("Styles", required: false)
    @GoogleAnalyticHelper.GtagScript()
</head>
<body>
    @GoogleAnalyticHelper.GtagNoScript()
    <div class="container-fluid page-viewlog">
        @Html.ActionLink("Index", "Tab", new { tabName = ViewContext.RouteData.Values["controller"], area = "" })
        @RenderBody()
        @await Html.PartialAsync("MonthNames")
    </div>

    <div class="shadow" id="shadow"></div>
    <div class="output" id="output"></div>

    @Html.Hidden("indexPath", "/settings/" + ViewContext.RouteData.Values["controller"] + "/index")
    @Html.Hidden("usernameAutoSuggestionPath", Model.UsernameAutoSuggestionPath)
    @Html.Hidden("viewIPInfoPath", Model.ViewIPInfoPath)

    @RenderSection("Scripts", required: false)
</body>
</html>