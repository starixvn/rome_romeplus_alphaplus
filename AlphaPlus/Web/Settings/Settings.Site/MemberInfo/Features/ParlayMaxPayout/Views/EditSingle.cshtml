@using AlphaPlus.Settings.Site.Features.ParlayMaxPayout.ViewModels
@using AlphaPlus.Core.Helpers

@model ParlayMaxPayoutSinglePageViewModel

@{
    Layout = "~/MemberInfo/Views/Shared/_Layout.cshtml";
}

@section Styles {
    @StaticResources.RenderStylesWithDarkMode("~/MemberInfo/Features/ParlayMaxPayout/bundles/parlay-max-payout")
}

<div id="header_main" class="pmp-page-title">@Model.SubTitle</div>

@await Html.PartialAsync(Model.ParlayMaxPayoutSettingPartialViewPath, Model)

@section Scripts {
    @StaticResources.RenderScripts("~/MemberInfo/Features/ParlayMaxPayout/bundles/parlay-max-payout")
}