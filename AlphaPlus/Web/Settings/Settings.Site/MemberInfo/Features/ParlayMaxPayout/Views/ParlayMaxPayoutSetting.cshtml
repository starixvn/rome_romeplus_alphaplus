@using AlphaPlus.Shared.AppResources.Settings.ProductResources
@using AlphaPlus.Settings.Site.Features.ParlayMaxPayout.ViewModels
@using AlphaPlus.Core.Helpers

@model ParlayMaxPayoutBasePageViewModel

<div id="pmp-container" class="pmp-container">
    <div id="message-container" class="message-container" style="display: none;">
        <div id="message-text" class="message message-icon"></div>
    </div>

    <div class="pmp-heading">@Model.SubText</div>
    <div class="pmp-content">
        <div class="pmp-setting-name"></div>
        <div class="pmp-setting-name single-match-parlay">@Model.SingleMatchParlayFieldText</div>
        <div class="pmp-setting-name combo-2">@Model.Combo2FieldText</div>
        <div class="pmp-setting-name combo-35">@Model.Combo35FieldText</div>
        <div class="pmp-setting-name combo-6-plus">@Model.ComboOver6FieldText</div>

        @{
            var data = Model.Data;
            foreach (var item in data)
            {
                var className = Model.GetClassName(item.SportTypeId);
                var willRenderCheckBoxRow = item.IsAllowUnlimitCombo2 || item.IsAllowUnlimitCombo35 || item.IsAllowUnlimitComboOver6 || item.IsAllowUnlimitSingleMatchParlay;

                <div class="pmp-sport-name sport-name @className @(willRenderCheckBoxRow ? string.Empty : "no-checkbox-row")"
                    data-bettypeid="@item.BetTypeId"
                    data-bettypename="@item.BetTypeName"
                    data-sporttypeid="@item.SportTypeId">
                    @if (Model.IsMultiple)
                    {
                        <div class="sport-type-name">
                            <div class="sport-type-name-ctrl">
                                <input type="checkbox"
                                    class="cb-sporttypename"
                                    data-sporttypeid="@item.SportTypeId" />
                            </div>
                            <div class="sport-type-name-text">
                                @item.SportTypeName
                            </div>
                        </div>
                    }
                    else
                    {
                        @item.SportTypeName
                    }
                </div>

                var singleMatchParlayName = "SingleMatchParlay";
                var combo2Name = "Combo2";
                var combo35Name = "Combo35";
                var comboOver6Name = "ComboOver6";

                var unlimited = "Unlimited";
                className = Model.GetClassName(item.SportTypeId);

                <div class="pmp-setting-control ctrl-input @className-@singleMatchParlayName">
                    <input type="text"
                        maxlength="14"
                        id="@singleMatchParlayName@item.SportTypeId"
                        class="tb-setting"
                        data-columnname="@singleMatchParlayName"
                        data-sporttypeid="@item.SportTypeId"
                        data-settingname="@singleMatchParlayName"
                        data-currentvalue="@item.SingleMatchParlay"
                        data-maxvalue="@item.UplineSingleMatchParlay"
                        data-cachedvalue="@(item.SingleMatchParlay == unlimited ? "0" : item.SingleMatchParlay)"
                        value="@item.SingleMatchParlay"
                        @(Model.IsMultiple || item.SingleMatchParlay == unlimited ? "disabled" : string.Empty) />
                </div>
                <div class="pmp-setting-control ctrl-max-setting @className-@singleMatchParlayName">@(item.UplineSingleMatchParlay == unlimited ? string.Empty : $"<= {item.UplineSingleMatchParlay}")</div>

                <div class="pmp-setting-control ctrl-input @className-@combo2Name">
                    <input type="text"
                        maxlength="14"
                        id="@combo2Name@item.SportTypeId"
                        class="tb-setting"
                        data-columnname="@combo2Name"
                        data-sporttypeid="@item.SportTypeId"
                        data-settingname="@combo2Name"
                        data-currentvalue="@item.Combo2"
                        data-maxvalue="@item.UplineCombo2"
                        data-cachedvalue="@(item.Combo2 == unlimited ? "0" : item.Combo2)"
                        value="@item.Combo2"
                        @(Model.IsMultiple || item.Combo2 == unlimited ? "disabled" : string.Empty) />
                </div>
                <div class="pmp-setting-control ctrl-max-setting @className-@combo2Name">@(item.UplineCombo2 == unlimited ? string.Empty : $"<= {item.UplineCombo2}")</div>

                <div class="pmp-setting-control ctrl-input @className-@combo35Name">
                    <input type="text"
                        maxlength="14"
                        id="@combo35Name@item.SportTypeId"
                        class="tb-setting"
                        data-columnname="@combo35Name"
                        data-sporttypeid="@item.SportTypeId"
                        data-settingname="@combo35Name"
                        data-currentvalue="@item.Combo35"
                        data-maxvalue="@item.UplineCombo35"
                        data-cachedvalue="@(item.Combo35 == unlimited ? "0" : item.Combo35)"
                        value="@item.Combo35"
                        @(Model.IsMultiple || item.Combo35 == unlimited ? "disabled" : string.Empty) />
                </div>
                <div class="pmp-setting-control ctrl-max-setting @className-@combo35Name">@(item.UplineCombo35 == unlimited ? string.Empty : $"<= {item.UplineCombo35}")</div>

                <div class="pmp-setting-control ctrl-input @className-@comboOver6Name">
                    <input type="text"
                        maxlength="14"
                        id="@comboOver6Name@item.SportTypeId"
                        class="tb-setting"
                        data-columnname="@comboOver6Name"
                        data-sporttypeid="@item.SportTypeId"
                        data-settingname="@comboOver6Name"
                        data-currentvalue="@item.ComboOver6"
                        data-maxvalue="@item.UplineComboOver6"
                        data-cachedvalue="@(item.ComboOver6 == unlimited ? "0" : item.ComboOver6)"
                        value="@item.ComboOver6"
                        @(Model.IsMultiple || item.ComboOver6 == unlimited ? "disabled" : string.Empty) />
                </div>
                <div class="pmp-setting-control ctrl-max-setting @className-@comboOver6Name">@(item.UplineComboOver6 == unlimited ? string.Empty : $"<= {item.UplineComboOver6}")</div>
                
                if (willRenderCheckBoxRow)
                {
                    <div class="pmp-setting-control ctrl-checkbox @className-@singleMatchParlayName">
                        @if (item.IsAllowUnlimitSingleMatchParlay)
                        {
                            <input type="checkbox"
                                class="cb-setting"
                                data-sporttypeid="@item.SportTypeId"
                                data-tbsettingid="@singleMatchParlayName@item.SportTypeId"
                                @(item.SingleMatchParlay == unlimited ? "checked" : string.Empty)
                                @(Model.IsMultiple ? "disabled" : string.Empty) />
                        }
                    </div>
                    <div class="pmp-setting-control ctrl-checkbox-label @className-@singleMatchParlayName">
                        @(item.IsAllowUnlimitSingleMatchParlay ? unlimited : string.Empty)
                    </div>

                    <div class="pmp-setting-control ctrl-checkbox @className-@combo2Name">
                        @if (item.IsAllowUnlimitCombo2)
                        {
                            <input type="checkbox"
                                class="cb-setting"
                                data-sporttypeid="@item.SportTypeId"
                                data-tbsettingid="@combo2Name@item.SportTypeId"
                                @(item.Combo2 == unlimited ? "checked" : string.Empty)
                                @(Model.IsMultiple ? "disabled" : string.Empty) />
                        }
                    </div>
                    <div class="pmp-setting-control ctrl-checkbox-label @className-@combo2Name">
                        @(item.IsAllowUnlimitCombo2 ? unlimited : string.Empty)
                    </div>

                    <div class="pmp-setting-control ctrl-checkbox @className-@combo35Name">
                        @if (item.IsAllowUnlimitCombo35)
                        {
                            <input type="checkbox"
                                class="cb-setting"
                                data-sporttypeid="@item.SportTypeId"
                                data-tbsettingid="@combo35Name@item.SportTypeId"
                                @(item.Combo35 == unlimited ? "checked" : string.Empty)
                                @(Model.IsMultiple ? "disabled" : string.Empty) />
                        }
                    </div>
                    <div class="pmp-setting-control ctrl-checkbox-label @className-@combo35Name">
                        @(item.IsAllowUnlimitCombo35 ? unlimited : string.Empty)
                    </div>

                    <div class="pmp-setting-control ctrl-checkbox @className-@comboOver6Name">
                        @if (item.IsAllowUnlimitComboOver6)
                        {
                            <input type="checkbox"
                                class="cb-setting"
                                data-sporttypeid="@item.SportTypeId"
                                data-tbsettingid="@comboOver6Name@item.SportTypeId"
                                @(item.ComboOver6 == unlimited ? "checked" : string.Empty)
                                @(Model.IsMultiple ? "disabled" : string.Empty) />
                        }
                    </div>
                    <div class="pmp-setting-control ctrl-checkbox-label @className-@comboOver6Name">
                        @(item.IsAllowUnlimitComboOver6 ? unlimited : string.Empty)
                    </div>
                }
            }
        }
    </div>
    <div class="pmp-footer">
        <button id="btn-submit" type="button" class="btn-submit">@ProductResources.Update</button>
    </div>

    <div id="hint" class="hint" style="display: none;">
        <div id="hint-text"></div>
        <div id="hint-pointer" class="hint-pointer"></div>
    </div>

    @Html.AntiForgeryToken()
    <input id="tb-updatesuccess-msg" type="hidden" value="@Model.UpdateSuccessfullyText" />
    <input id="tb-updateurl" type="hidden" value="@Model.UpdateUrl" />
    <input id="tb-custidlist" type="hidden" value="@Model.CustIdList" />
    <input id="tb-custnamelist" type="hidden" value="@Model.CustNameList" />
    <input id="tb-invalidvalue-msg" type="hidden" value="@Model.InvalidMaxPayoutValueText" />
    <input id="tb-gtmaxvalue-msg" type="hidden" value="@Model.GreaterThanMaxValueText" />
    <input id="tb-hasnochange-msg" type="hidden" value="@Model.HasNoChangeText" />
    <input id="tb-notauthorized-msg" type="hidden" value="@Model.NotAuthorizedText" />
    <input id="tb-checkdownlineurl" type="hidden" value="@Model.CheckDownlineUrl" />
    <input id="tb-ismultiple" type="hidden" value="@(Model.IsMultiple ? 1 : 0)" />
</div>