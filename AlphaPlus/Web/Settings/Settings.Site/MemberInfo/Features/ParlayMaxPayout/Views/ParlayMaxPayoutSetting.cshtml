@* @using Alpha.MemberInfo.Features.CustomerList.AppResources.ProductResources
@model ParlayMaxPayoutBasePageViewModel

<div id="pmp-container" class="pmp-container">
    <div id="message-container" class="message-container" style="display: none;">
        <div id="message-text" class="message message-icon"></div>
    </div>

    <div class="pmp-heading">@Model.SubText</div>
    <div class="pmp-content">
        <div class="pmp-setting-name"></div>
        <div class="pmp-setting-name single-match-parlay">@Model.SingleMatchParlayFieldText</div>
        <div class="pmp-setting-name combo-2">@Model.Combo2FieldText</div>
        <div class="pmp-setting-name combo-35">@Model.Combo35FieldText</div>
        <div class="pmp-setting-name combo-6-plus">@Model.ComboOver6FieldText</div>

        @RenderParlayMaxPayoutSetting(Model.Data)
    </div>
    <div class="pmp-footer">
        <button id="btn-submit" type="button" class="btn-submit">@ProductResources.Update</button>
    </div>

    <div id="hint" class="hint" style="display: none;">
        <div id="hint-text"></div>
        <div id="hint-pointer" class="hint-pointer"></div>
    </div>

    @Html.AntiForgeryToken()
    @RenderHiddenFields()
</div>

@helper RenderHiddenFields()
{
    <input id="tb-updatesuccess-msg" type="hidden" value="@Model.UpdateSuccessfullyText" />
    <input id="tb-updateurl" type="hidden" value="@Response.ApplyAppPathModifier(Model.UpdateUrl)" />
    <input id="tb-custidlist" type="hidden" value="@Model.CustIdList" />
    <input id="tb-custnamelist" type="hidden" value="@Model.CustNameList" />
    <input id="tb-invalidvalue-msg" type="hidden" value="@Model.InvalidMaxPayoutValueText" />
    <input id="tb-gtmaxvalue-msg" type="hidden" value="@Model.GreaterThanMaxValueText" />
    <input id="tb-hasnochange-msg" type="hidden" value="@Model.HasNoChangeText" />
    <input id="tb-notauthorized-msg" type="hidden" value="@Model.NotAuthorizedText" />
    <input id="tb-checkdownlineurl" type="hidden" value="@Response.ApplyAppPathModifier(Model.CheckDownlineUrl)" />
    <input id="tb-ismultiple" type="hidden" value="@(Model.IsMultiple ? 1 : 0)" />
}

@helper RenderParlayMaxPayoutSetting(IEnumerable<ParlayMaxPayoutViewModel> data)
{
    foreach (var item in data)
    {
        @RenderParlayMaxPayoutSettingRow(item)
    }
}

@helper RenderParlayMaxPayoutSettingRow(ParlayMaxPayoutViewModel item)
{
    var className = Model.GetClassName(item.SportTypeId);
    var willRenderCheckBoxRow = item.IsAllowUnlimitCombo2 || item.IsAllowUnlimitCombo35 || item.IsAllowUnlimitComboOver6 || item.IsAllowUnlimitSingleMatchParlay;

    <div class="pmp-sport-name sport-name @className @(willRenderCheckBoxRow ? string.Empty : "no-checkbox-row")"
         data-bettypeid="@item.BetTypeId"
         data-bettypename="@item.BetTypeName"
         data-sporttypeid="@item.SportTypeId">
        @if (Model.IsMultiple)
        {
            <div class="sport-type-name">
                <div class="sport-type-name-ctrl">
                    <input type="checkbox"
                           class="cb-sporttypename"
                           data-sporttypeid="@item.SportTypeId" />
                </div>
                <div class="sport-type-name-text">
                    @item.SportTypeName
                </div>
            </div>
        }
        else
        {
            @item.SportTypeName
        }
    </div>

    var singleMatchParlayName = "SingleMatchParlay";
    var combo2Name = "Combo2";
    var combo35Name = "Combo35";
    var comboOver6Name = "ComboOver6";

    @RenderInputControl(item.SportTypeId, singleMatchParlayName, item.SingleMatchParlay, item.UplineSingleMatchParlay, Model.SingleMatchParlayFieldText, Model.IsMultiple)
    @RenderInputControl(item.SportTypeId, combo2Name, item.Combo2, item.UplineCombo2, Model.Combo2FieldText, Model.IsMultiple)
    @RenderInputControl(item.SportTypeId, combo35Name, item.Combo35, item.UplineCombo35, Model.Combo35FieldText, Model.IsMultiple)
    @RenderInputControl(item.SportTypeId, comboOver6Name, item.ComboOver6, item.UplineComboOver6, Model.ComboOver6FieldText, Model.IsMultiple)

    if (willRenderCheckBoxRow)
    {
        @RenderCheckBoxControl(item.SportTypeId, singleMatchParlayName, item.SingleMatchParlay, item.IsAllowUnlimitSingleMatchParlay, Model.IsMultiple)
        @RenderCheckBoxControl(item.SportTypeId, combo2Name, item.Combo2, item.IsAllowUnlimitCombo2, Model.IsMultiple)
        @RenderCheckBoxControl(item.SportTypeId, combo35Name, item.Combo35, item.IsAllowUnlimitCombo35, Model.IsMultiple)
        @RenderCheckBoxControl(item.SportTypeId, comboOver6Name, item.ComboOver6, item.IsAllowUnlimitComboOver6, Model.IsMultiple)
    }
}

@helper RenderInputControl(byte sportTypeId, string settingName, string value, string maxValue, string columnName, bool isMultiple)
{
    var unlimited = "Unlimited";
    var className = Model.GetClassName(sportTypeId);

    <div class="pmp-setting-control ctrl-input @className-@settingName">
        <input type="text"
               maxlength="14"
               id="@settingName@sportTypeId"
               class="tb-setting"
               data-columnname="@columnName"
               data-sporttypeid="@sportTypeId"
               data-settingname="@settingName"
               data-currentvalue="@value"
               data-maxvalue="@maxValue"
               data-cachedvalue="@(value == unlimited ? "0" : value)"
               value="@value"
               @(isMultiple || value == unlimited ? "disabled" : string.Empty) />
    </div>
    <div class="pmp-setting-control ctrl-max-setting @className-@settingName">@(maxValue == unlimited ? string.Empty : $"<= {maxValue}")</div>
}

@helper RenderCheckBoxControl(byte sportTypeId, string settingName, string value, bool isAllowUnlimit, bool isMultiple)
{
    var unlimited = "Unlimited";
    var className = Model.GetClassName(sportTypeId);

    <div class="pmp-setting-control ctrl-checkbox @className-@settingName">
        @if (isAllowUnlimit)
        {
            <input type="checkbox"
                   class="cb-setting"
                   data-sporttypeid="@sportTypeId"
                   data-tbsettingid="@settingName@sportTypeId"
                   @(value == unlimited ? "checked" : string.Empty)
                   @(isMultiple ? "disabled" : string.Empty) />
        }
    </div>
    <div class="pmp-setting-control ctrl-checkbox-label @className-@settingName">
        @(isAllowUnlimit ? unlimited : string.Empty)
    </div>

} *@