@using AlphaPlus.Core.Helpers
@using AlphaPlus.Settings.MemberInfo.Domain.AppResources
@using AlphaPlus.Settings.MemberInfo.Domain.Configurations
@using AlphaPlus.Settings.Site.Features.CreateAccount.ViewModels
@model CreateAccountViewModel
@{
    Layout = "~/MemberInfo/Features/CreateAccount/Views/_Layout.cshtml";
    var userguideLink = AppSettings.IsSiteLabel789y ?
        MicroSites.FeatureUrl("~/StaticMessage/Guide?id=179159") :
        MicroSites.FeatureUrl("~/Index.aspx?linktomessagesite=179159");

    var userSession = AlphaPlus.Core.Models.UserSession.Current;
}

@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode($"/bundles/common/common-{Model.CustLevel}")
    @StaticResources.RenderStyles("~/MemberInfo/Features/CreateAccount/bundles/create-account")
}

<div class="page-title">
    @Model.PageTitle
    &nbsp;<a href="@userguideLink" target="_blank"><span class="icon icon-information-outline"></span></a>
</div>
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation">
        @Html.ActionLink(Resources.SearchAndCopy, "Index", "CopyAccount")
    </li>
    <li role="presentation">
        <a href="@MicroSites.SettingUrl("~/_MemberInfo/SearchAndCopy/MasterPage.aspx")" role="tab" data-toggle="tab">@Resources.FullMode</a>
    </li>
    @if (Model.IsCreateMember)
    {
        <li class="has-icon" role="presentation">
            @Html.ActionLink(Resources.QRCode, "Index", "QRCodeMemberSignIn")
        </li>
    }
    <li role="presentation" class="new-function active">
        <a href="javascript:;" aria-controls="home" role="tab" data-toggle="tab">@Resources.LiteMode</a>
        <span class="bage-new">@Resources.lblNew</span>
    </li>
</ul>
@await Html.PartialAsync("~/MemberInfo/Features/CreateAccount/Views/QuickIntroduction.cshtml", new QuickIntroductionViewModel(userSession.UserName, userSession.Language))
@if (Model.IsLimitNewDownline)
{
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane active">
            <div class="msg msg-error">
                <span className="col-xs-12">@Model.ErrorMessage</span>
            </div>
        </div>
    </div>
}
else
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="SecretKey" value="@Model.SecretKey" />
    <div id="root" style="height:100%"></div>
    @section Scripts{
        @if (AppSettings.DevelopmentEnvironment)
        {
            <!-- if development -->
            <script type="module" src="http://localhost:5173/src/pages/createAccount.tsx"></script>
        }
        else
        {
            <!-- if production -->
            <link rel="stylesheet" href="~/MemberInfo/ClientApp/dist/assets/createAccount-7aaa218c.css" />
            <script type="module" src="~/MemberInfo/ClientApp/dist/assets/createAccount-179a7f97.js"></script>
        }
    }
}
@StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
@StaticResources.RenderScripts("~/MemberInfo/Features/CreateAccount/bundles/create-account")