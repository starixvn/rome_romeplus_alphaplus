@using AlphaPlus.Core.Helpers
@using AlphaPlus.Settings.MemberInfo.Domain.AppResources
@using AlphaPlus.Settings.MemberInfo.Domain.Configurations
<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewBag.Title ?? "Alpha - Member Information")</title>
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-memberinfo/default")
    @StaticResources.RenderStylesWithDarkMode("~/MemberInfo/assets/bundles/default")
    @RenderSection("Styles", required: false)
</head>
<body style="height:100%">
    <noscript>You need to enable JavaScript to run this app.</noscript>
    @RenderBody()
    @if (AppSettings.DevelopmentEnvironment)
    {
        <!-- if development -->
        <script type="module" src=@("http://localhost:5173/@vite/client")></script>
    }
    else
    {
        <!-- if production -->

        <link rel="stylesheet" href="~/MemberInfo/ClientApp/dist/assets/index-1ea51596.css" />
        <script type="module" src="~/MemberInfo/ClientApp/dist/assets/index-4db67b07.js"></script>
        <link rel="stylesheet" href="~/MemberInfo/ClientApp/dist/assets/PTSelect-07858f5e.css" />
        <script type="module" src="~/MemberInfo/ClientApp/dist/assets/PTSelect-f2d1cf29.js"></script>
    }
    @RenderSection("Scripts", required: false)
</body>
</html>