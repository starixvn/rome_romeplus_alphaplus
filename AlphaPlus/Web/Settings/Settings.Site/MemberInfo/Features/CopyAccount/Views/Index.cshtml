@* @model CopyAccountViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.SearchAndCopy;
    var errorMessageClass = string.IsNullOrEmpty(Model.Errormessage, CancellationToken cancellation) ? "hidden" : "msg msg-error";
    var userguideLink = AppSettings.IsSiteLabel789y ?
        MicroSites.MessageUrl("~/StaticMessage/Guide?id=179159") :
        MicroSites.HowToUseUrl("~/Index.aspx?linktomessagesite=179159");
}
@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode($"/bundles/common/common-{Model.ActorLevel.DisplayName}")
    @StaticResources.RenderStylesWithDarkMode("~/MemberInfo/Features/CopyAccount/bundles/copy-account")
}

<div class="page-title">
    @Model.PageTitle
    &nbsp;<a href="@userguideLink" target="_blank"><span class="icon icon-information-outline"></span></a>
</div>
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="active">
        <a href="javascript:;" aria-controls="home" role="tab" data-toggle="tab">@Resources.SearchAndCopy</a>
    </li>
    <li role="presentation">
        <a href="@MicroSites.OldMainUrl("~/_MemberInfo/SearchAndCopy/MasterPage.aspx")" role="tab" data-toggle="tab">@Resources.FullMode</a>
    </li>
    @if (Model.IsCreateMember)
    {
        <li class="has-icon" role="presentation">
            @Html.ActionLink(Resources.QRCode, "Index", "QRCodeMemberSignIn")
        </li>
    }
    @if (Model.IsOfferLiteMode)
    {
        <li role="presentation" class="new-function">
            @Html.ActionLink(Resources.LiteMode, "Index", "CreateAccount", new { lng = Model.Language, isDarkMode = Model.IsDarkMode.ToString().ToLowerInvariant() }, null)
            <span class="bage-new">@Resources.lblNew</span>
        </li>
    }
</ul>

<div class="tab-content">
    <div role="tabpanel" class="tab-pane active">
        @if (Model.IsLimitNewDownline)
        {
            <div class="@errorMessageClass">
                <span className="col-xs-12">@Model.ErrorMessage</span>
            </div>
        }
        else
        {
            <div class="panel @(@Model.ActorLevel.IsAgentLevel() ? "panel-agent" : "")">
                <div class="panel-heading">
                    <div class="note"><span class="require">*</span> @Resources.CopyAccountNote</div>
                </div>
                <div class="panel-body">
                    <form id="copyAccountForm" class="form-validation">
                        <div id="message" class="@errorMessageClass">
                            <span id="message-content" className="col-xs-12">@Model.ErrorMessage</span>
                        </div>
                        <div class="form-section">
                            <p class="section-title">@Resources.SourceAccount <span class="require">*</span></p>
                            <div class="form-group relative-input fixed-width">
                                <input type="text" name="SourceUsername" id="SourceUsername" class="source-username" placeholder="@Resources.UsernamePlaceHolder" />
                                <span id="icon-message-SourceUsername"></span>
                                <div id="sourceAccountErrMsg" class="error-input-text hidden"></div>
                            </div>
                            <div class="line"></div>
                        </div>
                        <div class="form-section">
                            <p class="section-title">@Resources.AccountDetails</p>
                            <p class="note">@Resources.AccountDetailsNote</p>

                            <div class="form-row">
                                <div class="form-column">
                                    <label class="sub-label">@Resources.lblUsername <span class="require">*</span></label>
                                    <div class="form-input form-select relative-input form-username">
                                        <span class="name-account" id="actor-name">@Model.ActorUsername</span>
                                        <select id="FirstSuffix" name="FirstSuffix">
                                            @foreach (var item in Model.NameSuffix)
                                            {
                                                <option value="@item" @(Model.FirstChar.Equals(item) ? "selected=\"selected\"" : string.Empty)> @item</option>
                                            }
                                        </select>
                                        <select id="SecondSuffix" name="SecondSuffix">
                                            @foreach (var item in Model.NameSuffix)
                                            {
                                                <option value="@item" @(Model.SecondChar.Equals(item) ? "selected=\"selected\"" : string.Empty)> @item</option>
                                            }
                                        </select>

                                        @if (Model.ActorLevel.IsAgentLevel())
                                        {
                                            <select id="ThirdSuffix" name="ThirdSuffix">
                                                @foreach (var item in Model.NameSuffix)
                                                {
                                                    <option value="@item" @(Model.ThirdChar.Equals(item) ? "selected=\"selected\"" : string.Empty)> @item</option>
                                                }
                                            </select>
                                        }
                                        <span id="icon-message-username" class="icon-check" />
                                    </div>
                                </div>
                                <div class="form-column">
                                    <label class="tooltip-search-account">@Resources.Password <span class="require">*</span><span data-toggle="tooltip" data-placement="bottom" title="@(Model.ActorLevel.IsAgentLevel() ? Resources.lblPasswordMemberRequire : Resources.lblPasswordRequire)"> <span class="icon-information-outline"></span> </span></label>
                                    <div class="relative-input">
                                        <input type="text" name="Password" class="input-pass" id="Password" autocomplete="off" maxlength="@(Model.ActorLevel.IsAgentLevel() ? 10 : 16)" />
                                        <span class="icon-eye-close icon show-pass" aria-hidden="true"></span>
                                        <span id="icon-message-password"> </span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-column">
                                    <label>@Resources.NoOfAccounts</label>
                                    <div class="form-input">
                                        <select id="NoOfAccounts" name="NoOfAccounts">
                                            @for (var index = 1; index <= AppSettings.MaxAccountsCreatePerRequest; index++)
                                            {
                                                <option value="@index"> @index</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="form-column">
                                    <label class="sub-label">@Resources.GivenCreditPerAccount <span class="require">*</span></label>
                                    <div class="form-input relative-input">
                                        <input type="text" name="Credit" id="Credit" value="0" maxlength="14" />
                                        <span id="icon-message-credit"></span>
                                        <div id="creditErrMsg" class="error-input-text hidden"></div>
                                    </div>
                                    <div id="credit-range" class="hidden sub-input">
                                        @Resources.AvailableGivenCredit: <span id="credit-max-label"></span>
                                    </div>
                                </div>

                                @if (Model.ActorLevel.IsMasterLevel())
                                {
                                    <div class="form-column">
                                        <label class="sub-label">@Resources.MaxCreditPerMember <span class="require">*</span></label>
                                        <div class="form-input relative-input">
                                            <input type="text" name="MemberMaxCredit" id="MemberMaxCredit" value="0" maxlength="14" />
                                            <span id="icon-message-member-max-credit"> </span>
                                            <div id="member-max-credit-range" class="hidden">
                                                <span id="member-credit-min-label"></span> <=  @Resources.MemberMaxCredit <= <span id="member-credit-max-label"></span>
                                            </div>
                                            <div id="memberMaxCreditErrMsg" class="error-input-text hidden"></div>
                                        </div>
                                    </div>

                                }
                            </div>
                            <div class="form-submit">
                                <button type="submit" class="btn-submit" id="btn-submit" disabled>@Resources.CreateAccount</button>
                            </div>
                        </div>
                        @Html.Hidden("HashKey", Model.HashKey)
                        @Html.Hidden("IsCreateAgent", Model.ActorLevel.IsMasterLevel())
                        @Html.Hidden("IsCreateMember", Model.ActorLevel.IsAgentLevel())
                        <input type="hidden" id="member-info-url" value="@MicroSites.MemberInfoUrl()" />
                        @Html.Hidden("InvalidMaxCreditPerAccount", Resources.InvalidMaxCreditPerAccount)
                        @Html.Hidden("InvalidMemberMaxCredit", Resources.InvalidMemberMaxCredit)
                        @Html.Hidden("old-version-url", MicroSites.OldMainUrl("~/_MemberInfo/SearchAndCopy/MasterPage.aspx"))
                        @Html.Hidden("ActorUsername", Model.ActorUsername)
                        @Html.AntiForgeryToken()
                    </form>
                    <div id="result" class="result hidden">
                    </div>
                    @Html.Hidden("copy", Resources.Copy)
                    @Html.Hidden("copied", Resources.Copied)
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @StaticResources.AssetScripts.Render("/bundles/site-asset/numeral")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-memberinfo/copy-account")
    @StaticResources.RenderScripts("~/MemberInfo/Features/CopyAccount/bundles/copy-account")
} *@