@using AlphaPlus.Core.Helpers
@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
@using AlphaPlus.Settings.Site.Features.MyWatchlist.MyWatchlistAccounts.ViewModels
@using AlphaPlus.Settings.Site.MemberInfo.Helpers
@model ManagePersonalThresholdPresetViewModel

@{
    Layout = "~/MemberInfo/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.PersonalThresholdPresetSettings;
}

@section Styles {
    @StaticResources.RenderStylesWithDarkMode("~/MemberInfo/Features/MyWatchlist/Shared/bundles/my-watchlist-settings")
    @StaticResources.RenderStylesWithMedia(767,
        "~/MemberInfo/Features/MyWatchlist/Shared/bundles/my-watchlist-settings-media")
}

@section Scripts {
    @StaticResources.RenderScripts("~/MemberInfo/Features/MyWatchlist/MyWatchlistAccounts/bundles/manage-presets")
}

<div class="box-settings">
    <div id="alert-message"></div>
    <table id="tbl-report" class="tblRpt tblRpt-bordered alternative-row-table tblRpt-hover" style="width: 100%">
        <thead>
            <tr>
                <th style="width: 55px;">@Resources.No</th>
                <th>@Resources.ThresholdPresetName</th>
                <th style="width: 195px;">@Resources.WinningThreshold</th>
                <th style="width: 195px;">@Resources.LosingThreshold</th>
                <th style="width: 90px;">@Resources.Action</th>
            </tr>
        </thead>
        <tbody id="table-body">
            @{
                RenderTable();
            }
        </tbody>
    </table>
    <div class="btn-group">
        <button class="btn-submit" id="btn-add">@Resources.AddRow</button>
        <button class="btn-submit" id="btn-save">@Resources.Save</button>
    </div>
</div>

@functions
{
    void RenderTable()
    {
        var index = 0;
        foreach (var preset in Model.PersonalPresets)
        {
            var winningThresholdString = HtmlHelpers.FormatDecimal(preset.WinningThreshold);
            var losingThresholdString = HtmlHelpers.FormatDecimal(preset.LosingThreshold);

            <tr id="preset-@index" data-index=@index data-id=@preset.ID data-title=@preset.PresetTitle
                data-winningthresholdstring=@winningThresholdString data-losingthresholdstring=@losingThresholdString
                class="preset">
                <td class="text-center">@(index + 1)</td>
                <td class="preset-title">@preset.PresetTitle</td>
                <td class="winning-threshold text-right">@winningThresholdString</td>
                <td class="losing-threshold text-right">@losingThresholdString</td>
                <td class="action">
                    <div class="edit-group">
                        <span class="icon-edit"></span>
                        <span class="icon-bin remove"></span>
                    </div>
                    <div class="confirm-group hidden">
                        <span class="icon-check"></span>
                        <span class="icon-close"></span>
                    </div>
                </td>
            </tr>
            index++;
        }
    }
}

@Html.AntiForgeryToken()
<input type="hidden" id="member-info-url" value="@MicroSites.SettingUrl()">
<input type="hidden" id="no-change-to-update-error" value="@Resources.NoChangeToUpdateError" />
<input type="hidden" id="are-you-sure-to-remove-preset" value="@Resources.AreYouSureToRemovePreset" />
<input type="hidden" id="add-successfully" value="@Resources.AddSuccessfully" />
<input type="hidden" id="remove-successfully" value="@Resources.RemoveSuccessfully" />
<input type="hidden" id="update-successfully" value="@Resources.WatchlistUpdateSuccessfully" />
<input type="hidden" id="preset-is-duplicated" value="@Resources.PresetNameIsDuplicated" />
<input type="hidden" id="preset-is-no-longer-exists" value="@Resources.PresetIsNoLongerExists" />
<input type="hidden" id="must-enter-threshold-error" value="@Resources.MustEnterThresholdError" />
<input type="hidden" id="must-enter-preset-name-error" value="@Resources.MustEnterPresetNameError" />
