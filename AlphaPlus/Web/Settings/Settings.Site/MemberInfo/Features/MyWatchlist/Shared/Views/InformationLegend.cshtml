@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
<div class="modal modal-sm fade" id="report-legend" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Resources.Information</h5>
                <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true"></span>
                </button>
            </div>
            <div class="modal-body">
                <p class="list-msg">
                    <span class="star"></span>@Resources.SupportsSportsbookDataOnly
                </p>
                <p class="list-msg">
                    <span class="star"></span>@Resources.AccumulatedMemberWinLossOnlyStartsCountingNote
                </p>
                <p class="list-msg">
                    <span class="star"></span>@Resources.AccumulatedMemberWinLossWillBeCountedNote
                </p>
            </div>
        </div>
    </div>
</div>