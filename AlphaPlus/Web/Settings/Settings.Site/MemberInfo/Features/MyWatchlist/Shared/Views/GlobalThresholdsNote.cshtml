@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
@using AlphaPlus.Settings.Site.Features.MyWatchlist.MyThresholds.ViewModels
@using AlphaPlus.Settings.Site.MemberInfo.Helpers
@using AlphaPlus.Settings.MemberInfo.Domain.Features.MyWatchlist.MyWatchlistAccounts.Models
@model GlobalThresholdModel
<p class="note">
    <span class="star"></span>@Resources.GlobalWinningThreshold:
    <span class="red">
        @if (Model != null)
        {
            @HtmlHelpers.FormatThreshold(Model.WinningThreshold)
        }
        else
        {
            @Resources.Unlimited
        }
    </span>; @Resources.GlobalLosingThreshold:
    <span class="red">
        @if (Model != null)
        {
            @HtmlHelpers.FormatThreshold(Model.LosingThreshold)
        }
        else
        {
            @Resources.Unlimited
        }
    </span>
</p>