@using AlphaPlus.Settings.MemberInfo.Domain.AppResources
@using AlphaPlus.Settings.Site.Features.MyWatchlist.MyWatchlistAccounts.ViewModels

@model ThresholdViewModel

<div class="form-group">
    <label class="lbl-threshold" for="winningThreshold">@Resources.WinningThreshold</label>
    <input class="txt-threshold text-right"
           type="text"
           id="winningThreshold"
           maxlength="18"
           autocomplete="off"
           value="@Html.Raw(FormatThreshold(Model.WinningThreshold))"
           @(Model.WinningThreshold == null ? "disabled" : string.Empty) />
    <input id="winning-unlimited" class="ckb-unlimited" type="checkbox" @(Model.WinningThreshold == null ? "checked" : string.Empty) />
    <label class="lbl-unlimited" for="winning-unlimited">@Resources.Unlimited</label>
</div>

<div class="form-group">
    <label class="lbl-threshold" for="losingThreshold">@Resources.LosingThreshold</label>
    <input class="txt-threshold text-right"
           type="text"
           id="losingThreshold"
           maxlength="18"
           autocomplete="off"
           value="@Html.Raw(FormatThreshold(Model.LosingThreshold))"
           @(Model.LosingThreshold == null ? "disabled" : string.Empty) />
    <input id="losing-unlimited" class="ckb-unlimited" type="checkbox" @(Model.LosingThreshold == null ? "checked" : string.Empty) />
    <label for="losing-unlimited" class="lbl-unlimited">@Resources.Unlimited</label>
</div>

<input type="hidden" id="must-enter-threshold-or-check-error" value="@Resources.MustEnterThresholdOrCheckError" />

@functions
{
    string FormatThreshold(decimal? number)
    {
        if (number.HasValue)
        {
            return AlphaPlus.Settings.Site.MemberInfo.Helpers.HtmlHelpers.FormatDecimal(number.Value);
        }

        return "0.00";
    }
}