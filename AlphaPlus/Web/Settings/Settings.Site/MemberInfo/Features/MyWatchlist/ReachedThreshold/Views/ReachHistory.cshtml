@using Newtonsoft.Json
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
@using AlphaPlus.Settings.Site.Features.MyWatchlist.ReachedThreshold.ViewModels
@using AlphaPlus.Settings.Site.MemberInfo.Helpers
@model ReachHistoryViewModel

@{
    Layout = "~/MemberInfo/Views/Shared/_Layout.cshtml";
}

@section Styles {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-asset/data-table")
    @StaticResources.RenderStylesWithDarkMode("~/MemberInfo/Features/MyWatchlist/Shared/bundles/my-watchlist")
    @StaticResources.RenderStylesWithMedia(767, "~/MemberInfo/Features/MyWatchlist/Shared/bundles/my-watchlist-media")
}

@section Scripts {
    <script type="text/javascript">
        var reachHistoryData = @Html.Raw(JsonConvert.SerializeObject(Model.ReachHistories, Formatting.None));
    </script>

    @StaticResources.AssetScripts.RenderCommon("/bundles/site-asset/data-table")
    @StaticResources.RenderScripts("~/MemberInfo/Features/MyWatchlist/ReachedThreshold/bundles/reach-history")
}

<table id="tblRpt" class="hidden tblRpt tblRpt-bordered tblRpt-hover display nowrap" style="width: 99%;">
    <thead>
        <tr>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
        </tr>
        <tr>
            <th class="header">@Resources.No</th>
            <th class="header">@Resources.DateTime</th>
            <th class="header">@Resources.ThresholdType</th>
            <th class="header">@Resources.WinningLosingAmount</th>
            <th class="header">@Resources.WinningThreshold</th>
            <th class="header">@Resources.LosingThreshold</th>
        </tr>
    </thead>
</table>

<input type="hidden" id="selected-cust-id" value="@Model.ReachHistoryQuery.SelectedCustId" />
<input type="hidden" id="from-date" value="@Model.ReachHistoryQuery.FromDate" />
<input type="hidden" id="to-date" value="@Model.ReachHistoryQuery.ToDate" />
<input type="hidden" id="limit-type" value="@Model.ReachHistoryQuery.LimitType" />
<input type="hidden" id="no-info" value="@Resources.NoInformationIsAvailable" />
<input type="hidden" id="reach-history-url" value="@Url.Action("GetReachHistoryList")" />
