@using Newtonsoft.Json
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
@using AlphaPlus.Settings.Site.Features.MyWatchlist.ReachedThreshold.ViewModels
@using AlphaPlus.Settings.Site.MemberInfo.Helpers
@using AlphaPlus.Settings.Site.Features.CustomerList.AppResources
@using AlphaPlus.Shared.AppResources.Settings.ProductResources
@model ReachedThresholdViewModel

@{
    Layout = "~/MemberInfo/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.ReachedThreshold;
}

@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode(
        $"/bundles/site-memberinfo/tab-{Model.CustLevel.ToLowerInvariant()}",
        "/bundles/site-memberinfo/daterangepicker",
        "/bundles/site-asset/data-table")
    @StaticResources.RenderStylesWithDarkMode("~/MemberInfo/Features/MyWatchlist/Shared/bundles/my-watchlist")
    @StaticResources.RenderStylesWithMedia(767, "~/MemberInfo/Features/MyWatchlist/Shared/bundles/my-watchlist-media")
}

@section Scripts {
    <script type="text/javascript">
        var reachlistAccountData = @Html.Raw(JsonConvert.SerializeObject(Model.ReachedThresholdPagingViewModel, Formatting.None));
    </script>

    @StaticResources.AssetScripts.RenderCommon("/bundles/site-asset/data-table")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-memberinfo/daterangepicker")
    @StaticResources.RenderScripts("~/MemberInfo/Features/QRCodeMemberSignIn/Scripts/EasyAutocomplete/jquery.easy-autocomplete")
    @StaticResources.RenderScripts("~/MemberInfo/Features/MyWatchlist/ReachedThreshold/bundles/reached-threshold")
}

<div class="reached-threshold">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="active">
            <a href="javascript:;" aria-controls="home" role="tab" data-toggle="tab">@Resources.ReachedThreshold</a>
        </li>
        <li role="presentation">
            @Html.ActionLink(Resources.MyWatchlist, "Index", "MyWatchlistAccounts")
        </li>
        <li role="presentation">
            @Html.ActionLink(Resources.MyThresholds, "Index", "MyThresholds")
        </li>
        @await Html.PartialAsync("~/MemberInfo/Features/MyWatchlist/Shared/Views/InfoUserGuideTabs.cshtml", Model.UserGuideLink)
    </ul>

    @using (Html.BeginForm("GetReachlistThreshold", "ReachedThreshold", FormMethod.Post, new { @class = "form-inline filter form-report", id = "report-form" }))
    {
        <div class="form-group username-box">
            <label>@Resources.Username</label>
            <input type="text" class="txt-search" id="txt-username" placeholder="@Resources.Username" />
        </div>
        @await Html.PartialAsync("~/MemberInfo/App_Code/Components/DateRangePicker.cshtml", Model.DateRangePickerViewModel)
        <div class="form-group">
            <label for="status-dropdown">@Resources.Status</label>
            @Html.DropDownList("status-dropdown", Model.StatusOptions, new { id = "status-dropdown" })
        </div>
        <div class="form-group">
            <label for="limit-type-dropdown" class="limit-type-dropdown">@Resources.ThresholdType</label>
            @Html.DropDownList("limit-type-dropdown", Model.LimitTypeOptions, new { id = "limit-type-dropdown" })
        </div>
        <div class="form-group">
            <input type="submit" value="@Resources.Submit" class="btn-submit" id="btn-submit" />
        </div>
        <div class="form-group">
            <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
        </div>
    }

    @await Html.PartialAsync("~/MemberInfo/Features/MyWatchlist/Shared/Views/GlobalThresholdsNote.cshtml", Model.GlobalThresholdModel)

    <table id="tblRpt" class="hidden tblRpt tblRpt-bordered tblRpt-hover display nowrap" style="width: 100%">
        <thead>
            <tr>
                @if (!Model.IsMobile)
                {
                    <th></th>
                }
                <th></th>
                @if (Model.IsShowLastLoginColumn)
                {
                    <th></th>
                }
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
            <tr>
                @if (!Model.IsMobile)
                {
                    <th class="header all padding-icon">
                        @Resources.No
                    </th>
                }
                <th class="header all username">@Resources.Username</th>
                @if (Model.IsShowLastLoginColumn)
                {
                    <th class="header">@Resources.LastLogin</th>
                }
                <th class="header">@Resources.Status</th>
                <th class="header">@Resources.ProblemAccount</th>
                <th class="header all last-reach">@Resources.LastReach</th>
                <th class="header">@Resources.LastThresholdType</th>
                <th class="header all winning-losing">@Resources.WinningLosingAmount</th>
                <th class="header">@Resources.LastWinningThreshold</th>
                <th class="header">@Resources.LastLosingThreshold</th>
                <th class="header">@Resources.ReachCount</th>
                <th class="header" style="width: 100px !important;"></th>
            </tr>
        </thead>
    </table>
</div>

<form class="form-inline hide" role="form" id="export-excel-form" action="@Url.Action("Excel")">
    @Html.Hidden("Username")
    @Html.Hidden("FromDate")
    @Html.Hidden("ToDate")
    @Html.Hidden("Status")
    @Html.Hidden("LimitType")
</form>

@await Html.PartialAsync("~/MemberInfo/Features/MyWatchlist/Shared/Views/InformationLegend.cshtml")
@Html.AntiForgeryToken()

<input type="hidden" id="search-account-id" value="@Model.SearchAccountId" />
<input type="hidden" id="member-info-url" value="@MicroSites.SettingUrl()" />
<input type="hidden" id="reach-history-popup-title" value="@Resources.ReachHistory" />
<input type="hidden" id="is-mobile" value='@(Model.IsMobile ? "true" : "false")' />
<input type="hidden" id="page-size" value="@Resources.PageSize" />
<input type="hidden" id="page" value="@Resources.Page" />
<input type="hidden" id="of" value="@Resources.Of" />
<input type="hidden" id="no-info" value="@Resources.NoInformationIsAvailable" />
<input type="hidden" id="is-show-last-login" value="@(Model.IsShowLastLoginColumn ? "true" : "false")" />
<input type="hidden" id="text-locked" value="@Resources.Locked" />
<input type="hidden" id="text-confirm-suspend-member" value="@ProductResources.ConfirmSuspendedViewModelInCaseSuspendedMemberMessage" />
<input type="hidden" id="suspended-text" value="@Resources.Suspended" />
<input type="hidden" id="can-update-account" value="@(Model.CanUpdateAccount ? "true" : "false")" />
