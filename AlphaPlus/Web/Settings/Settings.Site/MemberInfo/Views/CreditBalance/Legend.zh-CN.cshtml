@{
    Layout = null;
}
@using AlphaPlus.Settings.Site.ViewModels.CreditBalance
@using AlphaPlus.Settings.MemberInfo.Domain.AppResources

@model CreditBalanceViewModel

<div class="modal fade message-modal" id="report-legend" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="@Resources.ConditionToClearCredit"><span aria-hidden="true"></span></button>
                <h4 class="modal-title">@Resources.ConditionToClearCredit</h4>
            </div>
            <div class="modal-body">
                <div id="msg-content">
                    @if (Model.CustLevel.IsAgentLevel())
                    {
                        if (!string.IsNullOrWhiteSpace(Model.TransferCondition))
                        {
                            <p>- @Model.TransferCondition</p>
                        }
                        if (Model.IsViewingMemberList)
                        {
                            <p>- @Resources.CreditBalanceNote</p>
                        }
                        <p>- 任何会员在代理创建后超过14天未登录。</p>
                    }
                    else
                    {
                        <span>如果符合以下任何条件，下线的信用将被自动清除。</span>
                        if (Model.CustLevel.IsSuperLevel())
                        {
                            if (Model.IsViewingMemberList)
                            {
                                <p>- @Resources.CreditBalanceNote</p>
                            }
                            <ul class="list-msg">
                                <li>
                                    对于没有任何下线的总代理/代理：
                                    <p>- 任何总代理/代理在上线创建后超过7天未登录。</p>
                                </li>
                                <li>
                                    对于会员：
                                    <p>- 任何会员在代理创建后超过14天未登录。</p>
                                </li>
                            </ul>
                        }
                        else
                        {
                            if (Model.IsViewingMemberList)
                            {
                                <p>- @Resources.CreditBalanceNote</p>
                            }
                            <ul class="list-msg">
                                <li>
                                    对于没有任何下线的代理：
                                    <p>- 任何代理在总代理创建后超过7天未登录。</p>
                                </li>
                                <li>
                                    对于会员：
                                    <p>- 任何会员在代理创建后超过14天未登录。</p>
                                </li>
                            </ul>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

