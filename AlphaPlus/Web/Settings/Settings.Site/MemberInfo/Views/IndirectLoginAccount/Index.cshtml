@* @using Alpha.MemberInfo.Site.ViewModels.IndirectLoginAccount
@using Alpha.MemberInfo.Configurations;
@{
    ViewBag.Title = Resources.IndirectLoginAccount;

    var userguideLink = AppSettings.IsSiteLabel789y ?
        MicroSites.MessageUrl("~/StaticMessage/Guide?id=132782") :
        MicroSites.HowToUseUrl("~/Index.aspx?linktomessagesite=132782");
}
@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-totalbetsforecast/default")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/indirect-login-account/indirect-login-account")
}
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/indirect-login-account/manage-account")
}
@model ManageAccountViewModel
<div class="page-title">
    <span class="pull-left">@Resources.IndirectLoginAccount</span>
    &nbsp;<a href="@userguideLink" target="_blank"><span class="icon icon-information-outline"></span></a>
</div>
<div class="content-page">
    <div class="list-button">
        <input type="button" class="btn-submit" value="@Resources.ConnectToNewAccount" id="btn-connectToNewAccount" />
    </div>
    <table class="tblRpt tblRpt-bordered tblRpt-hover width-100per">
        <thead>
            <tr>
                <th>@Resources.Username</th>
                <th>@Resources.Level</th>
                <th>@Resources.Status</th>
                <th>@Resources.LockStatus</th>
                <th>@Resources.IndirectLogIn</th>
                <th>@Resources.Disconnect</th>
            </tr>
        </thead>
        @if (Model.Accounts.Any())
        {
            <tbody>
                @foreach (var account in Model.Accounts)
                {
                    <tr data-custid="@account.CustId" data-subaccid="@account.SubAccId" data-custname="@account.Username">
                        <td>@account.Username</td>
                        <td class="text-center">@account.LevelName</td>
                        <td class="text-center">@account.Status</td>
                        <td class="text-center">@account.LockedStatus</td>
                        <td class="text-center">
                            @if (!account.Enabled || account.Closed || account.Locked != 0)
                            {
                                <span class="icon icon-indirect-login disabled"></span>
                            }
                            else
                            {
                                @Html.ActionLink(" ", "Redirect", new { custId = account.CustId, subAccId = account.SubAccId, custname = account.Username }, new { @class = "icon icon-indirect-login", target = "_blank" })
                            }
                        </td>
                        <td class="text-center">
                            <span class="icon icon-disconnect"></span>
                        </td>
                    </tr>
                }
            </tbody>
        }
        else
        {
            @NoInformation.Render(6);
        }
    </table>
</div>
<input type="hidden" value="@Model.RootURL" id="txt-rootURL" />
@Html.Partial("~/Views/IndirectLoginAccount/Introduction/QuickIntroduction.cshtml") *@