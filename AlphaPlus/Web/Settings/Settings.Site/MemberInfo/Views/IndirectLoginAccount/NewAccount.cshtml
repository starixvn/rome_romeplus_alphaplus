@using AlphaPlus.Settings.MemberInfo.Domain.AppResources
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Settings.Site.MemberInfo.Helpers

@{
    ViewBag.Title = Resources.NewIndirectLoginAccount;
}
@section Styles {
    @StaticResources.RenderStylesWithDarkMode("~/MemberInfo/assets/bundles/indirect-login-account/indirect-login-account")
}
@section Scripts {
    @StaticResources.RenderScripts("~/MemberInfo/assets/bundles/indirect-login-account/new-account")
}
@model string
@Alert.Render()
@using (Html.BeginForm("NewAccount", "IndirectLoginAccount", FormMethod.Post, new { @class = "form-validation", id = "form-account" }))
{
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label for="txt-custname">@Resources.YourDownlineUsernameOrNickname</label>
        <input type="text" id="txt-custname" />
    </div>
    <div class="form-group">
        <label for="txt-password">@Resources.Password</label>
        <input type="password" id="txt-password" />
    </div>
    <div class="form-group">
        <input type="checkbox" id="chk-showPassword" />
        <label for="chk-showPassword">@Resources.ShowPassword</label>
    </div>
    <div class="form-group">
        <button type="submit" class="btn-submit">@Resources.Connect</button>
    </div>
}
<input type="hidden" value="@Model" id="txt-hashkey" />
<input type="hidden" value="@Resources.RequiredPasswordError" id="txt-requiredPasswordError" />
<input type="hidden" value="@Resources.RequiredYourDownlineUsernameOrNicknameError" id="txt-requiredYourDownlineUsernameOrNicknameError" />
