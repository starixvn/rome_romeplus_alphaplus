@* @using Alpha.MemberInfo.Site.ViewModels.IndirectLoginAccount
@{
    ViewBag.Title = Resources.IndirectLoginAccountPasswordUpdated;
}
@section Styles {
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/indirect-login-account/indirect-login-account")
}
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/indirect-login-account/update-account")
}
@model UpdatePasswordViewModel
@Alert.Render()
<p>@Resources.UpdatePasswordHint</p>
<p>@Resources.Username: <strong>@Model.CustName</strong></p>
@using (Html.BeginForm("UpdatePassword", "IndirectLoginAccount", FormMethod.Post, new { @class = "form-validation", id = "form-account" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" value="@Model.CustId" id="txt-custId" />
    <input type="hidden" value="@Model.SubAccId" id="txt-subAccId" />
    <input type="hidden" value="@Model.CustName" id="txt-custname" />

    <div class="form-group">
        <label for="txt-password">@Resources.Password</label>
        <input type="password" id="txt-password" />
    </div>
    <div class="form-group">
        <input type="checkbox" id="chk-showPassword" />
        <label for="chk-showPassword">@Resources.ShowPassword</label>
    </div>
    <div class="form-group">
        <button type="submit" class="btn-submit">@Resources.Login</button>
    </div>
}

<input type="hidden" value="@Model.HashKey" id="txt-hashkey" />
<input type="hidden" value="@Resources.RequiredPasswordError" id="txt-requiredPasswordError" />
<input type="hidden" value="@Resources.RequiredYourDownlineUsernameOrNicknameError" id="txt-requiredYourDownlineUsernameOrNicknameError" />

@using (Html.BeginForm("Redirect", "IndirectLoginAccount", FormMethod.Get, new { @class = "hidden", name = "formRedirect", target = "_blank" }))
{
    @Html.HiddenFor(m => m.CustId)
    @Html.HiddenFor(m => m.SubAccId)
    @Html.HiddenFor(m => m.CustName)
    <input type="hidden" id="txt-browserSize" />
} *@
