@using AlphaPlus.Core.Helpers

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@(ViewBag.Title ?? "Alpha - Member Information")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />

    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-memberinfo/default")
    @StaticResources.RenderStylesWithDarkMode("~/MemberInfo/assets/bundles/default")
    @RenderSection("Styles", required: false)
    @AlphaPlus.Core.Helpers.GoogleAnalyticHelper.GtagScript()
</head>
<body>
    @AlphaPlus.Core.Helpers.GoogleAnalyticHelper.GtagNoScript()
    @RenderBody()
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-memberinfo/default")
    @RenderSection("Scripts", required: false)
    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
</body>
</html>