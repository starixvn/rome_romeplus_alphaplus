@* @using Alpha.MemberInfo.Site.ViewModels.ProblemAccount
@model ConfirmAddToWatchlistViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.AddMultipleToWatchlist;
}

@section Styles {
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/problem-account/confirm-add-to-watchlist")
    @StaticResources.RenderStylesWithMedia(767, "~/Features/MyWatchlist/Shared/Bundles/my-watchlist-settings-media")
}

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/problem-account/confirm-add-to-watchlist")

}

<div class="box-settings flex-settings">
    <div class="content-settings">

        @if (Model.HasAlreadyAddedAccounts)
        {
            if (Model.IsShowAllAlreadyAddedAccounts)
            {
                <div class="shorten-content red">
                    <span class="total">@string.Format(Resources.AccountsAlreadyInWatchlist, Model.NoOfAlreadyAddedAccounts):</span>
                    @(string.Join(", ", Model.ShortenAlreadyAddedUsernames))
                </div>
                <span class="more-ellipses">...</span>
                <div class="more-content red">
                    <span>@($", {string.Join(", ", Model.MoreAlreadyAddedUsernames)}")</span>
                    <a href="#" id="already-more" class="more-link">@Resources.ShowMore</a>
                </div>

                <div id="already-less" class="less-content" style="display: none;">
                    <a href="#" class="less-link">@Resources.ShowLess</a>
                </div>
            }
            else
            {
                <p class="red">
                    <span class="total">@string.Format(Resources.AccountsAlreadyInWatchlist, Model.NoOfAlreadyAddedAccounts):</span>
                    @Model.AlreadyAddedAccounts
                </p>
            }
        }
        <p></p>
        @if (Model.IsExceedLimit)
        {
            <p class="red">@Resources.AddMultipleToWatchlistExceedMessage  </p>
        }
        <p></p>
        @if (Model.HasNewlyAddedAccounts)
        {
            <div>
                @if (Model.IsShowAllNewlyAddedAccounts)
                {
                    <div class="shorten-content">
                        <span class="total">
                            @(Model.NoOfNewlyAddedAccounts) @Resources.SelectedAccounts
                        </span>
                        @(string.Join(", ", Model.ShortenNewlyAddedUsernames))
                    </div>
                    <span class="more-ellipses">...</span>
                    <div class="more-content">
                        <span>@($", {string.Join(", ", Model.MoreNewlyAddedUsernames)}")</span>
                        <a href="#" id="newly-more" class="more-link">@Resources.ShowMore</a>
                    </div>

                    <div id="newly-less" class="less-content" style="display: none;">
                        <a href="#" class="less-link">@Resources.ShowLess</a>
                    </div>
                }
                else
                {
                    <p class="note">
                        <span class="total">
                            @Model.NoOfNewlyAddedAccounts @Resources.NewlyAddedAccounts:
                        </span>
                        @Model.NewlyAddedAccounts
                    </p>

                }
                <div class="message">
                    @Html.Raw(@Resources.AddToWatchListConfirmThresholds)
                </div>
            </div>
        }
    </div>
</div>
<div class="list-button">
    <button class="btn-submit" id="btnSubmit" @(!Model.HasNewlyAddedAccounts ? "disabled" : "")>@Resources.SetThresholds</button>
    <input type="button" class="btn-cancel" id="btnCancel" value="@Resources.Cancel" />
</div>
@Html.AntiForgeryToken()

@Html.Hidden("member-info-url", MicroSites.MemberInfoUrl())
@Html.Hidden("NewlyAddedAccounts", @Model.NewlyAddedAccounts) *@