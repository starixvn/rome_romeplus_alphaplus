<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AlphaPlus.Tickets.API</AssemblyName>
    <RootNamespace>AlphaPlus.Tickets.API</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\Shared\Extensions\FanexDataExtensions.cs" Link="Extensions\FanexDataExtensions.cs" />
    <Compile Include="..\..\..\Shared\Extensions\FanexLoggingExtensions.cs" Link="Extensions\FanexLoggingExtensions.cs" />
    <Compile Include="..\..\..\Shared\Extensions\RemotingRefExtensions.cs" Link="Extensions\RemotingRefExtensions.cs" />
    <Compile Include="..\..\..\Shared\ExceptionHelper.cs" Link="Helpers\ExceptionHelper.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.3.4.5" />
    <PackageReference Include="Fanex.Logging.RabbitMQ" Version="1.0.1" />
    <PackageReference Include="Fanex.Logging.Sentry" Version="5.0.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.16" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BetsForecast\Infrastructure\BetsForecast.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="App_Data\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>