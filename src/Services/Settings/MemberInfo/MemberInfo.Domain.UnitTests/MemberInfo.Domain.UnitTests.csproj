      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="AutoFixture.Xunit2" Version="4.18.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MemberInfo.Domain\MemberInfo.Domain.csproj" />
    <ProjectReference Include="..\..\..\Modules\AlphaPlus.Core\AlphaPlus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Moq" />
    <Using Include="AutoFixture" />
    <Using Include="AlphaPlus.Settings.MemberInfo.Domain" />
    <Using Include="AlphaPlus.Settings.MemberInfo.Domain.Constants" />
    <Using Include="AlphaPlus.Settings.MemberInfo.Domain.Extensions" />
    <Using Include="AlphaPlus.Settings.MemberInfo.Domain.Models" />
