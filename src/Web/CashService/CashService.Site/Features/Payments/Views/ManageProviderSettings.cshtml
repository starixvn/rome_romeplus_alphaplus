@using AlphaPlus.CashService.Site.Features.Payments.ViewModels
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Manage Provider Settings";
    Layout = "_Layout";
}
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model ProviderSettingsViewModel
<div id="root"></div>

<script>
    window.providerSettingsViewModel = @Html.Raw(JsonConvert.SerializeObject(Model));
    // Initialize language from localStorage or fallback to model's language
    const storedLanguage = localStorage.getItem('i18nextLng');
    window.language = storedLanguage || "@Model.Language";
    
    // Function to change language
    window.changeLanguage = function(lang) {
        localStorage.setItem('i18nextLng', lang);
        window.language = lang;
        // Reload the page to apply the new language
        window.location.reload();
    };
</script>

<environment names="Development">
    <script type="module" src="http://localhost:5173/src/pages/PaymentProviderSettings/index.tsx"></script>
</environment>
<environment names="Production">
    <script type="module" asp-src-include="/paymentProviderSettings-*.js"></script>
</environment>