@{
    ViewData["Title"] = "Member Sites";
    Layout = "_Layout";
}
@inject IConfiguration Configuration

@section Styles {
    <environment names="Production">
        <link rel="stylesheet" asp-href-include="/index-*.css" />
    </environment>
}

<div id="root"></div>

<script>
    window.custId = "1234567890";
    window.cashServiceAPIUrl = "@Configuration["CashServiceAPIUrl"]";
</script>


<environment names="Development">
    <script type="module" src="http://localhost:5173/src/pages/Transactions/History/index.tsx"></script>
</environment>
<environment names="Production">
    <script type="module" asp-src-include="/transactionsHistory-*.js"></script>
</environment>