@using AlphaPlus.Core.Models
@inject IUserSession UserSession
@inject IConfiguration Configuration;
@{
    var hideUpcomingPromotion = Configuration.GetValue<bool>("HideUpcomingPromotion");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="description">
    <meta content="" name="author">
    <title>@ViewData["Title"]</title>
    @await RenderSectionAsync("Styles", required: false)
    <environment include="Development">
        <script type="module">
            import RefreshRuntime from 'http://localhost:5173/@@react-refresh'
            RefreshRuntime.injectIntoGlobalHook(window)
            window.$RefreshReg$ = () => { }
            window.$RefreshSig$ = () => (type) => type
            window.__vite_plugin_react_preamble_installed__ = true
        </script>
        <script type="module" src=@("http://localhost:5173/@vite/client")></script>
    </environment>
</head>

<body class="view-@UserSession.SiteName.ToLowerInvariant()"
    data-theme="@(string.IsNullOrWhiteSpace(UserSession.DarkModeName) ? "light" : "dark")">
    <span id="user-currency" hidden="">@UserSession.Currency</span>
    <input hidden id="HideUpcomingPromotion" value="@hideUpcomingPromotion.ToString().ToLowerInvariant()" />
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>