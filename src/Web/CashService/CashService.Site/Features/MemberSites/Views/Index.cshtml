@{
    ViewData["Title"] = "Member Sites";
    Layout = "_Layout";
}
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<div id="root" data-theme="@(string.IsNullOrWhiteSpace(Model.DarkModeName) ? "" : "dark")"></div>

@section Styles {
    <environment names="Production">
        <link rel="stylesheet" asp-href-include="/index-*.css" />
    </environment>
}

<environment names="Development">
    <script type="module" src="http://localhost:5173/src/pages/MemberSites/index.tsx"></script>
</environment>
<environment names="Production">
    <script type="module" asp-src-include="/memberSites-*.js"></script>
</environment>

<input type="hidden" name="__RequestVerificationToken" value="@ViewData["RequestVerificationToken"]" /> 
<input type="hidden" id="IsCashServiceEnabled" value="@Model.IsCashServiceEnabled" />