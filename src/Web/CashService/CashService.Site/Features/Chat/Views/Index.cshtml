@{
    ViewData["Title"] = "Chat";
}

<div class="container-fluid">
    <div class="row">
        <!-- Online Users Panel -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Online Users</h5>
                </div>
                <div class="card-body">
                    <ul id="onlineUsers" class="list-group">
                    </ul>
                </div>
            </div>
        </div>

        <!-- Chat Area -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Chat</h5>
                </div>
                <div class="card-body">
                    <div id="messageList" class="chat-messages" style="height: 400px; overflow-y: auto;">
                    </div>
                    <div id="typingIndicator" class="typing-indicator" style="display: none;">
                        Someone is typing...
                    </div>
                    <div class="input-group mt-3">
                        <input type="text" id="messageInput" class="form-control" placeholder="Type your message...">
                        <button id="sendButton" class="btn btn-primary">Send</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Groups Panel -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Groups</h5>
                </div>
                <div class="card-body">
                    <div class="input-group mb-3">
                        <input type="text" id="groupNameInput" class="form-control" placeholder="Group name">
                        <button id="joinGroupButton" class="btn btn-success">Join</button>
                    </div>
                    <ul id="groupList" class="list-group">
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/signalr.js"></script>
<script src="~/js/chat.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const chat = new ChatClient();
        
        // Message handling
        chat.on('ReceiveMessage', ({ user, message }) => {
            addMessage(user, message);
        });

        chat.on('ReceivePrivateMessage', ({ fromUser, message }) => {
            addMessage(`${fromUser} (private)`, message, 'private-message');
        });

        chat.on('ReceiveGroupMessage', ({ user, message }) => {
            addMessage(`${user} (group)`, message, 'group-message');
        });

        // User events
        chat.on('UserConnected', ({ user }) => {
            addSystemMessage(`${user} connected`);
            updateOnlineUsers();
        });

        chat.on('UserDisconnected', ({ user }) => {
            addSystemMessage(`${user} disconnected`);
            updateOnlineUsers();
        });

        chat.on('OnlineUsers', ({ users }) => {
            updateOnlineUsersList(users);
        });

        // Typing indicator
        chat.on('UserTyping', ({ user, isTyping }) => {
            const typingIndicator = document.getElementById('typingIndicator');
            typingIndicator.textContent = isTyping ? `${user} is typing...` : '';
            typingIndicator.style.display = isTyping ? 'block' : 'none';
        });

        // Group events
        chat.on('UserJoinedGroup', ({ userId, groupName }) => {
            addSystemMessage(`${userId} joined group ${groupName}`);
        });

        chat.on('UserLeftGroup', ({ userId, groupName }) => {
            addSystemMessage(`${userId} left group ${groupName}`);
        });

        // UI Event Handlers
        document.getElementById('sendButton').addEventListener('click', sendMessage);
        document.getElementById('messageInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        document.getElementById('joinGroupButton').addEventListener('click', () => {
            const groupName = document.getElementById('groupNameInput').value.trim();
            if (groupName) {
                chat.joinGroup(groupName);
                addGroupToList(groupName);
                document.getElementById('groupNameInput').value = '';
            }
        });

        // Typing indicator
        let typingTimeout;
        document.getElementById('messageInput').addEventListener('input', () => {
            chat.sendTypingIndicator('CurrentUser', true);
            clearTimeout(typingTimeout);
            typingTimeout = setTimeout(() => {
                chat.sendTypingIndicator('CurrentUser', false);
            }, 1000);
        });

        // Helper functions
        function addMessage(user, message, className = '') {
            const messageList = document.getElementById('messageList');
            const messageElement = document.createElement('div');
            messageElement.className = `message ${className}`;
            messageElement.innerHTML = `<strong>${user}:</strong> ${message}`;
            messageList.appendChild(messageElement);
            messageList.scrollTop = messageList.scrollHeight;
        }

        function addSystemMessage(message) {
            const messageList = document.getElementById('messageList');
            const messageElement = document.createElement('div');
            messageElement.className = 'system-message';
            messageElement.textContent = message;
            messageList.appendChild(messageElement);
            messageList.scrollTop = messageList.scrollHeight;
        }

        function updateOnlineUsersList(users) {
            const onlineUsersList = document.getElementById('onlineUsers');
            onlineUsersList.innerHTML = '';
            users.forEach(user => {
                const li = document.createElement('li');
                li.className = 'list-group-item';
                li.textContent = user;
                onlineUsersList.appendChild(li);
            });
        }

        function addGroupToList(groupName) {
            const groupList = document.getElementById('groupList');
            const li = document.createElement('li');
            li.className = 'list-group-item d-flex justify-content-between align-items-center';
            li.innerHTML = `
                ${groupName}
                <button class="btn btn-sm btn-danger leave-group" data-group="${groupName}">Leave</button>
            `;
            groupList.appendChild(li);

            li.querySelector('.leave-group').addEventListener('click', () => {
                chat.leaveGroup(groupName);
                li.remove();
            });
        }

        function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const message = messageInput.value.trim();
            if (message) {
                chat.sendMessage('CurrentUser', message);
                messageInput.value = '';
            }
        }

        // Start the chat
        chat.start();
    });
</script>

<style>
    .chat-messages {
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 10px;
        margin-bottom: 10px;
    }

    .message {
        margin-bottom: 8px;
        padding: 5px;
        border-radius: 4px;
    }

    .private-message {
        background-color: #e3f2fd;
    }

    .group-message {
        background-color: #f1f8e9;
    }

    .system-message {
        color: #666;
        font-style: italic;
        margin: 5px 0;
    }

    .typing-indicator {
        color: #666;
        font-style: italic;
        margin: 5px 0;
    }
</style>