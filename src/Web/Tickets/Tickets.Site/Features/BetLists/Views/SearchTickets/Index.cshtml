@using AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.SearchTickets
@model SearchTicketsViewModel
@{
    ViewData["Title"] = Model.Title;
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/common/common")
    @StaticResources.AssetStyles.Render("/bundles-v2/site-betlists/search-tickets")
    <link rel="stylesheet" href="~/bundles/betlists/search-tickets.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/bundles/betlists/search-tickets.js" asp-append-version="true"></script>
}
<div class="bl_title">
    <div class="box">
        <div>@Model.Title</div>
        <div>
            <partial name="IconInformation"
                model="new[] { Resources.ipnote, Model.ViewDataInstructionMessage, CommonResx.MemberWinNote }" />
        </div>
    </div>
</div>
<form method="get" class="form-inline search-ticket filter" role="form" id="betlist-form" asp-action="BetData">
    <div class="form-group">
        <label>@Resources.RefNo<span class="red">&nbsp;*</span></label>
        <input type="number" id="ref-no" class="form-control" autocomplete="off" />
    </div>
    <div class="form-group">
        <input type="submit" value="@Resources.Submit" class="btn-submit" id="btn-submit" disabled />
    </div>
</form>
<div id="tbl-betlist-box">
    <partial name="WinLossTableNew" model="Model" />
</div>
