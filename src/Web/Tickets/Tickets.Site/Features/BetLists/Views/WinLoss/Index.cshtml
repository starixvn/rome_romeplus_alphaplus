@{
    ViewData["Title"] = Model.Title;
    var notes = new List<string> { Resources.ipnote, Resources.CommissionRoundNote };
    if (Model.ShowContributionAmountRoundNote)
    {
        notes.Add(Resources.ContributionAmountRoundNote);
    }
}
@section Scripts {
    @StaticResources.RenderScripts("~/bundles/betlists/betlist-feedback")
}
@model AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.WinLoss.WinLossViewModel
@if (!string.IsNullOrWhiteSpace(Model.BetListData.OutputParams.ErrMsg))
{
    <div style="border: 1px solid #f00; color: #f00; padding: 10px">@Model.BetListData.OutputParams.ErrMsg</div>
}
<div class="bl_title">
    <div class="box">
        <div>@Model.Title</div>
        <div>
            <partial name="IconInformation" model="@notes" />
        </div>
        <div class="left-icon-title">
            <compact-feedback fid="54" />
            <div class="bl-export-excel">
                <a class="icon icon-excel" title="@Resources.ExportToExcel" asp-action="Excel"
                    asp-all-route-data="Model.GetExcelParams()"></a>
            </div>
        </div>
    </div>
</div>
<partial name="WinLossTable" model="Model" />
