@{
    ViewData["Title"] = Model.Title;
    var notes = new List<string> { Resources.ipnote, Model.ViewDataInstructionMessage, Resources.CommissionRoundNote };
    if (Model.ShowContributionAmountRoundNote)
    {
        notes.Add(Resources.ContributionAmountRoundNote);
    }

    notes.Add(CommonResx.MemberWinNote);
}
@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-betlists/filter")
    @StaticResources.RenderStyles("~/bundles/betlists/filter")
}
@section Scripts {
    @StaticResources.AssetScripts.Render("/bundles/site-betlists/filter")
    @StaticResources.RenderScripts("~/bundles/betlists/member-betlist")
}
@model AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.MemberBetList.MemberBetListViewModel
<div class="bl_title">
    <div class="box">
        <div>@Model.Title</div>
        <div>
            <partial name="IconInformation" model="@notes" />
        </div>
        <div class="push">
            <div class="list-icon" id="betlist-filter">
                <ul>
                    <li class="showfilter-element"><span class="icon-arrow-up-drop-circle icon-filter"
                            title="@Resources.HideFilter"></span></li>
                    <li class="hidefilter-element"><span class="icon-arrow-down-drop-circle icon-filter"
                            title="@Resources.ShowFilter"></span></li>
                </ul>
            </div>
        </div>
    </div>
</div>
<form class="form-inline filter @(Model.IsFilterVisible ? string.Empty : "hide")" role="form" id="betlist-form">
    <input type="hidden" asp-for="CustId" />
    <input type="hidden" asp-for="CustName" />
    <input type="hidden" asp-for="IsFilterVisible" />
    <div class="form-group">
        <select id="dropdown-betlist-type">
            <option value="1" data-url="@Model.GetDailyStatementUrl()">@Resources.DailyStatement</option>
            <option value="2" selected="selected">@Resources.BetList</option>
            <option value="3" data-url="@Model.GetRunningBetListUrl()">@Resources.BetlistRunning</option>
        </select>
    </div>
    <product model="@Model.ProductViewModel" />
    <daterange-picker model="Model.DateRangePicker" />
    @if (Model.BetListData.Total > 0)
    {
        <div class="form-group">
            <compact-feedback fid="52" />
        </div>
    }
</form>
<partial name="WinLossTable" model="Model" />
