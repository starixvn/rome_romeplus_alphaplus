@{
    ViewData["Title"] = Model.Title;
}
@section Scripts {
    @StaticResources.RenderScripts("~/bundles/betlists/betlist-feedback")
}
@model AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.RiskAnalysisIPMatching.RiskAnalysisIPMatchingViewModel
<div class="bl_title">
    <div class="box">
        <div>@Model.Title</div>
        <div>
            <partial name="IconInformation"
                model="new[] { Resources.ipnote, Resources.CommissionRoundNote, CommonResx.MemberWinNote }" />
        </div>
        <div class="left-icon-title">
            <compact-feedback fid="100" />
            <div class="bl-export-excel">
                <a asp-action="Excel" asp-route-ip="@Model.IP" asp-route-date="@Model.Date" class="icon icon-excel"
                    title="@Resources.ExportToExcel"></a>
            </div>
        </div>
    </div>
</div>
<partial name="WinLossTable" model="Model" />
