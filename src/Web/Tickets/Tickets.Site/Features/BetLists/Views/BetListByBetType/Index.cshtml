@{
    ViewData["Title"] = Model.Title;
}
@section Scripts {
    @StaticResources.RenderScripts("~/bundles/betlists/betlist-feedback")
}
@model AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.BetListByBetType.BetListByBetTypeViewModel
<div class="bl_title">
    <div class="box">
        <div>@Model.Title</div>
        <div>
            <partial name="IconInformation" model="new[] { Resources.ipnote, CommonResx.MemberWinNote }" />
        </div>
        <div class="left-icon-title">
            @if (Model.BetListData.Total > 0)
            {
                <compact-feedback fid="@Model.FeedbackFuncId" />
            }
            <div class="bl-export-excel">
                <a asp-action="@(Model.FuncName)Excel" asp-route-bettype="@Model.BetType" class="icon icon-excel"
                    title="@Resources.ExportToExcel"></a>
            </div>
        </div>
    </div>
</div>
<partial name="TableWithoutWinLoss" model="Model" />
