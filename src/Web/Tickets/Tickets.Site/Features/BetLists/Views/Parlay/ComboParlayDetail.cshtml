@using AlphaPlus.Tickets.Site.Features.BetLists.ViewModels.Parlay
@{
    ViewBag.Title = Model.Title;
    async Task RenderDetailItems(IGrouping<string, ComboParlayDetailWrapper> groupDetailItem)
    {
        var showWinLostDate = false;
        foreach (var item in groupDetailItem)
        {
            <tr>
                @if (!showWinLostDate)
                {
                    <td class="text-center" rowspan="@groupDetailItem.Count()">
                        <div class="divWidth80">
                            @groupDetailItem.Key
                        </div>
                    </td>
                    showWinLostDate = true;
                }
                <td class="text-left">
                    @foreach (var eventDetail in item.Events)
                    {
                        <div class="divEvent">@eventDetail</div>
                    }
                </td>
                <td class="text-right bl_underdog">
                    <div class="divWidth80">
                        @if (Model.IsHaveExtraInfo && @item.Odds != @item.MasterOdds)
                        {
                            <bet-builder-plus-odds original-odds="@item.Odds" odds="@item.MasterOdds" />
                        }
                        else if (Model.IsParlayBoost)
                        {
                            <parlay-boost-odds original-odds="@item.Odds" boost-odds="@item.MasterOdds" boost-rate="@item.BoostRate" />
                        }
                        else
                        {
                            @Html.Raw(item.MasterOdds);
                        }
                    </div>
                </td>
                <td class="text-right bl_underdog">
                    <div class="divWidth80">
                        @Html.Raw(item.Stake)
                    </div>
                </td>
                <td class="text-right">
                    <div class="bl_underdog divWidth80">@Html.Raw(item.WinLost)</div>
                    <div class="bl_underdog divWidth80">@Html.Raw(item.Comm)</div>
                </td>
                <td class="text-center bl_status">
                    <div class="divWidth50">
                        @item.Status
                    </div>
                </td>
            </tr>
        }
    }
}
@section Styles {
    <link rel="stylesheet" href="~/bundles/betlists/parlay-detail.css" asp-append-version="true" />
}
@model ComboParlayDetailViewModel
@if (Model.IsDataTooHuge)
{
    <div class="break-word">
        @Html.Raw(Model.HugeDataLabel)
    </div>
}
else
{
    if (Model.IsMobile)
    {
        <partial name="ComboParlayDetailMobile" model="Model" />
    }
    else
    {
        <div class="over-flow-y-auto">
            <table class="tblRpt tblRpt-bordered tblRpt-striped tablesorter tblRpt-hover">
                <thead>
                    <tr>
                        <th>
                            <div class="divWidth80">@Resources.date</div>
                        </th>
                        <th>
                            <div class="divEvent">@Resources.events</div>
                        </th>
                        <th>
                            <div class="divWidth80">@Resources.odds</div>
                        </th>
                        <th>
                            <div class="divWidth80">@Resources.stake</div>
                        </th>
                        <th>
                            <div class="divWidth80">@Resources.lblWinLoss</div>
                        </th>
                        <th>
                            <div class="divWidth50">@Resources.status</div>
                        </th>
                    </tr>
                </thead>
            </table>
        </div>
        <div class="divParlayDetail">
            <table class="tblRpt tblRpt-bordered tblRpt-striped tablesorter tblRpt-hover">
                <tbody>
                    @foreach (var group in Model.ComboParlayDetailWrapperGroups)
                    {
                        await RenderDetailItems(group);
                        <tr class="bl_footertotal">
                            <td class="text-right" colspan="4">@Resources.subTotal:</td>
                            <td class="text-right">@Html.Raw(Model.SubTotalWinLost(group))</td>
                            <td></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="over-flow-y-auto">
            <table class="tblRpt tblRpt-bordered tblRpt-striped tablesorter tblRpt-hover">
                <tfoot>
                    <tr class="bl_footertotal outstanding">
                        <th>
                            <div class="divWidth80"></div>
                        </th>
                        <th>
                            <div class="divEvent"></div>
                        </th>
                        <th>
                            <div class="divWidth80"></div>
                        </th>
                        <th>
                            <div class="text-right divWidth80">@Resources.outstanding:</div>
                        </th>
                        <th>
                            <div class="text-right divWidth80">@Html.Raw(Model.OutStanding)</div>
                        </th>
                        <th>
                            <div class="divWidth50"></div>
                        </th>
                    </tr>
                    @if (!Model.IsRunningTicket)
                    {
                        <tr class="bl_footertotal">
                            <th>
                                <div class="divWidth80"></div>
                            </th>
                            <th>
                                <div class="divEvent"></div>
                            </th>
                            <th>
                                <div class="divWidth80"></div>
                            </th>
                            <th>
                                <div class="text-right divWidth80">@Resources.total:</div>
                            </th>
                            <th>
                                <div class="text-right divWidth80">@Html.Raw(Model.TotalWinLost)</div>
                            </th>
                            <th>
                                <div class="divWidth50"></div>
                            </th>
                        </tr>
                    }
                </tfoot>
            </table>
        </div>
    }
    <div class="comm_note">
        <div class="title">
            <span class="star">*</span>@Resources.Note
        </div>
        <div class="content">@Resources.WinLossRoundNote</div>
    </div>
}
