@{
    ViewData["Title"] = $"{Resources.OddSlashEven} + {Resources._1X2} + {Resources.DrawSlashNoDraw}";
}
@section Styles {
    @StaticResources.RenderStyles("~/bundles/totalbets/totalbets")
}
@section Scripts {
    @StaticResources.RenderScripts("~/bundles/totalbets/totalbets")
}
@model IEnumerable<OE1X2DND>
<div class="page-title">@Resources.OddSlashEven + @Resources._1X2 + @Resources.DrawSlashNoDraw</div>
<div class="filter">
    <div class="auto-refresh"></div>
    <compact-feedback fid="200" class-name="@(Model.Any() ? string.Empty : "hide")" />
</div>
<table class="tblRpt tblRpt-bordered" id="tblRpt">
    <thead>
        <tr>
            <th rowspan="2" class="w-number">#</th>
            <th rowspan="2">@Resources.Time</th>
            <th rowspan="2">@Resources.Event</th>
            <th colspan="4">@Resources.FullTime</th>
            <th colspan="4">@Resources._1stHalf</th>
        </tr>
        <tr class="thead-row2">
            <th class="width-100">@Resources.OddSlashEven</th>
            <th colspan="2" class="width-116">@Resources._1X2</th>
            <th class="width-100">@Resources.DrawSlashNoDraw</th>
            <th class="width-100">@Resources.OddSlashEven</th>
            <th colspan="2" class="width-116">@Resources._1X2</th>
        </tr>
    </thead>
    <tbody>
        <partial name="OE1X2DNDPartial" />
    </tbody>
</table>
<input type="hidden" id="hidden-autoRefreshRefreshText" value="@Resources.Refresh" />
<input type="hidden" id="hidden-autoRefreshSeconds" value="15,30,45,60,75" />
<input type="hidden" id="hidden-autoRefreshUrl" value="OE1X2DND?partial=true" />
<input type="hidden" id="hidden-autoRefreshSavedSecondKey" value="OE1X2DND" />
