@inject IUserSession userSession
@{
    ViewData["Title"] = Resources.HDPOULive;
    var viewerLevelName = Enumeration.FromValue<UserLevel>(userSession.RoleId).DisplayName.ToLowerInvariant();
}
@section Styles {
    @StaticResources.RenderStyles("~/bundles/totalbets/totalbets")
}
@section Scripts {
    @StaticResources.RenderScripts("~/bundles/totalbets/totalbets")
}
@model IEnumerable<HDPOULive>
<div class="page-title">@Resources.HDPOULive</div>
<ul class="nav nav-tabs @viewerLevelName" role="tablist">
    <li role="presentation" class="active">
        <a href="javascript:;">@Resources.TotalBets</a>
    </li>
    <li role="presentation">
        <a asp-controller="Forecast" asp-action="HDPOULive">@Resources.Forecast</a>
    </li>
</ul>
<div class="filter">
    <div class="auto-refresh"></div>
    <compact-feedback fid="200" class-name="@(Model.Any() ? string.Empty : "hide")" />
</div>
<table class="tblRpt tblRpt-bordered width-100per" id="tblRpt">
    <thead>
        <tr>
            <th rowspan="2" class="w-number">#</th>
            <th rowspan="2">@Resources.Time</th>
            <th rowspan="2">@Resources.Event</th>
            <th colspan="4">@Resources.FullTime</th>
            <th colspan="4">@Resources._1stHalf</th>
        </tr>
        <tr class="thead-row2">
            <th colspan="2" class="width-116">@Resources.Handicap</th>
            <th colspan="2" class="width-116">@Resources.OverSlashUnder</th>
            <th colspan="2" class="width-116">@Resources.Handicap</th>
            <th colspan="2" class="width-116">@Resources.OverSlashUnder</th>
        </tr>
    </thead>
    <tbody>
        <partial name="HDPOULivePartial" />
    </tbody>
</table>
<input type="hidden" id="hidden-autoRefreshRefreshText" value="@Resources.Refresh" />
<input type="hidden" id="hidden-autoRefreshSeconds" value="15,30,45,60,75" />
<input type="hidden" id="hidden-autoRefreshUrl" value="HDPOULive?partial=true" />
<input type="hidden" id="hidden-autoRefreshSavedSecondKey" value="HDPOULive" />
