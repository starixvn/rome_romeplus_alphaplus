@{
    ViewData["Title"] = Resources._1X2;
}
@section Styles {
    @StaticResources.RenderStyles("~/bundles/totalbets/totalbets")
}
@section Scripts {
    @StaticResources.RenderScripts("~/bundles/forecast/forecast")
}
@model ForecastViewModel<Forecast1X2>
<div class="page-title">@Resources._1X2</div>
<div class="auto-refresh left-side"></div>
<div id="content">
    <partial name="1X2Partial" />
</div>
<input type="hidden" id="hidden-autoRefreshRefreshText" value="@Resources.Refresh" />
<input type="hidden" id="hidden-autoRefreshSeconds" value="15,30,45,60,75" />
<input type="hidden" id="hidden-autoRefreshUrl" value="1X2?partial=true&leagueId=" />
<input type="hidden" id="hidden-autoRefreshSavedSecondKey" value="1X2" />
<input type="hidden" id="hidden-dataUrl" value="1X2Data?leagueId=" />
