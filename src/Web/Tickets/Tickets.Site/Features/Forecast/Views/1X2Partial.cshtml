@{
    Layout = null;
}
@model ForecastViewModel<Forecast1X2>
<div class="flex">
    <div class="dropdown-league">
        @if (Model.Leagues.Any())
        {
            <label for="ddlLeague">@Resources.League</label>
            <select asp-items="Model.Leagues" id="ddlLeague"></select>
        }
    </div>
    <compact-feedback fid="72" class-name="@(Model.Forecast.Any() ? string.Empty : "hide")" />
</div>
<div class="clearfix"></div>
<table class="tblRpt tblRpt-bordered tbl-1X2 text-center" id="tblRpt">
    <thead>
        <tr>
            <th colspan="2">@Resources.Team</th>
            <th colspan="3">@Resources._1X2</th>
        </tr>
    </thead>
    <tbody>
        <partial name="1X2Data" model="Model.Forecast" />
    </tbody>
</table>
