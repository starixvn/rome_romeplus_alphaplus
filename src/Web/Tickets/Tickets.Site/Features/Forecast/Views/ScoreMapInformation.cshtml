@{
    ViewData["Title"] = Resources.ScoreMapInformation;
    void RenderBetTypes(IEnumerable<ScoreMapBetType> betTypes, bool isLive)
    {
        <div class="bettype-container">
            <div class="header @(isLive ? string.Empty : "collapse")">
                <span class="icon-table-sort-desc"></span>@(isLive ? Resources.Live + "!" : Resources.DeadBall)
            </div>
            <table @(isLive ? string.Empty : "style=display:none")>
                <thead>
                    <tr>
                        <th>@Resources.Group</th>
                        <th>@Resources.BetTypes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in betTypes)
                    {
                        var followedBetTypeNames = group.FollowedBetTypeNames.ToList();
                        var betTypesCount = followedBetTypeNames.Count;
                        <tr>
                            <td class="bettype" rowspan="@betTypesCount">@group.BetTypeName</td>
                            <td>@(betTypesCount == 0 ? string.Empty : followedBetTypeNames[0])</td>
                        </tr>
                        for (int i = 1; i < betTypesCount; i++)
                        {
                            <tr>
                                <td>@followedBetTypeNames[i]</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}
@section Styles {
    <link rel="stylesheet" href="~/bundles/forecast/scoremapinformation.css" asp-append-version="true" />
}
@section Scripts {
    <script type="text/javascript">
        $(function () {
            $('.header').click(function () { $(this).toggleClass('collapse').next().toggle(); });
        });
    </script>
}
@model IEnumerable<ScoreMapBetType>[]
<div class="score-map-information">
    <div class="note-box">
        <div class="note">@Resources.Note</div>
        <div>@Resources.ScoreMapNoteContent</div>
    </div>
    <div class="content">
        <div class="title">@Resources.ScoreMapInformation</div>
        <p>@Resources.ScoreMapInformationDescription</p>
        @{
            RenderBetTypes(Model[0], true);
            RenderBetTypes(Model[1], false);
        }
    </div>
</div>
