@inject AlphaPlus.Core.Models.IUserSession userSession
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Alpha - Results")</title>
    @StaticResources.AssetStyles.Render("/bundles-v2/common/common")
    <link rel="stylesheet" href="~/bundles/results/resultcore.css" asp-append-version="true" /> 
    @await RenderSectionAsync("Styles", required: false)
    @GoogleAnalyticHelper.GtagScript()
 
    @StaticResources.AssetStyles.Render("/bundles-v2/site-tickets/normal")
 
</head>

<body data-theme="@(string.IsNullOrWhiteSpace(userSession.DarkModeName) ? "light" : "dark")">
    @GoogleAnalyticHelper.GtagNoScript()
    <div id="page_main">
        <div class="container-fluid">
            <div class="page-title tabs @userSession.SiteName.ToLowerInvariant()">
            <ul class="nav nav-tabs" role="tablist">
                @await Component.InvokeAsync("Tab", new
                    { tabName = ViewContext.RouteData.Values["action"].ToString().ToLowerInvariant() })
            </ul>
            </div>
            <div class="tab-content">
                @RenderBody()
            </div>
        </div>
    </div>
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/ajaxSetup")
    @StaticResources.AssetScripts.Render("/bundles/site-results/default")
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
