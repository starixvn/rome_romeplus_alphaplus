@{
    Layout = "~/Features/Results/Views/_Layout.cshtml";
    ViewBag.Title = "Normal";
}
@section Scripts {
    <script src="~/bundles/results/normal-result.js" asp-append-version="true"></script>
}
@model NormalResultViewModel
<div role="tabpanel" class="tab-pane active" id="normal">
    <div class="row filter">
        <form method="get" asp-action="normal" id="result-filter">
            <div class="form-inline filter z-100">
                <div class="form-group from-date-box">
                    <label class="txt">@Resources.Date</label>
                    <div class="control date">
                        <div class="input-group date datepicker " id="dpkContainer">
                            <input type="text" class="form-control" asp-for="ResultDate" readonly />
                            <span class="input-group-addon">
                                <span class="icon-calendar"></span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="@Model.Today.ToShortDateWithSlash()" id="today-results"
                        class="btn-submit btn-default btn-other-day" />
                    <input type="submit" value="@Model.Yesterday.ToShortDateWithSlash()" id="yesterday-results"
                        class="btn-submit btn-default btn-other-day" />
                </div>
            </div>
            <div class="form-group note">
                <span class="star">*</span> @Model.MinDateMessage
            </div>
            @if (Model.Sports.Any())
            {
                <div class="form-inline filter">
                    <div class="form-group">
                        <label class="txt">@Resources.Sport</label>
                        <div class="control">
                            <select class="form-control" asp-for="SportId" asp-items="Model.Sports"
                                data-placeholder="@Resources.PleaseSelect">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="txt">@Resources.League</label>
                        <div class="control league-content">
                            <select class="form-control" asp-for="LeagueId" asp-items="Model.Leagues"
                                data-placeholder="@Resources.PleaseSelect">
                                <option></option>
                            </select>
                        </div>
                    </div>
                    @if (Model.HasInformation)
                    {
                        <div class="form-group">
                            <a class="ic-excel" asp-action="NormalExcel"
                                asp-route-resultDate="@Model.ResultDate.ToShortDateWithSlash()" asp-route-sportId="@Model.SportId"
                                asp-route-leagueId="@Model.LeagueId"></a>
                        </div>
                    }
                </div>
            }
        </form>
    </div>
    <div class="main-content" id="main-result">
        @Html.Raw(Model.HtmlResults)
    </div>
</div>
<div class="modal fade result-details" id="result-details" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span
                        aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="result-detailt-title"></h4>
            </div>
            <div class="modal-body" id="detail-result-body">
                <img id="loading-image" src="~/bundles/images/ajax-loader.gif" />
                <iframe src="about:blank" frameborder="0" scrolling="yes" height="400px" id="result-detail-frm"
                    name="result-detail-frm" style="display:none;width:100%;"></iframe>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="MinDate" value="@Model.MinDate.ToShortDateString()" />
<input type="hidden" id="Today" value="@Model.Today.ToShortDateString()" />
<a class="hide" id="hidden-resultDetailsUrl" asp-action="Details"></a>
<a class="hide" id="hidden-resultSoccer5Url" asp-action="GetSoccer5Result"></a>
