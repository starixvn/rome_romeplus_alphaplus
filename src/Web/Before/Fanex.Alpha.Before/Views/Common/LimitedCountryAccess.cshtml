@{
    Layout = null;
}
@model string
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Location Forbidden</title>
    <link href="~/assets/bundles/themes/limitedcountryaccess@(ViewData["DarkModeName"]).min.css" rel="stylesheet" asp-append-version="true"/>
</head>
<body>
   <div class="container">
    <div class="content">
         <div class="header">
            <span class="icon_note"></span>
            <span class="header-text">Notification Message</span>
        </div>
        <div class="body-content">
           <div class="title">Dear Valued Customers:</div>
            <p>  Note: Viewing and using this website at your current location (@Model) is prohibited due to its regulatory rules.
                We regret any inconvenience.</p>
            
            <div class="title second-text">尊敬的客户:</div>
            <p> 注意：您所在的地区法规条例 (@Model) 是禁止访问及使用本站。<br />
                    不便之处，敬请见谅！</p>
           
        </div>
    </div>
   </div>
</body>
</html>