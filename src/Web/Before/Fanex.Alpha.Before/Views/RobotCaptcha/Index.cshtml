@using Fanex.Alpha.Before.Resources
@{
    Layout = null;
    var errorMessage = (string)TempData["ErrorMessage"];
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>Robot Captcha</title>
    <link rel="stylesheet" href="~/assets/bundles/robotcaptcha@(ViewData["DarkModeName"]).min.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/assets/bundles/alpha.slider-captcha.css" asp-append-version="true"/>
</head>
<body>
    <div class="wrapper">
        <form method="post" id="captcha-form">
            <div id="captcha" name="token"></div>
        </form>
    </div>
    <script src="~/assets/bundles/alpha.slider-captcha.js" type="text/javascript" asp-append-version="true"></script>
    <script>
        var tooManyFailedLoginPageUrl = "/?r=@Html.Raw(Labels.tooManyFailedCaptcha)";
        sliderCaptcha('captcha', {
            lang: "@Fanex.Alpha.Before.AppSession.Language",
            baseUri: "@Url.Content("~/")",
            callback: function (response, event) {
                if (response.Code === 0) {
                    if (localStorage) {
                        localStorage.removeItem(itemKey);
                    }
                    document.getElementById("captcha-form").submit();
                } else {
                    var itemKey = "captcha-fail-count";
                    if (!localStorage) {
                        event.preventDefault = true;
                        location.href = event.instance.baseUrl;
                        return;
                    }

                    var count = parseInt(localStorage.getItem(itemKey)) || 0;
                    count++;
                    if (count >= 5) {
                        event.preventDefault = true;
                        localStorage.removeItem(itemKey);
                        location.href = tooManyFailedLoginPageUrl;
                        return;
                    }

                    localStorage.setItem(itemKey, count);
                }
            }
        });
    </script>
</body>
</html>