@using Alpha.Handbook.Demo.ViewModels
@using Alpha.Handbook.Demo.Models
@using Alpha.Handbook.Demo.Helpers
@using Alpha.Handbook.Demo.Resources

@model HomeViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Resources.AngencyHandbook</title>
    <link rel="stylesheet" href="~/assets/bundles/handbook/common.css" />
    <link rel="stylesheet" href="~/assets/bundles/handbook/page-home.css" />
</head>
<body>
    <div class="container">
        <div class="left-container"></div> <!-- keep this this to prevent break layout -->
        <div class="center-container">
            <div class="docsearch">
                <h2 class="ttl-search">@Resources.HomePage_Title</h2>
                <div class="search">
                    <input id="txt-search" type="text" name="name" value="" placeholder="@Resources.Search" />
                    <div class="box-suggestion hidden">
                        <ul></ul>
                    </div>
                    <button class="btn-search hover">
                        <span class="icon-search"></span>
                    </button>
                </div>
            </div>

            <div class="main-article" id="main-article">
                <ul class="head-tab">
                    <li class="active">
                        <a href="#">@Resources.Introduction</a>
                    </li>
                </ul>
                <p>
                    @Html.Raw(Resources.HomePage_Content)
                </p>
            </div>
        </div>
        <div class="right-container">

        </div>

    </div>
    @Html.Hidden("RootPath", "../")
    @Html.Hidden("NoRecords", Resources.NoRecords)
    <script src="~/assets/bundles/handbook/common.js"></script>
    <script src="~/assets/bundles/handbook/home.js"></script>
</body>
</html>