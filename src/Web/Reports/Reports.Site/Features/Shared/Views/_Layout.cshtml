@inject AlphaPlus.Core.Models.IUserSession userSession
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Alpha - Reports")</title>
    @StaticResources.AssetStyles.Render("/bundles-v2/common/common")
    @await RenderSectionAsync("Styles", required: false)
    @GoogleAnalyticHelper.GtagScript()
</head>

<body class="@userSession.SiteName.ToLowerInvariant()" data-theme="@(string.IsNullOrWhiteSpace(userSession.DarkModeName) ? "light" : "dark")">
    @GoogleAnalyticHelper.GtagNoScript()
    @RenderBody()
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/ajaxSetup")
    @StaticResources.AssetScripts.Render("/bundles/site-reports/default")
    @await RenderSectionAsync("Scripts", required: false)
    <script type="text/javascript">
        $(function () {
            $('.open-link').off().click(function (event) { top.alpha.viewDataURL(event); });
        });
    </script>
</body>

</html>
