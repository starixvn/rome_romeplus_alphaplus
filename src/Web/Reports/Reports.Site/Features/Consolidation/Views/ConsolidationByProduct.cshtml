@{
    Layout = "_Layout";
    ViewData["Title"] = Model.PageHeader.Title;
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-reports/consolidation")
    @StaticResources.RenderStyles("~/bundles-v2/winlossdetailnew")
}
@section Scripts {
    @StaticResources.RenderScripts("~/bundles/consolidation/consolidation")
}
@model ConsolidationByProductViewModel
<partial name="TitleAndFilter" model="Model" />
<table class="tb tb-bordered tb-hover w-full  @(Model.PageHeader.IsStackMode ? " stack-mode" : string.Empty)"
    id="tbl-report">
    <thead>
        <tr>
            <th rowspan="2" class="hidden-stack-mode">@Resources.Product</th>
            <th class="visible-stack-mode visible-stack-mode-first-col">@Resources.Product</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.Level</th>
            <th class="visible-stack-mode">@Resources.Level</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.Username</th>
            <th class="visible-stack-mode">@Resources.Username</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.Currency</th>
            <th class="visible-stack-mode">@Resources.Currency</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.Turnover</th>
            <th class="visible-stack-mode">@Resources.Turnover</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.GrossComm</th>
            <th class="visible-stack-mode">@Resources.GrossComm</th>
            <th colspan="3" class="hidden-stack-mode">@Resources.Member</th>
            <th class="visible-stack-mode">
                @Resources.Member<br />(@Resources.WinLossAbbr/@Resources.Comm/@Resources.Total)</th>
            <th colspan="4" class="hidden-stack-mode">@Resources.Owner</th>
            <th class="visible-stack-mode">
                @Resources.Owner<br />(@Resources.TurnoverAbbr/@Resources.WinLossAbbr/@Resources.Comm/@Resources.Total)
            </th>
            <th rowspan="2">@Resources.Company</th>
            <th rowspan="2">@Resources.BetCount</th>
        </tr>
        <tr class="thead-row2">
            <th class="hidden-stack-mode">@Resources.WinLoss</th>
            <th class="hidden-stack-mode">@Resources.Comm</th>
            <th class="hidden-stack-mode">@Resources.Total</th>
            <th class="hidden-stack-mode">@Resources.Turnover</th>
            <th class="hidden-stack-mode">@Resources.WinLoss</th>
            <th class="hidden-stack-mode">@Resources.Comm</th>
            <th class="hidden-stack-mode">@Resources.Total</th>
        </tr>
    </thead>
    @{
        var cashServiceBillingProductId = "111";
    }

    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var date in Model.ReportData)
            {
                var isFirstRow = true;
                foreach (var data in date.WinLoss)
                {
                    var isCashServiceBilling = data.BreakDown.Equals(cashServiceBillingProductId,
                    StringComparison.OrdinalIgnoreCase);
                    if (!isCashServiceBilling && data.BetCount == 0)
                    {
                        continue;
                    }
                    <tr>
                        @if (isFirstRow)
                        {
                            <td class="text-left bold first-row consolidation" rowspan="@date.WinLoss.Count(x => x.BetCount > 0)">
                                @date.BreakDown</td>
                            isFirstRow = false;
                        }
                        <td class="text-left @data.CustLevelName.ToLowerInvariant()">@data.CustLevelName</td>
                        <td class="text-left">
                            @if (data.IsMemberLevel())
                            {
                                <a class="open-link"
                                    data-url="@Model.BuildBetListUrl(data.CustId, data.Username, data.BreakDown)">@data.Username</a>
                            }
                            else
                            {
                                <a class="downline-link" asp-action="ConsolidationDetail"
                                    asp-all-route-data="@Model.BuildDrillDownParams(data.CustId, data.Username, data.CustLevel, data.BreakDown)">@data.Username</a>
                            }
                        </td>
                        <td class="text-center">@data.CurrencyName</td>
                        <td class="@(Model.IsNegative(data.Turnover) ? "format-negative" : string.Empty)">@data.Turnover.FormatNumber()</td>
                        <td class="@(Model.IsNegative(data.GrossComm) ? "format-negative" : string.Empty)">@data.GrossComm.FormatNumber()</td>
                        @if (Model.PageHeader.IsStackMode)
                        {
                            <td class="visible-stack-mode combinedcell col-member-winloss-combined">
                                <ul>
                                    <li class="@(Model.IsNegative(data.MemberWinLoss) ? "format-negative" : string.Empty)">@data.MemberWinLoss.FormatNumber()</li>
                                    <li class="@(Model.IsNegative(data.MemberComm) ? "format-negative" : string.Empty)">@data.MemberComm.FormatNumber()</li>
                                    <li class="@(Model.IsNegative(data.MemberTotal) ? "format-negative" : string.Empty)">@data.MemberTotal.FormatNumber()</li>
                                </ul>
                            </td>
                            <td class="visible-stack-mode combinedcell col-owner-turnover-combined">
                                <ul>
                                    <li class="@(Model.IsNegative(data.OwnerTurnover) ? "format-negative" : string.Empty)">@data.OwnerTurnover.FormatNumber()</li>
                                    <li class="@(Model.IsNegative(data.OwnerWinLoss) ? "format-negative" : string.Empty)">@data.OwnerWinLoss.FormatNumber()</li>
                                    <li class="@(Model.IsNegative(data.OwnerComm) ? "format-negative" : string.Empty)">@data.OwnerComm.FormatNumber()</li>
                                    <li class="@(Model.IsNegative(data.OwnerTotal) ? "format-negative" : string.Empty)">@data.OwnerTotal.FormatNumber()</li>
                                </ul>
                            </td>
                        }
                        else
                        {
                            <td class="hidden-stack-mode col-member-winloss @(Model.IsNegative(data.MemberWinLoss) ? "format-negative" : string.Empty)">@data.MemberWinLoss.FormatNumber()</td>
                            <td class="hidden-stack-mode @(Model.IsNegative(data.MemberComm) ? "format-negative" : string.Empty)">@data.MemberComm.FormatNumber()</td>
                            <td class="hidden-stack-mode bold consolidation @(Model.IsNegative(data.MemberTotal) ? "format-negative" : string.Empty)">@data.MemberTotal.FormatNumber()</td>
                            <td class="hidden-stack-mode col-owner-turnover @(Model.IsNegative(data.OwnerTurnover) ? "format-negative" : string.Empty)">@data.OwnerTurnover.FormatNumber()</td>
                            <td class="hidden-stack-mode @(Model.IsNegative(data.OwnerWinLoss) ? "format-negative" : string.Empty)">@data.OwnerWinLoss.FormatNumber()</td>
                            <td class="hidden-stack-mode @(Model.IsNegative(data.OwnerComm) ? "format-negative" : string.Empty)">@data.OwnerComm.FormatNumber()</td>
                            <td class="hidden-stack-mode bold consolidation @(Model.IsNegative(data.OwnerTotal) ? "format-negative" : string.Empty)">@data.OwnerTotal.FormatNumber()</td>
                        }
                        <td class="@(Model.IsNegative(data.Company) ? "format-negative" : string.Empty)">@data.Company.FormatNumber()</td>
                        <td>@data.BetCount.FormatNumber()</td>
                    </tr>
                }
            }
        </tbody>
    }

    @if (!Model.ReportData.Any() || Model.ReportData.All(x => x.WinLoss.All(o => o.BreakDown !=
    cashServiceBillingProductId && o.BetCount == 0)))
    {
        <no-information colspan="15" />
    }
</table>
<a class="hide" id="LoadLegendURL" asp-action="WinLoss" asp-controller="Legends"
    asp-route-MinDate="@Model.DateRangePicker.MinDate" asp-route-IsConsolidation="true"></a>
<input type="hidden" asp-for="IsSetDefaultStackMode" />
