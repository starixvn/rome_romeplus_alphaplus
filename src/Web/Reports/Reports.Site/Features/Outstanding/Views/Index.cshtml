@using AlphaPlus.Core.Models
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Shared.AppResources.Common
@using AlphaPlus.Shared.AppResources.Report
@using AlphaPlus.Reports.Features.Shared.Extensions
@using AlphaPlus.Reports.Features.Outstanding
@using AlphaPlus.Reports.Site.Features.Shared.ViewModels.Components
@using AlphaPlus.Reports.Site.Features.Outstanding
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AlphaPlus.Reports.Site
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.PageHeader.Title;
    var downlineRoleId = Model.CustLevel.Value - 1;

    (string, string) GetUserLevelTextAndTranslate(UserLevel userLevel)
    {
        if (userLevel.IsMemberLevel())
        {
            return (UserLevel.Member.DisplayName, Resources.Member);
        }

        if (userLevel.IsAgentLevel())
        {
            return (UserLevel.Agent.DisplayName, Resources.Agent);
        }

        if (userLevel.IsMasterLevel())
        {
            return (UserLevel.Master.DisplayName, Resources.Master);
        }

        return (UserLevel.Super.DisplayName, Resources.Super);
    }

    void RenderOutstandingCells(OutstandingModel data)
    {
        foreach (var level in Model.DisplayOutstandingLevels.Select(level => level.Value))
        {
            <td class="@(Model.IsNegative(data.GetValueByLevel(level).RoundTo2()) ? "format-negative" : string.Empty)">@data.GetValueByLevel(level).FormatNumber()</td>
        }
    }

    var length = Model.DisplayOutstandingLevels.Count;
    var isAgentLevel = Model.CustLevel.IsAgentLevel();
    var colIndex = 0;
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-reports/outstanding")
    @StaticResources.RenderStyles("~/bundles-v2/outstanding")
}
@section Scripts {
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-asset/data-table")
    @StaticResources.RenderScripts("~/bundles/outstanding/outstanding")
}
@model OutstandingViewModel
<report-title model="Model.PageHeader" />
<form method="get" class="form-inline filter form-report@(Model.PageHeader.IsFilterVisible ? string.Empty : " hide")"
    role="form" id="report-form">
    <product-multiselection model="@Model.ProductViewModel" />
    @if (Model.ShowLevelType)
    {
        <level-type custlevel="@Model.CustLevel" selected-value="@Model.LevelType" />
    }
    <div class="form-group last-group">
        <input type="submit" value="@Resources.Submit" class="btn-submit" />
    </div>
    <div class="form-group hide">
        <span id="icon-information" class="ic-information"></span>
    </div>
    @if (Model.ReportData.HasData)
    {
        <div class="form-group">
            <compact-feedback fid="13" />
        </div>
    }
    <input type="hidden" asp-for="CustId" />
    <input type="hidden" asp-for="CustName" />
    <input type="hidden" id="CustLevelId" name="CustLevelId" value="@Model.CustLevel.Value.ToString()" />
    <input type="hidden" name="BreadcrumbsJson" value="@Model.PageHeader.BreadcrumbLevel.BreadcrumbsJson" />
</form>
<div id="report-container" class="level-@Model.CustLevel.Value" style="width: @(Model.IsMobileView ? "100%" : "75%");">
    <table
        class="tb tb-bordered tb-freeze-header tb-hover w-full tbl-outstanding tablesorter text-right @(Model.ReportData.HasData ? "hide" : string.Empty)"
        style="width:100%" data-totalrecords="@Model.ReportData.TotalRecords"
        data-sortedcolumn="@Model.SortPropertyName" data-descendingsort="@Model.DescendingSort" id="tbl-report">
        <thead>
            <tr class="hide">
                <th data-priority="0"></th>

                @if (Model.ShowLevelType)
                {
                    <th data-priority="@length"></th>
                }
                @{
                    for (var i = 1; i <= length; i++)
                    {
                        <th data-priority="@(length - i)"></th>
                    }

                    <th data-priority="@(length + 1)"></th>
                    <th data-priority="@(length + 2)"></th>
                }
                <th></th>
            </tr>
            <tr>
                <th rowspan="2" class="header" data-name="CustName" data-colindex="@(colIndex++)">@Resources.Username</th>
                @if (Model.ShowLevelType)
                {
                    <th rowspan="2" class="header" data-name="Level" data-colindex="@(colIndex++)">@Resources.Level</th>
                }
                <th colspan="@length" class="header">@Resources.Outstanding</th>
                <th colspan="2" class="header">@Resources.SportsbookRiskAmount</th>
                <th rowspan="2" class="header"></th>
            </tr>
            <tr class="thead-row2">
                @{
                    for (var i = 0; i < length; i++)
                    {
                        var (userLevel, userLevelTranslate) = GetUserLevelTextAndTranslate(Model.DisplayOutstandingLevels[i]);
                        <th data-priority="@(length - i)" data-name="@userLevel" data-colindex="@(colIndex++)">
                            @userLevelTranslate
                        </th>
                    }
                }

                <th data-priority="@(length + 1)" data-name="ToWin" data-colindex="@(colIndex++)">
                    @Resources.ToWin
                </th>
                <th data-priority="@(length + 2)" data-name="Risk" data-colindex="@colIndex">
                    @Model.GetSMARiskText
                </th>
            </tr>
        </thead>
        @if (Model.ReportData.HasData)
        {
            <tbody>
                @foreach (var outstanding in Model.ReportData.DataSource)
                {
                    <tr>
                        <td class="text-left" data-sortedvalue="@outstanding.CustName">
                            @if (isAgentLevel || outstanding.IsDirectMember)
                            {
                                <a href="javascript:;" class="open-link" data-url="@Model.BuildBetListUrl(outstanding.CustId, outstanding.CustName)">@outstanding.CustName</a>
                            }
                            else
                            {
                                <a href="javascript:;" class="downline-link" data-custid="@outstanding.CustId"
                                    data-custname="@outstanding.CustName"
                                    data-custlevelid="@Model.DownlineLevelId">@outstanding.CustName</a>
                            }
                        </td>
                        @if (Model.ShowLevelType)
                        {
                            <td class="text-center">@(outstanding.IsDirectMember ? CommonResx.DirectMember : Model.LevelTypeValue)</td>
                        }
                        @{
                            RenderOutstandingCells(outstanding);
                        }

                        <td class="@(Model.IsNegative(outstanding.ToWin) ? "format-negative" : string.Empty)">@outstanding.ToWin.FormatNumber()</td>
                        <td class="@(Model.IsNegative(outstanding.GetSMARiskValueByLevel(Model.ViewerLevel)) ? "format-negative" : string.Empty)">@outstanding.GetSMARiskValueByLevel(Model.ViewerLevel).FormatNumber()</td>
                        <td></td>
                    </tr>
                }
                <tr class="tbl-footer">
                    <td class="text-right">@Resources.Total</td>
                    @if (Model.ShowLevelType)
                    {
                        <td></td>
                    }
                    @for (var i = 0; i < length; i++)
                    {
                        <td class="@(Model.IsNegative(Model.ReportData.Total.GetValueByLevel(Model.DisplayOutstandingLevels[i].Value).RoundTo2()) ? "format-negative" : string.Empty)">
                            @Model.ReportData.Total.GetValueByLevel(Model.DisplayOutstandingLevels[i].Value).FormatNumber()
                        </td>
                    }
                    <td>
                        @if(Model.TotalHasToWinValue)
                        {
                            <span class="@(Model.IsNegative(Model.ReportData.Total.ToWin) ? "format-negative" : string.Empty)">
                               @Model.ReportData.Total.ToWin.FormatNumber()
                            </span>                           
                        }
                        else
                        {
                            @NumberExtensions.NotAvailable
                        }
                    </td>
                    <td>
                        @if (Model.TotalHasToWinValue)
                        {
                            <span class="@(Model.IsNegative(Model.ReportData.Total.GetSMARiskValueByLevel(Model.ViewerLevel)) ? "format-negative" : string.Empty)">
                                @Model.ReportData.Total.GetSMARiskValueByLevel(Model.ViewerLevel).FormatNumber()
                            </span>
                        }
                        else
                        {
                            @NumberExtensions.NotAvailable
                        }
                    </td>
                    <td class="control"></td>
                </tr>
            </tbody>
        }
    </table>
</div>
<a class="hide" id="LoadLegendURL" asp-action="Outstanding" asp-controller="Legends"></a>
<input type="hidden" asp-for="DisplayOutstandingLevelsJson" />
<input type="hidden" id="NoInformationIsAvailable" value="@Resources.NoInformationIsAvailable" />
<input type="hidden" id="query-productids" value="@Model.ProductViewModel.UserSelectedProductIds" />
