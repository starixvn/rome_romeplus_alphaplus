@using AlphaPlus.Core.Helpers
@using AlphaPlus.Shared.AppResources.Report
@using AlphaPlus.Reports.Features.Shared.Extensions
@using AlphaPlus.Reports.Features.WinLossByProduct
@using AlphaPlus.Reports.Site.Features.Shared.ViewModels.Components
@using AlphaPlus.Reports.Site.Features.WinLossByProduct
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AlphaPlus.Reports.Site
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.PageHeader.Title;
    var isSuperLevel = Model.CustLevel.IsSuperLevel();
    var isMasterLevel = Model.CustLevel.IsMasterLevel();
    var isAgentLevel = Model.CustLevel.IsAgentLevel();

    void RenderProduct(WinLossByProductModel data, bool isExpand)
    {
        RenderWinLossByProduct(data, isExpand);

        foreach (var winLossBySportModel in data.WinLossBySports)
        {
            RenderSport(data.ProductId, winLossBySportModel, isExpand);
        }
    }

    void RenderWinLossByProduct(WinLossByProductModel data, bool isExpand)
    {
        <tr class="product-row" data-product-id="@data.ProductId" data-is-hide="@(isExpand ? "false" : "true")">
            <td class="text-left col-username bold @(isExpand ? "active" : string.Empty)">
                <div class="text-icon-left">
                    <span class="@(isExpand ? "ic-arrow-down" : "ic-arrow-right")"></span>
                    @data.ProductName
                </div>
            </td>
            @{
                RenderWinLossInfo(data.Total);
            }
        </tr>
    }

    void RenderSport(int productId, WinLossBySportModel data, bool isExpand)
    {
        if (!WinLossBySportModel.IsShowBetTypeDirectly(productId))
        {
            RenderWinLossBySport(productId, data, isExpand);
        }

        foreach (var winLossByBetType in data.WinLossByBetTypes)
        {
            RenderWinLossByBetType(productId, data.SportType, winLossByBetType, false, isExpand);
        }
    }

    void RenderWinLossBySport(int productId, WinLossBySportModel data, bool isExpand)
    {
        <tr class="sport-row sport-of-@productId@(isExpand ? string.Empty : " hide")" data-product-id="@productId"
            data-sporttype="@data.SportType" data-is-hide="@(isExpand ? "false" : "true")">
            <td class="text-left col-username bold @(isExpand ? "active" : string.Empty)">
                <div class="text-icon-left">
                    <span class="@(isExpand ? "ic-arrow-down" : "ic-arrow-right")"></span>
                    @data.SportTypeName
                </div>
            </td>
            @{
                RenderWinLossInfo(data.Total);
            }
        </tr>
    }

    void RenderWinLossByBetType(int productId, int sportType, WinLossByBetTypeModel data, bool isTotalRow, bool isExpand =
    false)
    {
        var betTypeRowClass = $"bet-type-row bet-type-of-product-{productId} bet-type-of-sport-{sportType}";
        var rowClass = isTotalRow ? "tbl-footer" : isExpand ? betTypeRowClass : betTypeRowClass + " hide";
        <tr class="@rowClass">
            <td class="text-left col-username">@(isTotalRow ? Resources.Total : @data.BetTypeName)</td>
            @{
                RenderWinLossInfo(data);
            }
        </tr>
    }

    void RenderWinLossInfo(WinLossByBetTypeModel data)
    {
        <td>@data.NumberOfTickets.FormatNumber()</td>
        if (Model.PageHeader.IsStackMode)
        {
            <td class="visible-stack-mode combinedcell col-turnover-combined">
                <ul>
                    <li class="@(Model.IsNegative(data.Turnover.RoundTo2()) ? "format-negative" : string.Empty)">@data.Turnover.FormatNumber()</li>
                    <li class="@(Model.IsNegative(data.GrossComm.RoundTo2()) ? "format-negative" : string.Empty)">@data.GrossComm.FormatNumber()</li>
                    @if (!isAgentLevel)
                    {
                        <li class="@(Model.IsNegative(data.DownlineTotal.RoundTo2()) ? "format-negative" : string.Empty)">@data.DownlineTotal.FormatNumber()</li>
                    }
                </ul>
            </td>
            if (isAgentLevel)
            {
                RenderStackNetWinLoss("member", data.MemberWinLoss, data.MemberComm, data.MemberTotal);
                RenderStackNetWinLoss("agent", data.WinLoss, data.Comm, data.Total, "altercol");
            }
            else if (isMasterLevel)
            {
                RenderStackNetWinLoss("master", data.WinLoss, data.Comm, data.Total, "altercol");
            }
            else
            {
                RenderStackNetWinLoss("super", data.WinLoss, data.Comm, data.Total, "altercol");
            }
        }
        else
        {
            <td class="hidden-stack-mode col-turnover @(Model.IsNegative(data.Turnover.RoundTo2()) ? "format-negative" : string.Empty)">@data.Turnover.FormatNumber()</td>
            <td class="hidden-stack-mode col-gross-com @(Model.IsNegative(data.GrossComm.RoundTo2()) ? "format-negative" : string.Empty)">@data.GrossComm.FormatNumber()</td>
            if (isAgentLevel)
            {
                RenderNetWinLoss("member", data.MemberWinLoss, data.MemberComm, data.MemberTotal);
                RenderNetWinLoss("agent", data.WinLoss, data.Comm, data.Total, "altercol");
            }
            else if (isMasterLevel)
            {
                <td class="hidden-stack-mode bold col-cust-total @(Model.IsNegative(data.DownlineTotal.RoundTo2()) ? "format-negative" : string.Empty)">@data.DownlineTotal.FormatNumber()</td>
                RenderNetWinLoss("master", data.WinLoss, data.Comm, data.Total, "altercol");
            }
            else
            {
                <td class="hidden-stack-mode bold col-cust-total @(Model.IsNegative(data.DownlineTotal.RoundTo2()) ? "format-negative" : string.Empty)">@data.DownlineTotal.FormatNumber()</td>
                RenderNetWinLoss("super", data.WinLoss, data.Comm, data.Total, "altercol");
            }
        }
        <td class="text-right col-company @(Model.IsNegative(data.Company.RoundTo2()) ? "format-negative" : string.Empty)">@data.Company.FormatNumber()</td>
    }

    void RenderStackNetWinLoss(string level, decimal winloss, decimal comm, decimal total, string highlightClass = "")
    {
        <td class="visible-stack-mode combinedcell col-@level-winloss-combined @highlightClass">
            <ul>
                <li class="@(Model.IsNegative(winloss.RoundTo2()) ? "format-negative" : string.Empty)">@winloss.FormatNumber()</li>
                <li class="@(Model.IsNegative(comm.RoundTo2()) ? "format-negative" : string.Empty)">@comm.FormatNumber()</li>
                <li class="@(Model.IsNegative(total.RoundTo2()) ? "format-negative" : string.Empty)">@total.FormatNumber()</li>
            </ul>
        </td>
    }

    void RenderNetWinLoss(string level, decimal winloss, decimal comm, decimal total, string highlightClass = "")
    {
        <td class="hidden-stack-mode col-@level-winloss @highlightClass @(Model.IsNegative(winloss.RoundTo2()) ? "format-negative" : string.Empty)">@winloss.FormatNumber()</td>
        <td class="hidden-stack-mode @highlightClass @(Model.IsNegative(comm.RoundTo2()) ? "format-negative" : string.Empty)">@comm.FormatNumber()</td>
        <td class="hidden-stack-mode bold col-cust-total @highlightClass @(Model.IsNegative(total.RoundTo2()) ? "format-negative" : string.Empty)">@total.FormatNumber()</td>
    }
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-reports/winlossbyproduct")
    @StaticResources.RenderStyles("~/bundles-v2/winlossdetailnew")
}
@section Scripts {
    @StaticResources.RenderScripts("~/bundles/winlossbyproduct/winlossbyproduct")
}
@model WinLossByProductViewModel
<report-title model="Model.PageHeader" />
<form class="form-inline filter@(Model.PageHeader.IsFilterVisible ? string.Empty : " hide")" role="form"
    id="report-form">
    <product-multiselection model="@Model.ProductViewModel" />
    <daterange-picker model="Model.DateRangePicker" />
    <div class="form-group form-group-short hide">
        <span id="icon-information" class="ic-information"></span>
    </div>
    <div class="form-group">
        <a class="ic-excel" title="@Resources.ExportToExcel" asp-action="Excel"
            asp-all-route-data="Model.GetExcelParams()"></a>
    </div>
    @if (Model.ReportData.Any())
    {
        <div class="form-group">
            <compact-feedback fid="19" />
        </div>
    }
    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage
    </div>
</form>
<table
    class="tb tb-bordered tb-hover w-full tbl-win-loss-by-product@(Model.PageHeader.IsStackMode ? " stack-mode" : string.Empty) "
    id="tbl-report">
    <thead>
        <tr>
            <th rowspan="2">@Resources.Product/@Resources.BetType</th>
            <th rowspan="2">@Resources.BetCount</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.Turnover</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.GrossComm</th>
            <th rowspan="2" class="visible-stack-mode col-combine">@(isAgentLevel ? Resources.TurnoverAbbr + "/" +
                Resources.GrossComm : (isSuperLevel ? Resources.TurnoverAbbr + Resources.GrossComAndMasterTotal :
                Resources.TurnoverAbbr + Resources.GrossComAndAgentTotal))
            </th>
            @if (isSuperLevel || isMasterLevel)
            {
                <th rowspan="2" class="hidden-stack-mode">@Resources.DownlineTotal</th>
            }
            @if (isAgentLevel)
            {
                <th colspan="3" class="col-level hidden-stack-mode">@Resources.Member</th>
                <th class="visible-stack-mode col-combine" rowspan="2">
                    @Resources.Member<br />(<span>@Resources.WinLossAbbr</span>@Resources.CommAndTotal)</th>
                <th colspan="3" class="col-level hidden-stack-mode">@Model.CustLevelName</th>
                <th class="visible-stack-mode col-combine" rowspan="2">
                    @Model.CustLevelName<br />(<span>@Resources.WinLossAbbr</span>@Resources.CommAndTotal)</th>
                <th class="hidden-stack-mode" rowspan="2">@Resources.Company</th>
                <th class="visible-stack-mode" rowspan="2">@Resources.Company</th>
            }
            else
            {
                <th colspan="3" class="col-level hidden-stack-mode">@Model.CustLevelName</th>
                <th class="visible-stack-mode col-combine" rowspan="2">
                    @Model.CustLevelName<br />(<span>@Resources.WinLossAbbr</span>@Resources.CommAndTotal)</th>
                <th class="hidden-stack-mode" rowspan="2">@Resources.Company</th>
                <th class="visible-stack-mode" rowspan="2">@Resources.Company</th>
            }
        </tr>
        <tr class="thead-row2">
            @if (isAgentLevel)
            {
                <th class="hidden-stack-mode col-winloss">@Resources.WinLoss</th>
                <th class="hidden-stack-mode">@Resources.Comm</th>
                <th class="hidden-stack-mode">@Resources.Total</th>
                <th class="hidden-stack-mode col-winloss">@Resources.WinLoss</th>
                <th class="hidden-stack-mode">@Resources.Comm</th>
                <th class="hidden-stack-mode">@Resources.Total</th>
            }
            else
            {
                <th class="hidden-stack-mode col-winloss">@Resources.WinLoss</th>
                <th class="hidden-stack-mode">@Resources.Comm</th>
                <th class="hidden-stack-mode">@Resources.Total</th>
            }
        </tr>
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @{
                var isExpand = true;
                foreach (var data in Model.ReportData)
                {
                    RenderProduct(data, isExpand);
                    isExpand = false;
                }
            }
        </tbody>
        <tfoot>
            @{
                RenderWinLossByBetType(0, 0, Model.Total, true);
            }
        </tfoot>
    }
    else
    {
        <no-information colspan="@(isAgentLevel ? 11 : 9)" />
    }
</table>
<a class="hide" id="LoadLegendURL" asp-action="WinLoss" asp-controller="Legends" asp-route-MinDate="01/01/0001"></a>
<input type="hidden" asp-for="IsSetDefaultStackMode" />
<input type="hidden" id="IsAgentLevel" value="@isAgentLevel.ToString()" />
