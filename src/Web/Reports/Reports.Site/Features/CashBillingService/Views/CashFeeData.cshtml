@using AlphaPlus.Reports.Features.CashBillingService.Models
@using AlphaPlus.Reports.Features.Shared.Extensions
@using AlphaPlus.Shared.AppResources.Report
@addTagHelper *, AlphaPlus.Reports.Site
@{
	Layout = null;

	void RenderCashFeeGroup(CashFeeGroupModel cashFeeGroup)
	{
		RenderFeeTypeRow(cashFeeGroup.Total);

		foreach (var item in cashFeeGroup.FeeItems)
		{
			RenderFeeItemRow(item);
		}
	}

	void RenderFeeTypeRow(CashFeeItemModel item)
	{
		<tr class="total-row">
			<td class="text-left">@item.DisplayType</td>
			<td></td>
			<td class="@(Model.IsNegative(item.Count) ? "format-negative" : string.Empty)">@item.Count.FormatNumber()</td>
			<td class="@(Model.IsNegative(item.Agent) ? "format-negative" : string.Empty)">@item.Agent.FormatNumber()</td>
			<td class="@(Model.IsNegative(item.Company) ? "format-negative" : string.Empty)">@item.Company.FormatNumber()</td>
		</tr>
	}

	void RenderFeeItemRow(CashFeeItemModel item)
	{
		<tr>
			<td class="text-left feeitem">@item.DisplayType</td>
			<td class="@(Model.IsNegative(item.Fee) ? "format-negative" : string.Empty)">@item.Fee.FormatNumber()</td>
			<td class="@(Model.IsNegative(item.Count) ? "format-negative" : string.Empty)">@item.Count.FormatNumber()</td>
			<td class="@(Model.IsNegative(item.Agent) ? "format-negative" : string.Empty)">@item.Agent.FormatNumber()</td>
			<td class="@(Model.IsNegative(item.Company) ? "format-negative" : string.Empty)">@item.Company.FormatNumber()</td>
		</tr>
	}
}
@model CashFeeModel
<table class="tb tb-bordered tb-hover w-full tb-cashfee tbl-win-loss-by-product " id="tbl-report">
	<thead>
		<tr>
			<th>@Resources.Type</th>
			<th>@Resources.Fee</th>
			<th>@Resources.Count</th>
			<th>@Resources.Agent</th>
			<th>@Resources.Company</th>
		</tr>
	</thead>
	@if (Model.FeeGroups.Any())
	{
		<tbody>
			@{
				foreach (var group in Model.FeeGroups)
				{
					RenderCashFeeGroup(group);
				}
			}
		</tbody>
		<tfoot>
			<tr class="tbl-footer">
				<td colspan="3">@Resources.Total</td>
				<td class="@(Model.IsNegative(Model.GrandTotal.Agent) ? "format-negative" : string.Empty)">@Model.GrandTotal.Agent.FormatNumber()</td>
				<td class="@(Model.IsNegative(Model.GrandTotal.Company) ? "format-negative" : string.Empty)">@Model.GrandTotal.Company.FormatNumber()</td>
			</tr>
		</tfoot>
	}
	else
	{
		<no-information colspan="5" />
	}
</table>
