@using AlphaPlus.Core.Helpers
@using AlphaPlus.Reports.Site.Features.WinLoss
@using AlphaPlus.Shared.AppResources.Report
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AlphaPlus.Reports.Site
@{
	Layout = "_Layout";
}
@section Styles {
	@StaticResources.AssetStyles.Render("/bundles-v2/site-reports/winloss")
	@StaticResources.RenderStyles("~/bundles-v2/winlossdetailnew")
}
@section Scripts {
	@StaticResources.RenderScripts("~/bundles/winloss/cashfee-report")
}
@model CashFeeViewModel
<div class="page-title page-title-upper">
	<div class="text-title icon-center">
		<span>@Model.PageHeader.Title</span>
		<a id="icon-excel" class="ic-excel ic-title" data-title="@Resources.ExportToExcel" asp-action="CashFeeExcel"
			asp-all-route-data="Model.GetExcelParams()"></a>
		<compact-feedback fid="32" />
	</div>
</div>
<div class="cash-fee-container">
	<div id="tbl-report-container">
		<partial name="~/Features/CashBillingService/Views/CashFeeData.cshtml" model="@Model.CashFee" />
	</div>
</div>
