@using AlphaPlus.Core.Helpers
@using AlphaPlus.Reports.Features.Shared.Extensions
@using AlphaPlus.Reports.Features.WinLoss
@using AlphaPlus.Reports.Site.Features.Shared.ViewModels.Components
@using AlphaPlus.Reports.Site.Features.WinLoss
@using AlphaPlus.Shared.AppResources.Common
@using AlphaPlus.Shared.AppResources.Report
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AlphaPlus.Reports.Site
@{
	Layout = "_Layout";
	ViewData["Title"] = Model.PageHeader.Title;
	var isSuperLevel = Model.CustLevel.IsSuperLevel();
	var isMasterLevel = Model.CustLevel.IsMasterLevel();
	var isAgentLevel = Model.CustLevel.IsAgentLevel();

	void RenderTableHeaderForSuperMaster()
	{
		<tr>
			<th class="sorting" rowspan="2" data-sortedname="CustName" data-colindex="0">@Resources.Username</th>
			<th class="sorting" rowspan="2" data-sortedname="IsDirectMember" data-colindex="1">@Resources.Level</th>
			<th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="Turnover" data-colindex="2" data-colname="turnover">
				@Resources.Turnover
			</th>
			<th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="GrossComm" data-colindex="3" data-colname="grosscomm">
				@Resources.GrossComm
			</th>
			<th rowspan="2" class="visible-stack-mode col-combine sorting" data-sortedname="Turnover" data-colindex="2">
				<span class="prior-sortedcolumn">@Resources.TurnoverAbbr</span>
				@(isAgentLevel ? "/ " + Resources.GrossComm :
						(isSuperLevel ? Resources.GrossComAndMasterTotal : Resources.GrossComAndAgentTotal))
			</th>
			<th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="DownlineTotal" data-colindex="4" data-colname="downlinetotal">
				@Resources.DownlineTotal
			</th>
			<th colspan="3" class="col-level hidden-stack-mode">@Model.CustLevelName</th>
			<th class="visible-stack-mode col-combine sorting" data-sortedname="@(Model.CustLevel.DisplayName + "WinLoss")"
				rowspan="2" data-colindex="3">
				@Model.CustLevelName
				<br />
				(<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
			</th>
			<th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="8" data-colname="company">
				@Resources.Company
			</th>
			<th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="4">
				@Resources.Company
			<th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="RewardAmount" data-colindex="9" data-colname="reward">
					@Resources.Reward @(Model.ReportData.DataSource.Any() ?
					$"({Model.ReportData.DataSource.First().RewardCurrency})" : string.Empty)
			</th>
			<th class="sorting visible-stack-mode" rowspan="2" data-sortedname="RewardAmount" data-colindex="5">
					@Resources.Reward @(Model.ReportData.DataSource.Any() ?
					$"({Model.ReportData.DataSource.First().RewardCurrency})" : string.Empty)
			</th>
		</tr>
		<tr class="thead-row2">
			<th class="hidden-stack-mode col-winloss sorting" data-sortedname="@(Model.CustLevel.DisplayName + "WinLoss")"
				data-colindex="5" data-colname="winloss">
				@Resources.WinLoss
			</th>
			<th class="hidden-stack-mode sorting" data-sortedname="@(Model.CustLevel.DisplayName + "Comm")" data-colindex="6" data-colname="comm">
				@Resources.Comm
			</th>
			<th class="hidden-stack-mode sorting" data-sortedname="@(Model.CustLevel.DisplayName + "Total")" data-colindex="7" data-colname="total">
				@Resources.Total
			</th>
		</tr>
	}

	void RenderTableHeaderForAgent()
	{
		<tr>
			<th class="sorting" rowspan="2" data-sortedname="CustName" data-colindex="0">@Resources.Username</th>
			<th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="Turnover" data-colindex="1" data-colname="turnover">
				@Resources.Turnover
			</th>
			<th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="GrossComm" data-colindex="2" data-colname="grosscomm">
				@Resources.GrossComm
			</th>
			<th rowspan="2" class="visible-stack-mode col-combine sorting" data-sortedname="Turnover" data-colindex="1">
				<span class="prior-sortedcolumn">@Resources.TurnoverAbbr</span>
				@(isAgentLevel ? "/ " + Resources.GrossComm :
						(isSuperLevel ? Resources.GrossComAndMasterTotal : Resources.GrossComAndAgentTotal))
			</th>
			<th colspan="3" class="col-level hidden-stack-mode">@Resources.Member</th>
			<th class="visible-stack-mode col-combine sorting" data-sortedname="MemberWinLoss" rowspan="2" data-colindex="2">
				@Resources.Member
				<br />
				(<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
			</th>
			<th colspan="3" class="col-level hidden-stack-mode">@Model.CustLevelName</th>
			<th class="visible-stack-mode col-combine sorting" data-sortedname="AgentWinLoss" rowspan="2" data-colindex="3">
				@Model.CustLevelName<br />(<span
					class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
			</th>
			<th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="9" data-colname="company">
				@Resources.Company
			</th>
			<th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="4">
				@Resources.Company
			</th>
			<th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="RewardAmount" data-colindex="9" data-colname="reward">
				@Resources.Reward @(Model.ReportData.DataSource.Any() ?
				$"({Model.ReportData.DataSource.First().RewardCurrency})" : string.Empty)
			</th>
			<th class="sorting visible-stack-mode" rowspan="2" data-sortedname="RewardAmount" data-colindex="5">
				@Resources.Reward @(Model.ReportData.DataSource.Any() ?
				$"({Model.ReportData.DataSource.First().RewardCurrency})" : string.Empty)
			</th>
		</tr>
		<tr class="thead-row2">
			<th class="hidden-stack-mode col-winloss sorting" data-sortedname="MemberWinLoss" data-colindex="3" data-colname="pwinloss">
				@Resources.WinLoss
			</th>
			<th class="hidden-stack-mode sorting" data-sortedname="MemberComm" data-colindex="4" data-colname="pcomm">
				@Resources.Comm
			</th>
			<th class="hidden-stack-mode sorting" data-sortedname="MemberTotal" data-colindex="5" data-colname="ptotal">
				@Resources.Total
			</th>
			<th class="hidden-stack-mode col-winloss sorting" data-sortedname="@(Model.CustLevel.DisplayName + "WinLoss")"
				data-colindex="6" data-colname="awinloss">
				@Resources.WinLoss
			</th>
			<th class="hidden-stack-mode sorting" data-sortedname="@(Model.CustLevel.DisplayName + "Comm")" data-colindex="7" data-colname="acomm">
				@Resources.Comm
			</th>
			<th class="hidden-stack-mode sorting" data-sortedname="@(Model.CustLevel.DisplayName + "Total")" data-colindex="8" data-colname="atotal">
				@Resources.Total
			</th>
		</tr>
	}

	void RenderRow(WinLossModel data, bool isTotalRow = false)
	{
		var isDormantAccounts = data.IsDormantAccounts;
		var isCashFee = string.IsNullOrEmpty(data.CustName) ? false : data.CustName.Equals("CASH SERVICE BILLING",
		StringComparison.OrdinalIgnoreCase);
		var rowClass = string.Empty;
		@if (isTotalRow)
		{
			rowClass = "tbl-footer";
		}
		else
		{
			if (isDormantAccounts)
			{
				rowClass = "dormant-accounts-mark";
			}
			else if (isCashFee)
			{
				rowClass = "cash-fee-row";
			}
			else
			{
				rowClass = string.Empty;
			}
		}

		<tr class="@rowClass">
			<td @(isDormantAccounts || isCashFee ? string.Empty : $"data-sortedvalue={data.CustName}")
				class="text-left col-username">
				@if (isTotalRow)
				{
					@Resources.Total
				}
				else if (isDormantAccounts)
				{
					<span class="pull-left">@Resources.DormantAccounts</span>
					<span class="icon icon-information-outline icon-dormant-accounts"
						title="@Resources.SummaryOfDormantAccounts"></span>
				}
				else if (isAgentLevel || data.IsDirectMember)
				{
					if (isCashFee)
					{
						<a href="javascript:;" class="open-link cash-fee-link"
							data-url="@Model.BuildCashFeeUrl(data.CustId, Model.PageHeader.BreadcrumbLevel.BreadcrumbsJson)">@data.CustName</a>
					}
					else
					{
						<a href="javascript:;" class="open-link"
							data-url="@Model.BuildBetListUrl(data.CustId, data.CustName)">@data.CustName</a>
					}
				}
				else
				{
					<a href="javascript:;" class="downline-link" data-custid="@data.CustId" data-custname="@data.CustName"
						data-custlevelid="@Model.DownlineLevelId">
						@data.CustName
					</a>
				}
			</td>
			@if (Model.ShowLevelType)
			{
				if (isTotalRow)
				{
					<td></td>
				}
				else
				{
					<td class="text-center">@(data.IsDirectMember ? CommonResx.DirectMember : Model.LevelTypeValue)</td>
				}
			}
			@if (Model.PageHeader.IsStackMode)
			{
				<td class="visible-stack-mode combinedcell col-turnover-combined">
					<ul>
						<li class="@(Model.IsNegative(data.Turnover.RoundTo2()) ? "format-negative" : string.Empty)">@data.Turnover.FormatNumber()</li>
						<li class="@(Model.IsNegative(data.GrossComm.RoundTo2()) ? "format-negative" : string.Empty)">@data.GrossComm.FormatNumber()</li>
						@if (!isAgentLevel)
						{
							<li class="@(Model.IsNegative(data.DownlineTotal.RoundTo2()) ? "format-negative" : string.Empty)">@data.DownlineTotal.FormatNumber()</li>
						}
					</ul>
				</td>
				if (isSuperLevel)
				{
					RenderStackNetWinLoss("super", data.WinLoss, data.Comm, data.Total, "altercol");
				}
				else if (isMasterLevel)
				{
					RenderStackNetWinLoss("master", data.WinLoss, data.Comm, data.Total, "altercol");
				}
				else
				{
					RenderStackNetWinLoss("member", data.MemberWinLoss, data.MemberComm, data.MemberTotal);
					RenderStackNetWinLoss("agent", data.WinLoss, data.Comm, data.Total, "altercol");
				}
			}
			else
			{
				<td class="hidden-stack-mode col-turnover @(Model.IsNegative(data.Turnover) ? "format-negative" : string.Empty)" data-colname="turnover">@data.Turnover.FormatNumber()</td>
				<td class="hidden-stack-mode col-gross-com @(Model.IsNegative(data.GrossComm.RoundTo2()) ? "format-negative" : string.Empty)" data-colname="grosscomm">@data.GrossComm.FormatNumber()</td>
				if (isSuperLevel)
				{
					<td class="hidden-stack-mode bold col-cust-total @(Model.IsNegative(data.DownlineTotal.RoundTo2()) ? "format-negative" : string.Empty)" data-colname="downlinetotal">@data.DownlineTotal.FormatNumber()</td>
					RenderNetWinLoss("super", data.WinLoss, data.Comm, data.Total, "altercol");
				}
				else if (isMasterLevel)
				{
					<td class="hidden-stack-mode bold col-cust-total @(Model.IsNegative(data.DownlineTotal.RoundTo2()) ? "format-negative" : string.Empty)" data-colname="downlinetotal">@data.DownlineTotal.FormatNumber()</td>
					RenderNetWinLoss("master", data.WinLoss, data.Comm, data.Total, "altercol");
				}
				else
				{
					RenderNetWinLoss("member", data.MemberWinLoss, data.MemberComm, data.MemberTotal);
					RenderNetWinLoss("agent", data.WinLoss, data.Comm, data.Total, "altercol");
				}
			}
			<td class="text-right col-company @(Model.IsNegative(data.Company.RoundTo2()) ? "format-negative" : string.Empty)" data-colname="company">@data.Company.FormatNumber()</td>
			<td class="text-right col-reward-amount" data-colname="reward">@data.RewardAmount.FormatNumber()</td>
		</tr>
	}

	void RenderStackNetWinLoss(string level, decimal winloss, decimal comm, decimal total, string highlightClass = "")
	{
		<td class="visible-stack-mode combinedcell col-@level-winloss-combined @highlightClass">
			<ul>
				<li class="@(Model.IsNegative(winloss.RoundTo2()) ? "format-negative" : string.Empty)">@winloss.FormatNumber()</li>
				<li class="@(Model.IsNegative(comm.RoundTo2()) ? "format-negative" : string.Empty)">@comm.FormatNumber()</li>
				<li class="@(Model.IsNegative(total.RoundTo2()) ? "format-negative" : string.Empty)">@total.FormatNumber()</li>
			</ul>
		</td>
	}

	void RenderNetWinLoss(string level, decimal winloss, decimal comm, decimal total, string highlightClass = "")
	{
		var prefix = level == "member" ? "p" : level == "agent" ?  "a" : string.Empty;
		<td class="hidden-stack-mode col-@level-winloss @highlightClass @(Model.IsNegative(winloss.RoundTo2()) ? "format-negative" : string.Empty)" data-colname="@(prefix)winloss">
			@winloss.FormatNumber()
		</td>
		<td class="hidden-stack-mode @highlightClass @(Model.IsNegative(comm.RoundTo2()) ? "format-negative" : string.Empty)" data-colname="@(prefix)comm">
			@comm.FormatNumber()
		</td>
		<td class="hidden-stack-mode bold @highlightClass col-cust-total @(Model.IsNegative(total.RoundTo2()) ? "format-negative" : string.Empty)" data-colname="@(prefix)total">
			@total.FormatNumber()
		</td>
	}
}
@section Styles {
	@StaticResources.AssetStyles.Render("/bundles-v2/site-reports/winloss")
	@StaticResources.AssetStyles.Render("/bundles-v2/site-reports/winlossdetailnew")
    @StaticResources.RenderStyles("~/bundles-v2/winlossdetailnew")
}
@section Scripts {
	<script type="text/javascript">
		var columnList = [
			{ value: "turnover", text: '@Resources.Turnover' },
			{ value: "grosscomm", text: '@Resources.GrossComm' },
			@if (!isAgentLevel)
			{
				@:{ value: "downlinetotal", text: '@Resources.DownlineTotal' },
			}
			@if (isAgentLevel)
			{
				@:{ value: "pwinloss", text: '@Resources.MemberWinLossNew' },
				@:{ value: "pcomm", text: '@Resources.MemberCommNew' },
				@:{ value: "ptotal", text: '@Resources.MemberTotalNew' },
				@:{ value: "awinloss", text: '@Resources.AgentWinLossNew' },
				@:{ value: "acomm", text: '@Resources.AgentCommNew' },
				@:{ value: "atotal", text: '@Resources.AgentTotalNew' },				
			}
			@if (isMasterLevel || isSuperLevel)
			{
				@:{ value: "winloss", text: '@(isSuperLevel ? Resources.SuperWinLossNew : Resources.MasterWinLossNew)' },
				@:{ value: "comm", text: '@(isSuperLevel ? Resources.SuperCommNew : Resources.MasterCommNew)' },
				@:{ value: "total", text: '@(isSuperLevel ? Resources.SuperTotalNew : Resources.MasterTotalNew)' },
			}
			{ value: "company", text: '@Resources.Company' },
			{ value: "reward", text: '@Resources.Reward' }
		];
	</script>
	@StaticResources.RenderScripts("~/bundles/winloss/winloss")
}
@model WinLossViewModel
<report-title model="Model.PageHeader" />
<form class="form-inline filter@(Model.PageHeader.IsFilterVisible ? string.Empty : " hide")" role="form"
	id="report-form">
	<product-multiselection model="@Model.ProductViewModel" />
	@if (Model.ShowLevelType)
	{
		<level-type custlevel="@Model.CustLevel" selected-value="@Model.LevelType" />
	}
	@if (Model.IsHistoricReport)
	{
		<visible-column />
		<month-picker model="Model.MonthPicker" />
		<div class="form-group form-group-short">
			<input type="submit" value="@Resources.Submit" class="btn-submit" />
		</div>
	}
	else
	{
		<visible-column />
		<daterange-picker model="Model.DateRangePicker" />
	}
	<div class="form-group form-group-short hide">
		<span id="icon-information" class="ic-information"></span>
	</div>
	<div class="form-group">
		<a class="ic-excel" title="@Resources.ExportToExcel" asp-action="Excel"
			asp-all-route-data="Model.BuildExcelParams()"></a>
	</div>
	@if (Model.ReportData.HasData)
	{
		<div class="form-group">
			<compact-feedback fid="14" />
		</div>
	}
	@if (Model.IsHistoricReport)
	{
		<div class="note">
			<span class="star">*</span>@Model.ViewDataInstructionMessage
			<a href="javascript:;" id="historic-report" data-is-historic-report="true">@Resources.BackToCurrentReport</a>
		</div>
	}
	else
	{
		<a href="javascript:;" class="hide" id="historic-report" data-is-historic-report="false"></a>
	}
	<input type="hidden" asp-for="CustId" />
	<input type="hidden" asp-for="CustName" />
	<input type="hidden" id="CustLevelId" name="CustLevelId" value="@Model.CustLevel.Value.ToString()" />
	<input type="hidden" name="BreadcrumbsJson" value="@Model.PageHeader.BreadcrumbLevel.BreadcrumbsJson" />
	<input type="hidden" asp-for="IsHistoricReport" />
</form>
<table class="tb tb-bordered tb-hover tablesorter w-full @(Model.PageHeader.IsStackMode ? " stack-mode" : string.Empty)"
	data-cansort="@Model.ReportData.MoreThanOne" data-sortedcolumn="@Model.SortPropertyName"
	data-descendingsort="@Model.DescendingSort" id="tbl-report" style="visibility:hidden">
	<thead>
		@if (isAgentLevel)
		{
			RenderTableHeaderForAgent();
		}
		else
		{
			RenderTableHeaderForSuperMaster();
		}
	</thead>
	@if (Model.ReportData.HasData)
	{
		<tbody>
			@foreach (var data in Model.ReportData.DataSource)
			{
				RenderRow(data);
			}
		</tbody>
		<tfoot>
			@{
				RenderRow(Model.ReportData.Total, true);
			}
		</tfoot>
	}
	else
	{
		<no-information colspan="@(isAgentLevel ? 11 : 10)" />
	}
</table>
<a class="hide" id="LoadLegendURL" asp-action="WinLoss" asp-controller="Legends"
	asp-route-MinDate="@(Model.DateRangePicker != null ? Model.DateRangePicker.MinDate : string.Empty)"
	asp-route-IsHistoricReport="@Model.IsHistoricReport" asp-route-ShowDormantAccountsNote="True"></a>
<input type="hidden" asp-for="IsSetDefaultStackMode" />
<input type="hidden" id="IsAgentLevel" value="@isAgentLevel.ToString()" />
<input type="hidden" id="query-productids" value="@Model.ProductViewModel.UserSelectedProductIds" />
<input type="hidden" id="query-resourceids" value="@Model.ProductViewModel.UserSelectedResourceIds" />
<input type="hidden" id="query-fromdate" value="@Model.FromDate" />
<input type="hidden" id="query-todate" value="@Model.ToDate" />
<input type="hidden" id="IsSuperLevel" value="@isSuperLevel.ToString()" />
<input type="hidden" id="IsMasterLevel" value="@isMasterLevel.ToString()" />
<input type="hidden" id="SubAccId" value="@Model.SubAccId" />
<input type="hidden" id="UserId" value="@Model.UserId" />
