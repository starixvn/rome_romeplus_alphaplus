@using AlphaPlus.Reports.Features.WinLossDetail.Models
@using AlphaPlus.Reports.Site.Features.WinLossDetail.ViewModels
@{
	Layout = "_Layout";

	void RenderCashFeeGroup(CashFeeGroupModel cashFeeGroup)
	{
		RenderFeeItemRow(cashFeeGroup.Total, true);

		foreach (var item in cashFeeGroup.FeeItems)
		{
			RenderFeeItemRow(item);
		}
	}

	void RenderFeeItemRow(CashFeeItemModel item, bool isTotalRow = false)
	{
		var rowClass = isTotalRow ? "sub-total-row" : "";
		<tr class="@rowClass">
			<td>@item.Type</td>
			<td>@item.Fee.FormatNumber()</td>
			<td>@item.Count.FormatNumber()</td>
			<td>@item.Agent.FormatNumber()</td>
			<td>@item.Company.FormatNumber()</td>
		</tr>
	}
}
@section Styles {
	@StaticResources.AssetStyles.Render("/bundles-v2/site-reports/winlossdetailnew")
	<link rel="stylesheet" href="~/bundles-v2/winlossdetailnew.css" />
}
@section Scripts {
	@StaticResources.AssetScripts.RenderCommon("/bundles/site-reports/winlossdetail")
	<script src="~/bundles/winlossdetail/cashFee.js"></script>
}
@model CashFeeViewModel



<div class="title-has-info title-has-entered">
	<report-title-new model="Model.PageHeader" />
</div>
<form class="form-inline filter" role="form" id="report-form">
	<daterange-picker-jquery model="@Model.DateRangePicker" />
</form>

<div class="breadcrumb-table">
	<div class="breadcrumb-container">
		<ul class="breadcrumb" id="breadcrumb-level">
			@{
				var index = 0;
				var breadcrumbsCount = Model.Breadcrumbs.Count();
			}
			@foreach (var item in Model.Breadcrumbs)
			{
				if (index + 1 == breadcrumbsCount)
				{
					<li>@item.CustName</li>
				}
				else
				{
					index++;
					<li>
						<a href="javascript:;" class="upline-link" data-custid="@item.CustId" data-custname="@item.CustName"
						   data-custlevelid="@item.CustLevelId">@item.CustName</a>
					</li>
				}
			}
		</ul>
	</div>
	<div class="list-icon">
		<ul>
			<li>
				<span id="icon-copy" class="ic-copy" data-toggle="tooltip" data-placement="top"
					  title="@Resources.Copy"></span>
			</li>
			<li>
				<a id="icon-excel" class="ic-excel" data-toggle="tooltip" data-placement="top"
				   title="@Resources.ExportToExcel" asp-action="Excel"></a>
			</li>
		</ul>
	</div>
</div>
<div id="tbl-report-container">
	<table class="tb tb-bordered tb-hover w-full tbl-win-loss-by-product@(Model.PageHeader.IsStackMode ? " stack-mode" : string.Empty) "
		   id="tbl-report">
		<thead>
			<tr>
				<th>Type</th>
				<th>Fee</th>
				<th>Count</th>
				<th>@Resources.Agent</th>
				<th>@Resources.Company</th>
			</tr>
		</thead>
		@if (Model.CashFee.FeeGroups.Any())
		{
			<tbody>
				@{
					foreach (var group in Model.CashFee.FeeGroups)
					{
						RenderCashFeeGroup(group);
					}
				}
			</tbody>
			<tfoot>
				<tr class="tbl-footer">
					<td colspan="3">@Resources.Total</td>
					<td>@Model.CashFee.GrandTotal.Agent.FormatNumber()</td>
					<td>@Model.CashFee.GrandTotal.Company.FormatNumber()</td>
				</tr>
			</tfoot>
		}
		else
		{
			<no-information colspan="5" />
		}
	</table>
</div>
<input type="hidden" id="hidden-breadcrumbsJson" value="@JsonHelper.ToJson(Model.Breadcrumbs)" />
<input type="hidden" id="winloss-detail-report-path" value="@MicroSites.ReportsUrl("~/WinLossDetail/Index")" />
