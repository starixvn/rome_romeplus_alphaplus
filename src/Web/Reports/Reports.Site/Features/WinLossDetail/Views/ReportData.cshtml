@{
    Layout = null;
    var isSuperLevel = Model.CustLevel.IsSuperLevel();
    var isMasterLevel = Model.CustLevel.IsMasterLevel();
    var isMasterOrSuperLevel = Model.CustLevel.IsMasterOrSuperLevel();
    var isAgentLevel = Model.CustLevel.IsAgentLevel();
    var theadIndex = 0;
    var totalColumns = isSuperLevel
    ? 20
    : Model.CustLevel.IsMasterLevel() ? 17 : 14;
    var rewardCurrency = Model.ReportData.Total?.RewardCurrency;
    var rewardColumnName = string.Format(
    "{0}{1}",
    Resources.Reward,
    string.IsNullOrWhiteSpace(rewardCurrency) ? string.Empty : $"<br/>({rewardCurrency})");

    void RenderRow(WinLossDetailModel data, bool isTotalRow = false)
    {
        var isDormantAccounts = data.CustId == 0;
        <tr class="@(isTotalRow ? "tbl-footer" : (isDormantAccounts ? "dormant-accounts-mark" : string.Empty))">
            @{
                RenderUsernameColumn(data, isTotalRow, isDormantAccounts);
            }
            <td data-colname="betcount">@data.NumberOfTickets.FormatNumber()</td>
            <td data-colname="turnover">@data.Turnover.FormatNumber()</td>
            <td data-colname="netturnover">@data.NetTurnover.FormatNumber()</td>
            <td data-colname="grosscomm">@data.GrossComm.FormatNumber()</td>
            <td data-colname="pwinloss">@data.MemberWinLoss.FormatNumber()</td>
            <td data-colname="pcomm">@data.MemberComm.FormatNumber()</td>
            <td data-colname="ptotal" class="bold">@data.MemberTotal.FormatNumber()</td>
            <td data-colname="awinloss">@data.AgWinLoss.FormatNumber()</td>
            <td data-colname="acomm">@data.AgComm.FormatNumber()</td>
            <td data-colname="atotal" class="bold">@data.AgTotal.FormatNumber()</td>
            @if (isMasterOrSuperLevel)
            {
                <td data-colname="mwinloss">@data.MAgWinLoss.FormatNumber()</td>
                <td data-colname="mcomm">@data.MAgComm.FormatNumber()</td>
                <td data-colname="mtotal" class="bold">@data.MAgTotal.FormatNumber()</td>
            }
            @if (isSuperLevel)
            {
                <td data-colname="swinloss">@data.SAgWinLoss.FormatNumber()</td>
                <td data-colname="scomm">@data.SAgComm.FormatNumber()</td>
                <td data-colname="stotal" class="bold">@data.SAgTotal.FormatNumber()</td>
            }
            <td data-colname="company">@data.Company.FormatNumber()</td>
            <td data-colname="reward">@data.RewardAmount.FormatNumber())</td>
        </tr>
    }
    void RenderUsernameColumn(WinLossDetailModel data, bool isTotalRow, bool isDormantAccounts)
    {
        if (isTotalRow)
        {
            <td class="text-left">@Resources.Total</td>
            <td data-colname="fullname"></td>
        }
        else
        {
            <td class="text-left col-username" @(isDormantAccounts ? string.Empty : $"data-sortedvalue={data.CustName}")>
                @if (isDormantAccounts)
                {
                    <span class="pull-left">@Resources.DormantAccounts</span>
                    <span class="icon icon-information-outline icon-dormant-accounts" data-toggle="tooltip" data-placement="right"
                        title="@Resources.SummaryOfDormantAccounts"></span>
                }
                else if (Model.CanDrilldown)
                {
                    if ((isAgentLevel || data.IsDirectMember) && data.NumberOfTickets == 0)
                    {
                        @:@data.CustName
                    }
                    else
                    {
                        <a href="javascript:;" class="downline-link" data-custid="@data.CustId" data-custname="@data.CustName"
                            data-custlevelid="@(data.IsDirectMember ? UserLevel.Member.Value : Model.DownlineLevelId)">@data.CustName</a>
                    }
                }
                else
                {
                    @:@data.CustName
                }
                @if (Model.CanShowMonitoredIcon)
                {
                    if (data.IsExistedWatchlist)
                    {
                        <span class="icon-mywatchlist" data-toggle="tooltip" data-placement="right"
                            title="@Resources.MonitoredMember"></span>
                    }
                    else if (Model.CanUpdateAccount)
                    {
                        <span class="icon-plus-box" data-toggle="tooltip" data-placement="right" title="@Resources.AddToMyWatchlist"
                            data-custname="@data.CustName"></span>
                    }
                }
            </td>
            <td class="text-left" data-colname="fullname">
                <div class="fullname" data-toggle="tooltip" data-placement="bottom" title="@data.FullName">@data.FullName</div>
            </td>
        }
    }
}
@model WinLossDetailGetDataViewModel
<div class="breadcrumb-table">
    <div class="breadcrumb-container">
        <ul class="breadcrumb" id="breadcrumb-level">
            @{
                var index = 0;
                var breadcrumbsCount = Model.Breadcrumbs.Count();
            }
            @foreach (var item in Model.Breadcrumbs)
            {
                if (index + 1 == breadcrumbsCount)
                {
                    <li>@item.CustName</li>
                }
                else
                {
                    index++;
                    <li><a href="javascript:;" class="upline-link" data-custid="@item.CustId" data-custname="@item.CustName"
                            data-custlevelid="@item.CustLevelId">@item.CustName</a></li>
                }
            }
        </ul>
    </div>
    <div class="list-icon">
        <ul>
            <li><span id="icon-copy" class="ic-copy" data-toggle="tooltip" data-placement="top"
                    title="@Resources.Copy"></span></li>
            <li>
                <a id="icon-excel" class="ic-excel" data-toggle="tooltip" data-placement="top"
                    title="@Resources.ExportToExcel" asp-action="Excel"></a>
            </li>
        </ul>
    </div>
</div>
<div class="wrapper-table-scrollable">
    <table class="tb tb-bordered w-full tablesorter tb-hover tb-freeze-body tb-freeze-header"
        data-cansort="@Model.ReportData.MoreThanOne" id="tbl-report">
        <thead>
            <tr>
                <th class="sorting" rowspan="2" data-colindex="@(theadIndex++)" data-colname="username"
                    data-sorttype="text">
                    @Resources.Username
                </th>
                <th class="sorting" rowspan="2" data-colindex="@(theadIndex++)" data-colname="fullname"
                    data-sorttype="text">
                    @Resources.FirstLastName</th>
                <th class="sorting" rowspan="2" data-colindex="@(theadIndex++)" data-colname="betcount">
                    @Resources.BetCount
                </th>
                <th class="sorting" rowspan="2" data-colindex="@(theadIndex++)" data-colname="turnover">
                    @Resources.Turnover
                </th>
                <th class="sorting" rowspan="2" data-colindex="@(theadIndex++)" data-colname="netturnover">
                    @Resources.NetTurnover</th>
                <th class="sorting" rowspan="2" data-colindex="@(theadIndex++)" data-colname="grosscomm">
                    @Resources.GrossComm</th>
                <th colspan="3" id="groupColumnMember">@Resources.Member</th>
                <th colspan="3" id="groupColumnAgent">@Resources.Agent</th>
                @if (isMasterOrSuperLevel)
                {
                    <th colspan="3" id="groupColumnMaster">@Resources.Master</th>
                }
                @if (isSuperLevel)
                {
                    <th colspan="3" id="groupColumnSuper">@Resources.Super</th>
                }
                <th class="sorting" rowspan="2" data-colindex="@(totalColumns - 2)" data-colname="company">
                    @Resources.Company</th>
                <th class="sorting" rowspan="2" data-colindex="@(totalColumns - 1)" data-colname="reward">
                    @Html.Raw(rewardColumnName)</th>
            </tr>
            <tr class="thead-row2">
                <th class="sorting" data-colindex="@(theadIndex++)" data-colname="pwinloss">@Resources.WinLoss</th>
                <th class="sorting" data-colindex="@(theadIndex++)" data-colname="pcomm">@Resources.Comm</th>
                <th class="sorting" data-colindex="@(theadIndex++)" data-colname="ptotal">@Resources.Total</th>
                <th class="sorting" data-colindex="@(theadIndex++)" data-colname="awinloss">@Resources.WinLoss</th>
                <th class="sorting" data-colindex="@(theadIndex++)" data-colname="acomm">@Resources.Comm</th>
                <th class="sorting" data-colindex="@(theadIndex++)" data-colname="atotal">@Resources.Total</th>
                @if (isMasterOrSuperLevel)
                {
                    <th class="sorting" data-colindex="@(theadIndex++)" data-colname="mwinloss">@Resources.WinLoss</th>
                    <th class="sorting" data-colindex="@(theadIndex++)" data-colname="mcomm">@Resources.Comm</th>
                    <th class="sorting" data-colindex="@(theadIndex++)" data-colname="mtotal">@Resources.Total</th>
                }
                @if (isSuperLevel)
                {
                    <th class="sorting" data-colindex="@(theadIndex++)" data-colname="swinloss">@Resources.WinLoss</th>
                    <th class="sorting" data-colindex="@(theadIndex++)" data-colname="scomm">@Resources.Comm</th>
                    <th class="sorting" data-colindex="@(theadIndex++)" data-colname="stotal">@Resources.Total</th>
                }
            </tr>
        </thead>
        @if (Model.ReportData.HasData)
        {
            <tbody>
                @foreach (var data in Model.ReportData.DataSource)
                {
                    RenderRow(data);
                }
            </tbody>
            <tfoot>
                @{
                    RenderRow(Model.ReportData.Total, true);
                }
            </tfoot>
        }
        else
        {
            <no-information colspan="@totalColumns" />
        }
    </table>
</div>
<input type="hidden" id="hidden-custLevelId" value="@Model.CustLevel.Value.ToString()" />
<input type="hidden" id="hidden-breadcrumbsJson" value="@JsonHelper.ToJson(Model.Breadcrumbs)" />
<input type="hidden" id="hidden-totalEnteredResultsJson" value="@JsonHelper.ToJson(Model.TotalEnteredResults)" />