@{
    Layout = "_Layout";
    ViewData["Title"] = Model.PageHeader.Title;
    var isSuperLevel = Model.ViewerLevel.IsSuperLevel();
    var isMasterOrSuperLevel = Model.ViewerLevel.IsMasterOrSuperLevel();
    var version = AlphaPlus.Core.Configurations.AppSettings.JsVersion;
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-reports/winlossdetailnew")
    <link rel="stylesheet" href="~/bundles-v2/winlossdetailnew.css?v=@version" />
}
@section Scripts {
    <script type="text/javascript">
        var productList = $.parseJSON('@Html.Raw(JsonHelper.ToJson(Model.ProductViewModel.Products))');
        var productDetailList = $.parseJSON('@Html.Raw(JsonHelper.ToJson(Model.ProductViewModel.ProductDetails))');
        var columnList = [
            { value: "fullname", text: '@Resources.FirstLastName', checked: false },
            { value: "betcount", text: '@Resources.BetCount' },
            { value: "turnover", text: '@Resources.Turnover' },
            { value: "netturnover", text: '@Resources.NetTurnover' },
            { value: "grosscomm", text: '@Resources.GrossComm' },
            { value: "pwinloss", text: '@Resources.MemberWinLossNew' },
            { value: "pcomm", text: '@Resources.MemberCommNew' },
            { value: "ptotal", text: '@Resources.MemberTotalNew' },
            { value: "awinloss", text: '@Resources.AgentWinLossNew' },
            { value: "acomm", text: '@Resources.AgentCommNew' },
            { value: "atotal", text: '@Resources.AgentTotalNew' },
        @if (isMasterOrSuperLevel)
        {
            @:{ value: "mwinloss", text: '@Resources.MasterWinLossNew' },
            @:{ value: "mcomm", text: '@Resources.MasterCommNew' },
            @:{ value: "mtotal", text: '@Resources.MasterTotalNew' },
        }
        @if (isSuperLevel)
        {
            @:{ value: "swinloss", text: '@Resources.SuperWinLossNew' },
            @:{ value: "scomm", text: '@Resources.SuperCommNew' },
            @:{ value: "stotal", text: '@Resources.SuperTotalNew' },
        }
            { value: "company", text: '@Resources.Company' },
            { value: "reward", text: '@Resources.Reward' }
        ];
        var currentFromData = {
            custId: @Model.CustId,
            custName: '@Model.CustName',
            custLevelId: @Model.CustLevelId,
            weekFromDate: '@Model.WeekFromDate',
            weekToDate: '@Model.WeekToDate',
            fromDate: '@Model.DateRangePicker.FromDate',
            toDate: '@Model.DateRangePicker.ToDate',
            levelType: @Model.LevelType,
            username: '@Model.Username'
        }
        var viewerLevelId = @Model.ViewerLevel.Value;
    </script>
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-reports/winlossdetail")
    <script src="~/bundles/winlossdetail/winlossdetail.js?v=@version"></script>
}
@model WinLossDetailViewModel
<div class="flex" style="visibility: hidden">
    <div class="title-has-info title-has-entered">
        <report-title-new model="Model.PageHeader" fid="15" />
    </div>
    <form class="form-inline filter" role="form" id="report-form">
        <daterange-picker-jquery model="@Model.DateRangePicker" />
        <product-dropdown show-product-details="true" />
        @if (Model.ShowLevelType)
        {
            <level-type custlevel="@Model.CustLevel" selected-value="@Model.LevelType" />
        }
        <username-autosuggestion value="@Model.Username" />
        <visible-column />
        <div class="label-week-box" id="week-container">
            <partial name="Weeks" model="@Model.Weeks" />
        </div>
    </form>
    <div id="tbl-report-container" class="cover-week-selection">
        <partial name="ReportData" />
    </div>
</div>
<a class="hide" id="hidden-getReportDataUrl" asp-action="GetData"></a>
<a class="hide" id="hidden-getReportWeeksUrl" asp-action="GetWeeks"></a>
<a class="hide" id="LoadLegendURL" asp-action="WinLossDetail" asp-controller="Legends" asp-route-IsNew="true"
    asp-route-MinDate="@Model.DateRangePicker.MinDate" asp-route-ShowDormantAccountsNote="True"></a>
<a class="hide" id="hidden-usernameSuggestionUrl" asp-action="Suggest" asp-controller="Customer"></a>
<input type="hidden" id="hidden-betListUrl" value="@MicroSites.TicketUrl("~/WinLoss/IndexNew")" />
<input type="hidden" id="hidden-cashFeeUrl" value="@MicroSites.ReportsUrl("~/WinLossDetail/CashFee")" />
<input type="hidden" asp-for="VisibleColumns" />
<input type="hidden" id="hidden-copyText" value="@Resources.Copy" />
<input type="hidden" id="hidden-copiedText" value="@Resources.Copied" />
<input type="hidden" id="hidden-settingsUrl" value="@MicroSites.SettingUrl()" />
<input type="hidden" id="hidden-titleText2" value="@Resources.MemberWinLossDetail" />
@if (isMasterOrSuperLevel)
{
    <input type="hidden" id="hidden-titleText3" value="@Resources.AgentWinLossDetail" />
    <input type="hidden" id="hidden-masterAgentText3" value="@Resources.Agent" />
}
@if (isSuperLevel)
{
    <input type="hidden" id="hidden-titleText4" value="@Resources.MasterWinLossDetail" />
    <input type="hidden" id="hidden-masterAgentText4" value="@CommonResx.MasterAgent" />
}
