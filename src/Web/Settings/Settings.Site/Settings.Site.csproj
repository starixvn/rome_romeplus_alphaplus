<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AlphaPlus.Settings.Site</AssemblyName>
    <RootNamespace>AlphaPlus.Settings.Site</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
    <TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
    <IsPackable>false</IsPackable>
    <SpaRoot>Features\CreateAccount\ClientApp\</SpaRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="App_Data\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fanex.Customer.Client" Version="1.0.3.6" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.7" />
    <PackageReference Include="Fanex.Cryptography.Aes" Version="1.0.0.6" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <PackageReference Include="ONEbook.SpreadSheets" Version="2.0.0-netstandard01" />
    <PackageReference Include="ONEbook.SpreadSheets.NPOI" Version="1.0.0.3" />
    <PackageReference Include="Fanex.Common" Version="1.1.2.1" />
    <PackageReference Include="Fanex.Logging.RabbitMQ" Version="1.0.1" />
    <PackageReference Include="Fanex.Logging.Sentry" Version="5.0.0.1" />
    <PackageReference Include="Fanex.RemotingRef" Version="1.5.5.1" />
    <PackageReference Include="MediatR" Version="12.3.0" />
    <PackageReference Include="NPOI" Version="2.2.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\Shared\Extensions\FanexLoggingExtensions.cs" Link="Extensions\FanexLoggingExtensions.cs" />
    <Compile Include="..\..\..\Shared\Extensions\RemotingRefExtensions.cs" Link="Extensions\RemotingRefExtensions.cs" />
    <Compile Include="..\..\..\Shared\Extensions\HttpClientExtensions.cs" Link="Extensions\HttpClientExtensions.cs" />
    <Compile Include="..\..\..\Shared\Constants\RoleIdConstants.cs" Link="Features\Shared\Constants\RoleIdConstants.cs" />
    <Compile Include="..\..\..\Shared\Constants\ServiceTypeConstants.cs" Link="Features\Shared\Constants\ServiceTypeConstants.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Modules\AlphaPlus.Core\AlphaPlus.Core.csproj" />
    <ProjectReference Include="..\..\..\Modules\AlphaPlus.NetThrottling\AlphaPlus.NetThrottling.csproj" />
    <ProjectReference Include="..\..\..\Services\Settings\MemberInfo\MemberInfo.Domain\MemberInfo.Domain.csproj" />
    <ProjectReference Include="..\..\..\Modules\AlphaPlus.Utilities.IP\AlphaPlus.Utilities.IP.csproj" />
    <ProjectReference Include="..\..\..\Services\Settings\MemberInfo\MemberInfo.API\MemberInfo.API.csproj" />
    <ProjectReference Include="..\..\..\Modules\AlphaPlus.SecurityCode\AlphaPlus.SecurityCode.csproj" />
    <ProjectReference Include="..\..\..\Services\Settings\Viewlogs\ViewLog.API\ViewLog.API.csproj" />
    <ProjectReference Include="..\..\..\Services\Settings\Transfers\Transfer.API\Transfer.API.csproj" />
    <ProjectReference Include="..\..\..\Shared\AlphaPlus.Shared.AppResources\AlphaPlus.Shared.AppResources.csproj" />
    <ProjectReference Include="..\..\..\Services\Features\Messages\Messages.API.csproj" />
  </ItemGroup>
</Project>