@using AlphaPlus.Shared.AppResources.Settings.ViewLog
@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
@using AlphaPlus.Settings.Site.Features.ViewLogs.ViewModels
@using AlphaPlus.Core.Helpers
@using ViewLogResources = AlphaPlus.Shared.AppResources.Settings.ViewLog.Resources
@using MemberInfoResources = AlphaPlus.Shared.AppResources.Settings.MemberInfo.Resources
@addTagHelper *, AlphaPlus.Settings.Site
@model LogViewModel
@{
    Layout = "~/Features/ViewLogs/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ViewLogResources.ViewLogCredit;
}
<div class="tab-content tb-ver2">
    <div role="tabpanel" class="tab-pane active" id="@ViewContext.RouteData.Values["controller"].ToString().ToLower()">
        <div class="filter">
            <form class="form-inline" role="form">
                <div class="form-group">
                    <input type="text" id="txt-username" placeholder="@ViewLogResources.UsernameOrFirstLastName"
                        value="@(string.IsNullOrWhiteSpace(Model.Username) ? string.Empty : Model.Username)"
                        autocomplete="off" />
                </div>
                <div class="form-group">
                    <div id="monthPickerID">
                        <div id="ddlMonth"></div>
                    </div>
                </div>
                <div class="form-group submit-box">
                    <input type="button" class="btn-submit" id="btn-submit" value="@ViewLogResources.Submit">
                    <span id="icon-excel" class="icon-excel" data-toggle="tooltip" data-placement="top"
                        title="@MemberInfoResources.ExportToExcel"></span>
                    <span id="icon-loading" class="hide block-icon-small"></span>
                </div>
                @if (Model.HasLogs)
                {
                    <div class="form-group">
                        <compact-feedback fid="94" />
                    </div>
                }
            </form>
        </div>

        <div id="content">
            <table id="DataLog" class="width-100per tblRpt tblRpt-bordered">
                <thead>
                    <tr class="RptHeader">
                        <th>@ViewLogResources.No</th>
                        <th>@ViewLogResources.Username</th>
                        <th>@ViewLogResources.Action</th>
                        <th>@ViewLogResources.Details</th>
                        <th>@ViewLogResources.IP</th>
                    </tr>

                </thead>
                <tbody>
                    @if (Model.HasLogs)
                    {
                        var index = 1;
                        foreach (var logItem in Model.LogItems)
                        {
                            <tr>
                                <td align="center">
                                    @(Model.FirstRowNumber + index++)
                                </td>
                                <td align="left">
                                    @logItem.CustName
                                </td>
                                <td class="col-action">
                                    <span class="action-name">@Html.Raw(logItem.ActionName)</span>
                                    <br />
                                    @if (LogViewModel.ShowEditedBy(logItem.ActionId))
                                    {
                                        <span class="username">@Html.Raw(ViewLogResources.By + " " + logItem.Username)</span>
                                    }

                                    <span class="log-date">@Html.Raw(logItem.LogDate)</span>
                                    <br />
                                    <span class="logid">#@logItem.LogId</span>
                                </td>
                                <td align="left">
                                    @Html.Raw(logItem.Details)
                                    <br />
                                    <span class="valuechanged">@Html.Raw(logItem.TrackingValue)</span>
                                    <span class="valueold\">(@Html.Raw(logItem.TrackingValueOld))</span>
                                </td>
                                <td align="center">@Html.Raw(logItem.IP)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" align="center">@ViewLogResources.NoInfo</td>
                        </tr>
                    }
            </table>
            <div id="pagination" class="@(Model.HasLogs ? " ":"hide" )"></div>
        </div>
    </div>
</div>

@Html.Hidden("maxReportDate", Model.MaxReportDate)
@Html.Hidden("minReportDate", Model.MinReportDate)
@Html.Hidden("dayInMonth", Model.DayInMonth)
@Html.Hidden("totalRecords", Model.TotalRecords)
@Html.Hidden("pageIndex", Model.PageIndex)
@Html.Hidden("actionTypeId", Model.ActionTypeId)
@Html.Hidden("showOldValuesCookieName", Model.ShowOldValuesCookieName)
@Html.Hidden("viewmodal-fromdate", Model.FromDate)
@Html.Hidden("viewmodal-todate", Model.ToDate)
@Html.Hidden("viewmodal-pagesize", Model.PageSize)

@Html.Hidden("labelTo", ViewLogResources.To)
@Html.Hidden("noInfo", ViewLogResources.NoInfo)
@Html.Hidden("Page", ViewLogResources.Page)
@Html.Hidden("of", ViewLogResources.of)
@Html.Hidden("Pager_DisplayItems", ViewLogResources.Pager_DisplayItems)
@Html.Hidden("exportExcelPath", Url.Action("Excel", "Credit"))

@section Scripts
{
    @StaticResources.AssetScripts.Render("/bundles/site-viewlogs/default")
    @StaticResources.RenderScripts("~/Features/ViewLogs/assets/bundles/credit")
}
