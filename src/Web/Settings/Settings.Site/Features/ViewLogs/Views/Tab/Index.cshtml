@using AlphaPlus.Settings.Site.Features.ViewLogs.ViewModels;
@using AlphaPlus.Settings.Site.Features.ViewLogs.Constants;
@using AlphaPlus.Settings.Site.Features.ViewLogs.Configurations;
@using AlphaPlus.Shared.AppResources.Settings.ViewLog;

@model TabViewModel
<ul id="nav-tabs" class="nav nav-tabs" role="tablist">
    <li role="presentation" class="@(string.Equals(Model.SelectedTabName, TabType.Setting,StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
        <a data-tablink="/settings/setting/index")" role="tab" aria-controls="@TabType.Setting" data-to data-toggle="tab" class="lnk-changetab">@Resources.Setting</a>
    </li>
    <li role="presentation" class="@(string.Equals(Model.SelectedTabName, TabType.Status,StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
        <a data-tablink="/settings/status/index")" role="tab" aria-controls="@TabType.Status" data-toggle="tab" class="lnk-changetab">@Resources.Status</a>
    </li>
    <li role="presentation" class="@(string.Equals(Model.SelectedTabName, TabType.Credit,StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
        <a data-tablink="/settings/credit/index")" role="tab" aria-controls="@TabType.Credit" data-toggle="tab" class="lnk-changetab">@Resources.Credit</a>
    </li>
    <li role="presentation" class="@(string.Equals(Model.SelectedTabName, TabType.Login,StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
        <a data-tablink="/settings/login/index")" role="tab" aria-controls="@TabType.Login" data-toggle="tab" class="lnk-changetab">@Resources.Login</a>
    </li>
    <li role="presentation" class="@(string.Equals(Model.SelectedTabName, TabType.CashService,StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)">
        <a data-tablink="/settings/cashservice/index")" role="tab" aria-controls="@TabType.CashService" data-toggle="tab" class="lnk-changetab">@Resources.CashService</a>
    </li>
</ul>