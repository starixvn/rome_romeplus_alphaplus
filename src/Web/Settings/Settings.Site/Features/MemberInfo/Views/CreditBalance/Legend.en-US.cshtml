@{
    Layout = null;
}
@using AlphaPlus.Settings.Site.Features.MemberInfo.ViewModels.CreditBalance
@using AlphaPlus.Shared.AppResources.Settings.MemberInfo

@model CreditBalanceViewModel

<div class="modal fade message-modal" id="report-legend" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="icon icon-close close" data-dismiss="modal"
                    aria-label="@Resources.ConditionToClearCredit"><span aria-hidden="true"></span></button>
                <h4 class="modal-title">@Resources.ConditionToClearCredit</h4>
            </div>
            <div class="modal-body">
                <div id="msg-content">
                    @if (Model.CustLevel.IsAgentLevel())
                    {
                        <p>- Cash Members are not included on this page</p>
                        if (!string.IsNullOrWhiteSpace(Model.TransferCondition))
                        {
                            <p>- @Model.TransferCondition</p>
                        }
                        if (Model.IsViewingMemberList)
                        {
                            <p>- @Resources.CreditBalanceNote</p>
                        }
                        <p>- Any Member has not logged in after created by Agent for over 14 days.</p>
                    }
                    else
                    {
                        <span>Credit given to downlines will be automatically cleared under the following conditions:</span>
                        if (Model.CustLevel.IsSuperLevel())
                        {
                            if (Model.IsViewingMemberList)
                            {
                                <p>- @Resources.CreditBalanceNote</p>
                            }
                            <ul class="list-msg">
                                <li>
                                    For Master/Agent who does not have any downlines (include direct members):
                                    <p>- If the Master/Agent does not log in within 7 days after being created by their direct
                                        upline.</p>
                                </li>
                                <li>
                                    For Member/ Direct Member:
                                    <p>- If the Member/ Direct Member does not log in within 14 days after being created by
                                        their direct upline.</p>
                                </li>
                            </ul>
                        }
                        else
                        {
                            if (Model.IsViewingMemberList)
                            {
                                <p>- @Resources.CreditBalanceNote</p>
                            }
                            <ul class="list-msg">
                                <li>
                                    For Agent who does not have any downlines:
                                    <p>- If the Agent does not log in within 7 days after being created by Master.</p>
                                </li>
                                <li>
                                    For Member/ Direct Member:
                                    <p>- If the Member/ Direct Member does not log in within 14 days after being created by
                                        their direct upline.</p>
                                </li>
                            </ul>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
