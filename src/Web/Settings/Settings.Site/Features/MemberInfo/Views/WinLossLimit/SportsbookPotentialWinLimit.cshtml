@using AlphaPlus.Settings.MemberInfo.Domain.Constants
@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Settings.Site.Features.MemberInfo.ViewModels.WinLossLimit
@using AlphaPlus.Settings.Site.Features.MemberInfo.Helpers
@addTagHelper *, AlphaPlus.Settings.Site
@model SportsbookPotentialWinLimitViewModel
@{
    Layout = "~/Features/MemberInfo/Views/WinLossLimit/_Layout.cshtml";
    ViewBag.Title = "Sportsbook Potential Win Limit";
}
@section Styles {
    @StaticResources.RenderStyles("~/Features/MemberInfo/assets/bundles-v2/win-loss-limit")
}
<form id="potential-win-limit-form" class="form-inline demo-form-inline filter" role="form">
    <div class="form-group status-box">
        <label>@Resources.Status</label>
        <select id="dropdown-status" name="Status">
            @foreach (var option in Model.StatusOptions)
            {
                <option value="@option.Value" selected="@option.Value.Equals(Model.Status)">@option.Text</option>
            }
        </select>
    </div>
    <div class="form-group status-box">
        <label>@Resources.ProblemAccount</label>
        <select id="dropdown-problem-account" name="ProblemAccount">
            @foreach (var option in Model.ProblemAccountOptions)
            {
                <option value="@option.Value" selected="@option.Value.Equals(Model.ProblemAccount.ToString())">@option.Text
                </option>
            }
        </select>
    </div>
    @if (Model.IsOfferedCashService)
    {
        <div class="form-group">
            <label for="dropdown-account-type">@Resources.AccountType</label>
            <select id="dropdown-account-type" name="AccountType">
                <option value="2" @(Model.AccountType == AccountTypeConstant.All ? "selected" : string.Empty)>@Resources.All
                </option>
                <option value="0" @(Model.AccountType == AccountTypeConstant.Credit ? "selected" : string.Empty)>
                    @Resources.Credit</option>
                <option value="1" @(Model.AccountType == AccountTypeConstant.Cash ? "selected" : string.Empty)>
                    @Resources.Cash</option>
            </select>
        </div>
    }
    <div class="form-group">
        <label>@Resources.Username</label>
        <input type="text" id="txt-username" name="Username" placeholder="@Resources.Username" value="@Model.Username"
            maxlength="50" autocomplete="off" />
    </div>
    @Html.Hidden("AccountType", Model.AccountType)
</form>
<div class="potential-win-limit-table">
    <div class="breadcrumb-table">
        <div class="breadcrumb-container">
            <div class="note">
                <span class="star">*</span>@Resources.PotentialWinLimitNote1
            </div>
            <div class="note">
                <span class="star">*</span>@Resources.PotentialWinLimitNote2
            </div>
            @if (Model.IsOfferedCashService && Model.ViewerLevel.IsAgentLevel())
            {
                <div class="note has-icon">
                    <span class="star">*</span>@Html.Raw(Resources.ResetAccumulatedWinAmountNote)
                </div>
                <div id="result-msg" class="msg hide"></div>
            }
        </div>
        <div class="list-icon">
            <ul>
                @if (Model.HasData)
                {
                    <li>
                        <compact-feedback fid="98" like-icon-class="ic-like" />
                    </li>
                }
                <li>
                    <a id="icon-excel" class="ic-excel" data-placement="top" data-original-title="Export to Excel"
                        title="@Resources.ExportToExcel" href="/settings/WinLossLimit/potentialexcel"></a>
                </li>
            </ul>
        </div>
    </div>
    <div class="wrapper-table-scrollable">
        <table id="tbl-report" class="tb tb-bordered w-full tablesorter tb-hover tb-freeze-header"
            data-has-data="@Model.PotentialWinLimitPage.PotentialWinLimitDetail.Any()">
            <thead>
                <tr>
                    <th>
                        <div class="col-no">@Resources.No</div>
                    </th>
                    <th class="col-username">@Resources.Username</th>
                    <th class="col-status">@Resources.Status</th>
                    <th class="col-problem-account">@Resources.ProblemAccount</th>
                    <th>
                        <div class="col-credit">@Resources.Credit</div>
                    </th>
                    <th>
                        <div class="col-auto-daily-reset-limit">@Resources.AutoDailyResetLimit</div>
                    </th>
                    <th>
                        <div class="col-to-win">@Resources.ToWin</div>
                    </th>
                    <th>
                        <div class="col-accumulated-win-loss">@Resources.AccumulatedWinLoss</div>
                    </th>
                    <th>
                        <div class="col-potential-win">@Resources.PotentialWin</div>
                    </th>
                    <th>
                        <div class="col-max-potential-win-limit">@Resources.MaxPotentialWinLimit</div>
                    </th>
                    <th>
                        <div class="col-cur-potential-win-limit">@Resources.CurrentPotentialWin</div>
                    </th>
                    <th class="col-last-login">@Resources.LastLogin</th>
                </tr>
            </thead>
            @if (Model.HasData)
            {
                int index = (Model.PageIndex - 1) * Model.PageSize + 1;
                <tbody>
                    @foreach (var winLossLimitDetail in Model.PotentialWinLimitPage.PotentialWinLimitDetail)
                    {
                        <tr>
                            <td class="text-center">@index</td>
                            <td class="text-left" title="@winLossLimitDetail.Username">
                                <div class="row-icon-inline">
                                    <span class="text">
                                        @winLossLimitDetail.Username
                                    </span>
                                    @(winLossLimitDetail.IsCashMember ? Html.Raw("<span class='ic-cashservice'></span>") :
                                        string.Empty)
                                </div>
                            </td>
                            <td class="text-center">
                                @SportsbookPotentialWinLimitViewModel.GetStatusText(winLossLimitDetail.Status)</td>
                            <td class="text-center">@(winLossLimitDetail.IsProblemAccount ? Resources.Yes : Resources.No2)</td>
                            <td class="text-right">@HtmlHelpers.FormatNumber(winLossLimitDetail.Credit)</td>
                            <td class="text-center">@(winLossLimitDetail.IsAutoReset ? Resources.Yes : Resources.No2)</td>
                            <td class="text-right">@HtmlHelpers.FormatNumber(winLossLimitDetail.AccumToWin)</td>
                            <td class="text-right">
                                <div class="col-reset">
                                    @HtmlHelpers.FormatNumber(winLossLimitDetail.AccumWinLoss)
                                    @if (winLossLimitDetail.IsCashMember
                                   && Model.ViewerLevel.IsAgentLevel()
                                   && !winLossLimitDetail.IsAutoReset
                                   && winLossLimitDetail.AccumWinLoss > 0)
                                    {
                                        <span class="ic-refresh reset-win-amount" data-cust-id="@winLossLimitDetail.CustId"
                                            data-username="@winLossLimitDetail.Username"
                                            title="@Resources.ResetCurrentWinAmount"></span>
                                    }
                                </div>
                            </td>
                            <td class="text-right">
                                @HtmlHelpers.FormatNumber(winLossLimitDetail.PotentialWin)
                            </td>
                            <td class="text-right">@Model.GetMaxWinLimit(winLossLimitDetail.PotentialWinLimit)</td>
                            <td class="text-center @(winLossLimitDetail.PotentialWinPercent >= 100 ? "negative-value" : "")">
                                @Model.GetWinPercent(winLossLimitDetail.PotentialWinPercent,
                                         winLossLimitDetail.PotentialWinLimit)
                            </td>
                            <td class="text-left" title="@Model.GetLastLoginDate(winLossLimitDetail.LastLogged)">
                                @Model.GetLastLoginDate(winLossLimitDetail.LastLogged)
                            </td>
                        </tr>

                        index++;
                    }
                </tbody>
            }
            else
            {
                <tbody>
                    @NoInformation.Render(Model.NumberOfColumns)
                </tbody>
            }

        </table>
    </div>
    @if (Model.ShowPager)
    {
        @Pager.Render(Model.PagerViewModel)
    }
</div>
@Html.Hidden("ResetCurrentWinAmountConfirmMessage", Resources.ResetCurrentWinAmountConfirmMessage)
@Html.Hidden("ResetCurrentWinAmountErrorMessage", AlphaPlus.Shared.AppResources.Main.Resources.InternalServerError)
<input type="hidden" name="__RequestVerificationToken" value="@ViewData["RequestVerificationToken"]" />
@section Scripts {
    @StaticResources.RenderScripts("~/Features/MemberInfo/assets/bundles/win-loss-limit/potential-win-limit")
}