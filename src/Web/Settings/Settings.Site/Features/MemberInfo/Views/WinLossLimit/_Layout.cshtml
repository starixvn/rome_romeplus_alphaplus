@using AlphaPlus.Core.Helpers
@using AlphaPlus.Settings.Site.Features.MemberInfo.ViewModels.WinLossLimit

@{
    Layout = "~/Features/MemberInfo/Views/Shared/_Layout.cshtml";
    var action = ViewContext.RouteData.Values["action"].ToString();
}

@section Styles {
    @RenderSection("Styles", required: false)
}

<div class="win-loss-limit-container">
    <ul class="nav nav-tabs" role="tablist">
        @await Component.InvokeAsync("Tab", new { tabName = action.ToLowerInvariant() })
    </ul>
    <div class="tab-content">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}