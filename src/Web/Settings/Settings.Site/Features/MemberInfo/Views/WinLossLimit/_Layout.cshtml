@using AlphaPlus.Core.Helpers
@using AlphaPlus.Core.Configurations
@using AlphaPlus.Settings.Site.Features.MemberInfo.ViewModels.WinLossLimit
@inject AlphaPlus.Core.Models.IUserSession userSession

@{
    Layout = "~/Features/MemberInfo/Views/Shared/_Layout.cshtml";
    var action = ViewContext.RouteData.Values["action"].ToString();
}

@section Styles {
    @RenderSection("Styles", required: false)
}

<div class="win-loss-limit-container">
    @if (userSession.IsAgent && AppSettings.IsSupportPotentialWinLimit(userSession.Site))
    {
        @await Component.InvokeAsync("Tab", new { tabName = action.ToLowerInvariant() })
        <div class="tab-content">
            @RenderBody()
        </div>
    }
    else
    {
        @RenderBody()
    }
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}