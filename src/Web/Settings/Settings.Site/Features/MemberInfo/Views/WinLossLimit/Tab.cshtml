@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
@using AlphaPlus.Settings.Site.Features.MemberInfo.ViewModels.WinLossLimit
@model TabViewModel
@inject AlphaPlus.Core.Models.IUserSession userSession

<ul class="nav nav-tabs @userSession.SiteName.ToLowerInvariant()" role="tablist">
    <li role="presentation" class="@(Model.SelectedTabName == "index" ? "active" : string.Empty)">
        <a id="tabWinLossLimit" href="/settings/WinLossLimit/index">@Resources.MemberWinLossLimit</a>
    </li>
    <li role="presentation" class="@(Model.SelectedTabName == "sportsbookpotentialwinlimit" ? "active" : string.Empty)">
        <a id="tabSportsbookPotentialWinLimit" href="/settings/WinLossLimit/sportsbookpotentialwinlimit">@Resources.SportsbookPotentialWinLimit</a>
    </li>
    <li class="icon-tab">    
        <a href="@Model.HandbookUrl" target="_blank" class="user-guide-link pull-right">
            <span class="icon icon-book"></span>
        </a>
    </li>
</ul>