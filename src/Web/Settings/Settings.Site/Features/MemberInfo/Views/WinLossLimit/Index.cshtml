@using AlphaPlus.Shared.AppResources.Common
@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Core.Extensions
@using AlphaPlus.Settings.Site.Features.MemberInfo.ViewModels.WinLossLimit
@using AlphaPlus.Settings.Site.Features.MemberInfo.Helpers
@using AlphaPlus.Settings.Site.Features.Shared.Helpers
@using AlphaPlus.Settings.Site.Features.MemberInfo.ViewModels.Components
@using AlphaPlus.Settings.MemberInfo.Domain.Models
@using AlphaPlus.Settings.MemberInfo.Domain.Extensions
@using AlphaPlus.Core.Configurations
@using AlphaPlus.Settings.MemberInfo.Domain.Constants
@inject AlphaPlus.Core.Models.IUserSession userSession
@model WinLossLimitViewModel
@{
    Layout = "~/Features/MemberInfo/Views/WinLossLimit/_Layout.cshtml";
    ViewBag.Title = "Member Win/Loss Limit";
}
@section Styles {
    @StaticResources.RenderStyles("~/Features/MemberInfo/assets/bundles-v2/win-loss-limit")
}

<form id="win-loss-limit-form" class="form-inline demo-form-inline filter">
    <div class="form-group">
        <label>@Resources.Product</label>
        <select id="dropdown-product">
            @foreach (var group in Model.GroupProducts)
            {
                if (group.HasGroupName)
                {
                    <optgroup label="@group.GroupName">
                        @foreach (var product in group.Products)
                        {
                            <option value="@product.ProductName"
                                    data-product-id="@product.ProductId"
                                    data-sport-type="@product.SportType"
                                    data-bet-type="@product.BetType"
                                    @(Model.UserSelectedId.Equals($"{product.ProductId}-{product.SportType}") ? " selected=\"selected\"" : string.Empty)
                                    data-isnested="1">
                                @product.ProductName
                            </option>
                        }
                    </optgroup>
                }
                else
                {
                    foreach (var product in group.Products)
                    {
                        <option value="@product.ProductName"
                                data-product-id="@product.ProductId"
                                data-sport-type="@product.SportType"
                                data-bet-type="@product.BetType"
                                @(Model.UserSelectedId.Equals($"{product.ProductId}-{product.SportType}") ? " selected=\"selected\"" : string.Empty)>
                            @product.ProductName
                        </option>
                    }
                }
            }
        </select>
    </div>
    @if (Model.ViewerLevel.IsSuperLevel())
    {
        <div class="form-group">
            <label for="dropdown-master">@Resources.SelectDirectDownline</label>
            <select id="dropdown-master">
                @if (Model.MasterList.Any())
                {
                    foreach (var master in Model.MasterList)
                    {
                        <option value="@master.CustId" @(Model.MasterId == master.CustId ? " selected=selected" : string.Empty)>@(master.CustId == 0 ? CommonResx.DirectMember : master.CustName)</option>
                    }
                }
                else
                {
                    <option value="0">@Resources.NoDataFound</option>
                }
            </select>
        </div>
    }
    @if (Model.ViewerLevel.IsMasterOrSuperLevel())
    {
        <div class="form-group">
            <label for="dropdown-agent">@(Model.ViewerLevel.IsSuperLevel() ? Resources.SelectAgent : Resources.SelectDirectDownline)</label>
            <select id="dropdown-agent" @(Model.ViewerLevel.IsSuperLevel() && Model.MasterId == 0 ? "disabled=disabled" : string.Empty)>
                @if (Model.AgentList.Any())
                {
                    if (Model.ViewerLevel.IsSuperLevel())
                    {
                        <option value="0">@Resources.AllAgent</option>
                    }

                    foreach (var agent in Model.AgentList)
                    {
                        <option value="@agent.CustId" @(Model.RecommendId == agent.CustId ? " selected=selected" : string.Empty)>@agent.CustName</option>
                    }
                }
                else
                {
                    <option value="0">@Resources.NoDataFound</option>
                }
            </select>
        </div>
    }
    @if (Model.IsOfferedCashService)
    {
        <div class="form-group">
            <label for="dropdown-account-type">@Resources.AccountType</label>
            <select id="dropdown-account-type" name="AccountType" @(Model.ViewerLevel.IsSuperLevel() && Model.MasterId == 0 ? "disabled=disabled" : string.Empty)>
                <option value="2" @(Model.AccountType == AccountTypeConstant.All ? "selected" : string.Empty)>@Resources.All</option>
                <option value="0" @(Model.AccountType == AccountTypeConstant.Credit ? "selected" : string.Empty)>@Resources.Credit</option>
                <option value="1" @(Model.AccountType == AccountTypeConstant.Cash ? "selected" : string.Empty)>@Resources.Cash</option>
             </select>
        </div>
    }
    <div class="form-group">
        <label for="txt-username">@Resources.Username</label>
        <input type="text" id="txt-username" name="Username" placeholder="@Resources.Username" value="@Model.Username" maxlength="50" autocomplete="off" />
    </div>
    @if (Model.IsBBin)
    {
        <p><span class="star">@Html.Raw(Resources.BBINNote)</span></p>
    }
    @if (Model.IsSabaclub)
    {
        <div class="form-group">
            <label for="txt-player-id">@Resources.PlayerId</label>
            <input type="text" id="txt-player-id" name="PlayerId" value="@Model.PlayerId" />
        </div>
    }
    @Html.Hidden("UserSelectedProductId", Model.UserSelectedId)
    @Html.Hidden("SportType", Model.SportType)
    @Html.Hidden("BetType", Model.BetType)
    @Html.Hidden("MasterId", Model.MasterId)
    @Html.Hidden("RecommendId", Model.RecommendId)
    @Html.Hidden("AccountType", Model.AccountType)
    @Html.Hidden("ResetCurrentWinAmountConfirmMessage", Resources.ResetCurrentWinAmountConfirmMessage)
    @Html.Hidden("ResetCurrentWinAmountErrorMessage", AlphaPlus.Shared.AppResources.Main.Resources.InternalServerError)
</form> 

@if(Model.ViewerLevel.IsAgentLevel()) {
    <div class="note">
        <span class="star">*</span>@Html.Raw(Resources.ResetCurrentWinAmountNote)
    </div>
}
<div class="wrapper-table-scrollable">
    <table id="tbl-report" class="tb tb-bordered w-full tablesorter tb-hover tb-freeze-header" data-has-data="@Model.WinLossLimitPage.WinLossLimitDetail.Any()">
        <thead>
            <tr>
                <th><div class="col-no">@Resources.No</div></th>
                <th class="col-status">@Resources.Status</th>
                <th class="col-username">@Resources.Username</th>
                <th class="col-first-name">@Resources.FirstName</th>
                <th class="col-last-name">@Resources.LastName</th>
                @if (Model.IsSabaclub)
                {
                    <th><div class="col-player-id">@Resources.PlayerId</div></th>
                }
                <th><div class="col-credit">@Resources.Credit</div></th>
                <th><div class="col-balance">@Resources.Balance</div></th>
                <th class="col-auto-daily-reset">@Resources.AutoDailyResetLimit</th>
                <th class="col-current-win-loss">@Resources.CurrentWinLossAmount</th>
                @if (Model.IsBBin)
                {
                    <th><div class="col-current-win-loss">@Resources.RemainingTransferInAmount</div></th>
                }
                <th class="col-max-win">@Resources.MaximumWin</th>
                <th class="col-win-percent">@Resources.CurrentWinLimit</th>
                <th class="col-max-loss">@Resources.MaximumLoss</th>
                <th><div class="col-loss-percent">@Resources.CurrentLossLimit</div></th>
            </tr>
        </thead>
        @if (Model.HasData)
        {
            int index = (Model.PageIndex - 1) * Model.PageSize + 1;
            <tbody>
                @foreach (var winLossLimitDetail in Model.WinLossLimitPage.WinLossLimitDetail)
                {
                    <tr class="@BackgroundColorHelper.GetClassNameByAccountStatus(winLossLimitDetail.Enabled, winLossLimitDetail.Closed, winLossLimitDetail.ClosedReason, winLossLimitDetail.Suspended, winLossLimitDetail.Locked, index)">
                        <td class="text-center">@index</td>
                        <td class="text-left">@WinLossLimitViewModel.GetStatusText(winLossLimitDetail.Status)</td>
                        <td class="text-left" title="@winLossLimitDetail.Username">
                            <div class="row-icon-inline">
                                <span class="text">
                                    @winLossLimitDetail.Username
                                </span>                                
                                @(winLossLimitDetail.IsCashMember ? Html.Raw("<span class='ic-cashservice'></span>"): string.Empty)
                          
                            </div>
                        </td>
                        <td class="text-left" title="@winLossLimitDetail.Firstname">
                            <div class="col-first-name">
                                @winLossLimitDetail.Firstname
                            </div>
                        </td>
                        <td class="text-left" title="@winLossLimitDetail.Lastname">
                            <div class="col-last-name">
                                @winLossLimitDetail.Lastname
                            </div>
                        </td>
                        @if (Model.IsSabaclub)
                        {
                            <td class="text-left">@WinLossLimitViewModel.GetPlayerIdText(winLossLimitDetail.PlayerId)</td>
                        }
                        <td class="text-right">@HtmlHelpers.FormatNumber(winLossLimitDetail.Credit)</td>
                        <td class="text-right">@HtmlHelpers.FormatNumber(winLossLimitDetail.Balance)</td>
                        <td class="text-center">@(winLossLimitDetail.IsAutoReset ? Resources.Yes : Resources.No2)</td>
                        <td class="text-center">
                            <div class="col-reset">
                                @WinLossLimitViewModel.GetCurrentWinAnmout(winLossLimitDetail.CurrentWinAnmout)
                                @if (winLossLimitDetail.IsCashMember 
                                    && Model.ViewerLevel.IsAgentLevel()
                                    && !winLossLimitDetail.IsAutoReset 
                                    && winLossLimitDetail.CurrentWinAnmout > 0 
                                    && winLossLimitDetail.MaxWinLimit > 0)   
                                {
                                    <span class="ic-refresh reset-win-amount" 
                                        data-cust-id="@winLossLimitDetail.CustId" 
                                        data-username="@winLossLimitDetail.Username"
                                        title="@Resources.ResetCurrentWinAmount"></span>
                                }
                            </div>
                        </td>
                        @if (Model.IsBBin)
                        {
                            <td class="text-center">@WinLossLimitViewModel.GetRemainingTransferInAmount(winLossLimitDetail.ReaminingTransferInAmount, winLossLimitDetail.MaxLossLimit)</td>
                        }
                        <td class="text-center">
                            @(winLossLimitDetail.IsCashMember ? Model.GetMaxWinLimitCashMember(winLossLimitDetail.MaxWinLimit) : Model.GetMaxWinLimit(winLossLimitDetail.MaxWinLimit))
                        </td>
                        <td class="text-center @((winLossLimitDetail.Credit == 0 && winLossLimitDetail.CurrentWinAnmout > 0 || winLossLimitDetail.WinPercent >= 100 || winLossLimitDetail.WinPercent == -2) && !Model.IsBBin ? "negative-value" : "")">
                            @(winLossLimitDetail.IsCashMember ? Model.GetWinPercentCashMember(winLossLimitDetail.WinPercentCashMember, winLossLimitDetail.MaxWinLimit) : Model.GetWinPercent(winLossLimitDetail.WinPercent, winLossLimitDetail.CurrentWinAnmout, winLossLimitDetail.Credit, winLossLimitDetail.MaxWinLimit))
                        </td>

                        <td class="text-center">
                            @(winLossLimitDetail.IsCashMember ? "N/A" : WinLossLimitViewModel.GetMaxLossLimit(winLossLimitDetail.MaxLossLimit))
                        </td>
                        <td class="text-center @(!winLossLimitDetail.IsCashMember && winLossLimitDetail.LossPercent >= 100 ? "negative-value" : "")">
                            @(winLossLimitDetail.IsCashMember ? "N/A" : WinLossLimitViewModel.GetLossPercent(winLossLimitDetail.MaxLossLimit, winLossLimitDetail.LossPercent))
                        </td>
                    </tr>
                    index++;
                }
            </tbody>
        }
        else
        {
            <tbody>
                @NoInformation.Render(Model.NumberOfColumns)
            </tbody>
        }
        
    </table>
</div>

<input type="hidden" name="__RequestVerificationToken" value="@ViewData["RequestVerificationToken"]" />
@if (Model.ShowPager)
{
    @Pager.Render(Model.PagerViewModel)
}
@section Scripts {
    @StaticResources.RenderScripts("~/Features/MemberInfo/assets/bundles/win-loss-limit/win-loss-limit")
} 