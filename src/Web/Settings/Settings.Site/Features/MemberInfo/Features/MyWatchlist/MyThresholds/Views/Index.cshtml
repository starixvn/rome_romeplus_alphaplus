@using Newtonsoft.Json
@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Settings.Site.Features.MemberInfo.Features.MyWatchlist.MyThresholds.ViewModels
@using AlphaPlus.Settings.Site.Features.MemberInfo.Helpers
@addTagHelper *, AlphaPlus.Settings.Site
@model MyThresholdIndexPageViewModel

@{
    Layout = "~/Features/MemberInfo/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.MyThresholds;
}

@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode(
        $"/bundles/site-memberinfo/tab-{Model.CustLevel.DisplayName.ToLowerInvariant()}",
        "/bundles/site-memberinfo/daterangepicker",
        "/bundles/site-asset/data-table")
    @StaticResources.RenderStylesWithDarkMode("~/Features/MemberInfo/Features/MyWatchlist/Shared/bundles/my-watchlist")
    @StaticResources.RenderStylesWithMedia(767, "~/Features/MemberInfo/Features/MyWatchlist/Shared/bundles/my-watchlist-media")
}

@section Scripts {
    <script type="text/javascript">
        var myThresholdData = @Html.Raw(JsonConvert.SerializeObject(Model.MyThresholdHistory, Formatting.None));
    </script>
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-asset/data-table")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-memberinfo/daterangepicker")
    @StaticResources.RenderScripts("~/Features/MemberInfo/Features/MyWatchlist/MyThresholds/bundles/my-thresholds")
}

<div class="my-thresholds">
    @if (Model.CustLevel.IsAgentLevel())
    {
        <ul class="nav nav-tabs" role="tablist">
            <li role="presentation">
                <a class="open-link" data-url="@MicroSites.SettingUrl("~/ReachedThreshold/Index")">@Resources.ReachedThreshold</a>
            </li>
            <li role="presentation">
                <a class="open-link" data-url="@MicroSites.SettingUrl("~/MyWatchListAccounts/Index")">@Resources.MyWatchlist</a>
            </li>
            <li role="presentation" class="active">
                <a href="javascript:;" aria-controls="home" role="tab" data-toggle="tab">@Resources.MyThresholds</a>
            </li>
            @await Html.PartialAsync("~/Features/MemberInfo/Features/MyWatchlist/Shared/Views/InfoUserGuideTabs.cshtml", Model.UserGuideLink)
        </ul>
    }
    else
    {
        <div class="page-title">
            @Resources.MyThresholds
            <span id="icon-information" class="icon icon-information-outline"></span>
            <a href="@Model.UserGuideLink" target="_blank"><span class="icon icon-book"></span></a>
        </div>
    }

    @using (Html.BeginForm("GetHistory", "MyThresholds", FormMethod.Post, new { @class = "form-inline filter form-report", id = "report-form" }))
    {
        await Html.RenderPartialAsync("~/Features/MemberInfo/App_Code/Components/DateRangePicker.cshtml", Model.DateRangePickerViewModel);
        <div class="form-group">
            <input type="submit" value="@Resources.Submit" id="btn-submit" class="btn-submit" />
        </div>
        if (Model.CanUpdateAccount)
        {
            <div class="form-group">
                <input type="button" value="@Resources.MyThresholds" id="btn-my-thresholds" class="btn-reset" />
            </div>
        }
        <div class="form-group hide">
            <compact-feedback fid="101" />
        </div>
    }

    <p class="note">
        <span class="star"></span>@Resources.MyWinningThreshold:
        <span class="red">
            @if (Model.MyThreshold != null)
            {
                @Html.Raw(HtmlHelpers.FormatThreshold(Model.MyThreshold.WinningThreshold))
            }
            else
            {
                @Resources.Unlimited
            }
        </span>; @Resources.MyLosingThreshold:
        <span class="red">
            @if (Model.MyThreshold != null)
            {
                @Html.Raw(HtmlHelpers.FormatThreshold(Model.MyThreshold.LosingThreshold))
            }
            else
            {
                @Resources.Unlimited
            }
        </span>
    </p>

    <div class="table-container">
        <table id="tblRpt" class="hidden tblRpt tblRpt-bordered tblRpt-hover display nowrap" style="width: 100%">
            <thead>
                <tr>
                    @if (!Model.IsMobile)
                    {
                        <th></th>
                    }
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
                <tr>
                    @if (!Model.IsMobile)
                    {
                        <th class="header">@Resources.No</th>
                    }
                    <th class="header" data-priority="1">@Resources.DateTime</th>
                    <th class="header">@Resources.WinningLosingAmount</th>
                    <th class="header">@Resources.WinningThreshold</th>
                    <th class="header">@Resources.LosingThreshold</th>
                    <th class="header"></th>
                </tr>
            </thead>
        </table>
    </div>
</div>
@{
    await Html.RenderPartialAsync("~/Features/MemberInfo/Features/MyWatchlist/Shared/Views/InformationLegend.cshtml");
    @Html.Hidden("my-thresholds-url", MicroSites.SettingUrl("~/MyThresholds"));
    @Html.Hidden("is-mobile", Model.IsMobile ? 1 : 0);
    @Html.Hidden("no-info", Resources.NoInformationIsAvailable);
}