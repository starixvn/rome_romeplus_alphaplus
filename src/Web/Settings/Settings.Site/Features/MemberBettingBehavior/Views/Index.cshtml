                </div>
            </div>
        </div>

        <div id="statistic-chart-id">
            <div class="chart space-between">
                <div class="summary-statistic " id="summary-statistic" hidden>
                    <div class="item">
                        <div id="summary-turnover" class="number"></div>
                        <div class="text">@Resources.Turnover</div>
                    </div>
                    <div class="item">
                        <div id="summary-winloss" class="number"></div>
                        <div class="text">@Resources.WinLoss</div>
                    </div>
                    <div class="item">
                        <div id="summary-margin" class="number"></div>
                        <div class="text">@Resources.ProfitMargin</div>
                    </div>
                </div>
                <div class="turnover-by-sport-chart" id="turnover-by-sport-chart-id">
                    <canvas id="canvas-turnover-by-sport-chart" aria-label="@Resources.TurnoverBySport" role="img">
                        <p>@Resources.NoInformationIsAvailable</p>
                    </canvas>
                </div>
                <div class="turnover-by-bettype-chart" id="turnover-by-bettype-chart-id">
                    <canvas id="canvas-turnover-by-bettype-chart" aria-label="@Resources.TurnoverByBetType"
                        data-live="@Resources.Live" data-nonlive="@Resources.NonLive" data-mix="@Resources.Mix"
                        data-language="@Model.Language" role="img">
                        <p>@Resources.NoInformationIsAvailable</p>
                    </canvas>
                </div>
            </div>
            <div class="chart">
                <div class="turnover-winloss-by-date-chart" id="turnover-winloss-by-date-chart-id">
                    <canvas id="canvas-turnover-winloss-by-date-chart" aria-label="@Resources.TurnoverAndWinLossByDate"
                        data-turnover="@Resources.Turnover" data-winloss="@Resources.WinLoss" role="img">
                        <p>@Resources.NoInformationIsAvailable</p>
                    </canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="member-info-url" value="@MicroSites.SettingUrl()" />
<input type="hidden" id="mustEnterUserNameText" value="@Resources.MustEnterUsernameError" />
<input type="hidden" id="memberUserNameIsInvalidText" value="@Resources.MemberUsernameIsInvalid" />
<input type="hidden" id="yesText" value="@Resources.Yes" />
<input type="hidden" id="noText" value="@Resources.No2" />
<input type="hidden" id="isDarkMode" value='@(Model.IsDarkMode ? "true" : "false")' />
<input type="hidden" id="dateRangeNoteText30"
    value="@string.Format(Resources.DateRangeNote, string.Format("{0:#,0.##}", Model.EndDate.AddDays(-30).ToString("MM/dd/yyyy")), string.Format("{0:#,0.##}", Model.EndDate.ToString("MM/dd/yyyy")))" />
<input type="hidden" id="dateRangeNoteText60"
    value="@string.Format(Resources.DateRangeNote, string.Format("{0:#,0.##}", Model.EndDate.AddDays(-60).ToString("MM/dd/yyyy")), string.Format("{0:#,0.##}", Model.EndDate.ToString("MM/dd/yyyy")))" />
<input type="hidden" id="dateRangeNoteText90"
    value="@string.Format(Resources.DateRangeNote, string.Format("{0:#,0.##}", Model.EndDate.AddDays(-90).ToString("MM/dd/yyyy")), string.Format("{0:#,0.##}", Model.EndDate.ToString("MM/dd/yyyy")))" />
