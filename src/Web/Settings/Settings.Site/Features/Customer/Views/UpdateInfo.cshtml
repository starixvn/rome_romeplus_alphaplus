@using AlphaPlus.Shared.AppResources.Common
@using AlphaPlus.Core.Helpers
@model AlphaPlus.Settings.Site.Features.Customer.ViewModels.UpdateInfoViewModel
@* @{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
    ViewBag.Title = $"{Resources.Info} {Model.CustomerInfo.UserName}";
    var queryString = AlphaContext.Current.Request.Query;
}
@section Scripts {
    <script src="~/bundles/customer/update-customer-info.js" asp-append-version="true"></script>
}
<div class="page-title hide">
    <span class="text-title pull-left">@ViewBag.Title</span>
</div>
<div class="wrapper-transfer-condition">
    <div class="msg hide" id="msg-alert"></div>
    <form method="post" asp-action="UpdateInfoPost" id="form-update">
        <input type="hidden" name="CustId" value="@queryString["custid"]" />
        <div class="update-info">
            <table class="tb">
                <thead>
                    <tr>
                        <th colspan="4">@Resources.CustomerInformation</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><label asp-for="CustomerInfo.FirstName">@Resources.FirstName</label></td>
                        <td><input type="text" asp-for="CustomerInfo.FirstName" maxlength="32" autocomplete="off" /></td>
                        <td><label asp-for="CustomerInfo.LastName">@Resources.LastName</label></td>
                        <td><input type="text" asp-for="CustomerInfo.LastName" maxlength="32" autocomplete="off" /></td>
                    </tr>
                    <tr>
                        <td><label asp-for="CustomerInfo.Phone">@CommonResx.Phone</label></td>
                        <td><input type="text" asp-for="CustomerInfo.Phone" maxlength="32" autocomplete="off" /></td>
                        <td><label asp-for="CustomerInfo.MobilePhone">@Resources.MobilePhone</label></td>
                        <td><input type="text" asp-for="CustomerInfo.MobilePhone" maxlength="32" autocomplete="off" /></td>
                    </tr>
                    <tr>
                        <td><label asp-for="CustomerInfo.Email">@Resources.Email</label></td>
                        <td><input type="text" asp-for="CustomerInfo.Email" maxlength="32" autocomplete="off" /></td>
                        <td><label asp-for="CustomerInfo.Fax">@CommonResx.Fax</label></td>
                        <td><input type="text" asp-for="CustomerInfo.Fax" maxlength="32" autocomplete="off" /></td>
                    </tr>
                </tbody>
            </table>

            <div class="form-btn">
                <label></label>
                <button class="btn-submit" type="submit">@Resources.Update</button>
                <button class="btn-reset" type="button">@Resources.Reset</button>
            </div>
        </div>
    </form>
</div>
<input type="hidden" id="hidden-EmailNotValidText" value="@Resources.EmailNotValid" />
<input type="hidden" id="hidden-UpdatedSuccessfullyText" value="@Resources.UpdatedSuccessfully" />
<input type="hidden" name="NotAuthorizedMessage" value="@CommonResx.NotAuthorized" /> *@

<!DOCTYPE html>
<html>

<head>
    <title>UpdateInfoCashMember Page</title>
    <environment names="Production">
        <link rel="stylesheet" href="@(Model.CdnUri)cash-member/edit-info/index.css?version=@(Model.AssetsVersion)" />
        <script type="module" src="@(Model.CdnUri)cash-member/edit-info/index.js?version=@(Model.AssetsVersion)"></script>
    </environment>
</head>

<div id="root"></div>

<body>
    <script type="text/javascript">
        const updateInfoCustomerPageConfig = @Html.Raw(Json.Serialize(
            new {
                custId = Model.CustId,
                username = Model.Username,
                isCashMember = Model.IsCashMember,
                applicationPath = Model.ApplicationPath,
                settingSiteUrl = MicroSites.SettingUrl(),
                cashServiceUrl = MicroSites.CashServiceUrl(),
                cdnUri = Model.CdnUri,
                systemId = Model.SystemId,
            }
        ));
    </script>

    <environment include="Development">
        <script type="module">
            import RefreshRuntime from 'http://localhost:4212/@@react-refresh'
            RefreshRuntime.injectIntoGlobalHook(window)
            window.$RefreshReg$ = () => { }
            window.$RefreshSig$ = () => (type) => type
            window.__vite_plugin_react_preamble_installed__ = true
        </script>
        <script type="module" src=@("http://localhost:4212/@vite/client")></script>
        <script type="module" src="http://localhost:4212/src/main.tsx"></script>
        <link rel="stylesheet" href="http://localhost:4212/src/styles.scss" />
    </environment>

    @Html.AntiForgeryToken()
</body>

</html>