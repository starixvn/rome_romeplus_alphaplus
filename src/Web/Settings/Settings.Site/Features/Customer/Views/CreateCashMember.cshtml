@using AlphaPlus.Settings.Site.Features.Customer.ViewModels;
@inject AlphaPlus.Core.Models.IUserSession userSession
@model CreateCustomerViewModel
@{
    Layout = "~/Features/Shared/Views/_Layout.cshtml";
}

@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode($"/bundles/common/common-{Model.ActorLevel.DisplayName}")
    <environment names="Production">
        <link rel="stylesheet" href="@(Model.CdnUri)cash-member/create/index.css?version=@(Model.AssetsVersion)" />
    </environment>
    <environment names="Development">
        <link rel="stylesheet" href="http://localhost:4211/src/styles.scss" />
    </environment>
}

<div class="page-title">
    <span class="pull-left">@AlphaPlus.Shared.AppResources.Settings.MemberInfo.Resources.CreateCashMember</span>
</div>
<div class="page-container">
    @if (Model.IsLimitNewDownline)
    {
        <div class="msg msg-error">
            <span className="col-xs-12">@Model.Message</span>
        </div>
    }
    else
    {
        @Html.AntiForgeryToken()
        <input type="hidden" id="SecretKey" value="@Model.SecretKey" />
        <div id="root"></div>
        @section Scripts {
        <script type="text/javascript">
            const appConfig = @Html.Raw(Model.AppConfig);
            const params = @Html.Raw(Model.Params);
            const cdnUri = "@Html.Raw(Model.CdnUri)";
            const nickName = "@Html.Raw(userSession.NickName)";
            setTimeout(function () {
                window.top.indexManager && window.top.indexManager.initFeedbackFunction(41);
            }, 1000);
        </script>
        <environment names="Production">
            <script type="module" src="@(Model.CdnUri)cash-member/create/index.js?version=@(Model.AssetsVersion)"></script>
        </environment>
        <environment names="Development">
            <script type="module">
                import RefreshRuntime from "http://localhost:4211/@@react-refresh";
                RefreshRuntime.injectIntoGlobalHook(window);
                window.$RefreshReg$ = () => { };
                window.$RefreshSig$ = () => (type) => type;
                window.__vite_plugin_react_preamble_installed__ = true;
            </script>
            <script type="module" src=@("http://localhost:4211/@vite/client")></script>

            <script type="module" src="http://localhost:4211/src/main.tsx"></script>
        </environment>
        }
    }
</div>