@using AlphaPlus.Shared.AppResources.Settings.CustomerList
@using AlphaPlus.Shared.AppResources.Settings.MemberInfo
@using AlphaPlus.Settings.Site.Features.CustomerList.ViewModels
@using AlphaPlus.Core.Helpers

@model MultipleDoubleCommViewModel

@{
    Layout = "~/Features/MemberInfo/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Multiple Double Comm";
}

@section Styles {
}

<div class="multi-double-comm">
    <div id="message" class="hidden">
        <span id="message-content" class="message-content col-xs-12"></span>
    </div>
    <div>
        <input type="radio" checked="checked" name="mulitpleDoubleComm" value="true" id="dcomAllow">
        <label for="dcomAllow">@CustomerListResources.AllowDoubleCommission</label>
    </div>
    <div>
        <input type="radio" name="mulitpleDoubleComm" value="false" id="dcomDisallow">
        <label for="dcomDisallow">@CustomerListResources.DisallowDoubleCommission</label>
    </div>
    <div class="form-group btn-box">
        <input type="submit" value="@Resources.Submit" class="btn-submit" />
    </div>
    <input type="hidden" id="searchAccountIds" value="@Model.SearchAccountIds">
    <input type="hidden" id="searchAccountRoleId" value="@Model.SearchAccountRoleId">
    <input type="hidden" id="usernames" value="@Model.Usernames">
    <input type="hidden" id="agentId" value="@Model.AgentId">
    <input type="hidden" id="successullyMessage" value="@CustomerListResources.UpdateDoubleCommSuccessfully">
    @Html.AntiForgeryToken()
</div>

@section Scripts {
    @StaticResources.RenderScripts("~/bundles/Features/CustomerList/muliple-double-comm")
}
