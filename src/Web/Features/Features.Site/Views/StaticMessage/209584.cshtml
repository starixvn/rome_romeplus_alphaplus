@using AlphaPlus.Features.Messages.API.Services
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Shared.AppResources.Features.Messages
@{
    Layout = null;
}
<html>
<head>
    <title>Volleyball Announcement</title>
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-reports/default")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/extendMessage")
</head>
<body>
    <div class="baio-title-effect-date-format">@Lang.NewBetTypeOfBaseball</div>
    <table class="tblRpt tblRpt-bordered alternative-row-table width-100per tablesorter tblRpt-hover" id="tbl-report" style="padding: 0px;">
        <thead class="tableFloatingHeaderOriginal">
            <tr>
                <th>@Lang.NewBetType</th>
                <th>@Lang.BetSettingFollows</th>
                <th>@Lang.CommissionSettingFollows</th>
                <th>@Lang.PositionTakingSettingFollows</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("8828")</td>
                <td class="center" rowspan="8">@AlphaRemotingRefService.GetSportTypeName(8)</td>
                <td class="center">@Lang.LabelAsianHDC_OU_OE</td>
                <td class="center">@Lang.TwoWayMarket</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("8829")</td>
                <td class="center">@Lang.LabelAsianHDC_OU_OE</td>
                <td class="center">@Lang.TwoWayMarket</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("8830")</td>
                <td class="center">@Lang.LabelAsianHDC_OU_OE</td>
                <td class="center">@Lang.TwoWayMarket</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("8831")</td>
                <td class="center">@Lang.LabelOtherTypes</td>
                <td class="center">@Lang.LabelOthers</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("8832")</td>
                <td class="center">@Lang.LabelAsianHDC_OU_OE</td>
                <td class="center">@Lang.TwoWayMarket</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("8833")</td>
                <td class="center">@Lang.Label1x2</td>
                <td class="center">@Lang.ThreeWayMarket</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("8834")</td>
                <td class="center">@Lang.LabelOtherTypes</td>
                <td class="center">@Lang.LabelOthers</td>
            </tr>
            <tr>
                <td class="baio-bettypes-content-bg">@AlphaRemotingRefService.GetBetTypeName("8835")</td>
                <td class="center">@Lang.LabelOtherTypes</td>
                <td class="center">@Lang.LabelOthers</td>
            </tr>            
        </tbody>
    </table>
</body>
</html>