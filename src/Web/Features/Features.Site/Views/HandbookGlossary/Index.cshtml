@using AlphaPlus.Features.Site.Handbook.ViewModels
@using AlphaPlus.Features.Handbook.API.Models
@using AlphaPlus.Core.Helpers
@using AlphaPlus.Shared.AppResources.Features.Handbook
@model GlossaryViewModel
@{
    Layout = null;
    char[] alpha = "#ABCDEFGHIJKLMNOPQRSTUVWXYZ".ToCharArray();
    var glossaries = Model.Glossaries ?? new List<GlossaryModel>();
    var groups = Model.Groups;
    var isGetAll = string.IsNullOrWhiteSpace(Model.Group);
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Resources.AngencyHandbook</title>
    @StaticResources.RenderStyles("~/assets/bundles/handbook/common")
</head>
<body>
    <div class="container">
        <div class="left-container"></div> <!-- keep this this to prevent break layout -->
        <div class="center-container">
            <div class="sticky-glossary">
                <h2 class="title-page">@Resources.Glossary</h2>
                <div class="list-glossary">
                    @foreach (var a in alpha)
                    {
                        var s = a.ToString();
                        if (groups.ContainsKey(s))
                        {
                            <a data-val="@a"
                               @(string.Equals(Model.Group, s) ? "class=active" : "")
                               href="#ref-group-@a">@a</a>
                        }
                    }
                </div>
            </div>

            @if (isGetAll && !glossaries.Any())
            {
                <p>@Resources.NoRecords</p>
            }
            else
            {
                <div class="list-group-glossary">
                    @foreach (var a in alpha)
                    {
                        var s = a.ToString();

                        if (!isGetAll && !string.Equals(Model.Group, s, StringComparison.OrdinalIgnoreCase))
                        {
                            continue;
                        }

                        var hasData = groups.ContainsKey(s);
                        if (!hasData && !isGetAll)
                        {
                            <div class="characters">@(s).</div>
                        }

                        if (hasData)
                        {
                            var gs = groups[s];

                            <div class="characters">@(s).<span id="ref-group-@a" class="anchor-glossary"></span></div>
                            foreach (var g in gs)
                            {
                                <div class="group-glossary">
                                    <div class="group-glossary-title">
                                        @g.Name
                                    </div>
                                    <div>
                                        @Html.Raw(g.Content)
                                    </div>
                                </div>
                            }
                        }
                        else if (!isGetAll)
                        {
                            <p>@Resources.NoRecords</p>
                        }
                    }
                </div>
            }

        </div>
        <div class="right-container"></div>
    </div>
    <a class="icon-back-to-top" href="#" id="back-to-top"></a>

    @Html.Hidden("RootPath", "../")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")

</body>
</html>