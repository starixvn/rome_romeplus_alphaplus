@model AlphaPlus.Main.Site.Features.TelegramChatBot.ChatBotSettingViewModel
@{
    Layout = "~/Views/TelegramChatBot/Shared/_Layout.cshtml";
}
@section Styles {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-main/chatbot/chatbot-default")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode($"/bundles/site-main/tab-{Model.CustLevel.ToLowerInvariant()}")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/telegramchatbot/chatbot-setting")
        <style>
            .chatbot-linked-telegram .chatbot-notification-setting .tbl-notifications tbody tr:last-child td:last-child:after {
                background: url("/main/assets/images/TelegramChatbot/tryitnow_en-US.png");
            }
        </style>
}
<div id="container">
    <div class="overlay" id="overlay"></div>
    <div class="page-title">@ChatBot.Telegram</div>
    <div class="tab-content ">
        <div class="panel panel-account">
            <div class="panel-heading" role="tab" id="headingAccount">
                <h4 class="panel-title">
                    <a role="button" data-toggle="collapse" href="#account" aria-expanded="false"
                        aria-controls="account">
                        @ChatBot.Account
                    </a>
                </h4>
            </div>
            <div id="account" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingAccount">
                <div class="panel-body account-info">
                    <div id="account-message" class="container-msg"></div>
                    <form class="filter">
                        <div class="form-group">
                            <label>@ChatBot.ChatID: <span class="chatbot-name"
                                    id="telegram-id">@Model.ChatId</span></label>
                            <span id="copy-icon" class="icon-content-copy" data-clipboard-action="copy"
                                data-clipboard-target="#telegram-id" title="@Security.Copied"></span>
                            <button class="btn-remove" id="btnUnsubscribe">@ChatBot.unLink</button>
                        </div>
                        <div class="form-group only-text">
                            <label>@ChatBot.ChatbotName: <span class="chatbot-name">@Model.ChatBotName</span></label>
                        </div>
                        <div class="form-group">
                            <label>@ChatBot.ChatBotLanguage:</label>
                            <div class="dropdown language">
                                @await Html.PartialAsync("Language", Model.LanguageViewModel)
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        @await Html.PartialAsync("Reports", Model)
        @await Html.PartialAsync("NotificationsAndSettings", Model)
    </div>
</div>
@Html.Hidden("UnsubscribeWarning", ChatBot.UnsubscribeTelegramBotWarning)
@Html.Hidden("UpdateLanguageFailed", ChatBot.updateLanguageFailed)
@Html.Hidden("HasUnlinkedMessage", string.Format(ChatBot.HasUnlinkedMessage, Model.ChatBotName))
@Html.Hidden("UserId", Model.UserId)
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/telegramchatbot/telegram-chatbot-setting")
}