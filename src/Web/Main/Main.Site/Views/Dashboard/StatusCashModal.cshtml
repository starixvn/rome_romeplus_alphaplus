@* PartialView: EnableCashModal *@
@using AlphaPlus.Shared.AppResources.Common
@using AlphaPlus.Shared.AppResources.CashServices
@using AlphaPlus.Main.Site.Features.Dashboard.CashService
@model CashServiceInfoViewModel
<div id="enableCashServiceModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body cash-modal-body">
                <div class="cash-modal-icon">
                    <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="28" cy="28" r="28" fill="#F5F8FA" />
                        <path d="M18 29.5L25 36.5L38 21.5" stroke="#1A3365" stroke-width="3" stroke-linecap="round"
                            stroke-linejoin="round" />
                    </svg>
                </div>
                <div class="cash-modal-title">@CashServicesResx.SuperchargeYourCashFlow</div>
                <div class="cash-modal-line"></div>
                <div class="cash-modal-highlight-block">
                    <span class="cash-modal-free-badge">@Html.Raw(CashServicesResx.FreeTrial)</span>
                    <span class="cash-modal-save-amount">@Html.Raw(CashServicesResx.StartTodayAndEnjoy)</span>
                </div>
                <ul class="cash-modal-benefits">
                    <li>@Html.Raw(CashServicesResx.NoPlatformFee)</li>
                    <li>@Html.Raw(CashServicesResx.TransactionFee)</li>
                    <li>@CashServicesResx.CancelAnytime</li>
                </ul>
                <div class="cash-modal-note">
                    <span class="icon-info">ℹ️</span> @CashServicesResx.CashFlowToTheNextLevel
                </div>
            </div>
            <div class="cash-modal-footer">
                <button type="button" class="btn custom-cancel" data-dismiss="modal">@CommonResx.Cancel</button>
                <button type="button" class="btn custom-confirm" disabled="@(!Model.IsCanUpdateCashServiceStatus)"
                    id="confirmEnableCashService">@CommonResx.Confirm</button>
            </div>
        </div>
    </div>
</div>

<div id="disableCashServiceModal" class="modal fade cash-modal-danger" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body cash-modal-body">
                <div class="cash-modal-icon">
                    <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
                        <circle cx="28" cy="28" r="28" fill="#FDECEA" />
                        <polygon points="24,16 32,16 30,34 26,34" fill="#C82333" />
                        <circle cx="28" cy="39" r="3" fill="#C82333" />
                    </svg>
                </div>
                <div class="cash-modal-title">@Resources.DeactivateCashService</div>
                <div class="cash-modal-line"></div>
                <div class="cash-modal-desc">
                    @Resources.DeactivateCashServiceNote,
                    @DateTime.UtcNow.AddDays(1).AddHours(-4).ToString("dd MMM yyyy 00:00 tt") (GMT-4).
                </div>
            </div>
            <div class="cash-modal-footer">
                <button type="button" class="btn custom-cancel" data-dismiss="modal">@CommonResx.Cancel</button>
                <button type="button" class="btn custom-confirm" disabled="@(!Model.IsCanUpdateCashServiceStatus)"
                    id="confirmDisableCashService">@CommonResx.Confirm</button>
            </div>
        </div>
    </div>
</div>
@Html.AntiForgeryToken()