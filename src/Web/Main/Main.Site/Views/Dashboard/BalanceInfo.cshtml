@using AlphaPlus.Main.Site.Features.Dashboard.BalanceInfo
@model BalanceInfoViewModel
@using Fanex.Customer.Client.Models

@{
    var balanceInfo = Model.BalanceInfo;

    void TextRow(string label, string text)
    {
        <div class="row">
            <div class="col-xs-7">@label</div>
            <div class="col-xs-5 value"><strong>@text</strong></div>
        </div>
    }

    void RewardRow(string label, decimal value, string currency, string tooltip)
    {
        <div class="row reward ">
            <div class="col-xs-7 ver2">@label
                <span class="icon-information-outline" data-toggle="tooltip" data-placement="right" title="@tooltip"></span>
            </div>
            <div class="col-xs-5 value">
                <strong>@currency</strong>
                <strong>@value.ToString("#,##0.00")</strong>
            </div>
        </div>
    }

    void CashService(string label, bool isCashServiceEnabled)
    {
         <div class='row'>
            <div class='col-xs-7'>@label</div>
            <div class='col-xs-5 value-toggle'>
                <div id='cash-service-toggle' class='switch-toggle' data-state='@(isCashServiceEnabled ? "on" : "off")'>
                    <div class='toggle'></div>
                </div>
            </div>
        </div>
    }

    @* void TotalCashMember(string label, TotalCashMember total)
    {
        <div class="row">
            <div class="col-xs-7 lable">@label</div>
            <div class="col-xs-5 value">
                <strong data-toggle="tooltip" data-placement="top"
                    title="<div class='nowrap'>@Resources.active: <span class='active'>@total.TotalCashMemberActive</span></div><div class='nowrap'>@Resources.closed: <span class='closed'>@total.TotalCashMemberClosed</span></div><div class='nowrap'>@Resources.suspended: <span class='suspended'>@total.TotalCashMemberSuspended</span></div>">
                    <span class="active">@total.TotalCashMemberActive</span>|
                    <span class="closed">@total.TotalCashMemberClosed</span>|
                    <span class="suspended">@total.TotalCashMemberSuspended</span>
                </strong>
            </div>
        </div>
    } *@
     void RenderTotalMemberInfo(string labelName, int memberActive, int memberClosed, int memberSuspended)
    {
        <div class="row">
            <div class="col-xs-7 lable">@labelName</div>
            <div class="col-xs-5 value">
                <strong data-toggle="tooltip" data-placement="top"
                    title="<div class='nowrap'>@Resources.active: <span class='active'>@memberActive</span></div><div class='nowrap'>@Resources.closed: <span class='closed'>@memberClosed</span></div><div class='nowrap'>@Resources.suspended: <span class='suspended'>@memberSuspended</span></div>">
                    <span class="active">@memberActive</span>|
                    <span class="closed">@memberClosed</span>|
                    <span class="suspended">@memberSuspended</span>
                </strong>
            </div>
        </div>
    }
}


<div class="container">
    <div class="panel-title"><span class="icon-balance"></span>@Resources.balanceInfo</div>
    @{
        TextRow(label: Model.UserLevelLabel, text: balanceInfo.UserName);
        TextRow(label: Resources.currency, text: Model.Currency);
    }

    @if (Model.IsOfferedCashService)
    {
        <div class="group-title">@Resources.CashService</div>
        CashService(Resources.CashService, Model.CashServiceInfo.IsCashServiceEnabled);
        RenderTotalMemberInfo(Resources.TotalCashMember, Model.CashServiceInfo.TotalCashMember.TotalCashMemberActive, Model.CashServiceInfo.TotalCashMember.TotalCashMemberClosed, Model.CashServiceInfo.TotalCashMember.TotalCashMemberSuspended);
    }

    <div class="group-title">@Resources.balance</div>
    @Html.NumericRow(Resources.cashBalance, balanceInfo.CashBalance)
    @Html.NumericRow(Resources.yesterdayCashBalance, balanceInfo.YesterdayCashBalance)
    @Html.NumericRow(Resources.totalBalance, balanceInfo.TotalBalance)
    @Html.NumericRow(Resources.yesterdayTotalBalance, balanceInfo.YesterdayTotalBalance)
    @Html.NumericRow(Resources.PendingTransfer3rd, balanceInfo.PendingTransfer3rd)
    <div class="group-title">@Resources.winloss</div>
    @Html.NumericRow(
    $"{Resources.todayWinLoss} ({DateTime.Today.ToString("MM/dd/yyyy")})",
        balanceInfo.TodayWinLoss,
        Model.CanViewReports,
        Model.MemberTodayWinLossReportPath,
        "dashboard-winloss")
    @Html.NumericRow(
        $"{Resources.yesterdayWinLoss} ({DateTime.Today.AddDays(-1).ToString("MM/dd/yyyy")})",
        balanceInfo.YesterdayWinLoss,
        Model.CanViewReports,
        Model.MemberYesterdayWinLossReportPath,
        "dashboard-yesterday-winloss")

    <div class="group-title">
        @Resources.credit
    </div>
    @Html.NumericRow(Model.GivenCreditLabel, balanceInfo.GivenCredit)
    @Html.NumericRow(Model.TotalDownlineCreditLabel, balanceInfo.MemberCredit)
    @if (Model.ShowDirectMember)
    {
        @Html.NumericRow(Resources.TotalDirectMember, balanceInfo.DirectMemberCredit)
    }
    <div class="group-title">@Resources.Reward</div>
    @{
        RewardRow(Resources.RewardReceivable, Model.BalanceInfo.RewardReceivable ?? 0, Model.BalanceInfo.RewardCurrency,
        Resources.RewardReceivableTooltip);
        RewardRow(Resources.RewardPayable, Model.BalanceInfo.RewardPayable ?? 0, Model.BalanceInfo.RewardCurrency,
        Resources.RewardPayableTooltip);
    }
</div>

<partial name="StatusCashModal" />

<script>
    $(document).ready(function () {
        $(".open-link").unbind().bind('click', function (event) { alpha.viewDataURL(event); });
        $("#cash-service-toggle").unbind().bind('click', function (event) { onClickCashServiceToggle(); });

        $("#confirmEnableCashService").click(function () {
            $.ajax({
                url: '/main/Dashboard/UpdateCashServiceStatus',
                type: 'POST',
                data: {
                    IsEnableCash: true
                },
                headers: {
                    'RequestVerificationToken': $('input[name="RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.isSuccessful) {
                        const toggle = $("#cash-service-toggle");
                        toggle.attr("data-state", "on");
                        toggle.addClass("active");
                        $("#enableCashServiceModal").modal('hide');
                    } else {
                        console.error("enable cash service failed");
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error calling cash service status API:', error);
                }
            });
        });

        $("#confirmDisableCashService").click(function () {
            $.ajax({
                url: '/main/Dashboard/UpdateCashServiceStatus',
                type: 'POST',
                data: {
                    IsEnableCash: false
                },
                success: function (response) {
                    if (response.isSuccessful) {
                        const toggle = $("#cash-service-toggle");
                        toggle.attr("data-state", "off");
                        toggle.removeClass("active");
                        $("#disableCashServiceModal").modal('hide');
                    } else {
                        console.error("disable cash service failed");
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error calling cash service status API:', error);
                }
            });
        });
    });

    function onClickCashServiceToggle() {
        const toggle = $("#cash-service-toggle");
        const isChecked = toggle.attr("data-state");
        if (isChecked === "on") {
            // Mở modal xác nhận tắt
            $("#disableCashServiceModal").modal('show');
        } else {
            // Mở modal enable như cũ
            $("#enableCashServiceModal").modal('show');
        }
    }
</script>