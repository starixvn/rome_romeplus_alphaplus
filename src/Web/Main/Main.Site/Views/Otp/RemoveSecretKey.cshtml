@using AlphaPlus.Main.Site.Features.OTP
@model OtpViewModel
@{
    Layout = null;
}
<div class="panel success" id="remove-secret-key-panel" style="@(Model.IsAlreadySetup ? "" : "display:none;")">
    <div class="panel-heading" role="tab" id="headingChangeOtp">
        <h4 class="panel-title">
            <a class="collapsed color-success" role="button" data-toggle="collapse" data-parent="#accordion"
                href="#registerOtpAppSuccess" aria-expanded="false" aria-controls="registerOtpAppSuccess">
                @Security.RegisteredMobileApplication
                @if (Model.CustomerOtp.Enabled)
                {
                    <span class="icon-check-circle"></span>
                }
            </a>
        </h4>
    </div>
    <div id="registerOtpAppSuccess" class="panel-collapse collapse in" role="tabpanel"
        aria-labelledby="headingChangeOtp">
        <div class="panel-body">
            <div id="remove-otp-message"></div>
            <div id="change-status-message"></div>
            <div class="register-succeess">
                <p>@Security.ClickToRemoveOtp</p>
                <button class="btn-remove" id="btn-remove-otp">@Security.RemoveOtp</button>
            </div>
            <label class="ml-16 mt-15">
                <input class="cbkEnableOtp" type="checkbox" @(Model.CustomerOtp.Enabled ? "checked " : "")
                    data-is-already-setup="@Model.IsAlreadySetup.ToString().ToLower()"
                    data-is-checked="@Model.CustomerOtp.Enabled.ToString().ToLower()" />
                @Security.EnableOtpViaMobileAuthenticatorApp
            </label>
        </div>
    </div>
</div>