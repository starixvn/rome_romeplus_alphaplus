@using AlphaPlus.Main.Site
@using AlphaPlus.Main.Site.Features.Default
@model IndexViewModel
<div id="cash-service-checklist" class="cash-service-checklist hide"
    style="position:absolute;z-index:1000;width:100px;height:100px;background-color:red;left: 400px;">
    <div id="ico-checklist" class="icon-close-feedback"></div>
    <div class="checklist-content hide">
        <div>@Html.Raw(Resources.CashServiceSetupChecklist_Row1)</div>
        <div>@Html.Raw(string.Format(Resources.CashServiceSetupChecklist_Row2, Model.CashServiceRootPath + "Payments/Index"))</div>
        <div>@Html.Raw(Resources.CashServiceSetupChecklist_Row3)</div>
        <div>@Html.Raw(Resources.CashServiceSetupChecklist_Row4)</div>
        <div>@Html.Raw(string.Format(Resources.CashServiceSetupChecklist_Row5, Model.CashServiceRootPath + "MemberSites/Index"))</div>
        <div>@Html.Raw(Resources.CashServiceSetupChecklist_Row6)</div>
        <div>@Html.Raw(Resources.CashServiceSetupChecklist_Row7)</div>
        <div>@Html.Raw(Resources.CashServiceSetupChecklist_Row8)</div>
        <button class="btn-help">@Resources.Help</button>
    </div>
</div>