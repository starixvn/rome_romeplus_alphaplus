@using AlphaPlus.Main.Site.Features.Dashboard.CashService
@using AlphaPlus.Core.Helpers
@model CashServiceInfoViewModel
@using AlphaPlus.Main.Site
@{
    Layout = null;
    var version = AppSettings.JsVersion;
}

<!DOCTYPE html>
<html>

<head>
    <title>CashServiceAds Page</title>
    <environment names="Production">
        <link rel="stylesheet" href="@(Model.CDNUri)advertisement/index.css?version=@version" />
        <script type="module" src="@(Model.CDNUri)advertisement/index.js?version=@version"></script>
    </environment>
</head>

<div id="adv-popup-root"></div>

<body>
    <script type="text/javascript">
        const appConfig = @Html.Raw(Json.Serialize(
            new {
                applicationPath = "/",
                advName = "CashServiceAds",
                isCanUpdateCashServiceStatus = @Model.IsCanUpdateCashServiceStatus,
                isCanEditCashService = @Model.IsCanEditCashService,
                isOfferedCashService = @Model.IsOfferedCashService,
                isCashServiceEnabled = @Model.IsCashServiceEnabled,
                nickName = @Model.NickName
            }
        ));
        const cdnUri = "@Html.Raw(Model.CDNUri)";
        const mainUrl = '@MicroSites.MainUrl()';
        const homeUrl = '@MicroSites.MainUrl("~/Dashboard/index2")';
    </script>

    <environment include="Development">
        <script type="module">
            import RefreshRuntime from 'http://localhost:4213/@@react-refresh'
            RefreshRuntime.injectIntoGlobalHook(window)
            window.$RefreshReg$ = () => { }
            window.$RefreshSig$ = () => (type) => type
            window.__vite_plugin_react_preamble_installed__ = true
        </script>
        <script type="module" src=@("http://localhost:4213/@vite/client")></script>
        <script type="module" src="http://localhost:4213/src/main.tsx"></script>
        <link rel="stylesheet" href="http://localhost:4213/src/styles.scss" />
    </environment>

    @Html.AntiForgeryToken()
</body>
</html>