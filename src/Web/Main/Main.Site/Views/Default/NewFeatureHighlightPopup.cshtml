@using AlphaPlus.Main.Site
@using AlphaPlus.Main.Site.Features.Default
@model IndexViewModel
@if (Model.HightLightFeaturePermission)
{
    <div class="popup-highlight hide" id="boxHighlightPopupNewFeature">
        <button type="button" class="icon icon-close close" title="@Resources.close">
            <span aria-hidden="true"></span>
        </button>
        <div class="text">
            <div class="image">
                <img src="~/assets/images/@(Model.HightLightFeatureImageName).svg?v=@AppSettings.JsVersion"
                    alt="@Resources.HighlightPopupNewFeatureTitle">
                <p class="sm"><span>@Html.Raw(Resources.HighlightPopupNewFeatureTitle)</span></p>
            </div>
            <div>
                <p class="pc"><span>@Html.Raw(Resources.HighlightPopupNewFeatureTitle)</span></p>
                <p>@Html.Raw(Resources.HighlightPopupNewFeatureIntro)</p>
                <ul>
                    <li>@Html.Raw(Resources.HighlightPopupNewFeatureIntro2)</li>
                    <li>@Html.Raw(Resources.HighlightPopupNewFeatureIntro3)</li>
                    <li>@Html.Raw(Resources.HighlightPopupNewFeatureIntro4)</li>
                    <li>@Html.Raw(Resources.HighlightPopupNewFeatureIntro5)</li>
                </ul>
                <p>@Html.Raw(Resources.HighlightPopupNewFeatureIntro6)</p>
            </div>
        </div>
        <div class="action">
            <label class="label">
                <input id="chkHideHighlightPopupNewFeature" type="checkbox" />
                <span>@Resources.doNotShowAgain</span>
            </label>
            <a class="btn-submit" id="linkHighlightPopupCheckOut" target="_blank" href="@Model.HightLightFeatureUrl" target="main">@Resources.TakeATour</a>
        </div>
    </div>
}
else if (Model.IsShowRewardTour)
{
    <input type="hidden" id="hidden-isShowRewardTour" value="1" />
    <partial name="RewardHighlightPopup" />
}