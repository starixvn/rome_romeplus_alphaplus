<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Shared\Extensions\FanexLoggingExtensions.cs" Link="Shared\FanexLoggingExtensions.cs" />
    <Compile Include="..\..\Shared\ExceptionHelper.cs" Link="Shared\ExceptionHelper.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fanex.Data.Repository" Version="4.3.3" />
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.3.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.1" />
    <PackageReference Include="Fanex.Logging.RabbitMQ" Version="1.0.1" />
    <PackageReference Include="Fanex.Logging.Sentry" Version="5.0.0.1" />
    <Content Include="App_Data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>