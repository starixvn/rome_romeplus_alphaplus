{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Fanex.Logging": {
    "DefaultCategory": "AgencyCash-API-Gateway",
    "RabbitMQConnectionStrings": "host=rabbitmq.nexdev.net;virtualHost=/Fanex_Logging;username=fanexlogging;password=YKQrMtla7oYZGlP8apPtSw==",
    "SentryBackendUrl": ""
  },
  "ONEbook.UM": {
    "ServiceUri": "http://fanex_um_LOCAL:5000/api",
    "EnableCheckUM": false,
    "SiteId": 3100000,
    "EnableUnscheduledUM": false,
    "UMFrom": "3:00",
    "UMTo": "4:00",
    "ResultCacheDuration": 60
  },
  "ApiKey": "ykDT7W269wcjNkaz3wZNejiFRKwBR9KwOJd2quHhdEn0U0jpAptPI3qPiRglmsLF",
  "RateLimiting": {
    "FixedWindow": {
      "PermitLimit": 5,
      "WindowSeconds": 10
    }
  },
  "ReverseProxy": {
    "Routes": {
      "AgencyCashRoute": {
        "ClusterId": "AgencyCash",
        "RateLimiterPolicy": "FixedWindow",
        "Match": {
          "Path": "/api/{**catch-all}",
          "Methods": [
            "GET",
            "POST"
          ]
        }
      },
      "AgencyCashSwagger": {
        "ClusterId": "AgencyCash",
        "Match": {
          "Path": "/agency-cash-api/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/agency-cash-api"
          }
        ]
      },
      "AgencyCashSwaggerRoot": {
        "ClusterId": "AgencyCash",
        "Match": {
          "Path": "/agency-cash-api"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/agency-cash-api"
          },
          {
            "PathSet": "/swagger/index.html"
          }
        ]
      }
    },
    "Clusters": {
      "AgencyCash": {
        "Destinations": {
          "AgencyCashUrl": {
            "Address": "http://localhost:5054/"
          }
        }
      }
    }
  }
}